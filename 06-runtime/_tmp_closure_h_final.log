-window.KNOWLEDGE_GRAPH_DATA={"nodes":[{"id":"events:anshi-zhiluan","title":"安史之乱（An Lushan Rebellion）","name_en":"An Lushan Rebellion","type":"event","type_zh":"事件","color":"#EF4444","tags":["唐代","战乱","中晚唐","五代十国","分期背景"],"confidence":"medium","consensus":"tentative","sub_type":"historical_event","source_count":"2","evidence_status":"source_backed","description":"安史之乱是唐中叶的战乱。田自秉记“安史之乱”后国势日衰，并以之为唐灭亡后五代十国分裂局面的背景；2016 版称其战火破坏唐朝社会安定与经济繁荣，使中晚唐地方割据势力抬头，最终形成五代十国。两册均未给具体年份。","path":"events/anshi-zhiluan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"E","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"安史之乱是 E 维度下唐代由盛转衰的分期事件，主要用于解释中晚唐工艺与地方窑业格局的变化。Theme/Topic 尚未 materialize。"},{"id":"events:banama-saihui","title":"巴拿马赛会（Panama-Pacific International Exposition）","name_en":"Panama-Pacific International Exposition","type":"event","type_zh":"事件","color":"#EF4444","tags":["1915年","巴拿马赛会","博览会","中国参展","工艺"],"confidence":"medium","consensus":"tentative","sub_type":"exhibition","source_count":"2","evidence_status":"source_backed","description":"巴拿马赛会全称“太平洋万国巴拿马博览会”，是美国为庆祝巴拿马运河正式通航举办的盛会，1915年2月20日开幕，历时280天，设美术、教育、工艺、制造等12个馆。中国展品重约1500吨，参加赛会的著名手工艺匠师和工场代表约300多人。2016 版同记名称、开幕日、280天、12馆与300多人，未记展品吨位。","path":"events/banama-saihui.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"E","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"巴拿马赛会是 E 维度下中国工艺参加国际博览会、进入跨文化展示体系的条目。Theme/Topic 尚未 materialize。"},{"id":"events:hufu-qishe","title":"胡服骑射（Hufu Qishe Reform）","name_en":"Hufu Qishe Reform","type":"event","type_zh":"事件","color":"#EF4444","tags":["战国","赵国","赵武灵王","胡服","服饰改革"],"confidence":"medium","consensus":"tentative","sub_type":"historical_event","source_count":"1","evidence_status":"source_backed","description":"胡服骑射是战国时期赵武灵王在赵国推行的服饰与军事改革。赵农记赵国地处北方，长年与草原游牧民族作战，服饰不便使战斗力受到影响；赵武灵王力排众议引进胡服骑射，提高战斗能力，并说服贵族王室，最终奠定赵国强盛的基础。来源未给具体年份。","path":"events/hufu-qishe.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"E","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"胡服骑射是 E 维度下战国时期赵国引进北方游牧民族服饰的制度改革，用于说明服饰功能与跨文化采纳。Theme/Topic 尚未 materialize。"},{"id":"events:nanyang-quanyehui","title":"南洋劝业会（Nanyang Industrial Exposition）","name_en":"Nanyang Industrial Exposition","type":"event","type_zh":"事件","color":"#EF4444","tags":["1910年","南洋劝业会","南京丁家桥","博览会","实业"],"confidence":"medium","consensus":"tentative","sub_type":"exhibition","source_count":"2","evidence_status":"source_backed","description":"南洋劝业会于清宣统二年（1910）由南洋通商大臣倡办，原称“南洋第一次劝业会”，地址在南京丁家桥。全国选送展品100多万件，分24部420类，评出5269件产品获奖；因辛亥革命实际只办一届。2009 版另记江苏、广东获奖最多，2016 未记获奖省份。","path":"events/nanyang-quanyehui.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"南洋劝业会是 D 维度下清末实业展览与产品评奖制度的条目，也是 `places/nanjing.md` 清末会场的制度背景。Theme/Topic 尚未 materialize。"},{"id":"events:opium-war","title":"鸦片战争（Opium War）","name_en":"Opium War","type":"event","type_zh":"事件","color":"#EF4444","tags":["清代","近代","鸦片战争","半殖民地","近代设计转型"],"confidence":"medium","consensus":"tentative","sub_type":"historical_event","source_count":"5","evidence_status":"source_backed","description":"鸦片战争是 1840 年英国以鸦片贸易为借口对中国发动的战争。五册来源都把 1840 年作为中国近代史（或近代设计史）的开端，也都把战争的结果指向同一件事：中国被迫成为开放的国际市场，传统手工业与手工制瓷、手工纺织等部门在洋货倾销下解体或转型。各册对它的处理方式不同：高丰把它当成分期依据与设计衰退的起点，夏燕靖两版把它当成手工业转型的分界，田自秉把它当成工艺美术全面受摧残的开端，赵农把它当成白银回","path":"events/opium-war.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"E","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"鸦片战争是 E 维度下中国设计现代化的分界事件，同时通过通商口岸、海关与官办企业构成 D 维度的制度起点。Theme/Topic 尚未 materialize。"},{"id":"events:pangeng-move-to-yin","title":"盘庚迁殷（Pangeng's Move to Yin）","name_en":"Pangeng's Move to Yin","type":"event","type_zh":"事件","color":"#EF4444","tags":["商代","盘庚","殷墟","迁都","分期"],"confidence":"medium","consensus":"tentative","sub_type":"historical_event","source_count":"2","evidence_status":"source_backed","description":"盘庚迁殷是商王盘庚将都城迁至殷（今河南安阳）的事件。田自秉记其为公元前15世纪末商王盘庚最后一次迁都，并以此作为商代前期与后期的分界，此后商又称殷或商殷。2016 版记盘庚迁殷后商后期皆以殷为都，至纣亡共253年、八代十二王，约前1250—前1050年；殷墟发现宫殿、居民点、手工业作坊与墓葬区。原文同段又作“计73年”，与253年、八代十二王相矛盾，未改字。","path":"events/pangeng-move-to-yin.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"E","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"盘庚迁殷是 E 维度下商代都邑迁移与商后期分期的锚点事件。Theme/Topic 尚未 materialize。"},{"id":"events:quanguo-gongyi-meishu-zhanlanhui-1959","title":"1959年全国工艺美术展览会（National Arts and Crafts Exhibition 1959）","name_en":"National Arts and Crafts Exhibition 1959","type":"event","type_zh":"事件","color":"#EF4444","tags":["1959年","工艺美术展览","故宫午门","轻工业部","全国手工业合作总社"],"confidence":"medium","consensus":"tentative","sub_type":"exhibition","source_count":"2","evidence_status":"source_backed","description":"1959年10月3日，由轻工业部和全国手工业合作总社联合举办的“全国工艺美术展览会”在北京故宫午门开幕。展览展出11类工艺品3500余件作品。2016 版另称展览集中展出各地名师名家作品，推动当时工艺美术品的恢复和发展。","path":"events/quanguo-gongyi-meishu-zhanlanhui-1959.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本展览是 D 维度下 1950 年代工艺美术行业展示与生产恢复的制度性事件。Theme/Topic 尚未 materialize。"},{"id":"events:quanguo-minjian-meishu-gongyipin-zhanlanhui","title":"全国民间美术工艺品展览会（National Folk Arts and Crafts Exhibition）","name_en":"National Folk Arts and Crafts Exhibition","type":"event","type_zh":"事件","color":"#EF4444","tags":["1953年","民间美术","工艺美术展览","文化部","巡展"],"confidence":"medium","consensus":"tentative","sub_type":"exhibition","source_count":"2","evidence_status":"source_backed","description":"1953年12月至1954年1月，文化部主办的“全国民间美术工艺品展览会”在北京劳动人民文化宫举行，展出陶瓷、染织、刺绣、金属工艺、漆器、编织、雕塑、年画、剪纸、玩具等民间工艺品近3000件。1954年6月展览作品运往苏联、捷克斯洛伐克、匈牙利、保加利亚等国展出。2016 版另记：1953年12月7日开幕、1954年1月3日闭幕；1954年6—11月赴苏联、捷克斯洛伐克、匈牙利、保加利亚和缅甸巡回","path":"events/quanguo-minjian-meishu-gongyipin-zhanlanhui.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本展览是 D 维度下 1950 年代民间工艺调查、展示与对外交流的制度性事件。Theme/Topic 尚未 materialize。"},{"id":"events:shanghai-shougongye-shouxian-dahui","title":"上海市首次手工业技艺人员授衔大会（Shanghai First Handicraft Artisan Title Conferral）","name_en":"Shanghai First Handicraft Artisan Title Conferral","type":"event","type_zh":"事件","color":"#EF4444","tags":["1964年","上海","手工业","工艺师","授衔"],"confidence":"medium","consensus":"tentative","sub_type":"professional_event","source_count":"2","evidence_status":"source_backed","description":"1964年2月6日，上海市首次手工业技艺人员授衔大会召开，全市手工业者1100人出席，会上共有112位人员受衔。工艺美术行业的61位艺术上有独特成就、创作上有重大贡献的著名艺人被授予“工艺师”称号。两册记载一致，2016 为压缩表述。","path":"events/shanghai-shougongye-shouxian-dahui.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本事件是 D 维度下新中国工艺美术艺人职称制度的早期实践，可与 1950 年代的展览、合作社等制度条目并置。Theme/Topic 尚未 materialize。"},{"id":"events:xinhai-geming","title":"辛亥革命（Xinhai Revolution）","name_en":"Xinhai Revolution","type":"event","type_zh":"事件","color":"#EF4444","tags":["1911年","辛亥革命","孙中山","封建统治","近代工商业"],"confidence":"medium","consensus":"tentative","sub_type":"historical_event","source_count":"2","evidence_status":"source_backed","description":"辛亥革命是1911年推翻中国几千年封建统治的革命。2016 版记其虽然没有改变我国半殖民地、半封建社会性质，但冲破了封建专制主义对国家的长期禁锢，资本主义生产关系和工商业得以发展。赵农记孙中山领导的辛亥革命一开始就提出“驱除鞑虏，恢复中华，创立合众政府”（兴中会语）的口号，并以之作为近代革命与《建国方略》构想的起点。","path":"events/xinhai-geming.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"E","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"辛亥革命是 E 维度下清末民初政治转折与近代工商业发展的分界事件。Theme/Topic 尚未 materialize。"},{"id":"events:yangwu-yundong","title":"洋务运动（Self-Strengthening Movement）","name_en":"Self-Strengthening Movement","type":"event","type_zh":"事件","color":"#EF4444","tags":["晚清","洋务运动","近代工业","中体西用","设计转型"],"confidence":"medium","consensus":"tentative","sub_type":"historical_event","source_count":"2","evidence_status":"source_backed","description":"洋务运动是晚清官员继承魏源思想、引进西方机器装备、技术和管理方法的经济变革。2016 版记曾国藩、左宗棠、李鸿章等办军民用工业、设船政局、制造局、招商局并派幼童留学，称其开启我国近代工业，是工业设计和现代设计孕育的土壤。赵农则认为其现实格局定位于“旧（中）学为体，西学为用”，“强国”实为“强政府”，很少关注“民生”根本利益。","path":"events/yangwu-yundong.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"E","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"洋务运动是 E 维度下晚清引进西方技术、开启近代工业与设计转型的枢纽事件。Theme/Topic 尚未 materialize。"},{"id":"institutions:bintieju","title":"镔铁局（Bintie Bureau）","name_en":"Bintie Bureau","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["元代","镔铁","矿冶","金属工艺","集宁路"],"confidence":"medium","consensus":"tentative","sub_type":"government_office","source_count":"3","evidence_status":"source_backed","description":"镔铁局是元代官府管理镔铁生产与加工的机构，隶属关系只有夏燕靖两版给出（“工部总管府下”）。三册来源对它的职能说法不同：夏燕靖两版说它“专门冶炼铁铜等金属产品”，赵农说它“管理镔铁镂刻、镶嵌金银的制作”——一为冶铸，一为装饰加工，本 KU 并存。赵农另给出镔铁在元代铁器中的地位（“元代铁器中最著名的是以镔铁为材料的刀具”）。","path":"institutions/bintieju.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"镔铁局是 D 维度下元代官府管理特种金属材料的机构节点，镔铁作为材料的稀缺性同时构成 B 维度刀具与饰件工艺的约束条件。Theme/Topic 尚未 materialize。"},{"id":"institutions:central-academy-arts-design","title":"中央工艺美术学院（Central Academy of Arts and Design）","name_en":"Central Academy of Arts and Design","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["设计教育","工艺美术","1956","北京"],"confidence":"medium","consensus":"tentative","sub_type":"design_school","source_count":"5","evidence_status":"source_backed","description":"中央工艺美术学院是 1956 年经国务院批准成立的高等工艺美术院校，校址在北京马神庙白堆子，1999 年并入清华大学并更名为清华大学美术学院。五册来源都把它作为新中国综合性高等工艺美术教育全面启动的标志。","path":"institutions/central-academy-arts-design.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"中央工艺美术学院是 D 维度（商业、制度与设计教育）下设计教育制度的锚点；其专业设置与 1999 年合并也涉及 E 维度的现代性转型。Theme/Topic 尚未 materialize。"},{"id":"institutions:chuangong","title":"船宫（Chuangong Shipyard）","name_en":"Chuangong Shipyard","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["春秋战国","吴越","楚","造船","水军"],"confidence":"medium","consensus":"tentative","sub_type":"craft_workshop","source_count":"2","evidence_status":"source_backed","description":"船宫是春秋战国时期南方所建的造船作坊。赵农在“水战”段称南方吴、越、楚国与北方齐国造船业均非常发达，吴越建有“船宫”；夏燕靖 2016 称南方楚、吴、越出现专门的造船工场——船宫，与最早的水军舟师并见。","path":"institutions/chuangong.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下先秦造船工场的锚点，其军事背景属于 D 维度。Theme/Topic 尚未 materialize。"},{"id":"institutions:dier-qinggongyebu","title":"第二轻工业部（Second Ministry of Light Industry）","name_en":"Second Ministry of Light Industry","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["1965","北京","工艺美术局","中央手工业管理总局","工艺美术创作设计会议"],"confidence":"medium","consensus":"tentative","sub_type":"government_office","source_count":"2","evidence_status":"source_backed","description":"第二轻工业部于 1965 年初由国务院决定撤销中央手工业管理总局后改建成立，下设工艺美术局；同年 6 月在北京召开全国工艺美术创作设计会议。","path":"institutions/dier-qinggongyebu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 D 维度下 1960 年代工艺美术行政机构的锚点。Theme/Topic 尚未 materialize。"},{"id":"institutions:fujian-chuanzhengju","title":"福建船政局（Fujian Naval Yard）","name_en":"Fujian Naval Yard","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["清代","洋务运动","马尾","造船","左宗棠"],"confidence":"medium","consensus":"tentative","sub_type":"government_office","source_count":"4","evidence_status":"source_backed","description":"福建船政局是 1866 年由左宗棠奏请创办的近代官办造船与船政机构，设在福建马尾。三册来源对它的侧重完全不同：夏燕靖两版把它作为左宗棠洋务活动的核心事例，给出选址、人事接续、造船年限与艺局人数；李立新把它作为“近代工业化造物”的第一个标志，只取造船时间一点。夏燕靖一册内部有两处年代需要分开读：1866 年上奏创办，1872 年奏报创办意图。","path":"institutions/fujian-chuanzhengju.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"福建船政局是 D 维度下洋务官办企业的组织样本，其技术引进与求实堂艺局的人才培养同时属 E 维度的跨文化技术转移。Theme/Topic 尚未 materialize。"},{"id":"institutions:fuliang-ciju","title":"浮梁瓷局（Fuliang Porcelain Bureau）","name_en":"Fuliang Porcelain Bureau","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["元代","景德镇","官窑","青花瓷"],"confidence":"medium","consensus":"tentative","sub_type":"government_office","source_count":"4","evidence_status":"source_backed","description":"浮梁瓷局是元初设在景德镇的官方瓷业机构。四册来源都把它作为元代景德镇官营瓷业的起点，但对它的机构性质记述不一：高丰称其为“全国惟一的官营瓷器作坊”，夏燕靖两版则称其为“监督税收机构”。本 KU 并存两说，不调和。","path":"institutions/fuliang-ciju.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"浮梁瓷局是 D 维度下元代官方介入景德镇瓷业生产的制度节点，也是 C 维度青花瓷视觉体系得以成立的制度前提。Theme/Topic 尚未 materialize。"},{"id":"institutions:gugong-bowuyuan","title":"故宫博物院（The Palace Museum）","name_en":"The Palace Museum","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["博物院","藏品","西周织物","商代提花织物","纺织史证据"],"confidence":"medium","consensus":"tentative","sub_type":"museum","source_count":"2","evidence_status":"source_backed","description":"故宫博物院在两册中都不是作为机构史对象出现，而是作为藏品来源：田自秉记其藏有周墓出土的玉刀，上面残留回纹图案的织花痕迹，是西周织物的间接实物证据；李立新记其收藏商代铜戈把和玉女戈（疑“玉援戈”）附着丝织品痕迹，并据以说明商代提花织物为平纹地起四成六枚斜纹花。","path":"institutions/gugong-bowuyuan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 D 维度下博物馆机构的锚点，其实质内容服务于 B 维度的纺织技术史。Theme/Topic 尚未 materialize。"},{"id":"institutions:jiangnan-zhizao-zongju","title":"江南制造总局（Jiangnan Manufacturing Bureau）","name_en":"Jiangnan Manufacturing Bureau","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["1865","上海","洋务运动","兵工厂","造船"],"confidence":"medium","consensus":"tentative","sub_type":"government_office","source_count":"2","evidence_status":"source_backed","description":"江南制造总局于 1865 年在曾国藩支持下由李鸿章在上海创办，是当时我国最大的兵工厂，并开始造船和修船。赵农把“造船”视为晚清洋务运动中向西方科学技术学习、揭开中国近代工业和科技发展序幕的标志之一，而非把该局本身单独列为标志。","path":"institutions/jiangnan-zhizao-zongju.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 D 维度下晚清洋务工业机构的锚点，其造船技术属于 B 维度、中西技术互动属于 E 维度。Theme/Topic 尚未 materialize。"},{"id":"institutions:jiangning-zhizaoju","title":"江宁织造局（Jiangning Imperial Silk Manufactory）","name_en":"Jiangning Imperial Silk Manufactory","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["清代","江宁","南京云锦","官营织造","曹氏"],"confidence":"medium","consensus":"tentative","sub_type":"government_office","source_count":"3","evidence_status":"source_backed","description":"江宁织造局是清代设在江宁（南京）的官营织造机构，与苏州、杭州合称三大织造中心，由内务府派员久任，以曹玺及其子孙的长期任职最为著名。三册来源都把它系在“云锦”这一品种上：夏燕靖两版说它“特织御用云锦”，田自秉说它管理织锦的生产。三册对曹氏任职年数的记法不一致，夏燕靖 2016 一册内部也有两处年数并存。","path":"institutions/jiangning-zhizaoju.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"江宁织造局是 D 维度下清代内务府系统官营织造的机构锚点，其产品云锦同时是 B 维度织造技术与 C 维度宫廷纹样的载体。Theme/Topic 尚未 materialize。"},{"id":"institutions:jiangzuojian","title":"将作监（Directorate of Imperial Construction）","name_en":"Directorate of Imperial Construction","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["官营手工业","唐代","宋代","土木营建"],"confidence":"medium","consensus":"tentative","sub_type":"government_office","source_count":"6","evidence_status":"source_backed","description":"将作监是隋唐中央主管土木营建工程的官署，与少府监、军器监、都水监并列，下辖左校、右校、中校、甄官四署。其前身可追溯至汉至南北朝的将作大匠：高丰把这一时期工官分为两类，少府掌手工业产品，将作大匠掌土木建筑工程。六册来源一致记其土木工程职掌，但所记工匠规模从“八百多人”到“各万余人”到“15000 人”不等，本 KU 并存不裁定。","path":"institutions/jiangzuojian.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"将作监是 D 维度下隋唐官营手工业体系中的土木营建主管机构，与少府监构成“大型工程／日常器具”的分工；其前身为汉至南北朝的将作大匠。Theme/Topic 尚未 materialize。"},{"id":"institutions:jiguge","title":"汲古阁（Jiguge）","name_en":"Jiguge","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["明末","常熟","毛晋","私家刻书","版刻"],"confidence":"medium","consensus":"tentative","sub_type":"publishing_house","source_count":"2","evidence_status":"source_backed","description":"汲古阁是明末常熟的私家刻书坊。李立新把它作为明清著名私家刻书机构，用以说明明清书坊、私宅刻书遍及各地及刻工匠人集聚；夏燕靖 2016 记毛晋在此雇工刻书 30 年、刻书 600 余种，书板达 10 万余副，刻本远销国内外。","path":"institutions/jiguge.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 C 维度下明清版刻出版机构的锚点。Theme/Topic 尚未 materialize。"},{"id":"institutions:jinshu","title":"锦署（Brocade Office）","name_en":"Brocade Office","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["东晋","南北朝","官营织造","蜀锦","提花"],"confidence":"medium","consensus":"tentative","sub_type":"government_office","source_count":"4","evidence_status":"source_backed","description":"锦署是晋室南渡后在江南设立的官营织锦机构。夏燕靖两版把它的设置系于刘裕灭后秦、迁关中织锦工匠至江南一事；李立新只记“晋室南渡后，成立锦署”，不给出自后秦的工匠来源。第四条来源（田自秉）提到的是后赵邺城的“织锦署”，与东晋锦署同名而异实，本 KU 把它作为同名机构的对照列入 sources，并在文中标明它不构成本实体的证据。","path":"institutions/jinshu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"锦署是 D 维度下东晋官营织造的机构起点，其设置以工匠迁徙为手段，直接改变 B 维度江南织锦的技术构成。Theme/Topic 尚未 materialize。"},{"id":"institutions:jinyin-zuofangyuan","title":"金银作坊院（Gold and Silver Workshop Institute）","name_en":"Gold and Silver Workshop Institute","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["唐代","官作","金银器","中尚署","行作"],"confidence":"medium","consensus":"tentative","sub_type":"government_office","source_count":"2","evidence_status":"source_backed","description":"金银作坊院是唐代“官作”金银器制作机构，设于中尚署之下，属少府监中尚署直属；与民间“行作”金银行、金银铺并存。非官方经营者称“行作”，质量差者称“行滥”。","path":"institutions/jinyin-zuofangyuan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 D 维度下唐代官营金银器机构的锚点，其器物质地与工艺属于 B 维度。Theme/Topic 尚未 materialize。"},{"id":"institutions:liangjiang-shifan-xuetang","title":"两江师范学堂（Liangjiang Normal College）","name_en":"Liangjiang Normal College","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["清末","南京","张之洞","图画手工科","设计教育"],"confidence":"medium","consensus":"tentative","sub_type":"design_school","source_count":"2","evidence_status":"source_backed","description":"两江师范学堂是清末设于南京的师范学堂，前身为 1902 年张之洞设立的三江师范学堂，1905 年更名。李立新记其 1906 年设图画手工科，采用日本教材并聘日本教习，为首次在中国设立美术与设计学科。赵农记 1905 年该校开设与设计有关的课程，但设计思想仍属“博物”“图画”“手工”等传统知识的范畴，并以此说明清末设计教育的过渡性质。","path":"institutions/liangjiang-shifan-xuetang.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 D 维度下清末设计教育机构的锚点。Theme/Topic 尚未 materialize。"},{"id":"institutions:lingjinyuan","title":"绫锦院（Brocade and Silk Weaving Office）","name_en":"Brocade and Silk Weaving Office","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["官营纺织","宋代","辽代","金代","元代"],"confidence":"medium","consensus":"tentative","sub_type":"government_office","source_count":"6","evidence_status":"source_backed","description":"绫锦院是宋、辽、金、元四朝都曾设置的官营丝织机构名称。六册来源分别在宋代少府监系统、辽代上京与祖州、金代五处、元代官匠局系统中提到它，建制与隶属各不相同。本 KU 把这些同名机构合并登记，并逐朝标注隶属差异，不假定其制度连续。","path":"institutions/lingjinyuan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"绫锦院是 D 维度下宋辽金元四朝官营丝织机构的同名制度，其跨朝代同名异制是制度史比较的样本。Theme/Topic 尚未 materialize。"},{"id":"institutions:lunchuan-zhaoshangju","title":"轮船招商局（China Merchants Steam Navigation Company）","name_en":"China Merchants Steam Navigation Company","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["1872","上海","李鸿章","轮船航运","洋务运动"],"confidence":"medium","consensus":"tentative","sub_type":"commercial_enterprise","source_count":"2","evidence_status":"source_backed","description":"轮船招商局于 1872 年由李鸿章创办，是当时国内最大的轮船航运公司，开机器内河航运之先。","path":"institutions/lunchuan-zhaoshangju.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 D 维度下晚清航运企业的锚点，其船舶与码头形制属于 B 维度、机器技术引入属于 E 维度。Theme/Topic 尚未 materialize。"},{"id":"institutions:nanjing-yunjin-yanjiusuo","title":"南京市云锦研究所（Nanjing Yunjin Research Institute）","name_en":"Nanjing Yunjin Research Institute","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["1957","南京","云锦","工艺美术研究机构"],"confidence":"medium","consensus":"tentative","sub_type":"research_institute","source_count":"2","evidence_status":"source_backed","description":"南京市云锦研究所于 1957 年 7 月由江苏省人民政府批准建立，2009 称其为新中国第一家工艺美术研究机构，2016 照录该评价。","path":"institutions/nanjing-yunjin-yanjiusuo.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下云锦研究机构的锚点，其建制过程属于 D 维度。Theme/Topic 尚未 materialize。"},{"id":"institutions:neiwufu-zaobanchu","title":"内务府造办处（Imperial Household Department Workshops）","name_en":"Imperial Household Department Workshops","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["清代","宫廷作坊","家具","珐琅作","乾隆"],"confidence":"medium","consensus":"tentative","sub_type":"government_office","source_count":"2","evidence_status":"source_backed","description":"内务府造办处是清代管理宫廷手工作坊的机构，下设木作、广木作及玻璃厂、珐琅作、金玉作、镶嵌作、漆作等众多作坊，集中全国挑选的匠师按宫廷要求制作家具与皇家用品。康熙、雍正时期有刘源、海望、年希尧等精通艺术的官员指导并参与家具设计，乾隆更逐件指示式样尺寸，其审美对清式家具的形成影响很大。2016 记其为清代宫廷制造皇家御用品的专门机构，康熙年间成立至 1924 年，先后设 60 多个专业作坊；珐琅彩在北","path":"institutions/neiwufu-zaobanchu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 D 维度下清代宫廷造物管理机构的锚点，其作坊分工与工艺内容同时属于 B 维度。Theme/Topic 尚未 materialize。"},{"id":"institutions:sanfuguan","title":"三服官（Three-Season Silk Office）","name_en":"Three-Season Silk Office","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["汉代","官营染织","宫廷服饰","临淄","襄邑"],"confidence":"medium","consensus":"tentative","sub_type":"government_office","source_count":"2","evidence_status":"source_backed","description":"三服官是汉代设置于襄邑、临淄一带的染织生产管理机构，负责采办宫廷服饰所需的丝绸。田自秉引《汉书·贡禹传》记齐三服官“作工各数千人，一岁数费巨万”，说明其规模。两册对“三服”的解释一致：指春、夏、秋三季所用的丝织物所对应的服色。","path":"institutions/sanfuguan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 D 维度下汉代官营染织机构的锚点，其生产规模同时属于 B 维度的织造组织问题。Theme/Topic 尚未 materialize。"},{"id":"institutions:shanghai-meishu-dianying-zhipianchang","title":"上海美术电影制片厂（Shanghai Animation Film Studio）","name_en":"Shanghai Animation Film Studio","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["1957","上海","动画","中国动画学派","大闹天宫"],"confidence":"medium","consensus":"tentative","sub_type":"film_studio","source_count":"2","evidence_status":"source_backed","description":"上海美术电影制片厂于 1957 年建立，拍摄了不少动画影片并在国际电影节上获奖，形成被世界公认的“中国动画学派”。其代表作品包括《大闹天宫》《小蝌蚪找妈妈》《牧笛》等。2016 另记 1978 年底至 1989 年新动画片生产厂家涌现，改变了该厂一枝独秀的局面。","path":"institutions/shanghai-meishu-dianying-zhipianchang.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 C 维度下现代动画生产机构的锚点，其在 1980 年代的产业格局变化亦涉及 D 维度。Theme/Topic 尚未 materialize。"},{"id":"institutions:shangmei-tuananguan","title":"尚美图案馆（Shangmei Pattern Studio）","name_en":"Shangmei Pattern Studio","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["1923","上海","陈之佛","图案设计","染织纹样"],"confidence":"medium","consensus":"tentative","sub_type":"design_firm","source_count":"2","evidence_status":"source_backed","description":"尚美图案馆于 1923 年由陈之佛在上海创办，从事工业产品的图案设计，并通过实际工作培养设计人员；仅维持 4 年，但其集体协调的设计形式产生相当反响。2016 称其为陈之佛在上海创办的图案设计机构，主要从事染织纹样设计。","path":"institutions/shangmei-tuananguan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 D 维度下近代设计事务所的锚点，其染织纹样业务属于 B 维度。Theme/Topic 尚未 materialize。"},{"id":"institutions:shangwu-yinshuguan","title":"商务印书馆（The Commercial Press）","name_en":"The Commercial Press","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["上海","1920","广告画家","商业招贴","出版机构"],"confidence":"medium","consensus":"tentative","sub_type":"publishing_house","source_count":"2","evidence_status":"source_backed","description":"商务印书馆是上海出版机构，对上海广告画家的培养起了很大作用。1920 年招收练习生，有李泳青、杭稚英、金梅生、金雪尘、鲁少飞、戈湘岚、陈在新、张荻寒等人，并聘请德国、日本画家授课，还请吴待秋传授中国画，这些人后来成长为中国早期商业招贴广告设计专家。","path":"institutions/shangwu-yinshuguan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 C 维度下近代商业美术人才培养机构的锚点，其企业办学方式属于 D 维度。Theme/Topic 尚未 materialize。"},{"id":"institutions:shaofujian","title":"少府监（Court of the Imperial Workshops）","name_en":"Court of the Imperial Workshops","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["官营手工业","唐代","宋代","百工","汉代"],"confidence":"medium","consensus":"tentative","sub_type":"government_office","source_count":"7","evidence_status":"source_backed","description":"少府监是唐代中央管理官方手工业的专设机构之一，掌“百工技巧之政”，直接负责宫廷与官府日用工业品的制造。汉代少府则是官营手工业的主管机构，属下设尚方、考工室、若庐、东织西织、东园匠等，分别负责制造皇宫所需器物、用具、兵器、纺织品、服饰与陵内器，并设有作坊。唐代少府监的完整职掌见《新唐书·百官志》，除五署外还总诸冶、铸钱、互市等监。其前身可上溯至三国两晋南北朝时期的少府系统，宋代仍沿设，辖绫锦院、染院","path":"institutions/shaofujian.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"少府监是 D 维度（制度）下官营手工业管理机构的锚点，其工匠数量与技术训练内容同时属于 B 维度的生产组织问题。Theme/Topic 尚未 materialize。"},{"id":"institutions:shenxin-fangzhi-gongsi","title":"申新纺织公司（Shenxin Textile Company）","name_en":"Shenxin Textile Company","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["民国","纺织","荣宗锦","荣宗铨","商标"],"confidence":"medium","consensus":"tentative","sub_type":"commercial_enterprise","source_count":"2","evidence_status":"source_backed","description":"申新纺织公司是荣宗锦、荣宗铨兄弟开办的当时全国最大的民营纺织企业，注册有“人钟”牌、“四平莲”牌、“宝塔”牌、“龙船”牌等近代名牌棉纱商标。","path":"institutions/shenxin-fangzhi-gongsi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 D 维度下近代民族纺织企业的锚点，其商标设计属于 C 维度。Theme/Topic 尚未 materialize。"},{"id":"institutions:wensiyuan","title":"文思院（Wensi Yuan）","name_en":"Wensi Yuan","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["唐代","宋代","官营手工业","金银器","42作"],"confidence":"medium","consensus":"tentative","sub_type":"government_office","source_count":"2","evidence_status":"source_backed","description":"文思院是唐宋两代均设的官营手工业机构，两册分记不同朝代。田自秉记其为宋代工部所属官营手工业机构，掌金银犀玉工巧及采绘装钿之饰，其中金、银、牙、玉、织、绣等有 42 作；同段又称其为宋代少府监所属机构、染织生产部门之一，院下有 40 多种作，包括绣作、克丝作，42 作中有玉作、犀作、牙作、雕木作、琥珀作等。夏燕靖 2016 记其为唐代宫廷金银作坊，并据银熏炉铭文“咸通十年（869）文思院造”说明其对","path":"institutions/wensiyuan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 D 维度下唐宋官营手工业机构的锚点，其金银器与织绣工艺属于 B 维度。Theme/Topic 尚未 materialize。"},{"id":"institutions:xingwenshu","title":"兴文署（Xingwen Shu）","name_en":"Xingwen Shu","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["元代","官府刻书","雕版印刷","集贤院","秘书监"],"confidence":"medium","consensus":"tentative","sub_type":"government_office","source_count":"3","evidence_status":"source_backed","description":"兴文署是元代官方刻书机构，与国子监、文艺监并列，为官府印刷的三大部门之一。三册来源都引同一批文献，但对它的上级归属给出两条互相冲突的记载：《元史·百官志》称其“属集贤院”，《元秘书监志》称其“属秘书监”。本 KU 并存两条引文，不裁定何者为准。","path":"institutions/xingwenshu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"兴文署是 D 维度下元代官方出版管理制度的具体机构，其刊刻活动直接决定 C 维度书籍版面与字体的生产条件。Theme/Topic 尚未 materialize。"},{"id":"institutions:yaping-yishu-zhuangshi-gongsi","title":"亚平艺术装饰公司（Yaping Art Decoration Company）","name_en":"Yaping Art Decoration Company","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["上海","民国","商业美术","广告","装潢"],"confidence":"medium","consensus":"tentative","sub_type":"design_firm","source_count":"2","evidence_status":"source_backed","description":"亚平艺术装饰公司是上海商业美术兴起时期出现的艺术设计企业，业务涵盖中西美术广告、商标盒样招贴图案、彩色封面及黑白画、活动或固定橱窗陈列、制绣及染织物图案、油漆路牌广告、舞台或会场布置、门面或室内装饰、撰编美术书籍、编辑宣传文稿、小工艺及玩具制作、家具设计、代制铜铅锌版等。同段还列有中国商务广告公司、活动广告影片公司、生生美术公司。","path":"institutions/yaping-yishu-zhuangshi-gongsi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 D 维度下近代商业美术企业的锚点，其业务内容同时覆盖 C 维度的广告与装潢。Theme/Topic 尚未 materialize。"},{"id":"institutions:yunjin-yanjiu-gongzuozu","title":"云锦研究工作组（Yunjin Research Working Group）","name_en":"Yunjin Research Working Group","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["1954","南京","云锦","陈之佛","双面锦"],"confidence":"medium","consensus":"tentative","sub_type":"research_institute","source_count":"2","evidence_status":"source_backed","description":"云锦研究工作组于 1954 年 6 月由南京市人民政府文化处组织云锦老艺人张福永、吉干臣和美术工作者成立，由陈之佛教授任组长，是新中国建立初期最早的工艺美术研究机构。工作组搜集整理云锦纹样画稿、培训艺徒，并恢复失传品种“双面锦”“凹凸锦”。","path":"institutions/yunjin-yanjiu-gongzuozu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下云锦工艺研究机构的锚点，其建制方式同时属于 D 维度。Theme/Topic 尚未 materialize。"},{"id":"institutions:yuqichang","title":"御器厂（Imperial Porcelain Factory）","name_en":"Imperial Porcelain Factory","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["明代","清代","景德镇","官窑","青花瓷"],"confidence":"medium","consensus":"tentative","sub_type":"government_office","source_count":"5","evidence_status":"source_backed","description":"御器厂是明初设在景德镇珠山的官窑。五册来源都提到它，但承担的功能各不相同：高丰与田自秉把它当成明代官窑的起点，赵农把它当成“不惜工本”的贡品生产组织，夏燕靖两版与田自秉另一处则把它当成唐代越窑“由官府督造”制度的后世归宿。三处年代与性质记载需要分开看：设置年代两册同作“洪武三十五年”，地点仅田自秉给出“珠山”，产品分工仅田自秉给出“钦限／部限”两分。","path":"institutions/yuqichang.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"御器厂是 D 维度下官窑制度的实体机构，其原料、工匠与官搭民烧的调拨方式直接塑造 B 维度明清瓷器的工艺路线。Theme/Topic 尚未 materialize。"},{"id":"institutions:zhiranshu","title":"织染署（Weaving and Dyeing Bureau）","name_en":"Weaving and Dyeing Bureau","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["隋代","唐代","少府监","官营纺织","印染"],"confidence":"medium","consensus":"tentative","sub_type":"government_office","source_count":"5","evidence_status":"source_backed","description":"织染署是隋唐时期设于少府监下的官营纺织与染练管理机构。田自秉给出它的来源：隋炀帝时少府监下有司染署与司织署，两署合并为织染署。其余四册只在唐代语境中提到它，各自强调一面：高丰把它列为少府监五署之一并注明“负责织造”，赵农引《新唐书·百官志》记其职掌并称其下分 25 个“作”，夏燕靖两版只引《唐六典》的“练染之作有六”。分工细目以田自秉所引《唐六典》最全，四类作数相加正好 25，与赵农的“25 个作","path":"institutions/zhiranshu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"织染署是 D 维度下唐代官营手工业分工体系的机构样本，其二十五作的划分直接对应 B 维度织造与练染的工序分化。Theme/Topic 尚未 materialize。"},{"id":"institutions:zhongguo-gongyi-meishu-xuehui","title":"中国工艺美术学会（China Society of Arts and Crafts）","name_en":"China Society of Arts and Crafts","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["1979","北京","工艺美术","民间工艺","学术团体"],"confidence":"medium","consensus":"tentative","sub_type":"professional_society","source_count":"2","evidence_status":"source_backed","description":"中国工艺美术学会于 1979 年 8 月 11 日在北京恢复。2009 记其民间工艺美术委员会主办的《民间工艺》杂志于 1985 年 10 月创刊；2016 另记 1980 年派观察员小组出席维也纳第九届世界手工艺大会、1982 年在西安举行传统工艺美术学术讨论会、1988 年与轻工业部工艺美术总公司主办“首届中国陶艺壁饰展”。","path":"institutions/zhongguo-gongyi-meishu-xuehui.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 D 维度下当代工艺美术行业组织的锚点。Theme/Topic 尚未 materialize。"},{"id":"institutions:zhongguo-gongyi-meishuguan","title":"中国工艺美术馆（China National Arts and Crafts Museum）","name_en":"China National Arts and Crafts Museum","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["1989","北京","工艺美术","展览","博物馆"],"confidence":"medium","consensus":"tentative","sub_type":"museum","source_count":"2","evidence_status":"source_backed","description":"中国工艺美术馆于 1989 年 11 月落成。同月 26 日至 12 月 6 日，“全国工艺美术展览会”在新落成的该馆举行，展出作品 5000 余件（套）。两版记载一致，2016 仅补出“11 月”。","path":"institutions/zhongguo-gongyi-meishuguan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 D 维度下当代工艺美术展示机构的锚点。Theme/Topic 尚未 materialize。"},{"id":"institutions:zhongguo-meishuguan","title":"中国美术馆（National Art Museum of China）","name_en":"National Art Museum of China","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["1962","北京","美术展览","工艺美术","全国美术作品展览会"],"confidence":"medium","consensus":"tentative","sub_type":"museum","source_count":"2","evidence_status":"source_backed","description":"中国美术馆于 1962 年 5 月初建成，开始展出我国近现代美术作品，包括绘画、雕塑、版画、工艺美术、民间艺术品等。同年 5 月 23 日，文化部和全国美协举办的“全国美术作品展览会”在该馆开幕，展出包括工艺美术设计图稿在内的作品 355 件。2016 另记此后年表中大量工艺美术与设计展览均在此举办。","path":"institutions/zhongguo-meishuguan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 D 维度下国家级美术展示机构的锚点。Theme/Topic 尚未 materialize。"},{"id":"institutions:zhongtian-dianjichang","title":"中天电机厂（Zhongtian Electric Motor Factory）","name_en":"Zhongtian Electric Motor Factory","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["1932","天津","电话机","民族工业","西门子"],"confidence":"medium","consensus":"tentative","sub_type":"commercial_enterprise","source_count":"2","evidence_status":"source_backed","description":"中天电机厂于 1932 年初由实业家周仁斋与王汰甄在天津创办，厂名寓意制造电机设备与西门子产品抗衡。当年 7 月制成两部军用携带机，年底生产我国第一部手摇磁石电话机；后测绘仿制西门子拨号盘，陆续生产 1000 部自动电话机，成为中国电话机工业的领头羊。2016 记其造出我国最早完全自行设计生产的通话机。","path":"institutions/zhongtian-dianjichang.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 D 维度下近代民族机电企业的锚点，其产品设计过程同时属于 B 维度的技术学习问题。Theme/Topic 尚未 materialize。"},{"id":"institutions:zhongyang-gongyi-meishu-kexue-yanjiu-suo","title":"中央工艺美术科学研究所（Central Research Institute of Arts and Crafts Science）","name_en":"Central Research Institute of Arts and Crafts Science","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["1956","北京","工艺美术","工艺美术通讯","研究机构"],"confidence":"medium","consensus":"tentative","sub_type":"research_institute","source_count":"2","evidence_status":"source_backed","description":"中央工艺美术科学研究所于 1956 年 11 月成立，与中央工艺美术学院同月，出版《工艺美术通讯》。","path":"institutions/zhongyang-gongyi-meishu-kexue-yanjiu-suo.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 D 维度下 1950 年代工艺美术研究机构的锚点。Theme/Topic 尚未 materialize。"},{"id":"institutions:zhongyang-meishu-xueyuan","title":"中央美术学院（Central Academy of Fine Arts）","name_en":"Central Academy of Fine Arts","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["1950","北京","实用美术系","陶瓷","染织"],"confidence":"medium","consensus":"tentative","sub_type":"design_school","source_count":"2","evidence_status":"source_backed","description":"中央美术学院于 1950 年 4 月 1 日成立，设实用美术系，分为陶瓷、染织和印刷三科。","path":"institutions/zhongyang-meishu-xueyuan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 D 维度下新中国设计教育机构的锚点。Theme/Topic 尚未 materialize。"},{"id":"institutions:zhujingju","title":"铸镜局（Mirror Casting Bureau）","name_en":"Mirror Casting Bureau","type":"institution","type_zh":"机构","color":"#8B5CF6","tags":["宋代","南宋","湖州","饶州","铜镜"],"confidence":"medium","consensus":"tentative","sub_type":"government_office","source_count":"2","evidence_status":"source_backed","description":"铸镜局是宋代官办铜镜铸造机构。田自秉记南宋湖州、饶州所设铸镜机构，两地所产铜镜多有柄、素地无纹，镜背一旁有长方形阴刻款式注明铸镜地及名号；因宋时缺铜禁铜、官方严格管理生产，有刻款的才可携带。夏燕靖 2016 记宋代铜镜分官办“铸镜局”所造与民间作坊制作两类，官工镜制作较精巧，民间多素背薄镜。","path":"institutions/zhujingju.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 D 维度下宋代官营铜镜机构的锚点，其镜式与刻款属于 B、C 维度。Theme/Topic 尚未 materialize。"},{"id":"persons:anige","title":"阿尼哥（Anige）","name_en":"Anige","type":"person","type_zh":"人物","color":"#3B82F6","tags":["元代","尼泊尔","妙应寺白塔","喇嘛塔","司天台"],"confidence":"medium","consensus":"tentative","sub_type":"architect","source_count":"2","evidence_status":"source_backed","description":"阿尼哥是元代入仕元朝廷的尼泊尔工匠、建筑师。赵农记其设计北京妙应寺白塔（至元八年，1271），塔高 53 米，呈宝瓶塔身，是元大都建筑的喇嘛塔样式，并与郭守敬合作设计元大都司天台；夏燕靖 2016 记其为元世祖建万安寺（妙应寺）时设计大圣寿万安寺塔，即今妙应寺白塔，为覆钵式喇嘛塔。","path":"persons/anige.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"阿尼哥是 B 维度下元代藏传佛教建筑与跨文化工匠的代表。Theme/Topic 尚未 materialize。"},{"id":"persons:bi-sheng","title":"毕昇（Bi Sheng）","name_en":"Bi Sheng","type":"person","type_zh":"人物","color":"#3B82F6","tags":["北宋","活字印刷","印刷设计","庆历"],"confidence":"medium","consensus":"tentative","sub_type":"craftsman","source_count":"2","evidence_status":"source_backed","description":"毕昇是北宋活字印刷术的发明者。赵农记其于北宋仁宗年间首创活字印刷，技术已接近铅活字印刷；李立新记其在宋仁宗庆历年间（1041—1048）创造活字印刷术，并将其列为中国印刷设计家集群向上追溯的起点。","path":"persons/bi-sheng.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"毕昇是 C 维度下活字印刷与印刷设计谱系的起点人物。Theme/Topic 尚未 materialize。"},{"id":"persons:chen-mingyuan","title":"陈鸣远（Chen Mingyuan）","name_en":"Chen Mingyuan","type":"person","type_zh":"人物","color":"#3B82F6","tags":["清代","紫砂","宜兴","茶具"],"confidence":"medium","consensus":"tentative","sub_type":"craftsman","source_count":"2","evidence_status":"source_backed","description":"陈鸣远是宜兴紫砂名艺人，号壶隐。田自秉把他系于康熙时期，引《阳羡名陶录》说明其声名与文人延揽；夏燕靖 2016 则把他与供寿、时大彬并列为明代制壶名家。两册的时代定位不一致，本 KU 并存。","path":"persons/chen-mingyuan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"陈鸣远是 B 维度下清代宜兴紫砂名家，其“文人学士争相延揽”的记载体现紫砂与文人趣味的结合。Theme/Topic 尚未 materialize。"},{"id":"persons:chen-zhifo","title":"陈之佛（Chen Zhifo）","name_en":"Chen Zhifo","type":"person","type_zh":"人物","color":"#3B82F6","tags":["近代","图案设计","染织纹样","书籍装帧","设计教育"],"confidence":"medium","consensus":"tentative","sub_type":"designer","source_count":"6","evidence_status":"source_backed","description":"陈之佛（1896—1962），号雪翁，浙江余姚浒山（今慈溪）人，六册来源一致列为中国近代艺术设计教育与图案设计的开拓者。六册对他的叙述重心并不一致：高丰以设计教育家兼图案艺术家立传并附书籍装帧成就，赵农以书籍设计开拓者定位，夏燕靖 2016 以染织美术设计家定位，李立新把他放进设计事务所与驻厂设计师的产业脉络并记其 1961 年参与《中国工艺美术通史》编写，田自秉只记其云锦出版物。本 KU 合并登","path":"persons/chen-zhifo.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"陈之佛在六册中同时出现在书籍装帧（C）、染织纹样与图案（B）、设计教育（D）三条线上。本批按两册明确以书籍设计为中心的叙述归主维度 C，B/D 记为次要维度。Theme/Topic 尚未 materialize。"},{"id":"persons:confucius","title":"孔子（Confucius）","name_en":"Confucius","type":"person","type_zh":"人物","color":"#3B82F6","tags":["春秋","儒家","文质彬彬","造物观念"],"confidence":"medium","consensus":"tentative","sub_type":"scholar","source_count":"6","evidence_status":"source_backed","description":"孔子（前551—前479），名丘，字仲尼，春秋后期鲁国人，儒家创始人。六册来源均把他作为中国早期造物与审美观念的关键论述者：其“文质彬彬”“绘事后素”“工欲善其事，必先利其器”等言论，被用来解释内容与形式、实用与审美、装饰与礼制之间的关系。","path":"persons/confucius.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"孔子不是工艺生产者，其设计史相关性在造物与器用观念层。暂以 B 为主导航，是因为 A 维度只处理设计史书写与方法，不承载设计思想本身；Theme/Topic 尚未 materialize，故层级只到 Dimension。"},{"id":"persons:dayu","title":"大禹（Yu the Great）","name_en":"Yu the Great","type":"person","type_zh":"人物","color":"#3B82F6","tags":["传说夏代","治水","九鼎","规划"],"confidence":"medium","consensus":"tentative","sub_type":"other","source_count":"2","evidence_status":"source_backed","description":"大禹是介于神话与真实之间的传说人物，夏起源于禹。赵农称“大禹治水”是中国先民改造自然本质力量的传说，并评价“大禹是中华民族最早的规划设计师”；夏燕靖 2016 另记传说大禹收九牧之金铸九鼎于荆山，象征九州。","path":"persons/dayu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"大禹是 D 维度下传说时代治水、规划与九鼎制度的源头人物。Theme/Topic 尚未 materialize。"},{"id":"persons:ding-huan","title":"丁缓（Ding Huan）","name_en":"Ding Huan","type":"person","type_zh":"人物","color":"#3B82F6","tags":["西汉","长安","铜灯","香炉","被中香炉"],"confidence":"medium","consensus":"tentative","sub_type":"craftsman","source_count":"3","evidence_status":"source_backed","description":"丁缓是西汉长安的巧工，三册来源都通过《西京杂记》征引他的四件制作。他在来源中的位置差别很大：高丰把他立为“青铜产品设计家”，是回答“中国古代有没有设计师”的关键例证；赵农把他放在秦汉香炉技术的谱系里，判断其贡献是恢复与延续而非首创；田自秉只把他作为汉代铜灯、铜炉制作精巧的旁证，不作主体叙述。**本 KU 记录的分歧有两处**：一是“七龙五凤”与“九龙五凤”、“常满灯”与“恒满灯”的字句差异；二是赵","path":"persons/ding-huan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"丁缓是 B 维度下汉代铜灯与熏炉的工艺样本，也是高丰“中国古代有没有设计师”这一 A 维度命题的主要例证。三册对他的身份定位不同：设计家、恢复者、巧工。Theme/Topic 均未 materialize。"},{"id":"persons:ding-pei","title":"丁佩（Ding Pei）","name_en":"Ding Pei","type":"person","type_zh":"人物","color":"#3B82F6","tags":["清代","刺绣","绣谱","苏绣"],"confidence":"medium","consensus":"tentative","sub_type":"craftsman","source_count":"2","evidence_status":"source_backed","description":"丁佩是清代道光年间的刺绣艺人、《绣谱》作者。两册来源都以《绣谱》为她的核心贡献：田自秉记其分章与“能、巧、妙、神”的美学原则，夏燕靖 2016 另记成书年代（道光元年，1821）、以绘画书法诗词建筑作比较的方法，以及“齐、光、直、匀、薄、顺、密”的苏绣特点。","path":"persons/ding-pei.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"丁佩是 B 维度下清代刺绣工艺理论化的代表人物，其《绣谱》把刺绣经验整理为可传授的章法与品评标准。Theme/Topic 尚未 materialize。"},{"id":"persons:dou-shilun","title":"窦师纶（Dou Shilun）","name_en":"Dou Shilun","type":"person","type_zh":"人物","color":"#3B82F6","tags":["初唐","丝绸","陵阳公样","益州","图案设计"],"confidence":"medium","consensus":"tentative","sub_type":"designer","source_count":"4","evidence_status":"source_backed","description":"窦师纶（一作窦师伦）是初唐丝绸图案设计家，封陵阳公，曾任益州大行台检校修造。四册来源都以“陵阳公样”为核心：高丰据张彦远《历代名画记》卷十给出最完整的生平与纹样分析，夏燕靖 2009 记其纹样特征与团窠联珠形式，田自秉、李立新另记对称纹的题材与“个体设计上升为全国样式”的评价。","path":"persons/dou-shilun.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"窦师纶是 B 维度下初唐丝绸图案设计的代表性人物，“陵阳公样”把个体设计提升为全国性样式。Theme/Topic 尚未 materialize。"},{"id":"persons:du-jinsheng","title":"都锦生（Du Jinsheng）","name_en":"Du Jinsheng","type":"person","type_zh":"人物","color":"#3B82F6","tags":["民国","杭州","丝织","织锦","费城博览会"],"confidence":"medium","consensus":"tentative","sub_type":"industrialist","source_count":"2","evidence_status":"source_backed","description":"都锦生（1897—1943）是杭州丝织工艺家、企业家。1921 年试织成功丝织西湖名景“九溪十八涧”，成为我国丝织风景的创始产品；次年创办丝织厂批量生产；1926 年其丝织风景参加美国费城国际博览会，获金质奖。","path":"persons/du-jinsheng.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"都锦生是 B 维度下民国丝织风景工艺与工商化生产的代表。Theme/Topic 尚未 materialize。"},{"id":"persons:feng-zikai","title":"丰子恺（Feng Zikai）","name_en":"Feng Zikai","type":"person","type_zh":"人物","color":"#3B82F6","tags":["民国","书籍装帧","插图","漫画"],"confidence":"medium","consensus":"tentative","sub_type":"designer","source_count":"2","evidence_status":"source_backed","description":"丰子恺是民国时期书籍插图与书装设计家，以漫画笔法入书籍插图，形成活泼天真的童趣。赵农把他列为民国书籍插图有代表性的设计者；夏燕靖 2016 另记其采用漫画笔法与富有装饰性的构图，形成独特的书装特色。","path":"persons/feng-zikai.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"丰子恺是 C 维度下民国书籍插图与书装设计的代表，连接漫画笔法与书籍装帧。Theme/Topic 尚未 materialize。"},{"id":"persons:gongchun","title":"供春（Gongchun）","name_en":"Gongchun","type":"person","type_zh":"人物","color":"#3B82F6","tags":["明代","紫砂","宜兴","茶具"],"confidence":"medium","consensus":"tentative","sub_type":"craftsman","source_count":"2","evidence_status":"source_backed","description":"供春是明代正德年间宜兴紫砂制壶名家，原名龚春。田自秉记其出身与学艺经过、作品声价与传世情况，并把他列为时大彬、赵良璧、陈鸣远的师承起点；夏燕靖 2016 只把他与供寿、时大彬、陈鸣远并列为明代制壶名家，且“供春”写作“供寿”。","path":"persons/gongchun.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"供春是 B 维度下明代宜兴紫砂壶工艺的早期名家锚点，其身份由书童而匠师的记载兼有工艺史与文人笔记色彩。Theme/Topic 尚未 materialize。"},{"id":"persons:gu-kai-zhi","title":"顾恺之（Gu Kaizhi）","name_en":"Gu Kaizhi","type":"person","type_zh":"人物","color":"#3B82F6","tags":["东晋","画家","斫琴图","佛教艺术","设计"],"confidence":"medium","consensus":"tentative","sub_type":"artist","source_count":"2","evidence_status":"source_backed","description":"顾恺之是东晋画家，也被设计史来源记为早年擅长设计者。赵农记相传其作有《斫琴图》，可见南方制作乐器工序的严格；李立新把他与谢赫并列为魏晋南北朝擅长设计的艺术家，并列入当时著名佛教绘画和雕刻艺术家。","path":"persons/gu-kai-zhi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"顾恺之是 B 维度下魏晋艺术与设计互动关系的代表。Theme/Topic 尚未 materialize。"},{"id":"persons:guan-zhong","title":"管仲（Guan Zhong）","name_en":"Guan Zhong","type":"person","type_zh":"人物","color":"#3B82F6","tags":["春秋","齐国","设计经济","反雕饰"],"confidence":"medium","consensus":"tentative","sub_type":"statesman","source_count":"4","evidence_status":"source_backed","description":"管仲是春秋齐国政治家、军事家。四册来源把他放在两个不同的论述位置：夏燕靖两版以《管子·立政》“工事无刻镂，女事无文章”说明其反雕饰立场；李立新与夏燕靖 2016 则以《管子·侈靡》说明其赞赏侈靡消费以促进再生产，并称之为最早的设计经济学论述。两条主张方向相反，本 KU 并存，不调和。","path":"persons/guan-zhong.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"A","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"管仲在来源中同时承载“废弃雕饰”与“侈靡消费”两条相反的经济—造物主张，是 A 维度设计观念讨论中的矛盾案例。Theme/Topic 尚未 materialize。"},{"id":"persons:guo-shoujing","title":"郭守敬（Guo Shoujing）","name_en":"Guo Shoujing","type":"person","type_zh":"人物","color":"#3B82F6","tags":["元代","天文仪器","简仪","授时历"],"confidence":"medium","consensus":"tentative","sub_type":"scientist","source_count":"4","evidence_status":"source_backed","description":"郭守敬是元代天文学家、水利专家与仪器设计者，字若思，顺德邢台（今河北邢台）人，1231—1316。四册来源都以简仪和《授时历》为他最重要的成就，并强调他对浑仪坐标系统的简化。","path":"persons/guo-shoujing.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"郭守敬是 B 维度下元代天文仪器设计与水利工程的知识元，其简仪的坐标分解是仪器结构简化的典型案例。Theme/Topic 尚未 materialize。"},{"id":"persons:han-fei-zi","title":"韩非子（Han Feizi）","name_en":"Han Feizi","type":"person","type_zh":"人物","color":"#3B82F6","tags":["战国","法家","造物思想","以文害用","重本抑末"],"confidence":"medium","consensus":"tentative","sub_type":"philosopher","source_count":"6","evidence_status":"source_backed","description":"韩非子是六册全有记载的战国思想家，但在各册中扮演两种不同角色。第一种是他本人的造物观：六册一致以“以文害用”“好质而恶饰”概括，并把他与墨子并置为“先实用后审美”一派。第二种是《韩非子》作为史料：五册分别从《十过》《五蠹》《外储说左上》《说林上》《安危》《外储说右上》《显学》中取证，用来讨论漆器起源、原始衣着、木鸢、豆荚、鲁人织屦、帛书、酒旗幌子与商品交易。两种角色的评价方向相反——作为思想家他被","path":"persons/han-fei-zi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"A","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"韩非子在六册中有双重身份：一是造物思想的提出者（A），二是被各册当作先秦造物史料的转引来源（A 之证据方法）。“以文害用”“好质而恶饰”涉及具体的质文关系与器物评价（B）；“重本抑末”涉及农商制度对造物的抑制（D）。本批按六册的共同用法归主维度 A。Theme/Topic 尚未 materialize。"},{"id":"persons:hang-zhiying","title":"杭穉英（Hang Zhiying）","name_en":"Hang Zhiying","type":"person","type_zh":"人物","color":"#3B82F6","tags":["民国","上海","月份牌","广告设计","穉英画室"],"confidence":"medium","consensus":"tentative","sub_type":"designer","source_count":"3","evidence_status":"source_backed","description":"杭穉英是近代上海月份牌广告设计家，与周慕桥、郑曼陀并称三大盟主。他早年在商务印书馆广告部从事设计，后创办“穉英画室”，与金雪尘、李慕白等合作，以旗袍美女为典型形象，20 世纪 30 年代领导上海工商广告设计潮流。","path":"persons/hang-zhiying.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"杭穉英是 C 维度下民国上海月份牌广告设计的核心人物。Theme/Topic 尚未 materialize。"},{"id":"persons:huang-dacheng","title":"黄大成（Huang Dacheng）","name_en":"Huang Dacheng","type":"person","type_zh":"人物","color":"#3B82F6","tags":["明代","髹漆","髹饰录","新安","漆艺"],"confidence":"medium","consensus":"tentative","sub_type":"craftsman","source_count":"2","evidence_status":"source_backed","description":"黄大成是明代新安漆工、《髹饰录》作者。高丰记其字号、籍贯、隆庆年间的漆工身份、剔红技艺与杨明天启五年加注作序的成书经过；田自秉另记《髹饰录》的乾坤两集、十八章结构与“三法”原则，并称其为我国现存唯一的古代漆艺专著。","path":"persons/huang-dacheng.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"黄大成是 B 维度下明代漆艺由实践走向系统文本的关键人物，其《髹饰录》是现存唯一的古代漆艺专著。Theme/Topic 尚未 materialize。"},{"id":"persons:huang-daopo","title":"黄道婆（Huang Daopo）","name_en":"Huang Daopo","type":"person","type_zh":"人物","color":"#3B82F6","tags":["宋末元初","棉纺织","松江","技术革新"],"confidence":"medium","consensus":"tentative","sub_type":"craftsman","source_count":"6","evidence_status":"source_backed","description":"黄道婆是宋末元初松江乌泥泾（今上海华泾镇）人，中国棉纺织史上的关键技术人物。她少年流落崖州（今海南），向黎族学习种棉与纺织技术，晚年返乡传授并改良捍、弹、纺、织工具，推动松江成为全国棉纺织业中心。","path":"persons/huang-daopo.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"黄道婆是 B 维度下棉纺织技术与织造设计的代表人物；Theme/Topic 尚未 materialize，故 primary_theme 与 topic_memberships 留空，属研究债务。"},{"id":"persons:ji-cheng","title":"计成（Ji Cheng）","name_en":"Ji Cheng","type":"person","type_zh":"人物","color":"#3B82F6","tags":["明代","园冶","造园","室内装修","掇山"],"confidence":"medium","consensus":"tentative","sub_type":"designer","source_count":"5","evidence_status":"source_backed","description":"计成（字无否，吴江人，1582—？）是五册共同记载的明代造园设计家与理论家，因《园冶》一书立目。五册对他的取材呈三层：高丰给出唯一一段成体系的设计思想分析（含“三分匠，七分主人”的专门解释），赵农给出《园冶》的卷次结构、名句与日本流传，夏燕靖两版只作书目提要，田自秉仅在家具发展原因中以一句带过。李立新一册不提其人其书。来源分歧不在事实而在判断：《园冶》的地位被从“我国古代造园专著”一路抬到“世界上","path":"persons/ji-cheng.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"A","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"计成在五册中首先是造园理论的作者（A），《园冶》的屋宇、装折、掇山、选石诸篇同时是具体的造物与构造技术（B）。本批按五册共同的“理论家＋造园设计家”定位归主维度 A，与同节的文震亨、李渔保持同一处理。Theme/Topic 尚未 materialize。"},{"id":"persons:jianzhen","title":"鉴真（Jianzhen）","name_en":"Jianzhen","type":"person","type_zh":"人物","color":"#3B82F6","tags":["唐代","扬州","东渡日本","工匠传播","佛教"],"confidence":"medium","consensus":"tentative","sub_type":"other","source_count":"2","evidence_status":"source_backed","description":"鉴真是唐代高僧，扬州佛教文化中心的重要人物。赵农记其驻锡扬州多年、743 年首次准备东渡日本，前后六次终于抵达；夏燕靖 2016 据《唐大和尚东征传》记其天宝二年（743）第一次东渡时同行有玉作人、雕檀、刻镂等工手 85 人，作为唐代工匠名分与技艺外传的例证。","path":"persons/jianzhen.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"E","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"鉴真是 E 维度下唐代工艺技术跨海传播的枢纽人物。Theme/Topic 尚未 materialize。"},{"id":"persons:laozi","title":"老子（Laozi）","name_en":"Laozi","type":"person","type_zh":"人物","color":"#3B82F6","tags":["春秋","道家","有无观","造物思想"],"confidence":"medium","consensus":"tentative","sub_type":"philosopher","source_count":"4","evidence_status":"source_backed","description":"老子是春秋时期道家创始人，《道德经》的作者。四册来源都把他作为“有无相生”空间观与“大巧若拙”朴素造物观的源头，夏燕靖两版更直接称其“虚无观”就是设计上的空间观念。","path":"persons/laozi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"A","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"老子在来源中是“有无相生”空间观与“大巧若拙”造物观的思想锚点，属 A 维度的设计观念讨论。Theme/Topic 尚未 materialize。"},{"id":"persons:lei-fada","title":"雷发达（Lei Fada）","name_en":"Lei Fada","type":"person","type_zh":"人物","color":"#3B82F6","tags":["清初","样式雷","样式房","紫禁城","圆明园"],"confidence":"medium","consensus":"tentative","sub_type":"architect","source_count":"2","evidence_status":"source_backed","description":"雷发达是清初工匠，被誉为“样式雷”。夏燕靖两版都记其应募赴北京修建紫禁城，从工匠升至工部样式负责人，康熙授予工部营造所长班，参与三大殿尤其是太和殿的修建，后调任圆明园楠木样式房掌案、担任工程总设计师，晚年著有《工部工程作法则例》《工程营造录》。","path":"persons/lei-fada.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"雷发达是 B 维度下清代样式房制度与皇家建筑设计谱系的代表。Theme/Topic 尚未 materialize。"},{"id":"persons:lei-guiyuan","title":"雷圭元（Lei Guiyuan）","name_en":"Lei Guiyuan","type":"person","type_zh":"人物","color":"#3B82F6","tags":["20世纪","工艺美术教育","中央工艺美术学院","图案"],"confidence":"medium","consensus":"tentative","sub_type":"designer","source_count":"5","evidence_status":"source_backed","description":"雷圭元是 20 世纪工艺美术教育家、中央工艺美术学院副院长。高丰把他列为中国近代艺术设计教育的重要开拓者之一；夏燕靖 2016 记其为近现代设计教育奠基人之一、中央工艺美术学院副院长，并记 1992 年召开“雷圭元先生学术研讨会”纪念其逝世 3 周年。","path":"persons/lei-guiyuan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"雷圭元是 D 维度下新中国工艺美术教育制度与中央工艺美术学院建院谱系的代表。Theme/Topic 尚未 materialize。"},{"id":"persons:li-cheng","title":"李诚（Li Cheng）","name_en":"Li Cheng","type":"person","type_zh":"人物","color":"#3B82F6","tags":["北宋","营造法式","建筑","模数制"],"confidence":"medium","consensus":"tentative","sub_type":"architect","source_count":"2","evidence_status":"source_backed","description":"李诚（通行作李诫）是北宋建筑师，《营造法式》的编撰者。赵农记其书由宋哲宗时编著、宋徽宗时刊行，是官方建筑工程的专用书；夏燕靖 2016 记其收集汴京实际工程做法、与工匠详细研究后编成，并详列全书四部分。","path":"persons/li-cheng.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"李诚是 B 维度下宋代官方建筑规范与模数制度的代表。Theme/Topic 尚未 materialize。"},{"id":"persons:li-chun","title":"李春（Li Chun）","name_en":"Li Chun","type":"person","type_zh":"人物","color":"#3B82F6","tags":["隋代","桥梁","石拱桥","赵州桥","敞肩拱"],"confidence":"medium","consensus":"tentative","sub_type":"craftsman","source_count":"3","evidence_status":"source_backed","description":"李春是六册中只见于隋代桥梁一条线的工匠，三册（夏燕靖 2009、赵农、夏燕靖 2016）提到他，高丰、田自秉、李立新三册完全不提，连赵州桥也不提。三册对其人的记载全部回溯到同一句唐代铭文，此外不载生卒、籍贯、师承与其他作品。本 KU 因此分为两层：一层是李春本人的可考信息（极薄），一层是赵州桥的技术叙述（三册均详，但取舍与数据不同）。来源分歧集中在建桥年代（595—605 年区间／605 年）、规","path":"persons/li-chun.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"李春是 B 维度下隋代桥梁营造的条目；同时是 A 维度下“单条唐代铭文能否支撑一个人物条目”的证据样本——三册所记其人的全部信息都来自同一句唐铭。Theme/Topic 均未 materialize。"},{"id":"persons:li-hongzhang","title":"李鸿章（Li Hongzhang）","name_en":"Li Hongzhang","type":"person","type_zh":"人物","color":"#3B82F6","tags":["清末","洋务运动","江南制造总局","轮船招商局","北洋海军"],"confidence":"medium","consensus":"tentative","sub_type":"statesman","source_count":"2","evidence_status":"source_backed","description":"李鸿章（1823—1901）是清末洋务派主将与官员。赵农记其 1891 年创建纶章造纸局，是中国近代第一家引进国外造纸技术的工场；夏燕靖 2016 记其 1862 年办上海洋炮局、1865 年办江南制造总局、1872 年办轮船招商局、1875—1888 年筹建北洋海军。","path":"persons/li-hongzhang.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"李鸿章是 D 维度下洋务运动与近代工业、航运、海军制度建立的核心人物。Theme/Topic 尚未 materialize。"},{"id":"persons:li-madou","title":"利玛窦（Matteo Ricci）","name_en":"Matteo Ricci","type":"person","type_zh":"人物","color":"#3B82F6","tags":["明代","传教士","自鸣钟","西学东渐","跨文化"],"confidence":"medium","consensus":"tentative","sub_type":"scholar","source_count":"2","evidence_status":"source_backed","description":"利玛窦是明末来华的天主教传教士。赵农记其与同侪带来望远镜、自鸣钟、世界地图等，传入科学知识；李立新记其 1601 年向万历皇帝进献自鸣钟等欧洲新式物品，作为早期传教士携带西方奇器来华的例证。","path":"persons/li-madou.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"E","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"利玛窦是 E 维度下明清中西器物与技术交流的早期节点。Theme/Topic 尚未 materialize。"},{"id":"persons:li-youxing","title":"李有行（Li Youxing）","name_en":"Li Youxing","type":"person","type_zh":"人物","color":"#3B82F6","tags":["近代","染织图案","限色","设计教育"],"confidence":"medium","consensus":"tentative","sub_type":"designer","source_count":"2","evidence_status":"source_backed","description":"李有行（1905—1982）是近代染织图案设计师与艺术设计教育家。早年毕业于国立北平艺专，后赴法国里昂美专留学；回国后任上海美亚丝绸厂图案设计室主任八年，其“限色”写生与变化方法为国内设计界首创。","path":"persons/li-youxing.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"李有行是 C 维度下近代染织图案设计与“限色”教学法的代表。Theme/Topic 尚未 materialize。"},{"id":"persons:li-yu","title":"李渔（Li Yu）","name_en":"Li Yu","type":"person","type_zh":"人物","color":"#3B82F6","tags":["清初","闲情偶寄","室内设计","家具设计","造园"],"confidence":"medium","consensus":"tentative","sub_type":"scholar","source_count":"4","evidence_status":"source_backed","description":"李渔（1610—1680，字笠鸿、谪凡，号笠翁，浙江兰溪人）是四册共同记载的清初文人设计师与设计理论家，核心文本为 1671 年成书的《闲情偶寄》。四册对他的用法分三层：高丰给出唯一一段系统的设计思想分析（含暖椅、凉机的设计个案），赵农把他列入“一流的设计家”名单并从“机”“趣”读其器物观，夏燕靖两版只在工艺著作与版本提要中著录《闲情偶寄》。田自秉、李立新两册完全不提其人其书。来源分歧集中在三处：","path":"persons/li-yu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"A","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"李渔在四册中首先是“文人设计师”与设计理论家（A），其《闲情偶寄》的居室、器玩两部又是家具与室内器物的具体设计论述（B）；高丰另把他列为影响明式、清式家具形成的设计者之一，涉及造物谱系（D 之设计者身份）。本批按四册共同的“理论家＋实践者”定位归主维度 A。Theme/Topic 尚未 materialize。"},{"id":"persons:liang-sicheng","title":"梁思成（Liang Sicheng）","name_en":"Liang Sicheng","type":"person","type_zh":"人物","color":"#3B82F6","tags":["20世纪","建筑学","清华学派","国徽","中国建筑史"],"confidence":"medium","consensus":"tentative","sub_type":"architect","source_count":"3","evidence_status":"source_backed","description":"梁思成是 20 世纪中国建筑学家、清华大学营建系主任、国徽设计组组长。赵农记其以“清华学派”重视古代建筑整理研究、强调现代建筑中的民族特色；夏燕靖 2016 记其主持清华国徽设计组，并于 1961 年发表《建筑和建筑艺术》，主张装饰应从建筑物功能和结构两方面考虑。","path":"persons/liang-sicheng.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"梁思成是 B 维度下近代至新中国建筑思想、建筑史研究与国徽设计的代表。Theme/Topic 尚未 materialize。"},{"id":"persons:liu-zhou","title":"刘昼（Liu Zhou）","name_en":"Liu Zhou","type":"person","type_zh":"人物","color":"#3B82F6","tags":["北朝","北齐","刘子","施用有宜","设计思想"],"confidence":"medium","consensus":"tentative","sub_type":"philosopher","source_count":"2","evidence_status":"source_backed","description":"刘昼是北朝／北齐文学家与设计思想论述者，所著《刘子》（又名《刘子新论》）直接讨论产品实用与审美的关系。他认为美丑相对，衡量标准在“施用有宜”，并以裘与蓑的比较说明适用高于材质贵贱与外表华美。","path":"persons/liu-zhou.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"A","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"刘昼是 A 维度下魏晋南北朝设计思想“施用有宜”命题的锚点。Theme/Topic 尚未 materialize。"},{"id":"persons:lu-xun","title":"鲁迅（Lu Xun）","name_en":"Lu Xun","type":"person","type_zh":"人物","color":"#3B82F6","tags":["近代","书籍装帧","版式设计","新文化运动"],"confidence":"medium","consensus":"tentative","sub_type":"designer","source_count":"4","evidence_status":"source_backed","description":"鲁迅是中国近代书籍装帧的开拓者与实践者。四册来源都不把他当作一般文学家处理，而是聚焦他在封面、题字、插图与版式上的具体设计工作，以及他对陶元庆、孙福熙等装帧设计家的提携。","path":"persons/lu-xun.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"鲁迅是 C 维度下近代书籍装帧与版式变革的实践锚点，其“中西融合”主张也涉及 E 维度的跨文化互动。Theme/Topic 尚未 materialize。"},{"id":"persons:lu-yanzhi","title":"吕彦直（Lu Yanzhi）","name_en":"Lu Yanzhi","type":"person","type_zh":"人物","color":"#3B82F6","tags":["民国","中山陵","中山纪念堂","建筑师","中国固有式"],"confidence":"medium","consensus":"tentative","sub_type":"architect","source_count":"2","evidence_status":"source_backed","description":"吕彦直是民国建筑师，1927 年中山陵建筑设计竞图首奖获得者，1929 年主持设计南京紫金山中山陵，同年完成广州中山纪念堂设计。中山陵以中国传统建筑风格为主线，吸收现代建筑手法，平面作钟形，被评“木铎警世”。","path":"persons/lu-yanzhi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"吕彦直是 B 维度下近代“中国固有式”建筑的代表，连接传统陵墓形制与现代建筑技术。Theme/Topic 尚未 materialize。"},{"id":"persons:ma-jun","title":"马钧（Ma Jun）","name_en":"Ma Jun","type":"person","type_zh":"人物","color":"#3B82F6","tags":["三国","机械设计","提花绫机","翻车"],"confidence":"medium","consensus":"tentative","sub_type":"craftsman","source_count":"4","evidence_status":"source_backed","description":"马钧是三国魏机械设计家，字德衡，扶风（今陕西兴平）人，有“巧思绝世”之誉。四册来源都以提花绫机的简化改造和“翻车”为他的核心成就，兼及指南车、连弩与发石车的改进。","path":"persons/ma-jun.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"马钧是 B 维度下三国机械改良与织机结构简化的匠人锚点。Theme/Topic 尚未 materialize。"},{"id":"persons:mao-jin","title":"毛晋（Mao Jin）","name_en":"Mao Jin","type":"person","type_zh":"人物","color":"#3B82F6","tags":["明代","汲古阁","刻书","毛边纸","毛抄"],"confidence":"medium","consensus":"tentative","sub_type":"other","source_count":"4","evidence_status":"source_backed","description":"毛晋是四册中唯一以私人刻书业立目的明代人物，经营常熟汲古阁。四册各记一面：夏燕靖两版记其雇工规模、刻书种数、书板数量与外销纸张，并把它作为“文人刻书商业化”的实例；赵农单独立目，补出校刻书目、影抄宋本（毛抄）与刻版块数；李立新只在刻书机构名单中一笔带过，但给出了“出版家／刻工”的分辨框架。四册都不记生卒年，年代只有“明代后期”与“崇祯年间”两种定位。分歧集中在刻书持续年数（三十年／四十余年）、书板","path":"persons/mao-jin.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"毛晋在四册中处于印刷与书籍生产（C）的主线上；夏燕靖两版明说“文人刻书也开始商业化”，把汲古阁作为出版经营（D）的样本；李立新则把汲古阁放在“书坊、私宅刻书”的刻工组织（B 之技艺与生产）叙述中。本批按四册共同的对象（刻书）归主维度 C。Theme/Topic 尚未 materialize。"},{"id":"persons:mengzi","title":"孟子（Mencius）","name_en":"Mencius","type":"person","type_zh":"人物","color":"#3B82F6","tags":["战国","儒家","民本","与民同乐"],"confidence":"medium","consensus":"tentative","sub_type":"philosopher","source_count":"4","evidence_status":"source_backed","description":"孟子是战国儒家代表人物，名轲，字子舆。四册来源都把他作为“与民同乐”民本思想的设计转译者：由“民为贵，社稷次之，君为轻”推出一切事物（包括设计）应以民为本。夏燕靖两版同时指出，这一主张在封建社会里只是幻想。","path":"persons/mengzi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"A","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"孟子在来源中是“与民同乐”“民为贵”民本观的设计转译者，属 A 维度的设计观念讨论。Theme/Topic 尚未 materialize。"},{"id":"persons:mozi","title":"墨子（Mozi）","name_en":"Mozi","type":"person","type_zh":"人物","color":"#3B82F6","tags":["先秦","墨家","造物思想","功能主义"],"confidence":"medium","consensus":"tentative","sub_type":"philosopher","source_count":"6","evidence_status":"source_backed","description":"墨子名翟，春秋战国之际的工匠、学者与墨家创始人。六册来源都把他作为“先质而后文”“先实用后审美”设计观的代表，同时强调他本人精于机械制作、直接参与设计与手工劳动。夏燕靖 2009 另记“节用、节葬、非乐”三主张与“器完而不饰”“质真而素朴”的评判标准；赵农另记其推崇夏禹、墨家组织原则与《墨子》现存篇数。","path":"persons/mozi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"墨子作为先秦造物思想与工艺实践的代表进入 B 维度；其“利人乎即为”的功利判断也涉及设计评价标准问题。Theme/Topic 尚未 materialize。"},{"id":"persons:nuwa","title":"女娲（Nuwa）","name_en":"Nuwa","type":"person","type_zh":"人物","color":"#3B82F6","tags":["上古传说","中华民族始祖","母系社会","抟土造人","炼石补天"],"confidence":"medium","consensus":"tentative","sub_type":"other","source_count":"1","evidence_status":"source_backed","description":"女娲是中国上古传说中的女性始祖，与伏羲并称中华民族始祖。赵农记其抟土造人、赋予人以生命，并熔炼五彩石补好天上的窟窿；传说包含着对母性的心理崇敬，缘于漫长母系社会形成的文化影响。同书另记传说女娲是竹笛和笙的创造者，引唐人王毂《吹笙引》“娲皇遗音寄玉笙，双成传得何凄清”。山东嘉祥汉画像石有女娲、伏羲蛇尾盘缠的形象，女娲持规为圆。","path":"persons/nuwa.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"女娲是 B 维度下上古造物传说的人物条目：抟土造人、炼石补天与笙的创造都在此汇合。Theme/Topic 尚未 materialize。"},{"id":"persons:pang-xunqin","title":"庞薰琹（Pang Xunqin）","name_en":"Pang Xunqin","type":"person","type_zh":"人物","color":"#3B82F6","tags":["近现代","工艺美术教育","中央工艺美术学院","决澜社","工商美术"],"confidence":"medium","consensus":"tentative","sub_type":"designer","source_count":"6","evidence_status":"source_backed","description":"庞薰琹是六册中除陈之佛外被记述最详的近现代设计人物，六册全部有字面命中。他同时出现在四个位置上：1930 年代上海工商美术的实践者、1940 年代工艺美术教育的课程建设者、1950 年代中央工艺美术学院的筹建者与副院长、以及 1957 年被斗争的政治受难者。**本条最需要注意的是字形问题**：六册对他的姓名共出现 8 种不同字形（栞、琴、栗、琍、某、渠、桀、杲），无一处写作规范字“琹”；本 KU ","path":"persons/pang-xunqin.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"庞薰琹是 D 维度下中国近代设计教育制度化的枢纽人物：从 1930 年代的工商美术事务所与课程，到 1950 年代中央工艺美术学院的筹建，再到 1957 年被定为“反党集团”首脑，制度线索完整。同时以 C 维度（装饰艺术与书籍装帧）与 B 维度（工艺美术研究组织）为副。Theme/Topic 均未 materialize。"},{"id":"persons:pu-yuan","title":"蒲元（Pu Yuan）","name_en":"Pu Yuan","type":"person","type_zh":"人物","color":"#3B82F6","tags":["三国蜀汉","独轮车","木牛流马","鸡公车"],"confidence":"medium","consensus":"tentative","sub_type":"craftsman","source_count":"2","evidence_status":"source_backed","description":"蒲元是三国蜀汉工匠与车辆设计者。夏燕靖两版都记其为解决山道运粮困难发明独轮车，“廉仰双辕，人行六尺，牛行四步，人载一岁粮之也”，即所谓“木牛流马”；2016 同时指出汉魏时期已盛行独轮车，有的地方称“鸡公车”，早于欧洲千余年。","path":"persons/pu-yuan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"蒲元是 B 维度下三国车辆设计与独轮车谱系的代表。Theme/Topic 尚未 materialize。"},{"id":"persons:shang-tang","title":"商汤（Shang Tang）","name_en":"Shang Tang","type":"person","type_zh":"人物","color":"#3B82F6","tags":["商代","王朝建立","青铜","矿产资源"],"confidence":"medium","consensus":"tentative","sub_type":"statesman","source_count":"2","evidence_status":"source_backed","description":"商汤（又称成汤）是商王朝建立者。赵农记约公元前 1711 年商汤在河南封丘一带击溃夏、建立商王朝，并称商朝对铜的充分认识是中国艺术设计史上的盛事；夏燕靖 2016 记约前 1600 年夏桀暴虐、成汤革夏立商。","path":"persons/shang-tang.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"商汤是 D 维度下商王朝建立与青铜资源开发的制度背景人物。Theme/Topic 尚未 materialize。"},{"id":"persons:shen-kuo","title":"沈括（Shen Kuo）","name_en":"Shen Kuo","type":"person","type_zh":"人物","color":"#3B82F6","tags":["北宋","梦溪笔谈","铜镜","科学技术"],"confidence":"medium","consensus":"tentative","sub_type":"scientist","source_count":"2","evidence_status":"source_backed","description":"沈括是北宋科学家、《梦溪笔谈》的作者。赵农称《梦溪笔谈》为百科全书，共 609 条，记载了许多艺术设计史史料；田自秉引其论铸鉴文字，说明铜镜镜面凸凹与照人面大小的关系。","path":"persons/shen-kuo.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"沈括是 B 维度下宋代科学著作记录工艺知识的代表。Theme/Topic 尚未 materialize。"},{"id":"persons:shen-shou","title":"沈寿（Shen Shou）","name_en":"Shen Shou","type":"person","type_zh":"人物","color":"#3B82F6","tags":["清末民初","刺绣","苏绣","雪宦绣谱","刺绣教育"],"confidence":"medium","consensus":"tentative","sub_type":"artist","source_count":"4","evidence_status":"source_backed","description":"沈寿（1874—1921，字雪君，后改号雪宦，江苏吴县人）是四册共同记载的清末民初刺绣家与刺绣教育家，也是六册中唯一有国际获奖记录、有教育机构、有理论著作三类事迹同时齐备的工艺人物。高丰给出唯一一段完整小传并把她与张謇并列为近代织绣两位人物；夏燕靖两版只通过《雪宦绣谱》的版本提要写她，不作生平；田自秉一册在清代刺绣著作的脉络里提她，却不提张謇之名。来源分歧集中在两处：谁记录了《雪宦绣谱》（张謇／“","path":"persons/shen-shou.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"沈寿的主体成就在刺绣工艺与绣稿设计（B）；高丰同时把她作为近代刺绣教育制度的创办者（D）叙述，并以她与张謇并列支撑“近代织绣两位人物”的判断（A 之史学分期）。本批按四册共同的工艺—教育双重身份归主维度 B。Theme/Topic 尚未 materialize。"},{"id":"persons:shen-zifan","title":"沈子蕃（Shen Zifan）","name_en":"Shen Zifan","type":"person","type_zh":"人物","color":"#3B82F6","tags":["南宋","缂丝","织绣"],"confidence":"medium","consensus":"tentative","sub_type":"craftsman","source_count":"2","evidence_status":"source_backed","description":"沈子蕃是南宋缂丝名手。田自秉把他与朱克柔、吴煦并列为南宋云间缂丝名家，称《梅鹊图》精美；李立新另记其《花鸟图》藏故宫博物院，并把他作为缂丝“直接将绘画引入设计”的代表。","path":"persons/shen-zifan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"沈子蕃是 B 维度下南宋缂丝名家，与朱克柔同属缂丝摹缂书画、走向观赏化的代表。Theme/Topic 尚未 materialize。"},{"id":"persons:shi-dabin","title":"时大彬（Shi Dabin）","name_en":"Shi Dabin","type":"person","type_zh":"人物","color":"#3B82F6","tags":["明代","紫砂","宜兴","茶具"],"confidence":"medium","consensus":"tentative","sub_type":"craftsman","source_count":"2","evidence_status":"source_backed","description":"时大彬是明代宜兴紫砂制壶名家，时朋之子、供春弟子。田自秉称他为明代紫砂名手中“成就最高”者，并记其泥料处理与形制风格；夏燕靖 2016 只把他列入明代制壶名家序列，未展开个体事迹。","path":"persons/shi-dabin.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"时大彬是 B 维度下明代宜兴紫砂工艺成熟期的代表匠师，其泥料处理与形制风格可作为紫砂工艺史的具体标本。Theme/Topic 尚未 materialize。"},{"id":"persons:song-yingxing","title":"宋应星（Song Yingxing）","name_en":"Song Yingxing","type":"person","type_zh":"人物","color":"#3B82F6","tags":["明代","天工开物","实学","工艺"],"confidence":"medium","consensus":"tentative","sub_type":"scholar","source_count":"5","evidence_status":"source_backed","description":"宋应星是明末《天工开物》的撰者，江西奉新人。五册来源都强调他科举失意后转向“实学”，通过广泛调查写成总结农业与手工业技术的综合性著作。","path":"persons/song-yingxing.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"宋应星是 B 维度下综合性技术著作作者与实学实践者的锚点；其科举失意转向实学的经历也可支持 A 或 D 维度的知识生产问题。Theme/Topic 尚未 materialize。"},{"id":"persons:su-shi","title":"苏轼（Su Shi）","name_en":"Su Shi","type":"person","type_zh":"人物","color":"#3B82F6","tags":["北宋","文人审美","平淡","造物评价"],"confidence":"medium","consensus":"tentative","sub_type":"scholar","source_count":"3","evidence_status":"source_backed","description":"苏轼是北宋文学家、文人，其造物评价与审美主张被设计史来源引作宋代设计观念转折的证据。赵农称其为中国文化史上的杰出人物、士人的精神形象；李立新引其“百工之于艺，自三代历汉，至唐而备矣”与“渐老渐熟，乃造平淡”，并记其持有的“药玉盏”“荷叶杯”自然而朴澹。","path":"persons/su-shi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"A","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"苏轼是 A 维度下宋代文人造物评价与“平淡”审美的代表。Theme/Topic 尚未 materialize。"},{"id":"persons:sun-yat-sen","title":"孙中山（Sun Yat-sen）","name_en":"Sun Yat-sen","type":"person","type_zh":"人物","color":"#3B82F6","tags":["清末民初","中山装","建国方略","剪辫易服"],"confidence":"medium","consensus":"tentative","sub_type":"statesman","source_count":"2","evidence_status":"source_backed","description":"孙中山是清末民初革命家、民国临时大总统，中山装的设计者与提倡者。赵农记其 1919 年《建国方略》设计上海“东方大港”及“创造市宅中心于浦东”的计划；夏燕靖 2016 记其亲自设计并带头穿着中山装、颁布剪辫易服法令。","path":"persons/sun-yat-sen.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"孙中山是 D 维度下近代服制改革与城市规划的代表人物，中山装是其设计史核心产物。Theme/Topic 尚未 materialize。"},{"id":"persons:tao-yuanqing","title":"陶元庆（Tao Yuanqing）","name_en":"Tao Yuanqing","type":"person","type_zh":"人物","color":"#3B82F6","tags":["民国","书籍装帧","鲁迅","封面设计"],"confidence":"medium","consensus":"tentative","sub_type":"designer","source_count":"2","evidence_status":"source_backed","description":"陶元庆是民国书籍装帧设计家。赵农记其《彷徨》《坟》等作品装帧含蓄深刻、饱满整洁，与鲁迅并列为对书籍装帧有独到见解的代表；夏燕靖 2016 记其早年在上海《时报》馆作杂志图案设计，1925 年结识鲁迅后为鲁迅著作设计大量封面，构图新颖精炼、色彩明快简洁而富装饰趣味。","path":"persons/tao-yuanqing.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"陶元庆是 C 维度下民国书籍装帧与鲁迅书装谱系的代表。Theme/Topic 尚未 materialize。"},{"id":"persons:wang-zhen","title":"王祯（Wang Zhen）","name_en":"Wang Zhen","type":"person","type_zh":"人物","color":"#3B82F6","tags":["元代","农书","农器图谱","木活字","转轮排字"],"confidence":"medium","consensus":"tentative","sub_type":"engineer","source_count":"5","evidence_status":"source_backed","description":"王祯是五册中元代条目最厚的人物，跨农具、农业机械与活字印刷两条技术线。五册对他的取材几乎不重叠：夏燕靖两版给出生平、《农书》的版本结构与一整段秧马材料的批判性讨论；赵农给出最详的农器图谱解读、水轮三事与水转连磨的设计，以及木活字的具体工艺；高丰只用他两句——《布机篇》的一句诗和“转轮排字盘”一条；李立新只取他作为印刷设计家集群的枢纽，并指出现代记住的是《农书》、忘记的是他的活字。田自秉一册完全不提","path":"persons/wang-zhen.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"王祯是 B 维度下农具、农业机械与活字印刷两条技术线的交会人物；夏燕靖两版围绕秧马展开的一整段材料批判属于 A 维度的方法论内容；其县尹劝农政绩属 D 维度的地方制度实践。本批按五册共同的技术设计主体归主维度 B。Theme/Topic 尚未 materialize。"},{"id":"persons:wei-gai","title":"卫改（Wei Gai）","name_en":"Wei Gai","type":"person","type_zh":"人物","color":"#3B82F6","tags":["东汉","画像石","武氏祠","石工"],"confidence":"medium","consensus":"tentative","sub_type":"craftsman","source_count":"2","evidence_status":"source_backed","description":"卫改是东汉武氏祠画像石工匠，姓名见于武氏家族墓地碑文与石刻题记。田自秉把他与孟孚、李弟卯、孙宗并列，视为留下姓名的石工；李立新引碑文“良匠卫改，雕文刻画，罗列成行，摅骋技巧，委蛇有章”，并据题记讨论高平、山阳的画像石工匠集群。","path":"persons/wei-gai.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"卫改是 B 维度下汉代画像石工匠留名与地域工匠集群的实例。Theme/Topic 尚未 materialize。"},{"id":"persons:wen-yiduo","title":"闻一多（Wen Yiduo）","name_en":"Wen Yiduo","type":"person","type_zh":"人物","color":"#3B82F6","tags":["民国","书籍装帧","插图","比亚兹莱"],"confidence":"medium","consensus":"tentative","sub_type":"designer","source_count":"2","evidence_status":"source_backed","description":"闻一多是文学家、美术家，也是民国时期书籍装帧设计者。赵农记其经常为文学作品设计封面，如《冯小青》的装帧及插图；夏燕靖 2016 记其明显受比亚兹莱绘画影响，所绘书籍插图及封面设计具有西方气息，将现代艺术与东方艺术手法自然结合。","path":"persons/wen-yiduo.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"闻一多是 C 维度下民国书籍装帧与插图设计的代表。Theme/Topic 尚未 materialize。"},{"id":"persons:wen-zhenheng","title":"文震亨（Wen Zhenheng）","name_en":"Wen Zhenheng","type":"person","type_zh":"人物","color":"#3B82F6","tags":["明代","长物志","园林","室内陈设","明式家具"],"confidence":"medium","consensus":"tentative","sub_type":"scholar","source_count":"5","evidence_status":"source_backed","description":"文震亨在五册来源中的位置相当整齐：高丰为他单设一节“文震亨的设计思想”，并在“文人设计师”名单、明式家具文人的参与、室内环境设计理论著作三处反复引用；夏燕靖两版把他作为《长物志》的撰者作文献条目；赵农在造园家名单与《长物志》的卷目两处提及；李立新只在参考书目中列《长物志校注》。**同一著作在两类来源中被读出两种主旨**：高丰读作雅俗与古雅的鉴赏体系，夏燕靖两版读作“以用为本”的实用性。本 KU 只","path":"persons/wen-zhenheng.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"A","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"文震亨是 A 维度下文人设计观的样本：《长物志》提供了一套以雅俗为轴的器物评价标准，与同时期计成《园冶》、李渔《闲情偶寄》同属明末清初的室内与园林设计理论。B 维度上则承载明式家具式样与灯具品评的具体材料。Theme/Topic 均未 materialize。"},{"id":"persons:xi-zhong","title":"奚仲（Xi Zhong）","name_en":"Xi Zhong","type":"person","type_zh":"人物","color":"#3B82F6","tags":["夏代","造车","车正","薛部族","传说人物"],"confidence":"medium","consensus":"tentative","sub_type":"craftsman","source_count":"5","evidence_status":"source_backed","description":"奚仲是五册来源共同记载的造车传说人物，出身薛部族，任夏朝“车正”（掌管造车的工官）。五册的分歧不在“有没有奚仲”，而在三处：车的发明权究竟归黄帝还是奚仲、由全木轮改为有辐轮是否应记在奚仲名下、以及这类古籍记载能否直接当作设计史事实。第一处由高丰提出并悬置，第二处赵农与夏燕靖两版取向相反，第三处李立新明确给出了否定性警告。","path":"persons/xi-zhong.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"奚仲是 B 维度下车辆设计的起源叙事，也是 A 维度下“传说能否作为设计史证据”的方法论样本：五册对同一传说的采信程度差异明显。Theme/Topic 均未 materialize。"},{"id":"persons:xunzi","title":"荀子（Xunzi）","name_en":"Xunzi","type":"person","type_zh":"人物","color":"#3B82F6","tags":["战国","儒家","工艺美学","装饰观"],"confidence":"medium","consensus":"tentative","sub_type":"philosopher","source_count":"4","evidence_status":"source_backed","description":"荀子是战国末期儒家思想家，名况（一说字卿）。四册来源都把他列为先秦诸子工艺美学诸家之一，重点在于他与墨子“非乐”相反的立场：不否认装饰的价值，而把装饰看作“养目”之物，主张内质与外形并重。","path":"persons/xunzi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"A","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"荀子在来源中作为先秦诸子工艺美学的论述者出现，其“养目”说支撑 A 维度的设计观念讨论；同时其“以玉比德”涉及 B 维度的器物评价。Theme/Topic 尚未 materialize。"},{"id":"persons:yan-su","title":"燕肃（Yan Su）","name_en":"Yan Su","type":"person","type_zh":"人物","color":"#3B82F6","tags":["北宋","宋仁宗","漏刻","莲花漏","指南车"],"confidence":"medium","consensus":"tentative","sub_type":"scientist","source_count":"1","evidence_status":"source_backed","description":"燕肃是北宋仁宗时期的官吏、画家、机械学家、天文学家，山东益都人。赵农两处记其技术贡献：改进漏壶、修正记时标准；研制指南车，恢复汉魏以来屡造屡湮的形制；研制莲花漏，采用漫流系统稳定水流速度与压力，惜被朝廷冷落而未获使用。今传《寒岩积雪图》等绘画作品。","path":"persons/yan-su.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"燕肃是 B 维度下北宋机械与记时装置的人物条目：漏刻、莲花漏与指南车复原都归于其名下。Theme/Topic 尚未 materialize。"},{"id":"persons:yang-mao","title":"杨茂（Yang Mao）","name_en":"Yang Mao","type":"person","type_zh":"人物","color":"#3B82F6","tags":["元代","雕漆","剔红","嘉兴","髹漆"],"confidence":"medium","consensus":"tentative","sub_type":"craftsman","source_count":"2","evidence_status":"source_backed","description":"杨茂是元代嘉兴府西塘杨汇（一作扬汇）的雕漆名家，与张成齐名。田自秉记其故宫藏品与明人评骘；李立新补充《剔红花卉渣斗》的尺寸、纹饰与风格评价。","path":"persons/yang-mao.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"杨茂是 B 维度下元代嘉兴雕漆（剔红）名家，与张成并称，其作品与“堆朱杨成”的日本谱系构成漆艺史的具体链条。Theme/Topic 尚未 materialize。"},{"id":"persons:yuwen-kai","title":"宇文恺（Yuwen Kai）","name_en":"Yuwen Kai","type":"person","type_zh":"人物","color":"#3B82F6","tags":["隋代","建筑家","大兴城","东都洛阳","里坊制"],"confidence":"medium","consensus":"tentative","sub_type":"architect","source_count":"3","evidence_status":"source_backed","description":"宇文恺是隋代建筑家，官至工部尚书，三册来源都以大兴城为核心案例记述他。夏燕靖 2009 与 2016 两版的叙述几乎逐句相同，把大兴城拆成选址、规模、区划、里坊、街制五条来论证其规划才能，并在 2016 版增设“知识链接：宇文恺”小传，给出字号、籍贯、族属与官阶。赵农的写法完全不同：他先引《隋书》三句原文立其人，再以“揣摩皇帝的心思”与魏征“危乱之源，抑亦此之由”的评语作结，把同一批工程读作皇权工","path":"persons/yuwen-kai.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"宇文恺是 D 维度下国家工程与都城制度的设计者样本：其作品由朝廷下令、以工官体系实施，设计能力与皇权意志不可分割。夏燕靖两版给出完整的规划方法（选址、分区、里坊、街制），赵农给出制度批评视角（揣摩帝心、魏征评语）。Theme/Topic 均未 materialize。"},{"id":"persons:zeng-guofan","title":"曾国藩（Zeng Guofan）","name_en":"Zeng Guofan","type":"person","type_zh":"人物","color":"#3B82F6","tags":["清末","洋务运动","江南机器制造总局","安庆军械所"],"confidence":"medium","consensus":"tentative","sub_type":"statesman","source_count":"2","evidence_status":"source_backed","description":"曾国藩是清末洋务派官员。赵农记其与左宗棠、李鸿章、张之洞继承魏源思想、开始洋务运动；夏燕靖 2016 列其兴办洋务的五件实事，并称其为“第一个尝螃蟹的人”。","path":"persons/zeng-guofan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"曾国藩是 D 维度下洋务运动与近代工业制度建立的核心人物。Theme/Topic 尚未 materialize。"},{"id":"persons:zhang-cheng","title":"张成（Zhang Cheng）","name_en":"Zhang Cheng","type":"person","type_zh":"人物","color":"#3B82F6","tags":["元代","雕漆","剔红","嘉兴","髹漆"],"confidence":"medium","consensus":"tentative","sub_type":"craftsman","source_count":"2","evidence_status":"source_backed","description":"张成是元代嘉兴府西塘杨汇（一作扬汇）的雕漆名家，以剔红最得名。田自秉记其作品形制、涂漆层数、铭文与明人评骘；李立新补充作品尺寸、剔犀刀口深度、其子张德刚承业入明以及嘉兴漆艺东传日本的谱系。","path":"persons/zhang-cheng.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"张成是 B 维度下元代嘉兴雕漆（剔红、剔犀）的代表匠师，其作品、铭文与东传日本“堆朱杨成”的记载构成漆艺史的具体链条。Theme/Topic 尚未 materialize。"},{"id":"persons:zhang-guang-yu","title":"张光宇（Zhang Guangyu）","name_en":"Zhang Guangyu","type":"person","type_zh":"人物","color":"#3B82F6","tags":["20世纪","书籍装帧","万象","装饰","字体设计"],"confidence":"medium","consensus":"tentative","sub_type":"designer","source_count":"2","evidence_status":"source_backed","description":"张光宇是 20 世纪书籍与杂志装帧设计家、工艺美术设计家与教育家。赵农记其《万象》杂志封面装饰风格显著、大方得体、民族气息浓郁，1949 年后《装饰》等字体设计仍保持风格；夏燕靖 2016 记 1992 年《装饰》第 4 期出“纪念张光宇特刊”。","path":"persons/zhang-guang-yu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"张光宇是 C 维度下民国至新中国书籍装帧与字体设计的代表。Theme/Topic 尚未 materialize。"},{"id":"persons:zhang-heng","title":"张衡（Zhang Heng）","name_en":"Zhang Heng","type":"person","type_zh":"人物","color":"#3B82F6","tags":["东汉","地动仪","浑天仪","浑天说","科学仪器"],"confidence":"medium","consensus":"tentative","sub_type":"scientist","source_count":"2","evidence_status":"source_backed","description":"张衡是东汉科学家与仪器设计者。赵农记其制造地动仪、提出浑天说，并在地图、指南车等方面有贡献；夏燕靖 2016 记其用青铜制作浑天仪、制成世界上第一架候风地动仪，并详述地动仪的机械结构与艺术化造型。","path":"persons/zhang-heng.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"张衡是 B 维度下汉代科学仪器设计与青铜工艺结合的代表。Theme/Topic 尚未 materialize。"},{"id":"persons:zhang-jian","title":"张謇（Zhang Jian）","name_en":"Zhang Jian","type":"person","type_zh":"人物","color":"#3B82F6","tags":["晚清民国","实业家","纺织教育","大生纱厂","南通"],"confidence":"medium","consensus":"tentative","sub_type":"industrialist","source_count":"4","evidence_status":"source_backed","description":"张謇在四册来源中出现，位置分两类：高丰用整段为他立传，把张謇与沈寿并列为中国近代织绣史上的两位人物，称其为“中国近代纺织教育和纺织工业的先驱”；夏燕靖两版只在《雪宦绣谱》的文献条目与丝织科技文献清单中记他是该书的记录整理者与作序者；赵农则把他当作“官商一体”的**反例**，用以论证近代民族工业的结构性困境。**四册合计没有一处提出与他生平相悖的事实**，但评价取向从“先驱”到“压制其他私人企业”之","path":"persons/zhang-jian.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"张謇是 D 维度下实业办学模式的样本：以企业收益支撑技术教育，形成“工厂—学校—传习所”的闭环。同时是 B 维度刺绣工艺文献《雪宦绣谱》得以成书的关键人物（记录整理者与作序者）。四册评价相反：高丰作“先驱”，赵农作“官商一体”的反例。Theme/Topic 均未 materialize。"},{"id":"persons:zhang-zhidong","title":"张之洞（Zhang Zhidong）","name_en":"Zhang Zhidong","type":"person","type_zh":"人物","color":"#3B82F6","tags":["晚清","洋务运动","癸卯学制","工艺学堂","中体西用"],"confidence":"medium","consensus":"tentative","sub_type":"statesman","source_count":"3","evidence_status":"source_backed","description":"张之洞在三册来源中的分量差别很大：高丰把他写作中国近代艺术设计教育的**创始人**，用两整段铺陈其学制、学堂与奏议，是六册中对张之洞评价最高的一处；李立新把他放进设计教育史的制度线索，但只给压缩版的事实，并把同期的赵尔巽并列；赵农只在三处提及——生卒年与洋务官员名单（总结章），以及一句“两广总督张之洞利用机器铸制了‘龙洋’银圆”。夏燕靖两版、田自秉册无字面命中。**本 KU 的核心是三组来源间的对","path":"persons/zhang-zhidong.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"张之洞是 D 维度下中国近代设计教育制度化的关键推手：癸卯学制把工艺与设计纳入国家学制，三江师范图画手工科培养出第一批师资。同时也是“中体西用”这一设计思想框架的命名者，属 A 维度边界。Theme/Topic 均未 materialize。"},{"id":"persons:zhao-guo","title":"赵过（Zhao Guo）","name_en":"Zhao Guo","type":"person","type_zh":"人物","color":"#3B82F6","tags":["汉代","农具","耧车","三脚耧","耦犁"],"confidence":"medium","consensus":"tentative","sub_type":"engineer","source_count":"3","evidence_status":"source_backed","description":"赵过是六册中记载最薄的汉代人物之一：三册提到他，高丰、田自秉、李立新三册完全不提，且三册的全部材料都集中在一段农具叙述里。夏燕靖两版把他写成“三脚耧”的设计发明者，赵农把他写成耧车与耦犁的推行者并补出耧车的构造与效率数据。三册都不记生卒、籍贯、师承与其他事迹；通行的“代田法”在六册中一次也没有出现。本 KU 因此以两说的分工差别为主，而不勉强补足生平。","path":"persons/zhao-guo.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"赵过在三册中只出现于汉代农具一条线（B）；其搜粟都尉身份与“主持农业生产”“负责推行”的叙述属官职与推广制度（D）。本批按三册共同的农具设计主体归主维度 B。Theme/Topic 尚未 materialize。"},{"id":"persons:zheng-guanying","title":"郑观应（Zheng Guanying）","name_en":"Zheng Guanying","type":"person","type_zh":"人物","color":"#3B82F6","tags":["清末","盛世危言","工艺","商战","实业救国"],"confidence":"medium","consensus":"tentative","sub_type":"scholar","source_count":"3","evidence_status":"source_backed","description":"郑观应（1842—1922）是清末改良主义思想家。赵农引其《盛世危言》“工艺一道，为国家致富之基。工艺既兴，物产即因之饶裕”，并主张“设工艺专科”“开工艺学堂”“派人游学各国”“设博览会以励百工”；李立新引其分析洋货入华导致女红失业、主张以“商战”对抗西方，视为“实业救国论”先声。","path":"persons/zheng-guanying.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"郑观应是 D 维度下晚清“工艺／实业”思潮与设计教育主张的代表。Theme/Topic 尚未 materialize。"},{"id":"persons:zheng-mantuo","title":"郑曼陀（Zheng Mantu）","name_en":"Zheng Mantu","type":"person","type_zh":"人物","color":"#3B82F6","tags":["民国","上海","月份牌","擦笔水彩法","广告设计"],"confidence":"medium","consensus":"tentative","sub_type":"designer","source_count":"2","evidence_status":"source_backed","description":"郑曼陀是近代上海月份牌广告设计家，首创“擦笔水彩法”。高丰记其用炭精粉擦出人物图像明暗变化、再用水彩层层渲染，风格风靡上海并为同行仿效，与周慕桥、杭穉英并称三大盟主；赵农将其列为月份牌代表设计者之一。","path":"persons/zheng-mantuo.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"郑曼陀是 C 维度下月份牌“擦笔水彩法”与上海广告设计谱系的代表。Theme/Topic 尚未 materialize。"},{"id":"persons:zhu-bishan","title":"朱碧山（Zhu Bishan）","name_en":"Zhu Bishan","type":"person","type_zh":"人物","color":"#3B82F6","tags":["元代","银器","银槎杯","嘉兴"],"confidence":"medium","consensus":"tentative","sub_type":"craftsman","source_count":"4","evidence_status":"source_backed","description":"朱碧山是元代江南著名银工，字华玉，嘉兴人。四册来源都以虾杯、蟹杯与银槎杯为他代表作，并记其槎杯传世仅四件，分藏北京故宫、台北故宫等四处。夏燕靖两版另记虾杯、蟹杯注入热酒后在桌上滑行，并给银槎杯的尺寸、铭文与“龙槎杯”之名。","path":"persons/zhu-bishan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"朱碧山是 B 维度下元代江南银工与槎杯器物传统的匠人锚点。Theme/Topic 尚未 materialize。"},{"id":"persons:zhu-kerou","title":"朱克柔（Zhu Kerou）","name_en":"Zhu Kerou","type":"person","type_zh":"人物","color":"#3B82F6","tags":["南宋","缂丝","云间","织绣"],"confidence":"medium","consensus":"tentative","sub_type":"craftsman","source_count":"2","evidence_status":"source_backed","description":"朱克柔是南宋缂丝名手。田自秉把她与沈子蕃、吴煦并列为南宋云间（今松江）缂丝名家，称其作品古澹清雅；李立新另记其活动于南宋高宗时，并给出《莲塘乳鸭图》《牡丹》的收藏地，把她作为缂丝“直接将绘画引入设计”的代表。","path":"persons/zhu-kerou.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"朱克柔是 B 维度下南宋缂丝名家，其作品体现缂丝由实用织造向书画摹缂、观赏化发展的阶段。Theme/Topic 尚未 materialize。"},{"id":"persons:zhu-qijian","title":"朱启钤（Zhu Qiqian）","name_en":"Zhu Qiqian","type":"person","type_zh":"人物","color":"#3B82F6","tags":["近现代","营造学会","中国营造学社","髹饰录"],"confidence":"medium","consensus":"tentative","sub_type":"scholar","source_count":"2","evidence_status":"source_backed","description":"朱启钤是北洋政府内务总长、近现代官员与学者。赵农记其 1925 年发起“营造学会”、1930 年改名“中国营造学社”；夏燕靖 2016 记其 1927 年据流传日本的钞本刊刻《髹饰录》。","path":"persons/zhu-qijian.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"朱启钤是 D 维度下近代建筑研究制度与漆艺文献整理的枢纽人物。Theme/Topic 尚未 materialize。"},{"id":"persons:zhu-xi","title":"朱熹（Zhu Xi）","name_en":"Zhu Xi","type":"person","type_zh":"人物","color":"#3B82F6","tags":["南宋","理学","简易","致用","道器"],"confidence":"medium","consensus":"tentative","sub_type":"philosopher","source_count":"2","evidence_status":"source_backed","description":"朱熹是南宋理学家，其服饰观与“简易”“致用”主张被设计史来源引作宋代设计思想的代表。赵农引其“男子有三紧”说明服饰与人格合一；李立新引其“去其重复，使之简易”与“道即器，器即道”，说明理学并不导致全面复古，而强调制度器物的简便实用。","path":"persons/zhu-xi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"A","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"朱熹是 A 维度下宋代“简易”“致用”设计思想的代表，连接理学、服饰规范与器物观。Theme/Topic 尚未 materialize。"},{"id":"persons:zhuangzi","title":"庄子（Zhuangzi）","name_en":"Zhuangzi","type":"person","type_zh":"人物","color":"#3B82F6","tags":["战国","道家","造物思想","反雕饰","漆园吏"],"confidence":"medium","consensus":"tentative","sub_type":"philosopher","source_count":"6","evidence_status":"source_backed","description":"庄子在六册中从不是被叙述的造物者，而是被反复征引的**思想来源**。他的出现方式分两类：一类是设计史观层面的正面论述——高丰、李立新、夏燕靖 2016 把他与老子并列为“反雕饰、尚自然”设计观的代表，赵农单设《庄子》一节论其器具认识；另一类是技术史层面的零散引证——田自秉引《庄子·秋水》释夔纹、引《史记》述漆园吏、引“虚室生白”溯吉祥图案，赵农引《庄子》论剑器、铜镜重影、毛笔、跪坐、音乐、园林。两","path":"persons/zhuangzi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"A","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"庄子是 A 维度下先秦造物思想的条目：他不从事造物，其价值在于为设计提供目的论与评价标准（素朴、自然、技进乎道）。同时是 B 维度诸条（漆器、铜镜、毛笔、夔纹）的古籍引证来源。Theme/Topic 均未 materialize。"},{"id":"persons:zuo-zongtang","title":"左宗棠（Zuo Zongtang）","name_en":"Zuo Zongtang","type":"person","type_zh":"人物","color":"#3B82F6","tags":["晚清","洋务运动","福建船政局","兰州制造局","甘肃织呢局"],"confidence":"medium","consensus":"tentative","sub_type":"statesman","source_count":"3","evidence_status":"source_backed","description":"左宗棠在六册中的相关文本很少，但分布很不均衡：夏燕靖 2009 与 2016 两版各有一段完整的洋务活动叙述，把他与曾国藩、李鸿章并列，逐条记福建船政局、求实堂艺局、兰州制造局、甘肃织呢局；赵农只在近代史总结里把他列入洋务官员名单，给出“强政府”而非“民生”的评价框架，不展开他的具体事迹；高丰、田自秉、李立新三册无字面命中。**本 KU 只做人物层面的身份、动因与评价合成**，福建船政局的局址、船","path":"persons/zuo-zongtang.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"左宗棠是 D 维度下洋务官员推动近代工业设计的样本：其活动以海防与军需为动因，以官办局厂为组织形式。夏燕靖两版把他列为洋务派三大人物之一作技术引进叙述，赵农仅在总结中列入洋务官员名单并给出“强政府非民生”的批判框架。Theme/Topic 均未 materialize。"},{"id":"places:banpo-site","title":"半坡遗址（Banpo Site）","name_en":"Banpo Site","type":"place","type_zh":"地点","color":"#06B6D4","tags":["新石器时代","仰韶文化","彩陶","半地穴式建筑"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_site","source_count":"6","evidence_status":"source_backed","description":"半坡遗址是陕西西安东郊浐河旁的仰韶文化聚落遗址，距今约六七千年。六册来源把它用作多处论证的实物依据：石器与农具、尖底瓶的力学设计、人面鱼纹彩陶盆的图像解释、半地穴式建筑的构造、以及“半坡型”彩陶的类型命名。本 KU 把这些不同层面的引用合并登记。","path":"places/banpo-site.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"半坡遗址是 B 维度下新石器时代聚落与器物群的综合锚点，同时是彩陶类型学的命名来源（半坡型）。Theme/Topic 尚未 materialize。"},{"id":"places:cizhou-kiln","title":"磁州窑（Cizhou Kiln）","name_en":"Cizhou Kiln","type":"place","type_zh":"地点","color":"#06B6D4","tags":["宋代","民窑","白地黑花","河北"],"confidence":"medium","consensus":"tentative","sub_type":"kiln_site","source_count":"5","evidence_status":"source_backed","description":"磁州窑是宋元时期北方规模最大的民间瓷窑体系，窑址集中在河北磁县、邯郸一带漳河两岸。五册来源都以白地釉下黑（褐）花和强烈的绘画性装饰为其标志，并把它看作中国瓷器由刻划装饰转向毛笔彩绘的关键节点。","path":"places/cizhou-kiln.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"磁州窑是 B 维度下民窑体系与白地黑花装饰传统的锚点，其绘画性装饰也涉及 C 维度的视觉表现问题。Theme/Topic 尚未 materialize。"},{"id":"places:dadiwan-site","title":"大地湾遗址（Dadiwan Site）","name_en":"Dadiwan Site","type":"place","type_zh":"地点","color":"#06B6D4","tags":["新石器时代","马家窑文化","建筑","料礓石","彩陶"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_site","source_count":"2","evidence_status":"source_backed","description":"大地湾遗址位于甘肃秦安，马家窑文化时期出现面积达420平方米的套房，有主室、后室、侧室。地面处理具有防潮、保温、抗压功能，房屋有料礓石面装饰，赵农称其几乎接近现代水泥材料的硬质。李立新记遗址出土人头形彩陶瓶。","path":"places/dadiwan-site.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"大地湾遗址是 B 维度下史前建筑技术与彩陶条目。Theme/Topic 尚未 materialize。"},{"id":"places:daxing-cheng","title":"大兴城（Daxing City）","name_en":"Daxing City","type":"place","type_zh":"地点","color":"#06B6D4","tags":["隋代","都城","里坊制","宇文恺","朱雀大街"],"confidence":"medium","consensus":"tentative","sub_type":"city","source_count":"2","evidence_status":"source_backed","description":"大兴城是隋开皇二年（582）隋文帝下令营建的新都，命高颎、宇文恺为正副监，宇文恺选定长安城东南龙首川一带平原为城址并主持规划。全城南北长8600米、东西长9700多米，总面积约84平方公里，有12座城门，由宫城、皇城、郭城组成，按里坊制分为108坊；有南北大街11条、东西大街14条，朱雀大街宽150米。开皇二年六月营建、当年十二月基本竣工，次年三月迁入，前后仅9个月。","path":"places/daxing-cheng.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"大兴城是 D 维度下隋唐都城规划与里坊制条目。Theme/Topic 尚未 materialize。"},{"id":"places:ding-kiln","title":"定窑（Ding Kiln）","name_en":"Ding Kiln","type":"place","type_zh":"地点","color":"#06B6D4","tags":["宋代","五大名窑","白瓷","覆烧","印花"],"confidence":"medium","consensus":"tentative","sub_type":"kiln_site","source_count":"6","evidence_status":"source_backed","description":"定窑位于河北曲阳（宋属定州），以白瓷为主，是宋代五大名窑中唯一被六册来源一致归为“民窑出身”的窑口。它的工艺标志是覆烧（因而碗盘口沿无釉，称芒口）与印花装饰；它的制度特征是产品被宫廷选用而窑本身仍属民营。六册来源在这一点上大体一致，但在**断代下限**与**款识清单**上分歧明显：田自秉记“唐至北宋”，赵农记“宋代”而未及下限，夏燕靖 2009 则给出“始烧于唐、兴盛于宋、失传于元”的发掘定论；款","path":"places/ding-kiln.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"定窑是 B 维度下白瓷体系与覆烧、印花工艺的关键窑口，其“民窑而供御”的身份又落在 D 维度的官民关系上。Theme/Topic 均未 materialize。"},{"id":"places:dunhuang-mogao-ku","title":"敦煌莫高窟（Mogao Grottoes）","name_en":"Mogao Grottoes","type":"place","type_zh":"地点","color":"#06B6D4","tags":["石窟寺","北朝","壁画","塑像","窟檐"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_site","source_count":"3","evidence_status":"source_backed","description":"敦煌莫高窟位于甘肃敦煌。李立新记其壁画塑像经编号的有492个，与云冈、龙门、麦积山、响堂山、栖霞山同为魏晋南北朝重要石窟寺院；窟前建木构殿阁，一般分前室窟檐与主室佛窟，图2-13为敦煌莫高窟窟檐建筑。2016 版将其与云冈、龙门并列为北朝石刻艺术精品。","path":"places/dunhuang-mogao-ku.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"敦煌莫高窟是 B 维度下石窟寺建筑与壁画塑像条目。Theme/Topic 尚未 materialize。"},{"id":"places:erlitou-site","title":"二里头遗址（Erlitou Site）","name_en":"Erlitou Site","type":"place","type_zh":"地点","color":"#06B6D4","tags":["夏代","商代早期","青铜时代","宫殿遗址","铸铜遗址"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_site","source_count":"6","evidence_status":"source_backed","description":"二里头遗址位于河南偃师，是二里头文化中范围最大、遗物最丰富、最具代表性的一处，文化命名即由此而来。六册来源都把它当作中国青铜时代开端的实物依据，理由集中在三点：出现了中国最早的宫殿建筑，发现了铸铜作坊（陶范、坩埚、铜渣），出土了最早的青铜容器。但六册对它的**年代与朝代归属给出三种互不相容的定性**——夏代晚期（高丰、夏燕靖两版）、夏文化但存疑（田自秉）、商代早期（赵农）——本 KU 三种并列，不","path":"places/erlitou-site.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"二里头遗址是 B 维度下中国青铜时代起点的遗址锚点：最早的青铜容器、最早的宫殿建筑、最早的铸铜作坊都在此汇合。遗址的年代归属争议同时构成 E 维度“何为中国文明开端”的叙述分歧。Theme/Topic 尚未 materialize。"},{"id":"places:fuhao-tomb","title":"妇好墓（Tomb of Fu Hao）","name_en":"Tomb of Fu Hao","type":"place","type_zh":"地点","color":"#06B6D4","tags":["商代","殷墟","青铜器","玉器","纺织"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_site","source_count":"2","evidence_status":"source_backed","description":"妇好墓位于安阳殷墟。出土商代铜铲7件，其中有装饰性铲与实用青铜铲；所出双虎食人青铜钺重达9公斤，是已出土青铜钺中最重者。墓中纺织品遗物表明当时已有简单提花器具和羊毛纤维织物；陪葬饰物仅玉器就有426件，含头饰、腕饰、坠饰、项链等。2016 版记墓中出4件以鸟兽浮雕和圆雕为主要装饰的酒器——铜鸮尊、偶方彝、圈足觥，标志青铜工艺与设计达到新高峰。","path":"places/fuhao-tomb.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"妇好墓是 B 维度下商代青铜、玉器与纺织造物条目。Theme/Topic 尚未 materialize。"},{"id":"places:hemudu-site","title":"河姆渡遗址（Hemudu Site）","name_en":"Hemudu Site","type":"place","type_zh":"地点","color":"#06B6D4","tags":["新石器时代","河姆渡文化","干栏式建筑","稻作农业"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_site","source_count":"6","evidence_status":"source_backed","description":"河姆渡遗址在浙江余姚，是长江下游新石器时代的重要聚落遗址，距今约 7000 年。六册来源主要用它论证四件事：干栏式木构建筑与榫卯、稻作农业的起源地位、陶器与骨器工艺、以及中国已知最早的漆器。本 KU 合并登记这四条论述线。","path":"places/hemudu-site.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"河姆渡遗址是 B 维度下长江下游新石器时代木构建筑、稻作与漆器起源的综合锚点，与黄河流域半坡构成南北对照。Theme/Topic 尚未 materialize。"},{"id":"places:jian-kiln","title":"建窑（Jian Kiln）","name_en":"Jian Kiln","type":"place","type_zh":"地点","color":"#06B6D4","tags":["宋代","黑釉","兔毫","油滴","鹧鸪斑"],"confidence":"medium","consensus":"tentative","sub_type":"kiln_site","source_count":"2","evidence_status":"source_backed","description":"建窑是宋代黑釉瓷窑。赵农记其在福建建阳，建阳为南宋富裕之地，以黑瓷著名、以碗盏为主，利用特殊温度烧制使铁质结晶成油滴圆纹点或细兔毫状条纹，胎体紫黑、釉色厚重，宋人喜用建窑兔毫盏饮茶品茗。田自秉记其在福建建瓯、水吉一带，黑釉中铁成分因烧制火度不同形成兔毫、鹧鸪斑、油滴等褐色斑纹；因宋徽宗及大臣蔡襄提倡黑瓷饮茶而受重视，产品多碗盏茶具，碗底刻“供御”“进盏”“才”等字样，为贡品。","path":"places/jian-kiln.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"建窑是 B 维度下宋代黑釉瓷窑与茶器条目。Theme/Topic 尚未 materialize。"},{"id":"places:jiangzhai-site","title":"姜寨遗址（Jiangzhai Site）","name_en":"Jiangzhai Site","type":"place","type_zh":"地点","color":"#06B6D4","tags":["仰韶文化","新石器时代","聚落布局","黄铜片","编织席印痕"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_site","source_count":"3","evidence_status":"source_backed","description":"姜寨遗址位于陕西临潼，属新石器时代仰韶文化。它在本库的三册来源中都不是以“遗址本体”被叙述，而是各自被调用为一条论据：赵农用它证明仰韶聚落的圆形向心布局与早期书写工具，李立新用它证明纹饰已进入造物、以及中国最早的黄铜制品，夏燕靖（2016）用它证明编织席纹在陶器上的留存。因此本 KU 的价值在于**同一遗址被三条不同论证路径征用**这一事实本身。","path":"places/jiangzhai-site.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"姜寨遗址是 B 维度下新石器时代聚落布局、编织与早期冶铜证据的样本点，其在设计史叙述中的功能是证明纹饰与向心布局先于青铜时代出现。Theme/Topic 尚未 materialize。"},{"id":"places:jingdezhen-kiln","title":"景德镇窑（Jingdezhen Kiln）","name_en":"Jingdezhen Kiln","type":"place","type_zh":"地点","color":"#06B6D4","tags":["青白瓷","影青","粉定","覆烧","浮梁瓷局"],"confidence":"medium","consensus":"tentative","sub_type":"kiln_site","source_count":"6","evidence_status":"source_backed","description":"景德镇窑是六册共同承认的宋代以来最重要的瓷窑，也是本库中少数需要与“地名”分开建条的窑口：地名条记建制、人口、产量与产业形态，本条只记窑场、釉色、装饰、窑具与款识。六册对它的技术定位相当一致——北宋中期创烧青白瓷（影青），南宋接受定窑的支圈覆烧，元代设浮梁瓷局并以枢府、太禧铭记进御器，元后期青花成熟，明清成为官窑与民窑并行的全国制瓷中心。**本 KU 记录的分歧集中在两处**：一是“枢府”“太禧”","path":"places/jingdezhen-kiln.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"景德镇窑是 B 维度下青白瓷—影青—青花—釉里红这条釉色与彩绘技术线的枢纽，浮梁瓷局与枢府铭记又把它接到 D 维度的官营手工业，钴料进口与外销接到 E 维度。地名与产业形态归 places/jingdezhen.md。Theme/Topic 均未 materialize。"},{"id":"places:jingdezhen","title":"景德镇（Jingdezhen）","name_en":"Jingdezhen","type":"place","type_zh":"地点","color":"#06B6D4","tags":["瓷都","江西","御器厂","浮梁瓷局","青花"],"confidence":"medium","consensus":"tentative","sub_type":"city","source_count":"6","evidence_status":"source_backed","description":"景德镇在六册来源中的身份不是一个窑口，而是一座因瓷而立的城市：它由镇而“瓷都”，由官监民烧而御器厂，再而近代瓷业公司、国营瓷厂与今日的“地方传统工业和城市的象征”。正因为如此，六册对它的叙述重心各不相同——高丰重官窑建制与近代转型，田自秉重产量与工匠规模，夏燕靖两版重工艺与“瓷都／陶都”格局，赵农重得名经过与仿定渊源，李立新重手工工场与战争破坏。**本 KU 记录的核心分歧有三处**：得名的具体说","path":"places/jingdezhen.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"景德镇是 D 维度下“官监民烧—御器厂—手工工场—近代瓷业公司—国营瓷厂”这条生产组织链条的完整样本，其瓷土与窑炉条件落在 B 维度，外销与外来钴料落在 E 维度。Theme/Topic 均未 materialize。"},{"id":"places:jizhou-kiln","title":"吉州窑（Jizhou Kiln）","name_en":"Jizhou Kiln","type":"place","type_zh":"地点","color":"#06B6D4","tags":["宋代","民窑","黑釉","玳瑁釉","剪纸贴花"],"confidence":"medium","consensus":"tentative","sub_type":"kiln_site","source_count":"2","evidence_status":"source_backed","description":"吉州窑在江西吉安永和镇，是宋代著名民窑，以黑釉瓷著称。使用剔花、印花、洒釉、贴花等方法，吸收民间剪纸纹饰，将剪纸纹样贴印在胎质上，形成新的制瓷装饰手法；烧制出称为“玳瑁釉”的黑褐色釉瓷。田自秉记其与北方磁州窑并称两大民窑体系，遗址面积20余亩、较大瓷片堆积18处。","path":"places/jizhou-kiln.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"吉州窑是 B 维度下宋代民窑与黑釉装饰工艺条目。Theme/Topic 尚未 materialize。"},{"id":"places:jun-kiln","title":"钧窑（Jun Kiln）","name_en":"Jun Kiln","type":"place","type_zh":"地点","color":"#06B6D4","tags":["宋代","窑变","铜红釉","五大名窑"],"confidence":"medium","consensus":"tentative","sub_type":"kiln_site","source_count":"6","evidence_status":"source_backed","description":"钧窑是宋代以铜红釉窑变为特征的瓷窑，窑址在河南禹县。六册来源在“钧瓷是否属于青瓷系统”上有实质分歧：高丰主张它是独立的“窑变花瓷”，田自秉、赵农仍归青瓷系统。本 KU 并存两说。","path":"places/jun-kiln.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"钧窑是 B 维度下宋代铜红釉窑变工艺的窑口锚点，其“是否属于青瓷系统”的归类分歧是陶瓷分类标准的样本。Theme/Topic 尚未 materialize。"},{"id":"places:liling","title":"醴陵（Liling）","name_en":"Liling","type":"place","type_zh":"地点","color":"#06B6D4","tags":["釉下彩","湖南","近现代","湘瓷"],"confidence":"medium","consensus":"tentative","sub_type":"kiln_site","source_count":"2","evidence_status":"source_backed","description":"醴陵是湖南的陶瓷产地，位于湖南东部渌水之滨，以釉下彩著名，并凭借自身优势成为南方著名的陶瓷工业重镇。赵农将其列为现代中国陶瓷业的重要基地之一；田自秉记其为湘瓷的代表，解放前釉下彩技艺几乎失传、色料仅5种，解放后研制新色料并能烧100多种复色。","path":"places/liling.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"醴陵是 B 维度下近现代釉下彩瓷产区条目。Theme/Topic 尚未 materialize。"},{"id":"places:linzi","title":"临淄（Linzi）","name_en":"Linzi","type":"place","type_zh":"地点","color":"#06B6D4","tags":["春秋战国","齐国都城","城制","官营手工业","纺织贸易"],"confidence":"medium","consensus":"tentative","sub_type":"city","source_count":"2","evidence_status":"source_backed","description":"临淄是春秋战国时期齐国都城（今山东淄博），战国时形成大城、小城二城制。小城北部为宫殿区、南部为官营手工业作坊区（青铜、冶铁、铸钱）；大城北部为平民手工业作坊。2016 版另记其布帛、衣物买卖发达，是纺织贸易与官府织造作坊集中的城市。","path":"places/linzi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"临淄是 D 维度下先秦都城城制与手工业分区条目。Theme/Topic 尚未 materialize。"},{"id":"places:longmen-grottoes","title":"龙门石窟（Longmen Grottoes）","name_en":"Longmen Grottoes","type":"place","type_zh":"地点","color":"#06B6D4","tags":["石窟寺","北魏","唐代","佛教艺术","奉先寺"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_site","source_count":"6","evidence_status":"source_backed","description":"龙门石窟位于河南洛阳伊水两岸，东为香山，西为龙门山，北魏迁都洛阳后开凿，历东魏、北齐、隋、唐续凿，是六册共同举出的中国石窟寺代表之一。它在设计史叙述中的功能随册而异：高丰把它与克孜尔、敦煌、云冈并列，作为佛教艺术进入造物纹样的时代标记；夏燕靖两版关注它的建筑与石刻纹饰（藻井莲花、卷草边饰）；赵农给出最完整的窟名、尺寸、功数与造像体系；田自秉把它放在石雕工艺与卷草纹的两条线索里；李立新则从“窟前木构","path":"places/longmen-grottoes.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"龙门石窟是 B 维度下石雕工艺、窟龛形制与宗教装饰纹样的最大实物群，其造像样式的犍陀罗渊源与中原化过程又落在 E 维度的跨文化互动；六册对它的取舍差异则构成 A 维度“设计史如何处理宗教美术”的样本。Theme/Topic 均未 materialize。"},{"id":"places:longquan-kiln","title":"龙泉窑（Longquan Kiln）","name_en":"Longquan Kiln","type":"place","type_zh":"地点","color":"#06B6D4","tags":["青瓷","粉青","梅子青","石灰碱釉","龙窑"],"confidence":"medium","consensus":"tentative","sub_type":"kiln_site","source_count":"6","evidence_status":"source_backed","description":"龙泉窑是宋元两代南方青瓷的主干产区，也是六册共同用来论证“宋代青瓷最高成就”的窑口。它的技术标志是石灰碱釉与多次施釉所得的粉青、梅子青；它的经济标志是宋时出口最多的青瓷产地与元代成批外销；它的史学标志是与哥窑的纠缠——章生一、章生二的兄弟传说被三册同时引用，又被三册同时标为不可考。**本 KU 记录的分歧有三处**：创烧年代（北宋早期／五代／宋代）、元代窑址数量（一百数十处／约 150 处）与“龙","path":"places/longquan-kiln.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"龙泉窑是 B 维度下石灰碱釉与粉青、梅子青的技术代表，也是宋元外销瓷数量最大的青瓷产区（D 维度的市场与港口条件、E 维度的海外流通）。其与哥窑的关系又牵动“五大名窑”的构成。Theme/Topic 均未 materialize。"},{"id":"places:mancheng-hanmu","title":"满城汉墓（Mancheng Han Tombs）","name_en":"Mancheng Han Tombs","type":"place","type_zh":"地点","color":"#06B6D4","tags":["西汉","铜器","金银器","长信宫灯","博山炉"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_site","source_count":"2","evidence_status":"source_backed","description":"满城汉墓是河北满城西汉中山靖王刘胜夫妇墓，出土长信宫灯、错金博山炉、长乐宫钟、错金银鸟篆文壶、单流银盒等，是汉代铜器与金银器工艺的重要出土地。李立新亦以长信宫灯为例。","path":"places/mancheng-hanmu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"满城汉墓是 B 维度下汉代铜器与金银器造物条目。Theme/Topic 尚未 materialize。"},{"id":"places:mawangdui-hanmu","title":"马王堆汉墓（Mawangdui Han Tombs）","name_en":"Mawangdui Han Tombs","type":"place","type_zh":"地点","color":"#06B6D4","tags":["西汉","漆器","丝织品","素纱禅衣","六博"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_site","source_count":"2","evidence_status":"source_backed","description":"马王堆汉墓是湖南长沙东郊的西汉墓葬群，1972—1974年发掘。高丰记1号墓出漆器184件、3号墓316件，合计500余件；1号墓出丝织品与服饰100多件（46幅、50余件衣物），并出素纱禅衣、双层九子奁、莞席、丝绸帷帐等，3号墓出龙纹漆几。田自秉记1号墓出基本完整的丝织品100多件，包括匹端单幅丝织物46段、成件衣服58件，被称为汉代“丝绸之库”；3号墓出全套六博博具，博局上有TLV规矩纹；同墓","path":"places/mawangdui-hanmu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"马王堆汉墓是 B 维度下西汉漆器与丝织造物条目。Theme/Topic 尚未 materialize。"},{"id":"places:miaodigou-site","title":"庙底沟遗址（Miaodigou Site）","name_en":"Miaodigou Site","type":"place","type_zh":"地点","color":"#06B6D4","tags":["新石器时代","仰韶文化","庙底沟类型","早期龙山","建筑"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_site","source_count":"2","evidence_status":"source_backed","description":"庙底沟遗址位于河南三门峡。早期龙山文化（或称“庙底沟第二期文化”）即据该遗址的发现而确定，主要分布在豫西、晋南、关中一带。2016 版记其为仰韶文化庙底沟类型所在遗址，房屋墙上和屋内留有许多柱洞、垫以天然砾石和白石灰，并发现长达10多米的房基；庙底沟类型的尖底瓶被列为汲水器，马家窑文化上承庙底沟类型。","path":"places/miaodigou-site.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"庙底沟遗址是 B 维度下新石器时代建筑与陶器类型条目。Theme/Topic 尚未 materialize。"},{"id":"places:nanjing","title":"南京（Nanjing）","name_en":"Nanjing","type":"place","type_zh":"地点","color":"#06B6D4","tags":["明初都城","琉璃窑","大报恩寺","南洋劝业会","首都计划"],"confidence":"medium","consensus":"tentative","sub_type":"city","source_count":"2","evidence_status":"source_backed","description":"南京是明初都城应天府所在，设琉璃窑72座并建大报恩寺琉璃塔；清末南洋劝业会会场设于南京丁家桥。赵农记其在1949年以前作为江南政治文化中心占据特殊地位，1928年民国政府定都并制定“首都计划”，但除中山陵、总统府大门、中央博物院等中西融合建筑外，缺乏规模和数量，尤其对普通民众生存环境缺乏必要改善；南京依山临水，80年代初出现金陵饭店等高层建筑，标志城市新格局。","path":"places/nanjing.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"南京是 D 维度下都城制度、博览会场与近代城市规划条目。Theme/Topic 尚未 materialize。"},{"id":"places:ou-kiln","title":"瓯窑（Ou Kiln）","name_en":"Ou Kiln","type":"place","type_zh":"地点","color":"#06B6D4","tags":["青瓷","六朝","唐代","缥瓷","瓯江"],"confidence":"medium","consensus":"tentative","sub_type":"kiln_site","source_count":"2","evidence_status":"source_backed","description":"瓯窑是浙江温州等地生产青瓷的窑口，古称东瓯窑，分布于永嘉、温州一带。赵农记其胎质与釉色结合紧密，釉色温润如玉、淡雅清脆；田自秉记其制品含铁量较越窑低、胎色较白、釉呈淡青，即晋代诗文所称“缥瓷”，并引“杜毓《薈赋》‘器择陶拣，出自东瓯’”（原文如此，书名 OCR 疑为《荈赋》）。","path":"places/ou-kiln.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"瓯窑是 B 维度下六朝至唐青瓷窑系条目。Theme/Topic 尚未 materialize。"},{"id":"places:ru-kiln","title":"汝窑（Ru Kiln）","name_en":"Ru Kiln","type":"place","type_zh":"地点","color":"#06B6D4","tags":["宋代","官窑","青瓷","五大名窑"],"confidence":"medium","consensus":"tentative","sub_type":"kiln_site","source_count":"6","evidence_status":"source_backed","description":"汝窑是北宋为宫廷烧造青瓷的窑场，“五大名窑”之首。六册来源一致把它列为宋代最重要的青瓷名窑，但在三处关键事实上分歧明显：窑址所在（宝丰清凉寺／河南临汝县）、始烧时间（北宋初期／北宋后期宋徽宗年间）、装饰面貌（印花刻花／素面无过多装饰）。本 KU 三处并存，不裁定。","path":"places/ru-kiln.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"汝窑是 B 维度下宋代青瓷官窑的窑口锚点，其“窑址在宝丰还是在临汝”的分歧同时构成 E 维度的考古学证据史问题。Theme/Topic 尚未 materialize。"},{"id":"places:sanxingdui","title":"三星堆（Sanxingdui）","name_en":"Sanxingdui","type":"place","type_zh":"地点","color":"#06B6D4","tags":["商代","蜀国都邑","青铜人像","巴蜀文化","城市遗址"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_site","source_count":"2","evidence_status":"source_backed","description":"三星堆位于四川广汉，是商代早期的蜀国都邑，城市面积约220万平方米。居住区域内有住宅、制陶与玉石作坊及墓地，其中地面木结构房屋为贵族居所。2016 版将其作为巴蜀文化遗址，称所出商代青铜人雕像为商代服饰文物中最具代表者。","path":"places/sanxingdui.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"三星堆是 B 维度下商代蜀国都邑与青铜造物遗址的条目。Theme/Topic 尚未 materialize。"},{"id":"places:shandingdong-site","title":"山顶洞遗址（Shandingdong Site）","name_en":"Shandingdong Site","type":"place","type_zh":"地点","color":"#06B6D4","tags":["旧石器时代晚期","骨针","装饰品","原始宗教"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_site","source_count":"2","evidence_status":"source_backed","description":"山顶洞遗址位于北京周口店，属旧石器时代晚期。遗址已使用钻孔、刮削、磨光、刻纹工艺，出土8厘米骨针及石块、骨片、兽牙、海贝等装饰品，被视为我国最早工艺品之一；随葬品与尸体撒红色粉粒反映原始宗教观念。赵农另记自1933年山顶洞遗址出土骨针以来，南北许多石器时期遗址都发现骨针，甚至发现了用较粗动物骨制作的保存骨针的贮藏管。","path":"places/shandingdong-site.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"山顶洞遗址是 B 维度下旧石器时代晚期工艺与装饰条目。Theme/Topic 尚未 materialize。"},{"id":"places:xianrendong-site","title":"仙人洞遗址（Xianrendong Site）","name_en":"Xianrendong Site","type":"place","type_zh":"地点","color":"#06B6D4","tags":["新石器时代","陶器起源","洞穴遗址","江西万年"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_site","source_count":"2","evidence_status":"source_backed","description":"仙人洞遗址位于江西万年县，1962年出土距今8000多年的陶器。田自秉称为我国目前发现最早的陶器资料；2016 版同记陶器与年代，并注明同章另处误作“江西万县仙人洞”，地名前后不一致。","path":"places/xianrendong-site.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"仙人洞遗址是 B 维度下陶器起源与史前造物遗址条目。Theme/Topic 尚未 materialize。"},{"id":"places:xing-kiln","title":"邢窑（Xing Kiln）","name_en":"Xing Kiln","type":"place","type_zh":"地点","color":"#06B6D4","tags":["唐代","白瓷","河北","南青北白"],"confidence":"medium","consensus":"tentative","sub_type":"kiln_site","source_count":"5","evidence_status":"source_backed","description":"邢窑是唐代北方白瓷的代表性窑口，与南方越窑青瓷并称“南青北白”。五册来源都引陆羽《茶经》“邢瓷类银，越瓷类玉”“邢不如越”与李肇《国史补》“内丘白瓷瓯……天下无贵贱通用之”来说明其地位，但对其主要窑址是否已经确认，说法不一致。","path":"places/xing-kiln.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"邢窑是 B 维度下唐代白瓷体系与“南青北白”格局的窑口锚点。Theme/Topic 尚未 materialize。"},{"id":"places:yanshi-shangcheng","title":"偃师商城（Yanshi Shang City）","name_en":"Yanshi Shang City","type":"place","type_zh":"地点","color":"#06B6D4","tags":["商代","都邑","城墙","给排水","城市遗址"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_site","source_count":"2","evidence_status":"source_backed","description":"偃师商城是商代都邑遗址，面积190万平方米，筑长方形城墙、有7座城门，城外有10多米宽的护城河。城区有系统的排水与饮水井，宫城居中偏南，北部为居住和墓区，制陶作坊密集分布。赵农将其与郑州商城、安阳殷墟并称王邑；2016 版称其与二里头遗址共同佐证文献所记夏商两个王朝的政权更迭。","path":"places/yanshi-shangcheng.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"偃师商城是 B 维度下商代都邑遗址条目。Theme/Topic 尚未 materialize。"},{"id":"places:yaozhou-kiln","title":"耀州窑（Yaozhou Kiln）","name_en":"Yaozhou Kiln","type":"place","type_zh":"地点","color":"#06B6D4","tags":["唐代","宋代","青瓷","刻花","黄堡镇"],"confidence":"medium","consensus":"tentative","sub_type":"kiln_site","source_count":"2","evidence_status":"source_backed","description":"耀州窑在陕西铜川。赵农记唐代主要烧白、黑釉瓷及关中西北生活用瓷；宋代以刻花青瓷闻名，同时生产白瓷、黑瓷、三彩等，广泛吸收不同生产技术并形成自身优势，在北方有明显制瓷特色。田自秉记其在同官县（今铜川）黄堡镇，因同官旧属耀州得名，沿漆河上下十里都是瓷窑，称“十里窑场”；釉色青中微带黄，装饰有刻花（偏刀）、剔花、印花、镂空，题材多牡丹、菊花、忍冬、莲荷及凤鹤鸭鱼、婴戏，碗多喇叭形、莲瓣状。","path":"places/yaozhou-kiln.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"耀州窑是 B 维度下唐至宋北方青瓷窑条目。Theme/Topic 尚未 materialize。"},{"id":"places:yinxu","title":"殷墟（Yinxu）","name_en":"Yinxu","type":"place","type_zh":"地点","color":"#06B6D4","tags":["商代后期","王都","甲骨文","铸铜遗址","妇好墓"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_site","source_count":"6","evidence_status":"source_backed","description":"殷墟是商代后期王都，位于河南安阳小屯一带，沿洹水而建，六册来源一致以它作为商代物质文化的中心遗址。它同时是甲骨文的出土地、商代最大的铸铜作坊所在、妇好墓的所在地，因此在六册中承担着“商代造物总账”的功能：青铜器、玉器、白陶、车马、丝麻织物的证据多从此处出。**本 KU 记录的核心分歧有两个**：一是《竹书纪年》年数在同一段内即自相矛盾（二百五十三年／七十三年），且赵农所引作“二百七十三年”；二是妇","path":"places/yinxu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"殷墟是 B 维度下商代青铜铸造、玉器、白陶与车马工艺的最大实物容器，其王都身份与作坊分区又落在 D 维度的官营手工业组织上。Theme/Topic 尚未 materialize。"},{"id":"places:yixing","title":"宜兴（Yixing）","name_en":"Yixing","type":"place","type_zh":"地点","color":"#06B6D4","tags":["紫砂","明代","清代","龙窑","陶都"],"confidence":"medium","consensus":"tentative","sub_type":"kiln_site","source_count":"2","evidence_status":"source_backed","description":"宜兴是江苏太湖南岸的产陶区，被誉为“陶都”。紫砂陶多制茶具，朴素大方、意匠精巧，为国内外所欢迎，历来艺人辈出；另有钧陶、精陶与青瓷，紫砂、钧陶、精陶、青瓷、陶塑合称“五朵金花”。2016 版记其明清时期成为陶都，蜀山为紫砂陶主要产区、约10条龙窑专烧紫砂器；1955年成立紫砂生产合作社，任淦庭、吴云根、顾景舟等艺人在此从事紫砂创作。","path":"places/yixing.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"宜兴是 B 维度下紫砂陶产地与窑业条目。Theme/Topic 尚未 materialize。"},{"id":"places:yong-cheng","title":"雍城（Yong City）","name_en":"Yong City","type":"place","type_zh":"地点","color":"#06B6D4","tags":["秦国","都城","选址","陵区","离宫别馆"],"confidence":"medium","consensus":"tentative","sub_type":"city","source_count":"2","evidence_status":"source_backed","description":"雍城是秦国历史上极为重要的一座都城，位于汧山山脉，南濒雍水、西依灵山、东接广袤的关中平原。西有大道直通甘肃，南经宝鸡可抵巴蜀，东流渭水能泛舟楫，形胜冲要、易守难攻；四周宽阔平坦、土地肥沃、河水密布、植被茂盛。雍城建置经过精心选择，总体格局由城址、陵区、墓地及郊外离宫别馆四部分组成，雍水之南为墓地，旁有秦公陵园。","path":"places/yong-cheng.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"雍城是 D 维度下秦国都城选址与格局条目。Theme/Topic 尚未 materialize。"},{"id":"places:yuan-dadu","title":"元大都（Yuan Dadu）","name_en":"Yuan Dadu","type":"place","type_zh":"地点","color":"#06B6D4","tags":["元代","都城规划","中轴线","周礼考工记","刘秉忠"],"confidence":"medium","consensus":"tentative","sub_type":"city","source_count":"4","evidence_status":"source_backed","description":"元大都是忽必烈于至元八年（1271）以燕京为基地建立的首都，其规划被四册来源共同视为中国都城设计史的里程碑：方形城郭、棋盘形街道、九经九纬、明确的中轴线与左祖右社。它同时是明清北京城的直接基础。四册的叙述重点不同——夏燕靖两版重规划礼制，赵农重设计者（刘秉忠）与水利（郭守敬），田自秉重琉璃与铜镜等实物出土——本 KU 合并而不抹平。**须注意的是，夏燕靖两版给出的“面积50余万平方公里”与同一段城","path":"places/yuan-dadu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"元大都是 D 维度下“以礼制规划都城”的制度性样本，其九经九纬与左祖右社直接落实《周礼·考工记》；城市的给排水与漕运又属于 B 维度的工程条件。Theme/Topic 尚未 materialize。"},{"id":"places:yue-kiln","title":"越窑（Yue Kiln）","name_en":"Yue Kiln","type":"place","type_zh":"地点","color":"#06B6D4","tags":["青瓷","浙江","唐代","秘色瓷"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_site","source_count":"6","evidence_status":"source_backed","description":"越窑是浙江境内以青瓷为主的窑系，因唐代属越州而得名，古称会稽窑。其窑址以曹娥江流域为中心，涵盖上虞、余姚、绍兴、萧山等地，是中国青瓷发源地与唐代“南青北白”格局中青瓷的代表。","path":"places/yue-kiln.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"越窑作为陶瓷生产地点进入 B 维度；其唐代贡瓷与宫廷制度内容也可支持 D 维度，但当前只选定 B 为暂定主导航。Theme/Topic 尚未 materialize。"},{"id":"places:yungang-shiku","title":"云冈石窟（Yungang Grottoes）","name_en":"Yungang Grottoes","type":"place","type_zh":"地点","color":"#06B6D4","tags":["石窟寺","北魏","佛教艺术","犍陀罗风格","石刻"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_site","source_count":"5","evidence_status":"source_backed","description":"云冈石窟位于山西大同西北武州山，因山势连绵如云而得“云冈”之名。北魏道武帝拓跋珪于398年定都平城（大同）后开凿，现存大中小石窟编号53个、大小佛像51000躯以上；因凿于流沙岩层，风化腐蚀严重。李立新将其与敦煌、龙门、麦积山、响堂山、栖霞山并列为石窟寺，窟前建木构殿阁。","path":"places/yungang-shiku.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"云冈石窟是 B 维度下北朝石窟寺与石刻造物条目。Theme/Topic 尚未 materialize。"},{"id":"places:zenghouyi-tomb","title":"曾侯乙墓（Tomb of Marquis Yi of Zeng）","name_en":"Tomb of Marquis Yi of Zeng","type":"place","type_zh":"地点","color":"#06B6D4","tags":["战国早期","青铜器","编钟","漆器","天象图"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_site","source_count":"2","evidence_status":"source_backed","description":"曾侯乙墓位于湖北随县，1978年5月出土战国早期青铜器群，数量多、品种全；墓中曾侯乙编钟65枚，铜尊、铜盘透空附饰纤细齐整。李立新另记墓中出土漆衣箱天象图，原文未记墓葬地点。","path":"places/zenghouyi-tomb.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"曾侯乙墓是 B 维度下战国青铜与漆器造物条目。Theme/Topic 尚未 materialize。"},{"id":"places:zhoukoudian-site","title":"周口店遗址（Zhoukoudian Site）","name_en":"Zhoukoudian Site","type":"place","type_zh":"地点","color":"#06B6D4","tags":["旧石器时代","北京人","山顶洞人","用火","石制品"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_site","source_count":"2","evidence_status":"source_backed","description":"周口店遗址是北京房山的石灰岩山洞遗址，约50万年前的“北京人”（中国猿人）与17000多年前的“山顶洞人”均发现于此，是旧石器时代石器与用火材料的重要出土地。李立新记第一地点十年发掘的石制品（石器、石片、原料）达10万件，是“北京人模式”的依据。","path":"places/zhoukoudian-site.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"周口店遗址是 B 维度下旧石器时代石器与用火证据条目。Theme/Topic 尚未 materialize。"},{"id":"procedures:chuihui-fa","title":"吹灰法（Cupellation）","name_en":"Cupellation","type":"procedure","type_zh":"程序","color":"#EC4899","tags":["唐代","炼银","灰窠","金属提纯"],"confidence":"medium","consensus":"tentative","sub_type":"metalworking_technique","source_count":"2","evidence_status":"source_backed","description":"吹灰法是唐代已广泛应用的炼银工艺，现存唐代炼银渣块表明其提高了银的纯度和回收率。田自秉记其具体做法：用上等炉灰作成灰窠，将含银铅砣置于窠中加热熔化，铅入灰中，纯银留存灰窠上；出土银器测定纯度很高。","path":"procedures/chuihui-fa.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"吹灰法是 B 维度下唐代炼银提纯工序的条目。Theme/Topic 尚未 materialize。"},{"id":"procedures:daolian-fa","title":"捣练法（Silk Scouring by Pounding）","name_en":"Silk Scouring by Pounding","type":"procedure","type_zh":"程序","color":"#EC4899","tags":["汉代","丝精练","脱胶","草木灰"],"confidence":"medium","consensus":"tentative","sub_type":"textile_technique","source_count":"2","evidence_status":"source_backed","description":"捣练法是汉代丝的精练方法，据班婕妤《捣练赋》所述，已能利用砧杵的机械作用和草木灰的化学作用相结合。这种方法提高了生丝的脱胶效率，缩短了工艺时间。","path":"procedures/daolian-fa.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"捣练法是 B 维度下汉代丝精练工序条目。Theme/Topic 尚未 materialize。"},{"id":"procedures:diaoban-yinshua","title":"雕版印刷（Woodblock Printing）","name_en":"Woodblock Printing","type":"procedure","type_zh":"程序","color":"#EC4899","tags":["唐代","宋代","佛经","宋版书","版画"],"confidence":"medium","consensus":"tentative","sub_type":"printing_technique","source_count":"2","evidence_status":"source_backed","description":"雕版印刷是唐代发明、宋代成熟的印刷技术。赵农记其因佛经的广布而风行，现存雕版印刷作品是唐咸通九年（868）的《金刚经》卷，印刷精美、技术成熟；中晚唐开始民间大量印刷生活实用书籍，并称隋唐时期雕版印刷术的出现与文字书写的规范化有很大关系。2016 版记宋版书书写刻印精美、形成时代特色，从版式、字体、用纸、插图四方面概括其特点。","path":"procedures/diaoban-yinshua.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"雕版印刷是 C 维度下唐宋印刷技术条目。Theme/Topic 尚未 materialize。"},{"id":"procedures:fenzhu-fa","title":"分铸法（Sectional Casting）","name_en":"Sectional Casting","type":"procedure","type_zh":"程序","color":"#EC4899","tags":["青铜铸造","商周","合范法","浑铸法","焊接"],"confidence":"medium","consensus":"tentative","sub_type":"metalworking_technique","source_count":"4","evidence_status":"source_backed","description":"分铸法是把器物上过分复杂或突出的部件先单独铸出、再与主体合铸的青铜铸造方法，与“一次铸成”的浑铸法相对。四册来源都在合范法的框架内提到它，但**对它与浑铸法、焊接法的先后关系给出两套不相容的说法**：田自秉作“浑铸→分铸→焊接”三段递进，李立新作“分铸法最初是浑铸……后改为焊接”，把分铸法的起点放回浑铸。本 KU 把两套说法并列，不裁定先后。","path":"procedures/fenzhu-fa.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"分铸法是 B 维度下商周青铜铸造工序分化的关键环节，其成立与否直接决定器物附件能否脱离主体范型单独成形。Theme/Topic 尚未 materialize。"},{"id":"procedures:jiazhu-tai","title":"夹纻胎（Jiazhu Lacquer Body）","name_en":"Jiazhu Lacquer Body","type":"procedure","type_zh":"程序","color":"#EC4899","tags":["战国","漆器","纻麻","脱胎法","胎骨"],"confidence":"medium","consensus":"tentative","sub_type":"lacquerware_technique","source_count":"4","evidence_status":"source_backed","description":"夹纻胎是战国时期出现的漆器胎体工艺：以纻麻为胎骨，用生漆将纻麻逐层贴在泥或木胎上形成外胎，干实后去掉内胎，再加以髹漆。其原理相当于后世“脱胎法”，是脱胎漆器的前身，胎体轻巧牢固，被视为中国漆器工艺的独特创造。","path":"procedures/jiazhu-tai.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"夹纻胎是 B 维度下战国漆器胎骨成形工艺条目。Theme/Topic 尚未 materialize。"},{"id":"procedures:jinyin-pingtuo","title":"金银平脱（Gold and Silver Pingtuo Inlay）","name_en":"Gold and Silver Pingtuo Inlay","type":"procedure","type_zh":"程序","color":"#EC4899","tags":["唐代","漆艺","金银工艺","铜镜装饰"],"confidence":"medium","consensus":"tentative","sub_type":"lacquer_technique","source_count":"5","evidence_status":"source_backed","description":"金银平脱是唐代盛行的漆器装饰工艺：把金银薄片剪刻成花纹，粘贴在髹漆胎体上，再加髹漆数层，最后研磨推光，使金银花纹与漆底齐平并显露出来。五册来源有直接记载（李立新全书未见此项），但\"平脱\"与\"贴金银／包金银\"是否同一工艺，来源间存在实质分歧。","path":"procedures/jinyin-pingtuo.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"金银平脱是 B 维度下唐代漆器装饰技法的代表工序，同时牵涉铜镜装饰与金银器工艺的交叉。Theme/Topic 尚未 materialize。"},{"id":"procedures:liujin","title":"鎏金（Amalgam Gilding）","name_en":"Amalgam Gilding","type":"procedure","type_zh":"程序","color":"#EC4899","tags":["战国","金汞齐","铜器装饰","镀金"],"confidence":"medium","consensus":"tentative","sub_type":"metalworking_technique","source_count":"2","evidence_status":"source_backed","description":"鎏金是把金溶于水银形成金汞齐、涂于铜器表面后加热使水银蒸发、金固着于器表的镀饰工艺，又称火镀金。赵农记战国中期鎏金技术已应用于制器；田自秉记其操作为将金箔剪碎入坩埚加热、按一比七比例加入水银熔成金泥，蘸盐、矾等物涂于铜器，经炭火温烤使水银蒸发。","path":"procedures/liujin.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"鎏金是 B 维度下战国金属镀饰工艺条目。Theme/Topic 尚未 materialize。"},{"id":"procedures:liuli-shaozhao","title":"琉璃烧造（Glazed Architectural Ceramics）","name_en":"Glazed Architectural Ceramics","type":"procedure","type_zh":"程序","color":"#EC4899","tags":["明清","铅釉陶器","十样","门头沟","法华器"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_technique","source_count":"2","evidence_status":"source_backed","description":"琉璃烧造是以铅釉陶器烧造建筑琉璃瓦脊、面砖和日用器皿的工艺。明代采用高岭土制胎，明清琉璃砖瓦有10种规格、称“十样”；明初南京设琉璃窑72座，迁都后移至门头沟琉璃渠村，清代与海王村琉璃厂合并为厂官窑。2016 版另记琉璃渠村用九龙山下黑格土烧造，并称其产品含建筑瓦脊、面砖与日用器皿。","path":"procedures/liuli-shaozhao.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"琉璃烧造是 B 维度下明清建筑琉璃工艺条目。Theme/Topic 尚未 materialize。"},{"id":"procedures:lost-wax-casting","title":"失蜡法（Lost-wax Casting）","name_en":"Lost-wax Casting","type":"procedure","type_zh":"程序","color":"#EC4899","tags":["青铜铸造","春秋战国","精密铸造"],"confidence":"medium","consensus":"tentative","sub_type":"metalworking_technique","source_count":"5","evidence_status":"source_backed","description":"失蜡法是以蜡制模、外敷泥范、加热排蜡后浇注铜液以获得复杂镂空铸件的一种精密铸造工艺，又称蜡模法、拔蜡法、出蜡法。五册来源都以曾侯乙墓尊盘为标志性实物，说明其在中国青铜铸造史上的技术地位。","path":"procedures/lost-wax-casting.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"失蜡法是 B 维度下精密铸造工艺的程序性锚点，其镂空效果同时决定了器物形态的可能性。Theme/Topic 尚未 materialize。"},{"id":"procedures:ni-tiao-panzhu","title":"泥条盘筑法（Coil Building）","name_en":"Coil Building","type":"procedure","type_zh":"程序","color":"#EC4899","tags":["新石器时代","陶器成形","几何印纹硬陶","变形"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_technique","source_count":"2","evidence_status":"source_backed","description":"泥条盘筑法是把泥搓成条、盘筑成器形的陶器成形工艺。田自秉记较大陶器搓成泥条盘筑成器形，或几部分相接后表里抹平修整。2016 版记几何印纹硬陶采用此法成形，器形常不甚规整，存在器身歪斜、高低不等和圆器不圆等缺陷，因高温烧成与成形工艺掌握不好而容易变形，大型器物变形概率更高。","path":"procedures/ni-tiao-panzhu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"泥条盘筑法是 B 维度下史前至先秦陶器成形工艺条目。Theme/Topic 尚未 materialize。"},{"id":"procedures:tiefan-zhuzao","title":"铁范铸造（Iron Mold Casting）","name_en":"Iron Mold Casting","type":"procedure","type_zh":"程序","color":"#EC4899","tags":["战国","铁范","兴隆","磁县","铸造"],"confidence":"medium","consensus":"tentative","sub_type":"metalworking_technique","source_count":"2","evidence_status":"source_backed","description":"铁范铸造是我国铸造技术从泥范（陶范）铸造改进而来的金属范铸造工艺。河北兴隆、磁县出土的战国铁范有镰、锄、双镰、斧、双凿范和车具范，是目前已发现最早的金属范；铁范外形与铸件形状相似、壁厚均匀、收缩一致，可重复使用，铸件规整而少加工，有的能同时浇铸两个以上铸件，薄壁件壁厚不过3毫米。","path":"procedures/tiefan-zhuzao.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"铁范铸造是 B 维度下战国金属范铸造工艺条目。Theme/Topic 尚未 materialize。"},{"id":"procedures:zhuanlun-paizifa","title":"转轮排字法（Rotary Type Setting）","name_en":"Rotary Type Setting","type":"procedure","type_zh":"程序","color":"#EC4899","tags":["元代","王祯","木活字","排字","印刷"],"confidence":"medium","consensus":"tentative","sub_type":"printing_technique","source_count":"2","evidence_status":"source_backed","description":"转轮排字法是元代王祯发明的活字排字方法，大大减轻了排字工人的劳动强度。王祯在安徽旌德县任县尹时请木匠制作木质活字30000多个，试印自纂《大德旌德县志》，全书6万余字不到一个月印出百部。","path":"procedures/zhuanlun-paizifa.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"转轮排字法是 C 维度下元代活字排字工序条目。Theme/Topic 尚未 materialize。"},{"id":"publications:bamboo-annals","title":"竹书纪年（Bamboo Annals）","name_en":"Bamboo Annals","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["战国","编年史","夏商","盘庚迁殷","离宫别馆"],"confidence":"medium","consensus":"tentative","sub_type":"history","source_count":"2","evidence_status":"source_backed","description":"《竹书纪年》是战国时期成书的编年史。赵农引以说明夏桀“作琼宫瑶台”的推想，以及夏朝后期天降陨石、地震、伊洛枯竭等灾异；又引古本记商代“在汤灭夏以至纣之灭，二十九王，用岁四百九十六年”，“自盘庚迁殷，至纣之灭，二百七十三年更不徙都”。2016 记自盘庚迁殷至纣之亡二百五十三年、更不徙都，纣时稍大其邑，南距朝歌、北距邯郸及沙丘皆为离宫别馆。","path":"publications/bamboo-annals.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"A","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 A 维度下先秦编年史的锚点，其宫室记载同时服务 B 维度。Theme/Topic 尚未 materialize。"},{"id":"publications:cansang-cuibian","title":"蚕桑萃编（Cansang Cuibian）","name_en":"Cansang Cuibian","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["清末","卫杰","蚕书","丝织纹样","吉祥图案"],"confidence":"medium","consensus":"tentative","sub_type":"agronomic_treatise","source_count":"2","evidence_status":"source_backed","description":"《蚕桑萃编》是清末卫杰所撰的蚕书，高丰称其为我国古代篇幅最大的一部蚕书。书中记载的清代丝织品纹样按贡货、时新、官服、吏服、商服、农服、僧道服式分类列举，几乎全部体现“图必有意，意必吉祥”的装饰原则。田自秉称其为摘录清代服用织花纹样的依据，所记分贡货、时新、官服、吏服、商服、农服、僧道七类；并指出其中许多纹样不知具体形象、也有错别字。","path":"publications/cansang-cuibian.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下清末蚕桑与丝织文献的锚点，也涉及 D 维度的服色等级。Theme/Topic 尚未 materialize。"},{"id":"publications:chajing","title":"茶经（The Classic of Tea）","name_en":"The Classic of Tea","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["唐代","陆羽","茶具","茶器","越窑"],"confidence":"medium","consensus":"tentative","sub_type":"monograph","source_count":"3","evidence_status":"source_backed","description":"《茶经》是唐代陆羽所著的茶学专著，三册中都不是作为茶文化史的对象，而是作为**唐代茶具设计的文献依据**出现：高丰用它判断茶碗品第并核对法门寺出土银茶具，田自秉用它确认唐代青瓷窑口与“邢不如越”的评价，夏燕靖 2016 用它给全书结构并把它列为茶艺著作之首。**三册没有一册给出成书年代、版本或陆羽生卒**。","path":"publications/chajing.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"《茶经》在三册中都是茶具与茶器条目：茶碗品第、茶器与法门寺银茶具的对应、饮茶方式对器类的影响构成主体（B），贡茶与官督造秘色瓷属制度面（D），本书作为设计史文献的使用方式属方法面（A）为次。候选组另含夏燕靖 2009，该册全文无“茶经”“陆羽”，故不计入来源。Theme/Topic 尚未 materialize。"},{"id":"publications:changwu-zhi","title":"长物志（Zhang Wu Zhi）","name_en":"Zhang Wu Zhi","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["明代","文震亨","室内设计","园林","陈设"],"confidence":"medium","consensus":"tentative","sub_type":"monograph","source_count":"6","evidence_status":"source_backed","description":"《长物志》是明末文震亨所撰的十二卷笔记体著作，六册来源一致把它当作理解明代文人园林室内陈设设计的核心理论文本。六册的用法分三层：高丰把它读作室内环境设计专著并大量引录原文；夏燕靖两版概括其\"以用为本\"的思想取向（2016 另补\"长物\"的典源与文人品格读法）；赵农提炼其\"宁古勿时\"的审美取向，田自秉则从陶瓷史角度记其载有柴窑材料。李立新一册仅见于参考文献，不支撑内容论断。","path":"publications/changwu-zhi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"《长物志》在六册中被用作文人园林室内陈设的设计理论文本，归 B 维度造物与工艺理论；其“以用为本”的读法另涉器物观念。Theme/Topic 尚未 materialize。"},{"id":"publications:chengshi-moyuan","title":"程氏墨苑（Chengshi Moyuan）","name_en":"Chengshi Moyuan","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["明代","万历","徽州","程大约","丁云鹏"],"confidence":"medium","consensus":"tentative","sub_type":"reference_work","source_count":"5","evidence_status":"source_backed","description":"《程氏墨苑》是明万历年间徽州程大约（滋兰堂）刊行的墨谱，在五册中一律作为**中国彩色套印的最早标本**出现。五册的分工是：夏燕靖两版给年份与中西比较，高丰给套印色数与具体图例，李立新给刻工姓名，赵农给编纂、绘画、刻工三者的分工。**五册没有一册说明本书的墨样内容、卷册结构或与《方氏墨谱》的关系**。","path":"publications/chengshi-moyuan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"《程氏墨苑》在五册中都是印刷技术条目：四色、五色套印与“比欧洲早百余年”的比较构成主体（C），徽州刻工、滋兰堂刊行与出版组织属 D，墨谱本身的墨样与图样属 B 为次。Theme/Topic 尚未 materialize。"},{"id":"publications:chuantong-gongyi-meishu-baohu-tiaoli","title":"传统工艺美术保护条例（Regulations on the Protection of Traditional Arts and Crafts）","name_en":"Regulations on the Protection of Traditional Arts and Crafts","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["1997","国务院","工艺美术","保护条例","制度"],"confidence":"medium","consensus":"tentative","sub_type":"regulation","source_count":"2","evidence_status":"source_backed","description":"《传统工艺美术保护条例》是 1997 年 5 月由国务院颁布的法规，规定国家对传统工艺美术品种和技艺实行保护、发展、提高的方针，地方各级政府应采取措施扶持。此后江苏、河北、浙江、上海、北京、广东、四川、安徽、重庆等九省市先后制定地方条例；2006 年依据该条例评出 161 名新一届中国工艺美术大师。","path":"publications/chuantong-gongyi-meishu-baohu-tiaoli.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 D 维度下工艺美术保护制度的文献锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:chuci","title":"楚辞（Chuci）","name_en":"Chuci","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["先秦","屈原","宋玉","器物","羽觞"],"confidence":"medium","consensus":"tentative","sub_type":"anthology","source_count":"2","evidence_status":"source_backed","description":"《楚辞》是与《诗经》并举的文学作品集，被赵农视为反映春秋战国时期器具在生活、战争中状态的资料性文献；他认为文学的情节性描写有助于还原《周礼》等典籍中器具的应用情景。田自秉多次引用《楚辞》：以“集芙蓉以为裳”“临曲池些，芙蓉始发”等句论证四叶纹可能为荷花；以“瑶浆密勺，实羽觞些”说明羽觞为饮器；以“陆离”一词联系琉璃；并在结语中以《楚辞》“回荡法”与战国工艺缠绕穿插的装饰风格相比。","path":"publications/chuci.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下先秦器物文献的锚点，也涉及 C 维度的纹样解释。Theme/Topic 尚未 materialize。"},{"id":"publications:daodejing","title":"道德经（Daodejing）","name_en":"Daodejing","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["春秋","老子","无为","埏埴以为器","有器之用"],"confidence":"medium","consensus":"tentative","sub_type":"classical_text","source_count":"2","evidence_status":"source_backed","description":"《道德经》是老子所著的道家经典，主张“无为”的行为，符合“道”的规律。赵农举书中“埏埴以为器”“当其无，有器之用”“朴散则为器”“大器晚成”“民多利器”等器具议论，视为艺术设计的精神资源。2016 记其分《道经》37 章、《德经》，是我国历史上首部完整哲学著作，其民本与契约思想与设计民本意识相联系。","path":"publications/daodejing.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"A","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 A 维度下先秦造物思想文献的锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:dianshizhai-huabao","title":"点石斋画报（Dianshizhai Pictorial）","name_en":"Dianshizhai Pictorial","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["1884","石版印刷","上海","画报","书籍装帧"],"confidence":"medium","consensus":"tentative","sub_type":"pictorial","source_count":"2","evidence_status":"source_backed","description":"《点石斋画报》是 1884 年由点石斋印书局石版印刷的上海画报。它与《申报》、同文书局出版的绣像小说、《吴友如画报》等一起改变了我国书籍装帧设计的面貌。","path":"publications/dianshizhai-huabao.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 C 维度下近代画报的文献锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:dongjing-menghua-lu","title":"东京梦华录（Dongjing Menghua Lu）","name_en":"Dongjing Menghua Lu","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["北宋","开封","城市史","商业","民俗"],"confidence":"medium","consensus":"tentative","sub_type":"monograph","source_count":"3","evidence_status":"source_backed","description":"《东京梦华录》是北宋孟元老追忆东京汴梁繁盛的城市笔记。三册对它的用法与写法分层明显：夏燕靖两版给了两份彼此不重合的条目（正文一处、书末知识链接一处），赵农一册只在正文里把它当作街市、夜市、瓦舍与园林四组数据的取证来源，并另在参考文献列出李士彪注本。三册均不给全书卷目的完整结构，也不引原书序文全文。","path":"publications/dongjing-menghua-lu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"《东京梦华录》在六册中不是工艺专著，而是被反复征引的都市史料：行户、夜市、瓦舍、服饰与幌子诸条都靠它取证，故归主维度 D（商业、制度与设计教育），其服饰与市招的记述兼及 B（造物）与 A（史料方法）。Theme/Topic 尚未 materialize。"},{"id":"publications:gegu-yaolun","title":"格古要论（Gegu Yaolun）","name_en":"Gegu Yaolun","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["明代","曹昭","王佐","鉴赏","青花"],"confidence":"medium","consensus":"tentative","sub_type":"connoisseurship_treatise","source_count":"2","evidence_status":"source_backed","description":"《格古要论》是明代曹昭所撰、王佐增补的古物鉴赏专著，3 卷。全书分古铜器、古画、古墨迹、古碑法帖、古琴、古砚、珍奇、金铁、古窑器、古漆器、锦绮、异木、异石诸论，记青花及彭均（君）宝仿定等窑口。高丰将其列入明代手工业设计专著群。","path":"publications/gegu-yaolun.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下明代鉴赏文献的锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:guanzi","title":"管子（Guanzi）","name_en":"Guanzi","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["先秦","管仲","齐国","工具","城市选址"],"confidence":"medium","consensus":"tentative","sub_type":"classical_text","source_count":"2","evidence_status":"source_backed","description":"《管子》是先秦典籍，相传为春秋时期齐国政治家管仲的著作，今存 76 篇；2016 称其为战国时各学派言论汇编，内容庞杂，包括法家、儒家、道家、阴阳家、名家、兵家和农家观点，传说根本为春秋初期管仲言论。赵农引《管子·轻重乙》说明农、车、女所需工具：齐国种田男子必须有一犁、一耙、一把锄等，造车木匠必须有斧、锯、锥、凿等，妇女必须有针、刀等；又引《管子·乘马》“凡立国都，非于大山之下必于广川之上……”说","path":"publications/guanzi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"A","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 A 维度下先秦造物与城市思想文献的锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:gujin-tushu-jicheng","title":"古今图书集成（Gujin Tushu Jicheng）","name_en":"Gujin Tushu Jicheng","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["清代","类书","铜活字","宋体字","插图"],"confidence":"medium","consensus":"tentative","sub_type":"reference_work","source_count":"3","evidence_status":"source_backed","description":"《古今图书集成》是清代内府用铜活字排印的大型类书，也是六册中唯一被反复用来标定“铜活字印刷最高成就”的书。三册对它的取材同为印刷技术条目，但取舍不同：高丰给它字数、册数、字体与插图四项，赵农给卷数、字数、册数、函数、印数与性质定位，夏燕靖 2016 只给卷数、册数、印数与排印年。三册都不记编纂者、成书经过与全书部类结构。","path":"publications/gujin-tushu-jicheng.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"《古今图书集成》在三册中都是印刷技术条目：铜活字排印、铜活字宋体字、雕版插图三类事实构成其主体，故归主维度 C（视觉传达与文字设计）；其官修性质与内府刻书规模属 D，开本与装帧材料属 B。Theme/Topic 尚未 materialize。"},{"id":"publications:haiguo-tuzhi","title":"海国图志（Haiguo Tuzhi）","name_en":"Haiguo Tuzhi","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["晚清","魏源","世界地理","变法","仿造"],"confidence":"medium","consensus":"tentative","sub_type":"geography","source_count":"2","evidence_status":"source_backed","description":"《海国图志》是晚清魏源的著作，书中初步介绍了西方民主政治制度，赵农将其作为魏源放眼世界、主张变法的著述依据。李立新记其建议仿造量天尺、千里镜、龙尾车、风锯、水锯、火轮机、火轮舟、自来火、自转礁、千斤秤等“有益民用者”。","path":"publications/haiguo-tuzhi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"E","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 E 维度下晚清西器东传文献的锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:hanfeizi","title":"韩非子（Han Feizi）","name_en":"Han Feizi","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["战国","韩非","法家","买椟还珠","反文饰"],"confidence":"medium","consensus":"tentative","sub_type":"classical_text","source_count":"2","evidence_status":"source_backed","description":"《韩非子》是战国末年思想家韩非的著作，韩非是荀子的学生，后以法家思想著称。他反对文饰、崇尚功用，以器具说明思想，如“买椟还珠”（《韩非子·外储说左上》）的故事从侧面反映物品的用途和装饰的意义；又引“竽先，则钟瑟皆随；竽唱，则诸乐皆和”。2016 引《韩非·五蠹篇》“古者丈夫不耕，草木之实足食也；妇人不织，禽兽之皮是衣也”，用以说明纺织品出现以前的衣着状况；并称其提出“法”“术”“势”相结合的法治理","path":"publications/hanfeizi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"A","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 A 维度下先秦造物思想文献的锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:jieziyuan-huazhuan","title":"芥子园画传（Jieziyuan Huazhuan）","name_en":"Jieziyuan Huazhuan","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["清代","画谱","短版套印","王概","中国画教材"],"confidence":"medium","consensus":"tentative","sub_type":"print_album","source_count":"2","evidence_status":"source_backed","description":"《芥子园画传》是清康熙至嘉庆年间刻印的画谱，采用明代创造的短版套印工艺并有所发展。它由李渔女婿请画家王概等人编绘，初期有山水卷、梅兰竹菊卷、草虫花鸟卷，后来加进人物卷；整部书编辑详备、体例得当、印制清晰、文风典雅，是清代以来中国画学的基础课本。","path":"publications/jieziyuan-huazhuan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 C 维度下清代画谱的文献锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:jifufu","title":"机妇赋（Jifu Fu）","name_en":"Jifu Fu","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["东汉","王逸","提花机","织造","赋"],"confidence":"medium","consensus":"tentative","sub_type":"rhapsody","source_count":"2","evidence_status":"source_backed","description":"《机妇赋》是东汉王逸所作赋文，以文学语言描绘提花机生产情形。李立新引“兔耳跄伏……猛犬相守……高楼双峙，下临清池”，并释兔耳、猛犬、高楼为提花机部件；2016 引作“兔耳踆伏，若安若危。猛犬相守，窜身匿蹄。高楼双峙，下临清池。游鱼衔饵，瀲澔其陂”。","path":"publications/jifufu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下汉代织机文献的锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:jingshi-dadian","title":"经世大典（Jingshi Dadian）","name_en":"Jingshi Dadian","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["元代","官修","建筑制度","工典","奎章阁"],"confidence":"medium","consensus":"tentative","sub_type":"official_compendium","source_count":"2","evidence_status":"source_backed","description":"《经世大典》是元代官方编纂的政书，又名《皇朝经世大典》，元文宗至顺元年由奎章阁学士院编纂，赵世延总撰、虞集副总撰，次年 5 月成书；全书 880 卷、目录 12 卷，分君事 4 篇、臣事 6 篇，工典列 22 目，保存元代建筑与工艺制度。夏燕靖 2009 称其记述元代建筑的详细方式，使这一时期的建筑特色得以流传，并把它作为建筑兴盛促进较完整建筑学著作出现的例证。","path":"publications/jingshi-dadian.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下元代官修营造文献的锚点，也涉及 D 维度的官修制度。Theme/Topic 尚未 materialize。"},{"id":"publications:kaogongji-tu","title":"考工记图（Kaogongji Tu）","name_en":"Kaogongji Tu","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["清代","戴震","考工记","图录","尺度"],"confidence":"medium","consensus":"tentative","sub_type":"illustrated_treatise","source_count":"2","evidence_status":"source_backed","description":"《考工记图》是清代戴震对《考工记》的自注并绘图说明，为清乾隆年间《戴氏遗书》所收。戴震对《考工记》中的礼乐、车舆、宫室、武器等进行图录式说明，对后人正确理解《考工记》内容有一定指导意义。李立新引其中“考工诸篇，高庫广狭有度”，以说明“度”兼为尺度与适度。","path":"publications/kaogongji-tu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下清代《考工记》研究文献的锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:kaogongji","title":"考工记（Kaogongji）","name_en":"Kaogongji","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["工艺典籍","先秦","百工","齐国官书"],"confidence":"medium","consensus":"tentative","sub_type":"monograph","source_count":"6","evidence_status":"source_backed","description":"《考工记》是先秦工艺文献，今本通常作为《周礼》的一部分流传，故又称《周礼·考工记》或《周礼·冬官考工记》。它系统记载百工分工、器物形制、材料选择与工艺规范，是六册来源共同引用、用以说明中国早期造物与设计制度的核心文本。","path":"publications/kaogongji.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"只在 pilot 维度 B 下完成暂定主导航；Theme 与 Topic 尚未 materialize，故 primary_theme 与 topic_memberships 留空。该缺口是研究债务，不是已完成的层级映射。"},{"id":"publications:liangyou","title":"良友（Liangyou）","name_en":"Liangyou","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["1926","上海","画报","明星广告","月份牌"],"confidence":"medium","consensus":"tentative","sub_type":"pictorial","source_count":"2","evidence_status":"source_backed","description":"《良友》是 1926 年 2 月创刊的大型画报，以令人耳目一新的形式轰动上海滩。它曾聘请郑君里作美丽牌香烟广告、白杨作美勃丹化妆品广告、兰心作宝昌首饰广告、王人美作广东兄弟橡皮公司球鞋广告，明星效应使商品成为二三十年代上海抢手品牌。","path":"publications/liangyou.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 C 维度下近代画报广告的锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:lidai-minghua-ji","title":"历代名画记（Lidai Minghua Ji）","name_en":"Lidai Minghua Ji","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["唐代","张彦远","画史","宣纸","瑞锦宫绫"],"confidence":"medium","consensus":"tentative","sub_type":"treatise","source_count":"2","evidence_status":"source_backed","description":"《历代名画记》是唐代张彦远所著画史文献。张彦远是唐代晚期人，曾在咸通三年任舒州刺史。书中记“江南地润无尘，人多精艺”“好事家宜置宣纸百幅，用法蜡之，以备摹写”，说明纸张在当时的使用状态；又记初唐益州艺匠窦师纶所织锦绫有双雉、斗羊、翔凤、游麟等图案，即“瑞锦”“宫绫”。","path":"publications/lidai-minghua-ji.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下唐代工艺史料的文献锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:liji","title":"礼记（Liji）","name_en":"Liji","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["先秦","礼制","服饰等级","深衣","器物等级"],"confidence":"medium","consensus":"tentative","sub_type":"classical_text","source_count":"2","evidence_status":"source_backed","description":"《礼记》是先秦礼制文献。田自秉引其规定天子龙衮、诸侯黼、大夫黻、士玄衣纁裳及天子之豆二十六等服饰器物等级，说明周代等级制在服饰器物上的体现。夏燕靖 2016 两引《礼运篇》：以“未有麻丝，衣其羽皮”说明纺织出现前的衣着，以“昔者先王，未有宫窑，冬则居管窑，夏则居槽巢……”（原文如此，疑有 OCR 异文）说明原始穴居、巢居；并记《礼记》有深衣篇载制作规范，《礼记·玉藻》称深衣为诸侯大夫家居便服、庶人","path":"publications/liji.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 D 维度下先秦礼制文献的锚点，其服饰与居住材料亦服务 B 维度。Theme/Topic 尚未 materialize。"},{"id":"publications:lubanjing","title":"鲁班经（Luban Jing）","name_en":"Luban Jing","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["明代","木工","营造","家具","匠家镜"],"confidence":"medium","consensus":"tentative","sub_type":"craft_manual","source_count":"2","evidence_status":"source_backed","description":"《鲁班经》是明代刊行的民间木工行业技术书籍，全称《鲁班经匠家镜》，2016 记其原名《工师雕新正式鲁班木经匠家镜》或《鲁班经匠家镜》，是我国古代营造房屋和日常生活用具的实用指南通书。该书对房舍施工构筑、建筑工具和定位技术、常用建筑的类型尺寸以及生活工具、家具的形制都有详细说明；2016 记其图 1 卷、文 3 卷，并称有说系年荣汇编的托名之作。","path":"publications/lubanjing.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下明代民间匠作文献的锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:lunyu","title":"论语（Lunyu）","name_en":"Lunyu","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["春秋","孔子","语录体","文质彬彬","工欲善其事"],"confidence":"medium","consensus":"tentative","sub_type":"classical_text","source_count":"2","evidence_status":"source_backed","description":"《论语》是孔子弟子及再传弟子编撰的语录体经典，记孔子及其弟子言行。赵农引其论器与论服饰颜色的言论，如“工欲善其事，必先利其器”（《论语·卫灵公》）、“君子不器”（《论语·为政》）、“质胜文则野，文胜质则史”“文质彬彬”（《论语·雍也》）；2016 称其“文质观”具审美意蕴。","path":"publications/lunyu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"A","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 A 维度下先秦造物思想文献的锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:luoxuan-biangu-jianpu","title":"萝轩变古笺谱（Luoxuan Biangu Jianpu）","name_en":"Luoxuan Biangu Jianpu","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["明代","吴发祥","恒版拱花","饾版","笺谱"],"confidence":"medium","consensus":"tentative","sub_type":"print_album","source_count":"2","evidence_status":"source_backed","description":"《萝轩变古笺谱》是明代笺谱，1626 年刊刻。李立新记吴发祥用“恒版拱花”印制，是明代印刷设计的重要例证；2016 称其为现存最早的饾版、拱花印本。","path":"publications/luoxuan-biangu-jianpu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 C 维度下明代笺谱的文献锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:lvshi-chunqiu","title":"吕氏春秋（Lüshi Chunqiu）","name_en":"Lüshi Chunqiu","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["战国","杂家","吕不韦","乐器","青铜器纹样"],"confidence":"medium","consensus":"tentative","sub_type":"classic","source_count":"6","evidence_status":"source_backed","description":"《吕氏春秋》是战国末年秦国吕不韦门客集体编纂的杂家著作，又名《吕览》。**六册全部引用**，是六册中覆盖面最宽的先秦文献之一。但六册的用法彼此几乎不重叠：高丰与田自秉用它给青铜器纹样定名，赵农用它取乐器起源、城市与邑制、云梯战例，夏燕靖两版用它取车战规模，李立新用它校读“大器免成”的语义，夏燕靖 2016 另用它取工艺制度语汇。全书篇数、十二纪月令结构与编纂经过，六册均不记。","path":"publications/lvshi-chunqiu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"《吕氏春秋》在六册中的用法可归四簇：青铜器纹样定名（高丰、田自秉）、乐器起源（赵农）、车战规模（夏燕靖两版）、城市与工艺制度语汇（赵农、夏燕靖 2016），另李立新以“成”的二解作造物训诂。四簇中三簇落在造物与工艺一侧，故归主维度 B；A 与 D 为次。Theme/Topic 尚未 materialize。"},{"id":"publications:makeboluo-youji","title":"马可·波罗游记（The Travels of Marco Polo）","name_en":"The Travels of Marco Polo","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["元代","马可·波罗","游记","中西交流","大都"],"confidence":"medium","consensus":"tentative","sub_type":"monograph","source_count":"5","evidence_status":"source_backed","description":"《马可·波罗游记》是五册共用的**域外史料**：田自秉用它证琉璃瓦与金锦采运，高丰用它证元代金银器之盛，夏燕靖两版用它证西夏毛织、质孙服与大都市制，赵农用它证海外贸易、造船、大都人口与卢沟桥。两册另为本书立了专条（夏燕靖 2009、2016）。**五册对作者生平、书名与成书方式的记载差别最大**，是本批中“同一书在不同册中面貌不同”最明显的一例。","path":"publications/makeboluo-youji.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"《马可·波罗游记》在五册中是元代造物与城市的域外史料：金银器、驼毛布、质孙服与金锦、琉璃瓦、造船、卢沟桥构成主体（B），大都的街巷、坊数、市集与“百物输入”属商业与城市制度面（D），引起欧洲对东方的向往与中西交流史价值属跨文化面（E）为次。李立新册中的“波罗子”是法门寺器物名，与本条无关，已排除。Theme/Topic 尚未 materialize。"},{"id":"publications:menglianglu","title":"梦粱录（Mengliang Lu）","name_en":"Mengliang Lu","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["南宋","吴自牧","临安","商业","夜市"],"confidence":"medium","consensus":"tentative","sub_type":"miscellany","source_count":"3","evidence_status":"source_backed","description":"《梦粱录》是南宋吴自牧所著笔记，成书于南宋末年，20 卷 169 目，体例仿《东京梦华录》。全书叙临安（今浙江杭州）繁华，详记淳佑至咸淳（1241—1274）社会风貌，保存不少民俗民艺材料。书中“铺席”节记杭州茶坊、酒肆、面店、果子、彩帛、绒线、香烛、油酱、食米、下饭鱼内鳖腊等铺，“夜市”节记杭城大街买卖昼夜不绝，并记瓦舍定义、影戏羊皮雕形与傀儡戏。","path":"publications/menglianglu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 D 维度下南宋城市商业文献的锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:mengxi-bitan","title":"梦溪笔谈（Mengxi Bitan）","name_en":"Mengxi Bitan","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["北宋","沈括","透光镜","铸鉴","科技文献"],"confidence":"medium","consensus":"tentative","sub_type":"miscellany","source_count":"2","evidence_status":"source_backed","description":"《梦溪笔谈》是北宋沈括所著的百科全书式著作，共 609 条，涉及面非常广泛，是中国古代科学技术和艺术设计史方面的重要文献。田自秉引其论透光镜“世有透光鉴（镜）……”及铸时薄处先冷、背文差厚后冷铜缩多的解释，用以说明透光镜原理；又引其论铸鉴“鉴大则平，鉴小则凸”，说明唐镜镜面微凸可照全人面的光学原理。","path":"publications/mengxi-bitan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下宋代科技文献的锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:mengzi","title":"孟子（Mengzi）","name_en":"Mengzi","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["战国","儒家","规矩准绳","造物规范","民本"],"confidence":"medium","consensus":"tentative","sub_type":"classic","source_count":"4","evidence_status":"source_backed","description":"《孟子》是战国中期孟轲及其门人著述的儒家经典。四册对它的用法集中在两处：一是把“规矩”“准绳”这类造物语汇引入儒家规范论，二是把“与民同乐”“民为贵”的民本观读作设计应以民为本。赵农是唯一大量按篇引用的来源（滕文公上／下、公孙丑上、梁惠王上／下、离娄上），且另记《孟子》入十三经的经过；李立新是唯一给出篇名与另一套引文用字的来源。**本条只写典籍**，孟轲其人的生卒、身份与学派位置见 `person","path":"publications/mengzi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"A","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"《孟子》在四册中的设计史价值有两簇：其一，把“规矩”“准绳”这类造物语汇引入儒家规范论（李立新、赵农），属 A；其二，“与民同乐”“民为贵”的民本观被读作设计应以民为本（赵农、田自秉、夏燕靖 2016），属 D 与 A 之间。器物层面的用鼎等级、弋射、箪食壶浆散见于赵农、田自秉，归 B 为次。Theme/Topic 尚未 materialize。"},{"id":"publications:mo-jing","title":"墨经（Mo Jing）","name_en":"Mo Jing","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["战国","墨家","墨翟","几何学","力学"],"confidence":"medium","consensus":"tentative","sub_type":"classic","source_count":"3","evidence_status":"source_backed","description":"《墨经》是战国前期记载墨家学说的著作，三册都把它与《考工记》并置，作为先秦造物科学知识的第二极。三册的取材分工清晰：夏燕靖两版给总论与几何、力学条目，赵农给三条具体原理的原文（秤、滑轮、车梯）。本书的**边界**在三册中并不一致：夏燕靖两版正文把几何、光学、力学全数归入《墨经》，夏燕靖 2016 的书末条目却把“墨经”限定为六篇论认识论与逻辑的篇目，并把工艺思想另归《墨子·节用》。","path":"publications/mo-jing.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"《墨经》在三册中都是“造物的科学知识”条目：几何概念、力学条目、杠杆与滑轮、车梯原理构成主体，故归主维度 B；其“可与《考工记》相媲美”的定位属史学评价，归 A 为次。Theme/Topic 尚未 materialize。"},{"id":"publications:qiminyaoshu","title":"齐民要术（Qimin Yaoshu）","name_en":"Qimin Yaoshu","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["北魏","贾思勰","农书","潢纸","手工艺"],"confidence":"medium","consensus":"tentative","sub_type":"agronomic_treatise","source_count":"2","evidence_status":"source_backed","description":"《齐民要术》是北魏农学家贾思勰所著，是我国现存最完整的古代农书之一，约写于东魏武定二年（544）以后（一说 533—544 年）；全书 10 卷 92 篇，记黄河流域下游农业生产，涉及园艺、造林、蚕桑、畜牧、酿造、烹饪、储备、治荒等，引古籍 200 余种，其中许多内容记述古代手工艺。赵农引其潢纸之法：“凡潢纸，灭白便是。不宜太深，深色年旧色暗也”，据此说明当时人们对造纸、染纸及使用已有深入认识。","path":"publications/qiminyaoshu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下北魏农工文献的锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:qingmi-cang","title":"清秘藏（Qingmi Cang）","name_en":"Qingmi Cang","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["明代","张应文","张谦德","鉴赏","玩好"],"confidence":"medium","consensus":"tentative","sub_type":"connoisseurship_treatise","source_count":"2","evidence_status":"source_backed","description":"《清秘藏》是明代张应文所撰、其子张谦德润色的古物鉴赏专著，2 卷。上卷 20 门、下卷 10 门，杂论玩好赏鉴诸物，是我国古代工艺美术鉴赏著作。高丰将其列入明代手工业设计专著群。","path":"publications/qingmi-cang.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下明代鉴赏文献的锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:shanhai-jing","title":"山海经（Shan Hai Jing）","name_en":"Shan Hai Jing","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["先秦","地理志","神话","夔纹","凤皇"],"confidence":"medium","consensus":"tentative","sub_type":"classic","source_count":"5","evidence_status":"source_backed","description":"《山海经》是先秦的地理与神话名物之书，五册（夏燕靖 2009 除外）都引用它，但**没有两册引同一段**：高丰引夔与奚仲造车，田自秉引夔与鸾鸟，赵农引凤皇与地理著述，李立新引“人身龙面”山神，夏燕靖 2016 只引铁矿山一处。五册的引用都属**以书证物**，而不讨论本书本身的性质、篇目与成书。成书年代只有夏燕靖 2016 一册给出（战国）。","path":"publications/shanhai-jing.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"《山海经》在五册中不是工艺专著，而是被征引的**名物与矿产文献**：夔、凤皇、鸾鸟三种神鸟异兽用于青铜器与铜镜纹样的释读，铁矿山一项用于冶铁规模，神怪图像一项用于春秋战国的观念背景。四册的用法都落在名物取证，故归主维度 B；图像与观念归 C、A 为次。Theme/Topic 尚未 materialize。"},{"id":"publications:shenbao","title":"申报（Shenbao）","name_en":"Shenbao","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["1872","美查","上海","报纸广告","图文广告"],"confidence":"medium","consensus":"tentative","sub_type":"newspaper","source_count":"2","evidence_status":"source_backed","description":"《申报》是 1872 年 3 月 27 日由英商美查创办于上海的报纸。创刊号上刊登广告 20 则，商品形象和推销口号并重，文字叙述趋向简洁，版式装帧颇为讲究，被视为现代图文广告的原形；2016 将其与《点石斋画报》等同列为改变我国书籍装帧设计面貌的近代出版物。","path":"publications/shenbao.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 C 维度下近代报纸广告的文献锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:shengshi-weiyan","title":"盛世危言（Shengshi Weiyan）","name_en":"Shengshi Weiyan","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["晚清","郑观应","商战","工艺教育","博览会"],"confidence":"medium","consensus":"tentative","sub_type":"reform_treatise","source_count":"2","evidence_status":"source_backed","description":"《盛世危言》是晚清郑观应的著作，提出“工艺一道，为国家致富之基。工艺既兴，物产即因之饶裕”，并主张设工艺专科、开工艺学堂、派人游学各国、设博览会以励百工。李立新记其分析洋货入华致女红失业、柏树弃为不材、冶者无事投闲，指出外国用机制故工致价廉、中国用人工故工笨价费，主张“商战”。","path":"publications/shengshi-weiyan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 D 维度下晚清工艺制度文献的锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:shiji","title":"史记（Shiji）","name_en":"Shiji","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["西汉","司马迁","纪传体","史学","战车"],"confidence":"medium","consensus":"tentative","sub_type":"history","source_count":"2","evidence_status":"source_backed","description":"《史记》是西汉司马迁所著的纪传体史书。司马迁忍辱负重、发愤著述而成，鲁迅评为“千古之绝唱，无韵之离骚”；东汉班固的《汉书》延续司马迁所开拓的史学工作，开始形成历朝断代史的著述。《史记》载武王伐纣时率战车 300 辆、近卫军 3000 人、甲士 4.5 万人，在孟津渡过黄河，是关于船只用于战争的最早记载。","path":"publications/shiji.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"A","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 A 维度下正史文献的锚点，其车船记载同时服务 B 维度。Theme/Topic 尚未 materialize。"},{"id":"publications:shijing","title":"诗经（Classic of Poetry）","name_en":"Classic of Poetry","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["先秦","诗歌总集","史料","器用","风雅颂"],"confidence":"medium","consensus":"tentative","sub_type":"classic","source_count":"6","evidence_status":"source_backed","description":"《诗经》是六册**全部引用**的典籍之一，但六册的用法完全不同：赵农把它单列为“**资料性文献**”，以四十余处引诗系统支撑农具、兵器、车马、建筑等器类；田自秉用它论雕刻工序、织锦名称与纹样形式法则；高丰取五条单证（纺织、蔽膝、车较、蓝草、广告）；夏燕靖两版取六条且两版近乎逐字相同；李立新只取“道”的语义。**六册没有一册给出成书年代、编订过程或注疏系统**，故本 KU 的重心不是文本学而是“**","path":"publications/shijing.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"《诗经》是六册全部引用的少数典籍之一，用法以“引诗证器”为主体（B）：农具、兵器、车马、建筑、服饰、丝织、乐器、饮食器、灯具、舟桥、园林、雕刻、纹样、广告共十余类；赵农的“资料性文献”定位与田自秉的形式法则类比属方法面（A），车舆服饰的等级与十三经、监本、四书五经的经典化属制度面（D）为次。Theme/Topic 尚未 materialize。"},{"id":"publications:shizhuzhai-huapu","title":"十竹斋画谱（Shizhuzhai Huapu）","name_en":"Shizhuzhai Huapu","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["明代","饾版","彩色套印","画谱","胡正言"],"confidence":"medium","consensus":"tentative","sub_type":"print_album","source_count":"2","evidence_status":"source_backed","description":"《十竹斋画谱》是明代胡正言刻印的画谱，用“恒版”（李立新）／“短版”（夏燕靖 2016）彩色套印，是明代彩色套印设计的重要例证。两处版名均疑为“饾版”之 OCR 误写，本 KU 照录原文并标注。它与《十竹斋笺谱》同为该版代表作，色彩艳丽、浓淡分明、阴阳向背酷似原画，被称为画、刻、印三绝。","path":"publications/shizhuzhai-huapu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 C 维度下明代彩色套印的文献锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:shuowen-jiezi","title":"说文解字（Shuowen Jiezi）","name_en":"Shuowen Jiezi","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["东汉","许慎","六书","文字设计","字书"],"confidence":"medium","consensus":"tentative","sub_type":"lexicographic_work","source_count":"4","evidence_status":"source_backed","description":"《说文解字》是东汉许慎编纂的字书，四册来源引用它，用法分两类：一是作为\"六书\"体系的权威出处，被高丰直接读作汉字的设计手法；二是作为名物训释的引据，被赵农、李立新、夏燕靖 2016 用来解释钺、踞、凭几、尺、缶等具体器物与尺度概念。赵农另记许慎的字号、籍贯、官职与\"五经无双许叔重\"之誉。夏燕靖 2009 与田自秉两册全书未见\"说文解字\"字样，故 source_count 为 4。","path":"publications/shuowen-jiezi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"《说文解字》在六册来源中主要作为汉字构形法则（六书）的权威出处，兼作器物名物训释的引用来源。前一条属 C 维度文字设计，后一条跨 B 维度器物考释。Theme/Topic 尚未 materialize。"},{"id":"publications:sixiu-biji","title":"丝绣笔记（Sixiu Biji）","name_en":"Sixiu Biji","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["丝绣","缂丝","织成","刺绣","工艺文献"],"confidence":"medium","consensus":"tentative","sub_type":"monograph","source_count":"2","evidence_status":"source_backed","description":"《丝绣笔记》是朱启钤辑、阚铎校的丝绣专著，上下两卷。卷上“纪闻”含锦绫、刻丝、刺绣 3 种，辑织作技法、各地纺织产品、丝帛时价、用料数量、历代丝绣制度与禁令等；卷下“辨物”含锦绫、织成、刻丝、刺绣 4 种，辑各种名锦、刻丝织物、刺绣作品、《蜀锦谱》及日本古染物等。田自秉引其说，谓缂丝与织成“是一是二，尚待论定”。","path":"publications/sixiu-biji.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下丝绣工艺文献的锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:tao-shuo","title":"陶说（Tao Shuo）","name_en":"Tao Shuo","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["清代","朱琰","陶瓷史","景德镇","仿制瓷"],"confidence":"medium","consensus":"tentative","sub_type":"monograph","source_count":"4","evidence_status":"source_backed","description":"《陶说》是清代朱琰所撰的陶瓷史，四册对它的用法分成两路：一路把它当**史料**——高丰和田自秉各自引同一句论乾隆仿制瓷，田自秉另引它评成化鸡缸杯；一路把它当**著作**——夏燕靖两版给作者、卷次结构，2016 另给初刻年份与“第一部陶瓷史”的定位。**四册都没有给朱琰的生平，也没有给成书年**（只有刻年）。","path":"publications/tao-shuo.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"《陶说》在四册中是陶瓷史与仿制瓷的文献依据：乾隆仿制瓷引文、成化鸡缸杯评语、景德镇官搭民烧构成主体（B），卷次结构与“第一部陶瓷史”的定位属著作史层面（A），官搭民烧与御窑制度属制度面（D）为次。赵农、李立新无本书条目。Theme/Topic 尚未 materialize。"},{"id":"publications:tiangong-kaiwu","title":"天工开物（Tiangong Kaiwu）","name_en":"Tiangong Kaiwu","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["明代","技术典籍","宋应星","工艺百科全书"],"confidence":"medium","consensus":"tentative","sub_type":"monograph","source_count":"6","evidence_status":"source_backed","description":"《天工开物》是明末宋应星撰写的综合性技术著作，1637 年（崇祯十年）刊行。全书分上、中、下三篇，按“贵五谷而贱金玉”的顺序记述谷物、蚕桑纺织、染色、制盐、制糖、陶瓷、冶铸、舟车、造纸、兵器、珠玉等生产全过程，被外国学者誉为“中国 17 世纪的工艺百科全书”。","path":"publications/tiangong-kaiwu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"《天工开物》是 B 维度下综合性技术典籍的锚点；其版本、卷数与插图数在来源间不一致。Theme/Topic 尚未 materialize，故层级只到 Dimension。"},{"id":"publications:wang-zhen-nongshu","title":"王祯农书（Wang Zhen Nongshu）","name_en":"Wang Zhen Nongshu","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["元代","农学","农器图谱","王祯","秧马"],"confidence":"medium","consensus":"tentative","sub_type":"monograph","source_count":"4","evidence_status":"source_backed","description":"《王祯农书》是元代王祯编撰的农学专著，四册都把它当作元代农具与农业技术的总汇。夏燕靖两版给全书结构与版本，赵农给成书背景、农器图谱的分卷与王祯本人的农具设计，高丰只取两条：一条把书名误作《农布》，一条记转轮排字盘的年份。**四册对卷数、部分名、字数的写法互不相同**，是本批分歧最密的一个条目。","path":"publications/wang-zhen-nongshu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"《王祯农书》在四册中都是农具与农业技术条目：农器图谱、搅车、经架、水力大纺车、耧锄、秧马构成主体（B），王祯的县尹身份、劝农措施、刊刻与版本属制度与流传面（D）。田自秉与李立新无本书条目。Theme/Topic 尚未 materialize。"},{"id":"publications:wujing-zongyao","title":"武经总要（Wujing Zongyao）","name_en":"Wujing Zongyao","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["北宋","军事","火药","火器","筏"],"confidence":"medium","consensus":"tentative","sub_type":"military_treatise","source_count":"2","evidence_status":"source_backed","description":"《武经总要》是北宋军事著作。赵农称其中有许多关于火器和火药制造的记录，如火药中引火球、蒺藜火球、毒药烟球的配方，已具有近代黑色火药的比例；李立新引其蒲筏、木罂、械筏的编排规范。","path":"publications/wujing-zongyao.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下宋代军事技术文献的锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:xianqing-ouji","title":"闲情偶寄（Xianqing Ouji）","name_en":"Xianqing Ouji","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["清代","李渔","居室","器玩","暖椅"],"confidence":"medium","consensus":"tentative","sub_type":"life_treatise","source_count":"2","evidence_status":"source_backed","description":"《闲情偶寄》是李渔所著，成书于 1671 年（清康熙十年），全书分声容、居室、器玩、饮馔、种植、颐养六卷。居室部论房舍构筑、窗栏图式、墙壁、联匾、山石等园林营造与室内装饰；器玩部论几椅、床帐、橱柜、箱笼、茶酒具、灯烛、笺简的设计制作。书中提出注重功能、实用第一，崇尚俭朴、创异标新，以及“宜简不宜繁，宜自然不宜雕斫”等设计思想，并记录李渔自创的暖椅与凉机。赵农称其以“机”“趣”为出发点，细致观察器物","path":"publications/xianqing-ouji.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下清代居室与器玩文献的锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:xin-qingnian","title":"新青年（New Youth）","name_en":"New Youth","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["民国","陈独秀","新文化运动","刊物","版式"],"confidence":"medium","consensus":"tentative","sub_type":"periodical","source_count":"2","evidence_status":"source_backed","description":"《新青年》是陈独秀宣传“民主”和“科学”、倡导新文化运动的阵地，积聚了当时一批文化精英。2016 将其版式与《域外小说集》、严复《天演论》及当时刊印的书刊并列为同一种设计形式，并以图注 10-32 收录《新青年》创刊号（图版未视觉核验）。","path":"publications/xin-qingnian.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 C 维度下近代期刊版式的文献锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:xiu-shi-lu","title":"髹饰录（Xiu Shi Lu）","name_en":"Xiu Shi Lu","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["明代","漆艺","黄成","工艺专著"],"confidence":"medium","consensus":"tentative","sub_type":"monograph","source_count":"5","evidence_status":"source_backed","description":"《髹饰录》是明代漆工黄成所撰的漆艺专著，天启五年（1625）由杨明逐条加注并作序，分乾、坤两集共十八章。田自秉称其为“我国现存唯一古代漆艺专著”，高丰则通过王世襄的整理本说明其价值。","path":"publications/xiu-shi-lu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"《髹饰录》是 B 维度下漆艺工艺知识体系化的著作锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:xiupu","title":"绣谱（Xiupu）","name_en":"Xiupu","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["清代","丁佩","苏绣","刺绣","能巧妙神"],"confidence":"medium","consensus":"tentative","sub_type":"craft_treatise","source_count":"2","evidence_status":"source_backed","description":"《绣谱》是清代苏绣艺人丁佩所著刺绣专著，成书于道光元年（1821）。全书分择地、选样、取材、辨色、程工（2016 作“工程”）、论品 6 章，提出“能、巧、妙、神”的美学原则与苏绣“齐、光、直、匀、薄、顺、密”的特点。田自秉称其为清道光时丁佩所著刺绣专著。","path":"publications/xiupu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下清代刺绣文献的锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:xuehuan-xiupu","title":"雪宦绣谱（Xuehuan Xiupu）","name_en":"Xuehuan Xiupu","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["清末民初","刺绣","苏绣","沈寿","张謇"],"confidence":"medium","consensus":"tentative","sub_type":"monograph","source_count":"4","evidence_status":"source_backed","description":"《雪宦绣谱》是清末沈寿口述、张謇记录整理的刺绣工艺专著。四册对它的处理分成三层：夏燕靖两版给**完整的章目与数值**（八章、十八种针法、八十八种色线、七百四十五种因染而别），田自秉给**著作谱系中的位置**并只列章名，高丰只给**成书经过与一句性质判断**。**四册都没有给出初版年份或出版者**，田自秉册末另列一个 2004 年现代版本。","path":"publications/xuehuan-xiupu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"《雪宦绣谱》在四册中是刺绣工艺著作：八章章目、十八种针法、八十八种色线与七百四十五种“因染而别”构成主体（B），沈寿在南通女工传习所的授绣与张謇的记录整理属制度与教育面（D），其“系统而完整的理论著作”定位属著作史层面（A）为次。赵农、李立新无本书条目。Theme/Topic 尚未 materialize。"},{"id":"publications:xunzi","title":"荀子（Xunzi）","name_en":"Xunzi","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["战国","荀子","荀况","以玉比德","天行有常"],"confidence":"medium","consensus":"tentative","sub_type":"classical_text","source_count":"2","evidence_status":"source_backed","description":"《荀子》是战国末年儒家思想家荀况的著作。荀子重视美感和教育功能，在议论中常以器具比喻说明道理，书中提出“以玉比德”（《荀子·法行》）的思想。2016 记其据《史记·孟子荀卿列传》为荀况晚年总结百家争鸣与自身学术思想而编；《天论》《非相》反映其唯物主义自然观，提出“天行有常”“天人相分”“制天命而用之”；《玉制》（疑为《王制》之讹）《富国》《天论》《宥坐》强调等级不同者的衣着、居住规制。","path":"publications/xunzi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"A","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 A 维度下先秦造物思想文献的锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:yanxian-qingshang-jian","title":"燕闲清赏笺（Yanxian Qingshang Jian）","name_en":"Yanxian Qingshang Jian","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["明代","高濂","漆器","雕漆","刺绣"],"confidence":"medium","consensus":"tentative","sub_type":"connoisseurship_treatise","source_count":"2","evidence_status":"source_backed","description":"《燕闲清赏笺》是明代高濂的鉴赏著作。田自秉三处引用：一记宋漆盒、漆盘、漆匣的多种造型；一记宋人雕漆朱厚堆至数十层、有锡胎者、有葛地者等；一评元绣“便不及宋，以其用绒粗肥，落针不密”，田自秉认为这种说法不公正。高丰将其列入明代手工业设计专著群。","path":"publications/yanxian-qingshang-jian.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下明代鉴赏文献的锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:yingzao-fashi","title":"营造法式（Yingzao Fashi）","name_en":"Yingzao Fashi","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["北宋","建筑规范","李诫","官书"],"confidence":"medium","consensus":"tentative","sub_type":"monograph","source_count":"6","evidence_status":"source_backed","description":"《营造法式》是北宋官方颁布的建筑设计与施工规范书，由李诫（来源另作“李诚”）编修，成书于元符三年（1100），刊行于崇宁二年（1103）。全书分名例、制度、工限料例、图样四部分，详述大木作、石作、砖作、小木作、雕木作与彩画作，是研究宋代建筑与室内设计最重要的技术文献之一。","path":"publications/yingzao-fashi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"《营造法式》是 B 维度下建筑与室内装修规范的锚点；其官方制度内容未来可与 D 维度交叉。Theme/Topic 尚未 materialize。"},{"id":"publications:yinliuzhai-shuoci","title":"饮流斋说瓷（Yinliuzhai Shuoci）","name_en":"Yinliuzhai Shuoci","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["民国","许之衡","陶瓷","说窑","款识"],"confidence":"medium","consensus":"tentative","sub_type":"ceramics_treatise","source_count":"2","evidence_status":"source_backed","description":"《饮流斋说瓷》是许之衡所著陶瓷专著，分上下两卷共 10 节，成书于 20 世纪 20 年代。上卷为概说、说窑、胎釉、彩色、花绘，下卷为款识、瓶罐、杯盘、杂具、疵伪。该书以分类、排比方法总结前人知识与个人见闻，保存大量古陶瓷学名和俗称；书前附《书成自题六十韵》。","path":"publications/yinliuzhai-shuoci.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下近代陶瓷文献的锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:yuan-ye","title":"园冶（Yuan Ye）","name_en":"Yuan Ye","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["明代","园林","计成","造园理论"],"confidence":"medium","consensus":"tentative","sub_type":"monograph","source_count":"4","evidence_status":"source_backed","description":"《园冶》是明代计成所撰的造园专著，崇祯四年（1631）成稿、崇祯七年刊行，三卷，附图二百余幅。夏燕靖 2016 称其为“我国第一本园林艺术理论的专著”，田自秉把它与《营造法式》并提，视作明代园林艺术的总结。","path":"publications/yuan-ye.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"《园冶》是 B 维度下造园工艺理论化的著作锚点，其“虽由人作，宛自天成”的命题也涉及 A 维度的设计观念问题。Theme/Topic 尚未 materialize。"},{"id":"publications:yugong","title":"禹贡（Yugong）","name_en":"Yugong","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["先秦","尚书","九州","物产","染织"],"confidence":"medium","consensus":"tentative","sub_type":"geographical_text","source_count":"2","evidence_status":"source_backed","description":"《禹贡》是《尚书》中的地理篇。田自秉据《禹贡》等书记载春秋战国染织生产分布，列举冀州、并州、青州、兖州、徐州、扬州、荆州、豫州的布帛、丝、纨、绮、绣、玄织缟、玄纁等物产，并引“青州贡盐緝海物”“厥贡漆丝”等句；2016 记《禹贡》有梁州（秦岭以南、陕南川东地区）贡铁的记载。","path":"publications/yugong.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下先秦物产地理文献的锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:zhongguo-gongyi-yange-shilue","title":"中国工艺沿革史略（Zhongguo Gongyi Yange Shilue）","name_en":"Zhongguo Gongyi Yange Shilue","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["工艺美术史","史学史","1917","商务印书馆"],"confidence":"medium","consensus":"tentative","sub_type":"monograph","source_count":"2","evidence_status":"source_backed","description":"《中国工艺沿革史略》是许衍灼撰著的工艺美术史，1917 年出版。田自秉在后记中称，该书是作者当时在国内仅发现的一本中国自己出版的工艺美术史书籍；李立新记其由商务印书馆出版，并将其视为中国工艺美术通史、断代史、专史编撰的起点。","path":"publications/zhongguo-gongyi-yange-shilue.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"A","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 A 维度下近代工艺史写作的文献锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:zhongguo-shejishi-gaofeng","title":"中国设计史（高丰）（The Design History of China (Gao Feng)）","name_en":"The Design History of China (Gao Feng)","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["设计史","通史","高丰","2004","广西美术出版社"],"confidence":"medium","consensus":"tentative","sub_type":"monograph","source_count":"1","evidence_status":"source_backed","description":"《中国设计史》是高丰著、广西美术出版社出版的中国设计史专著。正文由绪论和九章组成，从原始时代述至清末民国；绪论讨论中国设计史的研究课题、发生发展与若干规律。书名页附英文题名 THE DESIGN HISTORY OF CHINA。","path":"publications/zhongguo-shejishi-gaofeng.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"A","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 A 维度下现代设计通史的文献锚点，同时是本语料第 1 册的来源书目。Theme/Topic 尚未 materialize。"},{"id":"publications:zhongguo-shejishi-xiayanjing","title":"中国设计史（夏燕靖）（Zhongguo Shejishi (Xia Yanjing)）","name_en":"Zhongguo Shejishi (Xia Yanjing)","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["设计史","教材","夏燕靖","2009","上海人民美术出版社"],"confidence":"medium","consensus":"tentative","sub_type":"textbook","source_count":"1","evidence_status":"source_backed","description":"《中国设计史》是夏燕靖编著，许平、李新主编“中国高等院校艺术设计学系列教材”之一种，由上海人民美术出版社 2009 年 1 月出版。CIP 数据标明 ISBN 978-7-5322-5618-1、分类号 J509.2；版本记录载明开本 787×1092 1/18、印张 15.34、印数 0001-3300、定价 40.00 元。","path":"publications/zhongguo-shejishi-xiayanjing.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"A","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 A 维度下现代设计史教材的文献锚点，同时是本语料第 2 册的来源书目。Theme/Topic 尚未 materialize。"},{"id":"publications:zhouli","title":"周礼（Rites of Zhou）","name_en":"Rites of Zhou","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["先秦","官书","礼制","职官"],"confidence":"medium","consensus":"tentative","sub_type":"classic","source_count":"6","evidence_status":"source_backed","description":"《周礼》是六册来源共同征引的先秦官书。夏燕靖 2016 另记其为儒家经典，相传为西周周公所著。本 KU 只登记《周礼》本体：书名与篇目沿革、六官体系与职官规模、以及来源据《周礼》征引的职官与礼制材料。其《冬官》补篇《考工记》的工艺文本（百工分工、制车、六齐、营国、四要素等）已由 `publications/kaogongji.md` 承担，本 KU 不重复登记，只在必要处指向该条。","path":"publications/zhouli.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"《周礼》是 D 维度下先秦职官与礼制制度的文献依据，其《冬官》补篇《考工记》的工艺内容归 B 维度并已单独成 KU。Theme/Topic 尚未 materialize。"},{"id":"publications:zhouyi","title":"周易（Zhouyi）","name_en":"Zhouyi","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["先秦","易经","易传","卦爻象","制器尚象"],"confidence":"medium","consensus":"tentative","sub_type":"classical_text","source_count":"3","evidence_status":"source_backed","description":"《周易》是由《易经》与《易传》组成的典籍。《易经》含卦爻象符号系统与卦辞，高丰称多数专家认为约西周前期由巫史集体创造；《易传》十篇又称“十翼”，约成书于战国晚期。高丰把卦爻象视为平面构成设计，并从中提炼制器尚象、道器统一、文质统一等设计思想。2016 记其又名《易经》，约成书于西周初年，以六十四卦和阴阳之道说明万物变化，“道”与“器”的关系成为传统造物思想与设计方法的主题。","path":"publications/zhouyi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"A","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 A 维度下造物观念文献的锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:zhuanghuang-zhi","title":"装潢志（Zhuanghuang Zhi）","name_en":"Zhuanghuang Zhi","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["明末","周嘉胄","书画装裱","装潢","42节"],"confidence":"medium","consensus":"tentative","sub_type":"craft_treatise","source_count":"2","evidence_status":"source_backed","description":"《装潢志》是明末周嘉胄撰写的书画装裱专著，完整记述古代书画装裱理论，全书 4000 余字，分序言和 42 小节，介绍“洗”“揭”“补”“衬边”“小托”“全”“式”“镶攒”“覆”“上壁”“下壁”“安轴”等步骤要领与装潢用料知识；2016 另列“上杆”“上贴”“贴签”“染古绢托纸”等步骤。","path":"publications/zhuanghuang-zhi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下明代装裱文献的锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:zhuangshi-zazhi","title":"装饰杂志（Zhuangshi Magazine）","name_en":"Zhuangshi Magazine","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["1958","设计期刊","中央工艺美术学院","工业设计","张光宇"],"confidence":"medium","consensus":"tentative","sub_type":"periodical","source_count":"2","evidence_status":"source_backed","description":"《装饰》杂志于 1958 年 9 月在北京创刊，1980 年 6 月复刊。1988 年第 2 期发表广州美术学院设计研究室专稿《中国工业设计怎么办》；1989 年第 4 期以专辑讨论室内艺术设计；1992 年第 4 期推出“纪念张光宇特刊”；1996 年发表纪念陈之佛诞辰 100 周年的文章。","path":"publications/zhuangshi-zazhi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 D 维度下当代中国设计期刊的锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:zhuangzi","title":"庄子（Zhuangzi）","name_en":"Zhuangzi","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["战国","庄子","南华经","以器喻事","轮扁"],"confidence":"medium","consensus":"tentative","sub_type":"classical_text","source_count":"2","evidence_status":"source_backed","description":"《庄子》是庄子及其后学所著的道家典籍。赵农称其以器喻事、议论风生，对器具的认识具体而完整：《养生主》有“所好者道也，进乎技矣”；《知北游》记 80 余岁工匠“臣之年二十而好捶钩，于物无视也，非钩无察也”；《天道》记轮扁制轮“不徐不疾，得之于手而应于心，口不能言”；《天运》论乐有“惧”“怠”“惑”的递进。2016 记其又称《南华经》，原有 52 篇，内篇一般认为庄子所作，含“天人合一”“以天合天”“","path":"publications/zhuangzi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"A","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 A 维度下造物思想文献的锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:ziren-yizhi","title":"梓人遗制（Ziren Yizhi）","name_en":"Ziren Yizhi","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["元代","木工","织机","车制","薛景石"],"confidence":"medium","consensus":"tentative","sub_type":"monograph","source_count":"4","evidence_status":"source_backed","description":"《梓人遗制》是元代木工技术专著，四册都把它系于薛景石名下，但四册写的**不是同一本书**：赵农写的是两部分的完整体（先车制、后织机），夏燕靖两版写的是“规范制作织机的木工技术的专著”，田自秉只取其中花罗织机的一段机构说明。断代也有分歧——田自秉作“宋人”，其余三册作元代。","path":"publications/ziren-yizhi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"《梓人遗制》在四册中都是木工技术专著：织机四类、零件与总装图、用材与工时构成主体（B），刊行年、《永乐大典》收录、中国营造学社整理出版属流传与制度面（D）。Theme/Topic 尚未 materialize。"},{"id":"publications:ziren-zhuan","title":"梓人传（Ziren Zhuan）","name_en":"Ziren Zhuan","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["唐代","柳宗元","营造","匠师","设计思想"],"confidence":"medium","consensus":"tentative","sub_type":"essay","source_count":"2","evidence_status":"source_backed","description":"《梓人传》是唐代柳宗元所著文章，通过对一位自荐的杨氏木匠营造思想的分析和营造行为的实地观察描述，阐明设计构思及运用法则的重要作用。文章提出营造工艺的总体准则“规矩绳墨以定制”“善运众工而不伐艺”，即以合理的预设布局调整各项具体技术工作并完成整个设计意图；原文评价其以“相道”联系工匠经验论述工艺设计思想具有独到性。","path":"publications/ziren-zhuan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"A","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 A 维度下唐代设计思想文献的锚点。Theme/Topic 尚未 materialize。"},{"id":"publications:zunsheng-bajian","title":"遵生八笺（Zunsheng Bajian）","name_en":"Zunsheng Bajian","type":"publication","type_zh":"出版物","color":"#6366F1","tags":["明代","高濂","养生","岁时风俗","玉器"],"confidence":"medium","consensus":"tentative","sub_type":"life_treatise","source_count":"2","evidence_status":"source_backed","description":"《遵生八笺》是明代高濂所撰的养生专著，1591 年刊，20 卷 8 笺，含大量岁时风俗与实用艺术考据资料。田自秉引其“上古用玉，珍重似不敢亵”一语，说明周代玉器因与伦理道德联系而受社会特别重视。","path":"publications/zunsheng-bajian.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下明代生活与器物文献的锚点。Theme/Topic 尚未 materialize。"},{"id":"terms:an-furniture","title":"案（An (Table)）","name_en":"An (Table)","type":"term","type_zh":"术语","color":"#10B981","tags":["春秋战国","矮足","承具","漆案"],"confidence":"medium","consensus":"tentative","sub_type":"furniture_form","source_count":"3","evidence_status":"source_backed","description":"案是春秋战国主要家具，本义为木制盛食物的矮脚托盘，亦代桌。《考工记·玉人》“案十有二寸”；战国至两汉多木制髹漆饰彩纹，后演变为书案、平头案等长形承具，按材料有陶案、木案、漆案、铜案。","path":"terms/an-furniture.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"案是 B 维度下先秦两汉承具的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:baici","title":"白瓷（White Porcelain）","name_en":"White Porcelain","type":"term","type_zh":"术语","color":"#10B981","tags":["北齐","低铁胎釉","邢窑","青白两大体系"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_type","source_count":"2","evidence_status":"source_backed","description":"白瓷是用低含铁量胎釉烧成、釉色乳白的瓷器，北齐发明，胎料较细腻，釉薄而滋润、呈乳白色，釉厚处泛青；白瓷出现后瓷分青、白两大体系。隋代已烧制成功并大量生产，唐代成为重要品种，邢窑为代表，邢瓷洁白如银雪，釉白而微闪淡黄或淡青。","path":"terms/baici.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"白瓷是 B 维度下瓷器类型与胎釉技术的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:baigong","title":"百工（Baigong / Hundred Craftsmen）","name_en":"Baigong","type":"term","type_zh":"术语","color":"#10B981","tags":["先秦","考工记","官营手工业","工匠","六职"],"confidence":"medium","consensus":"tentative","sub_type":"craft_system","source_count":"4","evidence_status":"source_backed","description":"百工是先秦文献中对手工业者与官营手工业制度的称法。《考工记》说“国有六职，百工与居一焉”，把百工列为王公、士大夫、百工、商旅、农夫、妇功六职之一；又说“凡攻木之工七，攻金之工六，攻皮之工五，设色之工五，刮摩之工五，抟埴之工二”，共 30 个工种。高丰把“百工”释为“直接服务于王室的、有官长率领的官府手工业者”，并把“政府建立的整套官营手工业制度”也称为“百工”制度；李立新同样把“百工”制度释为“整","path":"terms/baigong.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"百工是 D 维度下官营手工业制度与工匠身份的术语锚点；工种分工、材料与工艺规范属 B。Theme/Topic 尚未 materialize。"},{"id":"terms:bandixue-shi-jianzhu","title":"半地穴式建筑（Semi-Subterranean Dwelling）","name_en":"Semi-Subterranean Dwelling","type":"term","type_zh":"术语","color":"#10B981","tags":["新石器时代","仰韶文化","半坡","木骨草泥"],"confidence":"medium","consensus":"tentative","sub_type":"building_type","source_count":"2","evidence_status":"source_backed","description":"半地穴式建筑是黄河流域仰韶文化遗址中大量存在的一种泥木房屋：先挖成半人高的坑，中心支木柱，屋顶沿坑周围用木椽架棚、再铺厚草泥土，木头用藤条捆扎。形状有方形和圆形，门朝南并有斜坡式或阶梯式门道，房子中间为灶坑。","path":"terms/bandixue-shi-jianzhu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"半地穴式建筑是 B 维度下新石器时代居住建筑的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:bao-yi-bo-dai","title":"褒衣博带（Baoyi Bodai (Loose Robe, Broad Sash)）","name_en":"Baoyi Bodai (Loose Robe, Broad Sash)","type":"term","type_zh":"术语","color":"#10B981","tags":["魏晋南北朝","竹林七贤","云冈石窟","佛像服饰","玄学"],"confidence":"medium","consensus":"tentative","sub_type":"garment_form","source_count":"2","evidence_status":"source_backed","description":"褒衣博带原指魏晋南北朝宽衫大袖、衣带宽博的服饰风尚。南朝时王公、名士、百姓都以宽衫大袖、褒衣博带为时髦；文人受佛道两教影响崇尚玄学，衣着突破礼法，敞领宽衫、袒胸露怀成为习俗，可从《竹林七贤画像砖》得到佐证。赵农则以“褒衣博带”指云冈石窟所采用的中原样式佛像服饰，它取代了早期佛像“偏袒右肩式”及“通肩式”的服饰。","path":"terms/bao-yi-bo-dai.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"E","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"褒衣博带是 E 维度下服饰风尚与佛教造像中国化的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:baomaizhu","title":"包买主（Baomaizhu (Putting-Out Merchant)）","name_en":"Baomaizhu (Putting-Out Merchant)","type":"term","type_zh":"术语","color":"#10B981","tags":["清末民初","棉布","换棉","出机","资本主义萌芽"],"confidence":"medium","consensus":"tentative","sub_type":"economic_role","source_count":"2","evidence_status":"source_backed","description":"包买主是清末民初出现的社会新阶层，主要收购农副产品再转售给大城市的棉布批发行，以“换棉”和“出机”方式控制生产和流通。之后包买主设立自己直接经营的手工工场，从农家招募“机织下女”从事生产，到民国年间已较广泛发展。","path":"terms/baomaizhu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"包买主是 D 维度下清末民初手工业组织与商业资本的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:beijingren","title":"北京人（Peking Man）","name_en":"Peking Man","type":"term","type_zh":"术语","color":"#10B981","tags":["旧石器时代早期","周口店","直立人","石器","用火"],"confidence":"medium","consensus":"tentative","sub_type":"hominin","source_count":"2","evidence_status":"source_backed","description":"北京人是晚期直立人的代表，20 世纪 20 年代发现于北京房山区周口店龙骨山，生活在距今 60 万至 23 万年前。石器原料以石英脉为主，普遍使用捶击法、砸击法打片；石器已有类型和分工，除刮削器外还有尖状器、砍砸器、雕刻器和石锤。","path":"terms/beijingren.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"北京人是 B 维度下旧石器时代早期人类与石器技术的核心条目。Theme/Topic 尚未 materialize。"},{"id":"terms:belt-hook","title":"带钩（Belt Hook）","name_en":"Belt Hook","type":"term","type_zh":"术语","color":"#10B981","tags":["春秋战国","服饰配件","胡服","青铜工艺"],"confidence":"medium","consensus":"tentative","sub_type":"clothing_accessory","source_count":"6","evidence_status":"source_backed","description":"带钩是春秋战国时期连接革带两端的钩形配件；田自秉记其\"约始于春秋初期\"，广泛流行于战国，直到西汉。六册一致认为它与胡服配套使用、自北方民族传入。分歧不在起源，而在两处：一是带钩是否只与胡服配套，二是带钩是否承担身份等级标示的功能。六册在这两点上的表述并不一致，本 KU 并列。","path":"terms/belt-hook.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"带钩是 B 维度下春秋战国服饰配件与青铜装饰工艺的交汇条目，其来源问题同时牵涉服饰史（胡服）与工艺史（错金银、嵌玉）。Theme/Topic 尚未 materialize。"},{"id":"terms:bianzhong","title":"编钟（Bianzhong (Chime Bells)）","name_en":"Bianzhong (Chime Bells)","type":"term","type_zh":"术语","color":"#10B981","tags":["商代","西周","礼乐","青铜","一套八钟"],"confidence":"medium","consensus":"tentative","sub_type":"musical_instrument","source_count":"2","evidence_status":"source_backed","description":"编钟是按大小排列成组的礼仪乐器，周代一系列大小不等的钟挂在一个架上、能发出不同音律，与单独悬挂的特钟相对，是周代礼乐制度的器物体现。赵农记商代编钟三个一组；商代铙到周代成为钟，铙柄保留为钟甬，钟甬侧加环为钟旋，钟偏挂并按大小排列成编钟；西周编钟八个钟一套，可演奏许多乐律，春秋战国时期达到高峰。","path":"terms/bianzhong.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"编钟是 B 维度下先秦青铜乐器的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:black-porcelain","title":"黑瓷（Black Porcelain）","name_en":"Black Porcelain","type":"term","type_zh":"术语","color":"#10B981","tags":["汉代","晋代","德清窑","建窑","吉州窑"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_type","source_count":"5","evidence_status":"source_backed","description":"黑瓷是以含铁量较高的釉料在还原焰中烧成的黑釉瓷器，汉代出现、晋代成熟，以浙江德清最负盛名，宋代因斗茶而大盛，建窑兔毫、吉州窑玳瑁是代表。五册的记载可分三层：**化学层**（田自秉给出氧化亚铁含量与呈色的对应）、**窑口层**（德清、建窑、吉州窑及其产品）、**风俗层**（斗茶与黑盏）。分歧在**德清黑釉是否达到纯黑**与**建窑所在政区**的写法。","path":"terms/black-porcelain.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"黑瓷是 B 维度下以高铁釉呈色的瓷种条目：氧化亚铁的配比与还原焰烧成属工艺，乌黑、兔毫、油滴、玳瑁等釉面肌理属装饰。斗茶风尚牵涉生活习俗，本 KU 只作动因记录。Theme/Topic 尚未 materialize。"},{"id":"terms:blue-and-white-porcelain","title":"青花瓷（Blue-and-white Porcelain）","name_en":"Blue-and-white Porcelain","type":"term","type_zh":"术语","color":"#10B981","tags":["唐代","宋代","元代","明代","清代"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_type","source_count":"5","evidence_status":"source_backed","description":"青花瓷是以钴料在瓷胎上绘纹、罩透明釉、高温一次烧成的釉下彩瓷器，因白地蓝花又称青花。五册都把它当作中国瓷器的主干品种，元代景德镇作品是共同焦点。**分歧集中在起源**：高丰、赵农主唐，田自秉主宋而判\"开始流行在元代中期以后\"，夏燕靖两版则明说\"我国青花起源于何时一直是个未获澄清的问题\"。本 KU 并列四说，不裁定。\n\n**立条说明**：候选索引里\"青花\"（`xdup-0141`：赵农 `cand-","path":"terms/blue-and-white-porcelain.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"青花瓷是 B 维度下以钴料呈色的釉下彩瓷种条目：钴料、施彩、罩釉与高温一次烧成属工艺，白地蓝花的色彩与纹饰体系属装饰。其外销与官民窑分工另涉 D 维度。Theme/Topic 尚未 materialize。"},{"id":"terms:boshanlu","title":"博山炉（Boshan Incense Burner）","name_en":"Boshan Incense Burner","type":"term","type_zh":"术语","color":"#10B981","tags":["汉代","青铜器","熏炉","香薰","仙山"],"confidence":"medium","consensus":"tentative","sub_type":"vessel_form","source_count":"3","evidence_status":"source_backed","description":"博山炉是汉代薰炉（香薰）中最著名的一种，炉盖高而尖、雕镂成山峦形，象征海上仙山\"博山\"，山间有孔，燃香时烟气从镂孔冒出；炉座作盘形盛水，以助蒸香气。三册都把它与汉人的仙山信仰、羽化登仙观念联系起来，但叙述重心不同：高丰以两件纪年明确的实物（满城刘胜墓错金铜博山炉、茂陵鎏金银铜竹节熏炉）为主，赵农以形制与《薰炉铭》为主，田自秉以名实、神话文献与《考古图》为主。本 KU 合并三册，器物数据与文献引文分","path":"terms/boshanlu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"博山炉是 B 维度下汉代青铜熏炉的器形条目；仙山造型与羽化登仙观念牵涉 C 维度。形制、铸造与错金工艺属 B，图像与信仰属 C。Theme/Topic 尚未 materialize。"},{"id":"terms:buzi","title":"补子（Rank Badge）","name_en":"Rank Badge","type":"term","type_zh":"术语","color":"#10B981","tags":["明代","清代","官服","品级标识","刺绣"],"confidence":"medium","consensus":"tentative","sub_type":"official_insignia","source_count":"4","evidence_status":"source_backed","description":"补子是明清官服上缀于胸前、背后的方形绣片，以文禽武兽区分品级。四册来源有直接记载（高丰、李立新两册无\"补子\"字样）。来源在三点上不一致：明代始定的年份（洪武二十四年／二十五年）、明制与清制品级表的具体分配、以及清代武官六七品至九品的纹样归属。夏燕靖两版各自在同书相邻两段中给出不同年份，赵农与田自秉的清代武官表亦互不相同。本 KU 全部并列。","path":"terms/buzi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"补子是 D 维度下明清官服品级制度的标识件，其禽兽纹样的符号语义属 C 维度。Theme/Topic 尚未 materialize。"},{"id":"terms:caihui-tao","title":"彩绘陶（Caihui Tao）","name_en":"Caihui Tao","type":"term","type_zh":"术语","color":"#10B981","tags":["春秋","战国","两汉","明器","陶器"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_type","source_count":"4","evidence_status":"source_backed","description":"彩绘陶是春秋兴起、战国大发展、延续至两汉的陶器，主要用作明器陪葬。**四册对它的工序定义分成相反的两组**：田自秉与高丰都说是**在烧成的陶坯上画花**，田自秉并明确以\"在名称中加一绘字\"与彩陶相区别；夏燕靖两版却写成\"**在陶胎上绘出花纹后再进行烧制**\"，而那正是彩陶的工序。两组表述不能同时成立，本 KU 并列原话，不裁定；分歧同时记入本批工作包。`consensus` 仍为 `tentati","path":"terms/caihui-tao.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"彩绘陶是 B 维度下战国至两汉明器类型条目：彩绘层与陶胎的结合方式属工艺，纹样与设色属装饰。其明器用途另涉丧葬制度。Theme/Topic 尚未 materialize。"},{"id":"terms:cangli-yuqi","title":"藏礼于器（Ritual Embedded in Vessels）","name_en":"Ritual Embedded in Vessels","type":"term","type_zh":"术语","color":"#10B981","tags":["西周","礼制","青铜礼器","九鼎","等级"],"confidence":"medium","consensus":"tentative","sub_type":"ritual_concept","source_count":"2","evidence_status":"source_backed","description":"“藏礼于器”指青铜礼器承载礼制等级观念：西周奴隶主规定一整套礼制，对祭祀和典礼使用礼器的数量和规格作严格限制，使贵贱有等、上下有别。《周礼》载“礼祭，天子九鼎，诸侯七鼎，大夫五鼎，士三鼎”，《左传·庄公十八年》有“名位不同，礼亦异数”。","path":"terms/cangli-yuqi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"A","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"藏礼于器是 A 维度下西周礼制与器物观念的核心条目。Theme/Topic 尚未 materialize。"},{"id":"terms:chai-yao","title":"柴窑（Chai Kiln）","name_en":"Chai Kiln","type":"term","type_zh":"术语","color":"#10B981","tags":["五代后周","传说","雨过天青","郑州","窑址未发现"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_kiln","source_count":"3","evidence_status":"source_backed","description":"柴窑是传说后周创建的瓷窑，窑址在郑州，柴世宗批其款式“雨过天青云破处，者般颜色作将来”；记载最早见于明代陶瓷著作，实物未见，窑址从未发现，是否存在至今悬而未决。","path":"terms/chai-yao.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"柴窑是 B 维度下文献记载而未证实的瓷窑条目。Theme/Topic 尚未 materialize。"},{"id":"terms:chanheliao","title":"羼和料（Temper (Ceramic Additive)）","name_en":"Temper (Ceramic Additive)","type":"term","type_zh":"术语","color":"#10B981","tags":["陶土","砂粒","耐热急变","新石器时代"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_technique","source_count":"2","evidence_status":"source_backed","description":"羼和料是制陶时有意掺入陶土的砂粒、石灰粒、稻草末和碎陶末等，以砂粒为主。除少量砂粒为陶土固有外，大多是有意填入的；羼和料能提高陶器的耐热急变性能，避免容器在火上加热时破裂。","path":"terms/chanheliao.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"羼和料是 B 维度下早期制陶材料配方的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:daibing-gongju","title":"带柄工具（Hafted Tools）","name_en":"Hafted Tools","type":"term","type_zh":"术语","color":"#10B981","tags":["旧石器时代","峙峪文化","复合工具","木柄"],"confidence":"medium","consensus":"tentative","sub_type":"tool_type","source_count":"2","evidence_status":"source_backed","description":"带柄工具是在石器上加装木柄以省力的复合工具。考古发现峙峪文化部分旧石器已装木柄，带柄工具可上推到旧石器时代晚期乃至中期；但当时制作水平原始、劳动尚未产生迫切需求，其大规模使用要待新石器时代加工技术进步、特别是农耕兴起后才可能。","path":"terms/daibing-gongju.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"带柄工具是 B 维度下旧石器时代工具结构的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:danke-heitao","title":"蛋壳黑陶（Eggshell Black Pottery）","name_en":"Eggshell Black Pottery","type":"term","type_zh":"术语","color":"#10B981","tags":["龙山文化","轮制","薄胎","山东"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_type","source_count":"2","evidence_status":"source_backed","description":"蛋壳黑陶是典型龙山文化最具特征的器物，薄而光亮，大量出现于轮制盛行的陶器群中。典型龙山文化以山东为中心，轮制陶器约占全部陶器一半以上，常见器形有鬶、鬼脸式腿鼎、高圈足镂孔豆和杯、盘等。","path":"terms/danke-heitao.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"蛋壳黑陶是 B 维度下龙山文化陶器类型的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:dark-pattern-pottery","title":"暗纹陶（Dark-pattern Pottery）","name_en":"Dark-pattern Pottery","type":"term","type_zh":"术语","color":"#10B981","tags":["春秋","战国","中原地区","陶器","压花"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_type","source_count":"3","evidence_status":"source_backed","description":"暗纹陶是春秋兴起、战国大发展、流行于中原地区的陶器，特征是在陶坯未干透前压出浅细花纹，仅在光线斜射时隐约可见，故称暗纹，又称砑花陶。三册的正文高度重合，分歧集中在**别称用字**（砑花陶／研花陶）与**中心产地**（中原／以河南为中心）两处。三册都没有给压花工具的形制，也没有给暗纹与磨光陶、彩绘陶的工序关系。","path":"terms/dark-pattern-pottery.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"暗纹陶是 B 维度下战国中原陶器类型条目：压花工序与胎质属工艺，隐约可见的线纹效果属装饰。Theme/Topic 尚未 materialize。"},{"id":"terms:dawenkou-culture","title":"大汶口文化（Dawenkou Culture）","name_en":"Dawenkou Culture","type":"term","type_zh":"术语","color":"#10B981","tags":["新石器时代","父系氏族","黄河下游","海岱地区","考古学文化"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_culture","source_count":"6","evidence_status":"source_backed","description":"大汶口文化是黄河下游新石器时代中晚期的考古学文化，因山东泰安大汶口遗址而得名（六册均未记发现年份）。六册都把它放在**母系氏族向父系氏族转化**的节点上，但只有田自秉给出分布与转化关系的完整表述，高丰、赵农、李立新分别从陶器造型、陶文符号与手工业分化三个方向取材。本 KU 只登记文化层面的命名、分期位置、工艺特征与争论点；陶器、象牙梳等单件器物的细节不在此重复。","path":"terms/dawenkou-culture.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"大汶口文化是 B 维度下黄河下游新石器时代中晚期、由母系向父系过渡的考古学文化条目；陶文符号牵涉 C 维度。Theme/Topic 尚未 materialize。"},{"id":"terms:diao-qi","title":"雕漆（Diaoqi (Carved Lacquer)）","name_en":"Diaoqi (Carved Lacquer)","type":"term","type_zh":"术语","color":"#10B981","tags":["剔红","剔犀","剔彩","张成","杨茂"],"confidence":"medium","consensus":"tentative","sub_type":"lacquer_technique","source_count":"2","evidence_status":"source_backed","description":"雕漆是在漆层上雕刻而非在胎体雕镂的漆器工艺，使漆色呈现具有立体感的浮雕效果。唐代新创：先在漆胎上涂漆数十层，待一定厚度再雕刻；此前漆雕是在木胎上先雕后漆，此作法今称剔红，唐代实物至今未发现。宋代包括剔红、剔犀、剔彩，多以金银为胎、朱漆堆至数十层，剔犀需两种以上色漆反复重叠；宋代雕漆多在宫中内府修内司制造。元代张成、杨茂（嘉兴西塘人）最负盛名，作品造型多为普通圆盘圆盒，特色在“漆”与“雕”，张成盒漆","path":"terms/diao-qi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"雕漆是 B 维度下髹漆雕刻工艺的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:ding","title":"鼎（Ding Cauldron）","name_en":"Ding Cauldron","type":"term","type_zh":"术语","color":"#10B981","tags":["商周","青铜器","礼器","列鼎","炊煮器"],"confidence":"medium","consensus":"tentative","sub_type":"vessel_form","source_count":"6","evidence_status":"source_backed","description":"鼎是圆体三足、双耳（方鼎则四足）的煮食器，陶鼎早于青铜鼎，青铜鼎在商周成为最重要的礼器与政权象征。六册均有字面记载，其中五册有实质论述（高丰、夏燕靖两版、赵农、田自秉），李立新一册仅在年表中列\"列鼎\"、以《天工开物》\"铸鼎图\"说明分工，属旁证。来源在**列鼎制度的等级数字**上有实质分歧，在**礼器分类的名称**上给出两套互不对应的系统。本 KU 并列，不裁定。","path":"terms/ding.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"鼎是 B 维度下由陶鼎到青铜鼎、由炊煮器到礼器的器形条目，其列鼎等级制度属 D 维度，纹饰与铭文属 C 维度。Theme/Topic 尚未 materialize。"},{"id":"terms:dingcun-wenhua","title":"丁村文化（Dingcun Culture）","name_en":"Dingcun Culture","type":"term","type_zh":"术语","color":"#10B981","tags":["旧石器时代中期","山西襄汾","石器","第二步加工"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_culture","source_count":"2","evidence_status":"source_backed","description":"丁村文化是中国旧石器时代中期的典型遗存，位于山西襄汾丁村。石器以砍砸器、三棱大尖状器、球状器为主，重要的是少量石器开始第二步修整加工；丁村人多用“互交打击法”制造砍砸器。","path":"terms/dingcun-wenhua.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"丁村文化是 B 维度下旧石器时代中期石器技术的关键遗存。Theme/Topic 尚未 materialize。"},{"id":"terms:dou-vessel","title":"豆（Dou）（Dou (Stemmed Serving Vessel)）","name_en":"Dou (Stemmed Serving Vessel)","type":"term","type_zh":"术语","color":"#10B981","tags":["西周","春秋","盛食器","陶豆","有盖豆"],"confidence":"medium","consensus":"tentative","sub_type":"vessel_form","source_count":"2","evidence_status":"source_backed","description":"豆为盛食器，用于盛调味品，由陶豆演变而来，铜豆始见西周后期。形制分三层，上有盘、中有柄、底为圈足；早期盘浅、柄短而粗，春秋出现有盖豆，盖与器身相合呈球体，盖有四钮、器身有四环耳。春秋战国时期的豆把手细而高，便于拿取，并增加了盖，盖翻置时可当盘使用，大大提高了实用性；豆的造型亦为曲线的球体所组成，形式优美。","path":"terms/dou-vessel.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"豆是 B 维度下商周盛食器形的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:doucai","title":"斗彩（Doucai）","name_en":"Doucai","type":"term","type_zh":"术语","color":"#10B981","tags":["明代","成化","景德镇","釉上彩","青花"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_decoration","source_count":"5","evidence_status":"source_backed","description":"斗彩是釉下青花与釉上彩绘相结合的瓷器装饰技法，成化时期最精。五册来源有直接记载（李立新一册无\"斗彩\"字样）。来源在三处结构性问题上的说法互相冲突：名称由何而来、斗彩与五彩是并列还是包含、以及斗彩是否创始于成化。这三处都不是措辞差异，而是分类体系层面的分歧，本 KU 并列。","path":"terms/doucai.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"斗彩是 B 维度下明代景德镇釉上彩与釉下青花结合的装饰技法，其色彩与纹饰效果属 C 维度。Theme/Topic 尚未 materialize。"},{"id":"terms:dougong","title":"斗拱（Dougong (Bracket Set)）","name_en":"Dougong (Bracket Set)","type":"term","type_zh":"术语","color":"#10B981","tags":["木构建筑","商周雏形","一斗二升","唐宋结构","明清装饰"],"confidence":"medium","consensus":"tentative","sub_type":"building_component","source_count":"3","evidence_status":"source_backed","description":"斗拱是我国古代木构建筑的特有构件，位于柱子承接屋顶的部分，由若干方木与横木垒叠而成，用以支撑伸出的屋檐并将重量转移到柱子上。商周时期已见雏形，可在青铜器上见到样式；汉代有直拱、人字拱、单层拱、多层拱，并出现一斗二升、一斗三升，东汉还有一斗四升。唐宋时期主要为结构构件，到明清演变为以装饰构件为主。","path":"terms/dougong.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"斗拱是 B 维度下木构建筑构件的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:duan-yan","title":"端砚（Duan Inkstone）","name_en":"Duan Inkstone","type":"term","type_zh":"术语","color":"#10B981","tags":["端州","肇庆","鸲鹆眼","唐代","清代"],"confidence":"medium","consensus":"tentative","sub_type":"inkstone_type","source_count":"2","evidence_status":"source_backed","description":"端砚石出自广东肇庆斧柯山中，肇庆属端州管辖，山中有端溪蜿蜒，砚石即在水畔山间。端砚石从唐代武德年间开采以来闻名天下，宋代时山体崩塌几乎湮没，明代后期开始复采，清代端砚重新复兴，其砚石古朴典雅，深受文人喜爱。","path":"terms/duan-yan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"端砚是 B 维度下文房砚台的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:dui-vessel","title":"敦（Dui (Ritual Vessel)）","name_en":"Dui (Ritual Vessel)","type":"term","type_zh":"术语","color":"#10B981","tags":["战国","青铜器","食器","瓜鼎","球形"],"confidence":"medium","consensus":"tentative","sub_type":"vessel_form","source_count":"2","evidence_status":"source_backed","description":"敦是战国时期新创的器种，由两个半球合成一球形。夏燕靖称其为盛黍稷的食器，三足和盖的三钮也都是圆形，整个器体构成圆的统一体；赵农称其为圆球体的炖肉器具，上下各为半球体，上半部压力较重，能加快肉食熟烂速度。春秋战国敦非常兴盛，一般大口、圆腹、二环耳、三短足，与簋作用相似但取代簋的地位，后人俗称“瓜鼎”。","path":"terms/dui-vessel.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"敦是 B 维度下春秋战国青铜器形的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:dulunche","title":"独轮车（Wheelbarrow）","name_en":"Wheelbarrow","type":"term","type_zh":"术语","color":"#10B981","tags":["西汉","诸葛亮","鹿车","山地运输","杠杆"],"confidence":"medium","consensus":"tentative","sub_type":"vehicle_type","source_count":"3","evidence_status":"source_backed","description":"独轮车是以独轮为标志的手推车，车轮多为木制，利用杠杆原理把负载抗力点靠近车轮，载货载人平稳轻巧，适合崎岖路面；大约西汉晚期出现，西汉时类似鹿车或辘轳车，木牛流马据考即独轮车。赵农记其重心低、操作灵活，便于山地运输，诸葛亮在蜀国山地军事运输中推广使用，后成为蜀地及北方许多地区的家常运输工具。","path":"terms/dulunche.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"独轮车是 B 维度下古代运输工具的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:duozi-he","title":"多子盒（Duozi Box (Compartmented Container)）","name_en":"Duozi Box (Compartmented Container)","type":"term","type_zh":"术语","color":"#10B981","tags":["汉代","漆器","宋代","耀州窑","多格食器"],"confidence":"medium","consensus":"tentative","sub_type":"container_form","source_count":"2","evidence_status":"source_backed","description":"多子盒在六册中有两种所指：一是与食案合用的多格食器，将深盘分割为许多空格以装载不同食物，携带方便、保存食品干净整洁；二是宋代瓷盒，一盒之中有数个小杯，子母口，中间以瓷条分割固定小杯、避免碰撞，以耀州窑产品最具特色。田自秉另记汉代漆器中的多件套盒，大盒内容纳九子、十一子等小盒。","path":"terms/duozi-he.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"多子盒是 B 维度下多格容器与成套组合设计的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:falangcai","title":"珐琅彩（Falangcai）","name_en":"Falangcai","type":"term","type_zh":"术语","color":"#10B981","tags":["清代","康熙","雍正","乾隆","景德镇"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_decoration","source_count":"4","evidence_status":"source_backed","description":"珐琅彩是康熙时期出现的清代宫廷釉上彩瓷，又称瓷胎画珐琅、洋瓷，旧俗称古月轩。景德镇制胎、运京施加彩绘并二次烧成，是四册共同给出的生产分工。**四册对\"珐琅彩\"这一条目所定义的对象并不一致**：赵农把定义落在彩料的制作上，田自秉与夏燕靖两版把定义落在瓷器品种上。本 KU 并列，不据一说改写另一说。","path":"terms/falangcai.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"珐琅彩是 B 维度下清代宫廷釉上彩条目：景德镇制胎、内务府或北京二次彩绘烧成的分工属工艺与生产组织，华丽稠厚的彩绘效果属装饰。Theme/Topic 尚未 materialize。"},{"id":"terms:fangsongti","title":"仿宋体（Fangsong Typeface）","name_en":"Fangsong Typeface","type":"term","type_zh":"术语","color":"#10B981","tags":["明代","雕版印刷","刻书","图案字"],"confidence":"medium","consensus":"tentative","sub_type":"typeface","source_count":"2","evidence_status":"source_backed","description":"仿宋体是明代仿刻宋版书成风后形成的印刷字体。刻工为施刀方便使字体渐趋方正，后发展为横轻直重的“图案字”，与手写体全然不同，即后世所称“仿宋体”。清代印刷业发达的城市中，刻字铺鳞次栉比，刻字甚至成为城市居民的家庭副业。","path":"terms/fangsongti.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"仿宋体是 C 维度下雕版印刷字体的类型条目。Theme/Topic 尚未 materialize。"},{"id":"terms:feiyi","title":"非物质文化遗产（Intangible Cultural Heritage）","name_en":"Intangible Cultural Heritage","type":"term","type_zh":"术语","color":"#10B981","tags":["UNESCO","活态传承","口传","传统手工艺"],"confidence":"medium","consensus":"tentative","sub_type":"heritage_concept","source_count":"2","evidence_status":"source_backed","description":"非物质文化遗产指被各群体、团体或个人视为其文化遗产的各种实践、表演、表现形式、知识体系和技能及有关的工具、实物、工艺品和文化场所，包括口头传统、表演艺术、社会风俗礼仪节庆、有关自然界和宇宙的知识和实践、传统手工艺技能五类。它依托人本身存在、以身口相传延续，是“活”的文化中最脆弱的部分。","path":"terms/feiyi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"非物质文化遗产是 D 维度下遗产制度与设计教育语境的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:fencai","title":"粉彩（Fencai）","name_en":"Fencai","type":"term","type_zh":"术语","color":"#10B981","tags":["清代","康熙","雍正","景德镇","釉上彩"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_decoration","source_count":"4","evidence_status":"source_backed","description":"粉彩是康熙时期出现、雍正时期最盛的清代釉上彩瓷，以玻璃白打底、油料调色、渲染出浓淡为特征，又称软彩。四册都把它列为清代彩瓷的主要品种，分歧在**起点措辞**（发展／始／创造）与**烧成温度**：田自秉给 700℃ 左右，夏燕靖两版给釉上彩的 750～860℃ 红炉彩烧，两版并未为粉彩单列温度，两个数值区间不重合。本 KU 并列。","path":"terms/fencai.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"粉彩是 B 维度下清代釉上彩装饰类型条目：玻璃白打底、油料调色与烘烧温度属工艺，柔和淡雅的色彩效果属装饰。Theme/Topic 尚未 materialize。"},{"id":"terms:fu-vessel","title":"簠（Fu (Ritual Food Vessel)）","name_en":"Fu (Ritual Food Vessel)","type":"term","type_zh":"术语","color":"#10B981","tags":["西周","食器","稻粱","仿竹器","菱形"],"confidence":"medium","consensus":"tentative","sub_type":"vessel_form","source_count":"2","evidence_status":"source_backed","description":"簠是西周后期新增食器，仿竹器，浅腹，侧视呈斜边菱形状，用以盛稻粱。《周礼》称“簠，稻粱器也”，与盛黍稷的簋在器形上相区别。2016 记其形体长方形，盖打开后为相同两器，器身与器盖各有四个短足；早期斜壁浅腹，后期变为直壁深腹。","path":"terms/fu-vessel.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"簠是 B 维度下西周青铜食器的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:futou","title":"幞头（Futou Headwrap）","name_en":"Futou Headwrap","type":"term","type_zh":"术语","color":"#10B981","tags":["头饰","隋唐","宋代","软脚幞头","硬脚幞头"],"confidence":"medium","consensus":"tentative","sub_type":"headwear_form","source_count":"3","evidence_status":"source_backed","description":"幞头是隋唐男服中的头巾类首服，以黑色纱、罗制成，四角成带，两角向前系住发髻、两角在脑后系结，余端自然垂下。三册的叙述分工是：夏燕靖两版给形制结构、软脚与硬脚的做法以及翘脚、展脚等名目；赵农给源流（汉代幅巾）、唐太宗\"起于后周\"的引文、盛唐加衬木藤皮革、唐代帝王专用与宋代软脚改硬脚。两册对源流的表述有一处不一致——夏燕靖说\"由汉代的幞头、幅巾等演变而来\"，赵农说\"从汉代的幅巾演变过来\"。本 KU 并","path":"terms/futou.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"幞头是 B 维度下隋唐至宋代首服的形制条目；巾帛裁剪、软硬脚构造属 B，服色等级与帝王专用制度牵涉 C 维度。Theme/Topic 尚未 materialize。"},{"id":"terms:gaiji","title":"改机（Gaiji）","name_en":"Gaiji","type":"term","type_zh":"术语","color":"#10B981","tags":["明代","弘治","丝织","福建","织机"],"confidence":"medium","consensus":"tentative","sub_type":"textile_technique","source_count":"4","evidence_status":"source_backed","description":"改机是明代弘治年间福建织工林洪把缎机由五层改为四层而形成的丝织工艺，所织丝绸两面有花纹、多用中小型花朵。四册来源有直接记载（高丰、赵农两册无\"改机\"字样）。材料密度低：夏燕靖两版与田自秉共用同一段引文，李立新只有一句概述，此外仅《天水冰山录》的品种名录另有一处著录。改机的技术细节（四层与两面花纹之间的因果关系）四册均未解释，本 KU 不代为补足。","path":"terms/gaiji.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"改机是 B 维度下明代福建丝织技术的单点条目。材料密度低，四册中三册共用同一段引文。Theme/Topic 尚未 materialize。"},{"id":"terms:ganlan-shi-jianzhu","title":"干栏式建筑（Ganlan Building / Stilt House）","name_en":"Ganlan Building","type":"term","type_zh":"术语","color":"#10B981","tags":["新石器时代","长江流域","河姆渡","巢居","榫卯"],"confidence":"medium","consensus":"tentative","sub_type":"building_type","source_count":"4","evidence_status":"source_backed","description":"干栏式建筑是中国南方新石器时代的一种木构建筑类型：以桩木为基础，构成高于地面的基座，用桩柱绑扎方式立柱、架梁、盖顶，形成下层架空、上层居住的半楼式房屋。四册都把它说成“巢居的继承和发展”，并以浙江余姚河姆渡遗址为典型。差异在范围与强度：高丰说“在木(竹)柱底架上建筑的高出地面(或水上)的房子”，并把河姆渡定为“目前发现年代最早的、最具典型性的干栏式建筑”；夏燕靖两版的知识链接说“河姆渡遗址发现的干","path":"terms/ganlan-shi-jianzhu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"干栏式建筑是 B 维度下史前木构建筑类型的术语锚点。本条只记类型定义、地域分布、构造特征与各册分歧；河姆渡遗址的具体尺寸、稻作、陶器与漆器留在 `places/hemudu-site.md`，河姆渡文化的命名、年代与工艺留在 `terms/hemudu-culture.md`。Theme/Topic 尚未 materialize。"},{"id":"terms:ge-yao","title":"哥窑（Ge Kiln）","name_en":"Ge Kiln","type":"term","type_zh":"术语","color":"#10B981","tags":["宋代","五大名窑","开片","金丝铁线","紫口铁足"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_kiln","source_count":"4","evidence_status":"source_backed","description":"哥窑是宋代五大名窑之一，以釉面开片为主要特征，有鱼子纹、蟹爪纹、百圾碎及“金丝铁线”等名称；釉色有粉青、米色，胎呈黑褐色，器皿边缘显褐色边称“紫口铁足”。窑址至今未发现，宋墓未见典型器皿。夏燕靖《中国设计史》另录章生一、章生二兄弟在两浙路处州、龙泉县各建一窑的传说（兄窑称哥窑，弟窑称弟窑、也称章窑、龙泉窑），并记有专家认为传世宫藏哥窑瓷实为南宋时修内司官窑烧制；釉为失透乳浊釉，釉色以灰青为主。赵农","path":"terms/ge-yao.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"哥窑是 B 维度下宋代名窑的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:geometric-stamped-hard-pottery","title":"几何印纹硬陶（Geometric Stamped Hard Pottery）","name_en":"Geometric Stamped Hard Pottery","type":"term","type_zh":"术语","color":"#10B981","tags":["商代","西周","春秋战国","长江以南","陶器"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_type","source_count":"4","evidence_status":"source_backed","description":"几何印纹硬陶是长江以南流行的高温印纹陶，胎骨坚致，呈紫或紫黑色，器表拍印几何纹。它是 `terms/geometric-stamped-pottery.md`（几何印纹陶）的下位类别，田自秉把上位类别分为印纹软陶与印纹硬陶\"两种\"。四册都把它当作独立品种，但**时代、成型法与纹样成因三处互相打架**：夏燕靖两版系于春秋，田自秉说战国窑址且\"长期流行\"，高丰说商代、西周已盛；成型法两作\"泥条盘筑\"、","path":"terms/geometric-stamped-hard-pottery.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"几何印纹硬陶是 B 维度下高温陶器类型条目：胎料成分、烧成温度与成型工艺是主问题，拍印几何纹的视觉效果属 C 维度。Theme/Topic 尚未 materialize。"},{"id":"terms:geometric-stamped-pottery","title":"几何印纹陶（Geometric Stamped Pottery）","name_en":"Geometric Stamped Pottery","type":"term","type_zh":"术语","color":"#10B981","tags":["新石器时代晚期","商周","春秋战国","长江以南","陶器"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_type","source_count":"3","evidence_status":"source_backed","description":"几何印纹陶是长江以南新石器时代晚期兴起、以印模在陶坯上压印几何纹为特征的陶器类别，按烧成火度分为几何印纹软陶与几何印纹硬陶两档。三册都把它作为独立品种叙述，但在分部省份、胎色与年代下限上写法不一致。本 KU 只承担上位类别；硬陶另有 `terms/geometric-stamped-hard-pottery.md` 专条，田自秉明言二者是\"印纹软陶和印纹硬陶两种\"，属上下位关系而非同物异名。","path":"terms/geometric-stamped-pottery.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"几何印纹陶是 B 维度下陶器类型条目的上位类别：胎料、火度与成型属工艺，几何纹的排布属装饰效果。Theme/Topic 尚未 materialize。"},{"id":"terms:glass","title":"玻璃（Glass）","name_en":"Glass","type":"term","type_zh":"术语","color":"#10B981","tags":["硅酸盐","吹制","模压","近代工业"],"confidence":"medium","consensus":"tentative","sub_type":"material_type","source_count":"2","evidence_status":"source_backed","description":"玻璃通常以石英砂、纯碱、长石、石灰石等为重要原料，并加入澄清剂、着色剂、乳浊剂，经混合、熔化、澄清、匀化、退火处理而成。玻璃多为硅酸盐玻璃，多以吹塑和模压技术为主，广泛用于建筑、包装、生活用品、照明；中国玻璃制造业从上海开始，1949 年后北京、上海、大连、山东、四川北碚等地建造玻璃厂。","path":"terms/glass.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"玻璃是 B 维度下硅酸盐材料与成型工艺的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:gongyi-meishu","title":"工艺美术（Arts and Crafts）","name_en":"Arts and Crafts","type":"term","type_zh":"术语","color":"#10B981","tags":["清末民初","学科","实用经济美观","1998","艺术设计"],"confidence":"medium","consensus":"tentative","sub_type":"design_discipline","source_count":"2","evidence_status":"source_backed","description":"工艺美术是清末民初艺术革命中形成的学科概念：在建筑、绘画、雕塑之外成为一种体系，利用古籍中“工艺”一词加上“美术”，形成复合概念。1920 年蔡元培《美术的起源》中已有“建筑、造像（雕刻）、图画、工艺美术”的并称；1949 年以后工艺美术成为手工业管理局、轻工业部所属范围，工艺美术教育以“实用、经济、美观”为目标；1998 年教育部高等教育专业目录中“艺术设计”替代了“工艺美术”。","path":"terms/gongyi-meishu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"工艺美术是 D 维度下设计学科名称与教育体制的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:guan-yao","title":"官窑（Guan Kiln (Official Kiln)）","name_en":"Guan Kiln (Official Kiln)","type":"term","type_zh":"术语","color":"#10B981","tags":["宋代","青瓷","汴梁","冰裂纹","皇室"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_kiln","source_count":"3","evidence_status":"source_backed","description":"官窑是宋代官方开办、利用垄断优势采用优质瓷土、釉色和良好烧制技术、供奉皇室生活需要的窑场。2016 记宋徽宗政和年间在汴梁建造的窑场，窑址至今未发现；主要烧青瓷，器形有瓶、尊、洗、盘、碗及仿周汉青铜器，釉色以月色、粉青、大绿流行。","path":"terms/guan-yao.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"官窑是 B 维度下宋代官办瓷窑的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:guanying-shougongye","title":"官营手工业（State-Run Handicraft Industry）","name_en":"State-Run Handicraft Industry","type":"term","type_zh":"术语","color":"#10B981","tags":["工商食官","官府工匠","皇室","商周至明清"],"confidence":"medium","consensus":"tentative","sub_type":"craft_system","source_count":"2","evidence_status":"source_backed","description":"官营手工业是由官府设立、使用官府工匠、产品主要供皇室官僚的生产体系。商周“工商食官”为开端，集中优秀工匠、不惜工本，覆盖建筑、车驾、礼器、织造、陶瓷等门类。春秋战国各国官方经营的手工业以陶器上刻“相邦”“守相”“左陶户”等字铭为标志，与之并存的是私营个体手工业。","path":"terms/guanying-shougongye.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"官营手工业是 D 维度下官府生产体制的总纲条目。Theme/Topic 尚未 materialize。"},{"id":"terms:gugu-guan","title":"顾姑冠（Gugu Hat）","name_en":"Gugu Hat","type":"term","type_zh":"术语","color":"#10B981","tags":["元代","蒙古","妇女首服","黑鞑事略","孛黑塔"],"confidence":"medium","consensus":"tentative","sub_type":"headwear","source_count":"2","evidence_status":"source_backed","description":"顾姑冠又写作“姑姑冠”“罟罟冠”，为元代蒙古族妇女首服。《黑鞑事略》记其“画木为骨，包以红绢金帛”，顶用四五尺长柳条或银枝包青毡，地位高者用翠花或五彩帛饰之，下人用野鸡毛。有爵命的蒙古族妇女和已婚女子戴此冠，《蒙古秘史》中蒙古语称“孛黑塔”。","path":"terms/gugu-guan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"顾姑冠是 B 维度下元代蒙古族首服的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:hanjing","title":"汉镜（Han Mirror）","name_en":"Han Mirror","type":"term","type_zh":"术语","color":"#10B981","tags":["汉代","铜镜","规矩镜","铭文","透光镜"],"confidence":"medium","consensus":"tentative","sub_type":"device_type","source_count":"3","evidence_status":"source_backed","description":"汉镜是汉代铜镜的断代称谓。三册对它的处理方式不同：夏燕靖两版把它作为\"铜器的分类型设计\"下的第一个类型，给\"体薄、平边、圆钮\"的总特点与西汉、西汉末至王莽、东汉三期演变；赵农把它列为\"制器与文化的充分结合\"的典范，给镜体加厚、半球钮、柿蒂纹钮座、铭文镜、规矩四神镜、制镜人商标与透光镜。两册在最基本的一点上相反——夏燕靖说汉镜\"体薄\"，赵农说汉镜\"比战国铜镜加大增厚\"。本 KU 两说并列，不替作者弥","path":"terms/hanjing.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"汉镜是 B 维度下汉代铜镜的断代器物条目；铭文的吉祥语与楚辞风格、四神方位观念牵涉 C 维度。铸造、纹样与分期属 B。Theme/Topic 尚未 materialize。"},{"id":"terms:he-cai","title":"褐彩（Brown Splash Decoration）","name_en":"Brown Splash Decoration","type":"term","type_zh":"术语","color":"#10B981","tags":["西晋","东晋","氧化铁","点彩","龙泉窑"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_decoration","source_count":"2","evidence_status":"source_backed","description":"褐彩是西晋晚期已在瓷器上出现、东晋时期最为流行的釉上彩装饰，以含多量氧化铁的釉料在瓷上点成几何纹或花瓣纹，具有锦上添花之妙；为浙江地区六朝瓷窑所创，后为宋代龙泉窑继承。田自秉称其为瓷上彩釉装饰的先声。","path":"terms/he-cai.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"褐彩是 B 维度下西晋至东晋瓷器装饰的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:he-wool","title":"褐（He (Coarse Woolen Cloth)）","name_en":"He (Coarse Woolen Cloth)","type":"term","type_zh":"术语","color":"#10B981","tags":["先秦","诗经","毛织品","平民","染色"],"confidence":"medium","consensus":"tentative","sub_type":"textile_type","source_count":"2","evidence_status":"source_backed","description":"褐是《诗经》中所见平民穿的粗制毛织物。原文以“无衣无褐，何以卒岁？”说明当时毛织品不只是少量生产；又以“毳衣如，毳衣如瑞”说明能将毛织品染成绿或红色之类鲜艳色彩。","path":"terms/he-wool.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"褐是 B 维度下先秦毛织品类型的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:hemudu-culture","title":"河姆渡文化（Hemudu Culture）","name_en":"Hemudu Culture","type":"term","type_zh":"术语","color":"#10B981","tags":["新石器时代","长江下游","干栏式建筑","稻作","骨器"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_culture","source_count":"5","evidence_status":"source_backed","description":"河姆渡文化是长江下游地区的新石器时代考古学文化，因发现于浙江余姚河姆渡而得名。五册来源有直接记载（李立新一册无\"河姆渡文化\"字样，仅以遗址与木器材料出现）。本 KU 只登记文化层面的命名、年代、分布与工艺特征；同一遗址的建筑尺寸、骨耜数量、朱漆木碗等实物细节已登记在 `places/hemudu-site.md`，此处不重复。","path":"terms/hemudu-culture.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"河姆渡文化是 B 维度下长江下游新石器时代的类型学条目，与 `places/hemudu-site.md`（遗址本体）分工：本 KU 记文化命名、年代、分布与工艺特征，遗址 KU 记建筑、器物与遗物细节。Theme/Topic 尚未 materialize。"},{"id":"terms:hongmu","title":"红木（Hongmu (Rosewood)）","name_en":"Hongmu (Rosewood)","type":"term","type_zh":"术语","color":"#10B981","tags":["硬木","酸枝","明清家具","树种统称"],"confidence":"medium","consensus":"tentative","sub_type":"material_type","source_count":"2","evidence_status":"source_backed","description":"红木是明清以来对稀有硬木的统称，从一开始就不是某一特定树种的家具；红木性脆、味酸，南方又称“酸枝”，纹理有清晰如行云流水者，也有细腻近紫檀者。赵农另记“红木”是 20 世纪末期中国社会重新出现的传统家具时尚，普通民众也重新崇尚实木家具。","path":"terms/hongmu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"红木是 B 维度下家具用材与材料名的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:hongshan-culture","title":"红山文化（Hongshan Culture）","name_en":"Hongshan Culture","type":"term","type_zh":"术语","color":"#10B981","tags":["新石器时代","北方地区","玉器","玉龙","女神庙"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_culture","source_count":"5","evidence_status":"source_backed","description":"红山文化是分布于内蒙古东南、辽宁西部与河北北部一带的新石器时代考古学文化，因内蒙古赤峰红山而得名。六册中有五册提及，**夏燕靖 2009 一册完全未出现**；田自秉给出发现时间、分布与玉龙尺寸，赵农、李立新、夏燕靖 2016 与高丰只截取玉器、祭祀遗迹或龙纹起源的某一侧面。本 KU 登记文化命名、分布、玉器特征与区域设计定位，不重复单件玉器的形制描述。","path":"terms/hongshan-culture.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"红山文化是 B 维度下北方燕山南北长城地带的新石器时代考古学文化条目；玉龙与祭祀遗迹同时牵涉 C 维度。Theme/Topic 尚未 materialize。"},{"id":"terms:huadian","title":"花钿（Huadian (Forehead Ornament)）","name_en":"Huadian (Forehead Ornament)","type":"term","type_zh":"术语","color":"#10B981","tags":["唐代","面妆","金箔","梅花妆"],"confidence":"medium","consensus":"tentative","sub_type":"cosmetic_accessory","source_count":"2","evidence_status":"source_backed","description":"花钿是唐代女子贴于额上或两眉之间的面部妆饰，式样繁多，质料有金箔、彩纸、翠鸟羽毛、鱼鳃骨及颜料等着彩。其源出南北朝寿阳公主梅花落额的传说；唐代除用颜色染绘外，还有用金属制造。","path":"terms/huadian.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"花钿是 B 维度下唐代面妆饰物的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:huangzi","title":"幌子（Huangzi / Shop Banner）","name_en":"Huangzi","type":"term","type_zh":"术语","color":"#10B981","tags":["商业美术","广告","招幌","酒旗","望子"],"confidence":"medium","consensus":"tentative","sub_type":"advertising_form","source_count":"4","evidence_status":"source_backed","description":"幌子是中国古代店铺悬挂的招徕标识，最典型的形态是布幔酒旗，后泛指酒店、茶舍、布店、药铺等行业的悬挂广告。四册的外延并不一致：高丰把“招幌”分为“招牌”与“幌子”两类，招牌宋代流行，幌子可追溯到春秋战国酒旗；夏燕靖两版把幌子说成“我国土生土长的‘广告’形式”，宋代称“望子”；赵农把幌子定义为“商家店铺中的悬挂广告，如酒帘”，却又把墙面上的“茶”“當”“药”“布”单字也纳入；夏燕靖 2016 在近代上","path":"terms/huangzi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"幌子是 C 维度下店铺标识与商业广告的术语锚点；其商业功能、行业分工与市镇制度属 D；布幔、木幌、模型幌的制作属 B。Theme/Topic 尚未 materialize。"},{"id":"terms:huayou","title":"花釉（Huayou (Splashed Glaze)）","name_en":"Huayou (Splashed Glaze)","type":"term","type_zh":"术语","color":"#10B981","tags":["唐代","黑釉","斑纹","腰鼓","鲁山"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_type","source_count":"2","evidence_status":"source_backed","description":"花釉是唐瓷新品种，在黑釉、黄釉、天蓝釉基础上再施蓝白或灰白釉，形成大小斑纹，或规则排列或任意飘洒如波浪、树叶、云彩。烧造地点有河南郏县、鲁山、内乡、禹县等，代表作是河南出土的“花釉腰鼓”。","path":"terms/huayou.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"花釉是 B 维度下唐代瓷釉类型的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:huazhuangtu","title":"化妆土（Slip (Ceramic Coating)）","name_en":"Slip (Ceramic Coating)","type":"term","type_zh":"术语","color":"#10B981","tags":["新石器时代","六朝","婺窑","胎色"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_technique","source_count":"2","evidence_status":"source_backed","description":"化妆土是施于陶器或瓷器表面、用以改善呈色或装饰的涂层。田自秉记母系氏族社会制陶已在陶器表面施化妆土，并进行彩画、刻镂、堆贴等装饰；夏燕靖记婺窑因制品含铁量较高、胎色泛红，为取得较好色彩效果而在烧制中运用化妆土。","path":"terms/huazhuangtu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"化妆土是 B 维度下陶瓷胎釉工艺的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:huchuang","title":"胡床（Folding Stool）","name_en":"Folding Stool","type":"term","type_zh":"术语","color":"#10B981","tags":["东汉","魏晋南北朝","唐代","家具","坐具"],"confidence":"medium","consensus":"tentative","sub_type":"furniture_form","source_count":"6","evidence_status":"source_backed","description":"胡床是东汉以后传入的可折叠坐具，即后世的马扎。六册均有直接记载，但它在各册中的重要性不在器物本身，而在坐姿与坐礼的改变：席地跽坐转为垂足而坐，进而导向高型家具与椅子。来源在四处不一致：传入方向、改称\"绳床\"的时点、绳床与胡床是否同物、胡床的社会评价。赵农一册内部对绳床的解释亦不自一致。本 KU 全部并列，不裁定。","path":"terms/huchuang.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"胡床是 B 维度下的坐具形制条目，其坐礼与礼制变动属 D 维度，其自域外传入并本土化属 E 维度。Theme/Topic 尚未 materialize。"},{"id":"terms:hudie-zhuang","title":"蝴蝶装（Butterfly Binding）","name_en":"Butterfly Binding","type":"term","type_zh":"术语","color":"#10B981","tags":["宋代","册页装","雕版印刷","包背装"],"confidence":"medium","consensus":"tentative","sub_type":"book_binding","source_count":"2","evidence_status":"source_backed","description":"蝴蝶装是宋代出现的中国古代册页装订最早形式，也是雕版印刷发展的结果：每页从中缝对折，按页码将折口逐页粘在包背纸上，再装上硬封面而成一册；版心向内、版外空白可裁，阅读翻检与保存较便。叶德辉《书林清话》形容“揭之若蝴蝶翼”；其缺陷是书页均为单页、翻阅不便，南宋因此创包背装，元代广泛应用。","path":"terms/hudie-zhuang.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"蝴蝶装是 C 维度下古代书籍装帧形式的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:hufu","title":"胡服（Hu Dress (Nomadic Costume)）","name_en":"Hu Dress (Nomadic Costume)","type":"term","type_zh":"术语","color":"#10B981","tags":["赵武灵王","胡服骑射","短衣长裤","带钩","跨文化"],"confidence":"medium","consensus":"tentative","sub_type":"garment_form","source_count":"2","evidence_status":"source_backed","description":"胡服本是北方草原游牧民族部落的服装，特征是短衣、长裤、靴子；古代中原民族用以总称西域和北方各族胡人所穿服饰，即塞外民族西戎和东胡的服饰。衣身紧窄、活动便利，便于生活与骑射；胡服进入中原始于赵武灵王胡服骑射。","path":"terms/hufu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"E","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"胡服是 E 维度下跨文化服饰传播的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:huohua","title":"火花（Matchbox Label）","name_en":"Matchbox Label","type":"term","type_zh":"术语","color":"#10B981","tags":["火柴商标","收藏","文革","商品设计"],"confidence":"medium","consensus":"tentative","sub_type":"advertising_form","source_count":"2","evidence_status":"source_backed","description":"火花即火柴商标的设计。火柴 19 世纪中期由英国传入中国，随后许多地方开设火柴生产厂商；火花为收藏家带来艺术欣赏天地，但随着打火机流行，火柴在 20 世纪末慢慢退出生活范围。文革时期火花是重要收藏对象，设计内容含毛主席语录、革命圣地、工农兵形象、向日葵、三面红旗、长江大桥等“革命性”图案。","path":"terms/huohua.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"火花是 C 维度下近现代商业标识与收藏印刷品的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:industrial-design","title":"工业设计（Industrial Design）","name_en":"Industrial Design","type":"term","type_zh":"术语","color":"#10B981","tags":["现代设计","产品设计","学科","工业化","设计教育"],"confidence":"medium","consensus":"tentative","sub_type":"design_discipline","source_count":"3","evidence_status":"source_backed","description":"工业设计是 20 世纪 80 年代初引入中国并逐步制度化的现代设计门类。夏燕靖两版把它定义为“在有序与无序之间，在科技与艺术之间进行的交叉设计活动”，核心是批量生产的工业产品设计，并给出五阶段流程、相关学科与 CAD 手段；李立新则从学科命名出发，指出“工业设计”一词外延含糊，容易把工业布局、工厂管理乃至传统造物排除在外，主张用“艺术设计”或“设计艺术”来限定艺术性造物。三册不是在给同一个定义：前","path":"terms/industrial-design.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"工业设计是 D 维度下现代设计学科与设计教育的术语锚点；批量生产、产品结构与材料工艺属 B；工业化、现代性与中西设计概念移植属 E。Theme/Topic 尚未 materialize。"},{"id":"terms:ji-furniture","title":"几（Ji Table）","name_en":"Ji Table","type":"term","type_zh":"术语","color":"#10B981","tags":["家具","坐具","凭几","榫卯","春秋战国"],"confidence":"medium","consensus":"tentative","sub_type":"furniture_form","source_count":"3","evidence_status":"source_backed","description":"几是中国先秦至后世低型家具的一种，由几面、腿、足座三部分以榫卯结合，表面少装饰、多呈黑色。三册对它的定性不完全相同：夏燕靖两版以\"凭几\"为核心，描述春秋时期横跗单足与栅形直足两式及江陵九店出土实例；赵农把它与席、床、屏风、案、箱并列，强调它是\"放置东西或者可以倚伏在上面\"的家具，战国墓出土较多、多带漆绘；夏燕靖 2016 另设\"案与几\"知识链接，用《说文》《周礼》界定几、案、桌、俎的差别。本 KU","path":"terms/ji-furniture.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"几是 B 维度下低型坐卧家具的条目；三册集中在春秋战国楚地漆木家具，形制与榫卯属造物层，凭几的礼制用法牵涉 C 维度。Theme/Topic 尚未 materialize。"},{"id":"terms:jianghu","title":"匠户（Jianghu (Artisan Household)）","name_en":"Jianghu (Artisan Household)","type":"term","type_zh":"术语","color":"#10B981","tags":["元代","明代","匠籍","世袭","系官人匠"],"confidence":"medium","consensus":"tentative","sub_type":"craft_system","source_count":"3","evidence_status":"source_backed","description":"匠户是元代对军匠、系官人匠等工匠的统称，身份世袭，子孙不能脱籍、婚嫁不得自由。元政府将被俘工匠分配给政府和贵族使用，制造兵器者编为“军匠”，有其他技艺者为“系官人匠”或“官匠”；《元典章》载系官诸色正匠免差，实际是一种工奴。明代改称匠籍，工匠须按规定时间轮班赴京服役。","path":"terms/jianghu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"匠户／匠籍是 D 维度下元明工匠户籍与官营手工业制度的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:jiangren-yingguo","title":"匠人营国（Jiangren Yingguo / Capital Planning Doctrine）","name_en":"Jiangren Yingguo","type":"term","type_zh":"术语","color":"#10B981","tags":["先秦","考工记","都城规划","礼制","营造制度"],"confidence":"medium","consensus":"tentative","sub_type":"planning_doctrine","source_count":"3","evidence_status":"source_backed","description":"匠人营国是《考工记》中关于都城营建的核心条文，字面为“匠人营建都城”。三册的用法有两层：夏燕靖 2016 的知识链接把“匠人营国”释为“建造都城的营建师”，即指人；夏燕靖 2009 与 2016 正文、赵农则把它作为一套都城规划制度来引述，即指营建规范。三册都引“方九里，旁三门，国中九经九纬，经涂九轨，左祖右社，面朝后市，市朝一夫”，并以道路宽度、居住尺度、奇数与“九”解释其等级秩序。本 KU 兼","path":"terms/jiangren-yingguo.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"匠人营国是 B 维度下都城营造制度与空间秩序的术语锚点；其礼制等级、道路分级与王城—诸侯城尺度关系属 D。Theme/Topic 尚未 materialize。"},{"id":"terms:jianzhi","title":"剪纸（Papercut）","name_en":"Papercut","type":"term","type_zh":"术语","color":"#10B981","tags":["东晋","窗花","镂金剪彩","民间工艺"],"confidence":"medium","consensus":"tentative","sub_type":"folk_craft","source_count":"2","evidence_status":"source_backed","description":"剪纸是先剪彩、后称窗花的民间剪刻艺术，起源于东晋的民间礼佛活动，即在佛陀涅槃日剪出通草花祭献佛陀。南北朝时期剪纸风行，荆楚一带有“镂金剪彩”的习俗；唐代立春用丝织品剪出春幡和首饰，后来改丝织品剪彩为剪纸。","path":"terms/jianzhi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"剪纸是 B 维度下民间剪刻工艺的类型条目。Theme/Topic 尚未 materialize。"},{"id":"terms:jiaoxie","title":"绞缬（Jiaoxie (Tie-Resist Dyeing)）","name_en":"Jiaoxie (Tie-Resist Dyeing)","type":"term","type_zh":"术语","color":"#10B981","tags":["防染","扎结","晕色","鹿胎缬","鱼子缬"],"confidence":"medium","consensus":"tentative","sub_type":"textile_technique","source_count":"3","evidence_status":"source_backed","description":"绞缬又称“撮缬”“撮晕缬”，民间又称“撮花”，是我国古代纺织品的一种“防染法”染花工艺：按花纹用针线缝扎或直接捆扎，抽紧使织物皱拢，染色时折叠处不易上染，形成晕色效果。魏晋南北朝应用广泛，花纹疏大者有鹿胎缬、玛瑙缬，细密者有鱼子缬等。","path":"terms/jiaoxie.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"绞缬是 B 维度下防染印花技术的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:jiaxie","title":"夹缬（Jiaxie (Clamp-Resist Dyeing)）","name_en":"Jiaxie (Clamp-Resist Dyeing)","type":"term","type_zh":"术语","color":"#10B981","tags":["镂空版","防染印花","秦汉","唐代","宋代"],"confidence":"medium","consensus":"tentative","sub_type":"textile_technique","source_count":"4","evidence_status":"source_backed","description":"夹缬是我国一种古老的镂空型版双面防染印花技术：将织物夹持于两块镂空版之间紧固，于镂空处涂刷或注入色浆，解开型版花纹即现；涂防白浆则染色后搓去白浆得色底白花。源流分层：2016 称历史可上溯东汉，唐代趋于成熟；高丰引《事物纪原》转引《二仪实录》称“秦汉间已有之，陈梁间贵贱通服之”，并记盛唐时流行于宫廷；田自秉记隋开皇六年（586）吐鲁番已有夹缬，盛唐极流行。宋代朝廷指定复色夹缬为宫室专用，洛阳染工李","path":"terms/jiaxie.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"夹缬是 B 维度下防染印花技术的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:jiguang-hu","title":"鸡冠壶（Chicken-Crest Ewer）","name_en":"Chicken-Crest Ewer","type":"term","type_zh":"术语","color":"#10B981","tags":["辽代","契丹","瓷器","皮囊壶","马背生活"],"confidence":"medium","consensus":"tentative","sub_type":"vessel_form","source_count":"5","evidence_status":"source_backed","description":"鸡冠壶是辽代瓷器中最具契丹族特征的壶式，仿皮囊壶而制，上部有孔式或提梁式。五册来源有直接记载（李立新一册无\"鸡冠壶\"字样）。来源对名称的合理性、器形分类的层级两处不一致：高丰认为\"鸡冠壶\"之名并不贴切、只是 20 世纪 30 年代以来的习惯提法，田自秉则按鸡冠形有孔大鼻直接释名；高丰分两大类型，田自秉分五种式样。本 KU 并列。","path":"terms/jiguang-hu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"鸡冠壶是 B 维度下辽代瓷器的代表性器形，其皮囊原型、马背功能与定居化改造属 E 维度的跨文化互动。Theme/Topic 尚未 materialize。"},{"id":"terms:jili-guche","title":"记里鼓车（Odometer Chariot）","name_en":"Odometer Chariot","type":"term","type_zh":"术语","color":"#10B981","tags":["汉代","宋代","制车","机械设计","计程装置"],"confidence":"medium","consensus":"tentative","sub_type":"device_type","source_count":"5","evidence_status":"source_backed","description":"记里鼓车是汉代以后按里程自动击鼓计程的机械车，又名记道车、大章车。五册的分工比同批的指南车条更散：**夏燕靖两版给定义、齿轮组原理与“里程表、减速器先驱”的判断**，**高丰给凸轮杠杆的实现方式与李约瑟的评断（附书名、版次、页码）**，**赵农给《晋书·舆服志》引文与宋代改进**，**李立新给“与现代计程表完全相同”的判断与汉代石刻的图像依据**。五册在传动方式（齿轮组／凸轮杠杆）与击打方式（鼓或","path":"terms/jili-guche.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"记里鼓车是 B 维度下机械制车类型的条目：齿轮组或凸轮杠杆的传动方式、里程—击鼓的计数逻辑与历代沿革都在此汇合。“汉代官府制车业”一侧归 D 维度。Theme/Topic 尚未 materialize。"},{"id":"terms:jingjin","title":"经锦（Warp-Faced Brocade）","name_en":"Warp-Faced Brocade","type":"term","type_zh":"术语","color":"#10B981","tags":["汉代","经线显花","三色经","马王堆"],"confidence":"medium","consensus":"tentative","sub_type":"textile_technique","source_count":"2","evidence_status":"source_backed","description":"经锦是汉代“经丝彩色显花”的锦，纬线只用一色，经线多至三色：一种作地色、一种织花纹、一种织轮廓线；同一图案、同一色彩形成直行排列。马王堆汉墓出土多种经锦；高丰记同出的绒圈锦具立体效果，被视为近代漳绒或天鹅绒前身。","path":"terms/jingjin.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"经锦是 B 维度下汉代提花织锦技术的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:jingtai-lan","title":"景泰蓝（Cloisonné）","name_en":"Cloisonné","type":"term","type_zh":"术语","color":"#10B981","tags":["铜胎掐丝珐琅","明代","景泰","北京","掐丝"],"confidence":"medium","consensus":"tentative","sub_type":"enamelware_type","source_count":"2","evidence_status":"source_backed","description":"景泰蓝是明代著名金属工艺，正式学名为铜胎掐丝珐琅。“景泰蓝”一词辛亥革命前后才采用，“蓝”非专指蓝色而是“发蓝”的简称；除万历外各代几乎都有生产，以景泰年间最精。其工序涉及掐丝、点蓝，品种含盘、瓶、炉、罐等欣赏品和台灯、果盘、文具、烟具、小盒等实用品，以北京为生产中心。","path":"terms/jingtai-lan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"景泰蓝是 B 维度下金属胎掐丝珐琅工艺的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:jixiang-tu-an","title":"吉祥图案（Auspicious Motifs）","name_en":"Auspicious Motifs","type":"term","type_zh":"术语","color":"#10B981","tags":["图必有意","意必吉祥","明清","象征","谐音"],"confidence":"medium","consensus":"tentative","sub_type":"decorative_motif","source_count":"2","evidence_status":"source_backed","description":"吉祥图案是以“图必有意，意必吉祥”为核心的装饰图案体系。高丰称其起源可追溯到原始社会、真正形成于汉代，经长期发展至清代达到高潮；通过象征、比拟、隐喻、谐音、寓意等手法或直接用文字传达吉祥意念，被视为中国古代富有鲜明民族特色的平面创意设计。","path":"terms/jixiang-tu-an.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"吉祥图案是 C 维度下传统装饰纹样体系的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:kaipian","title":"开片（Crackle Glaze）","name_en":"Crackle Glaze","type":"term","type_zh":"术语","color":"#10B981","tags":["宋代","哥窑","汝窑","金丝铁线","缺陷转化"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_decoration","source_count":"2","evidence_status":"source_backed","description":"开片是瓷器釉面裂纹，因釉与胎的收缩率不同而在冷却过程中形成。最先原是烧制缺陷，因纹理具有特殊效果，以后人为地使它形成自然装饰。哥窑按开片形状大小命名鱼子纹、蟹爪纹、百圾碎，并有“金丝铁线”之称；汝窑釉面也有冰裂纹。","path":"terms/kaipian.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"开片是 B 维度下陶瓷釉面装饰与缺陷转化的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:kesi","title":"缂丝（Kesi）","name_en":"Kesi","type":"term","type_zh":"术语","color":"#10B981","tags":["宋代","丝织","通经断纬","定州"],"confidence":"medium","consensus":"tentative","sub_type":"textile_technique","source_count":"5","evidence_status":"source_backed","description":"缂丝是以生丝作经、各色熟丝作纬，采用“通经断纬”织法织造的丝织品。因纬丝在图案边界处断开、形成细密裂痕，迎光看去如雕镂之像，故又称刻丝、克丝。五册来源都以宋代为缂丝的成熟与鼎盛期，并记其多用于摹织名人书画。","path":"terms/kesi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"缂丝是 B 维度下丝织工艺的术语锚点，其以书画为蓝本的生产方式也涉及 C 维度的图像转译问题。Theme/Topic 尚未 materialize。"},{"id":"terms:kouqi","title":"扣器（Kouqi Lacquerware）","name_en":"Kouqi Lacquerware","type":"term","type_zh":"术语","color":"#10B981","tags":["漆器","战国","金属附件","铜箍","胎骨"],"confidence":"medium","consensus":"tentative","sub_type":"lacquerware_type","source_count":"3","evidence_status":"source_backed","description":"扣器是战国漆器中以金属附件加固器身的一类。高丰的定义最宽：\"在卷木胎的和夹纻胎的漆器上加以金属口及铺首、合页、盖纽、足等金属附件……使用这种金属附件的漆器，称之为扣器\"，并把它定为\"战国漆器的一个特色\"。夏燕靖两版的定义较窄：战国末期出现，\"在器物口沿、底、腹部镶套铜箍（扣）以加固器身\"，耳、钮、足等附件用金属制作后再用漆胶住。两义不是互相否定，而是总类与典型形制的关系；本 KU 并列，不合并为单","path":"terms/kouqi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"扣器是 B 维度下战国漆器的加固与装饰类型条目；金属附件的功能与工艺属 B，铺首等附件的图像含义牵涉 C 维度。Theme/Topic 尚未 materialize。"},{"id":"terms:lantianren","title":"蓝田人（Lantian Man）","name_en":"Lantian Man","type":"term","type_zh":"术语","color":"#10B981","tags":["旧石器时代早期","陕西蓝田","打制石器","中更新世"],"confidence":"medium","consensus":"tentative","sub_type":"hominin","source_count":"2","evidence_status":"source_backed","description":"蓝田人是旧石器时代早期人类，1963—1964 年发现于今陕西蓝田县，属中更新世。遗址发掘和采集石器 50 余件，有刮削器、厚重尖状器、多边或单边砍砸器、球形器等，打制和修理均采用捶击法；石器虽粗糙，但已具一定设计形态和加工方法。","path":"terms/lantianren.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"蓝田人是 B 维度下旧石器时代早期人类与石器的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:leisi","title":"耒耜（Leisi (Digging Tool)）","name_en":"Leisi (Digging Tool)","type":"term","type_zh":"术语","color":"#10B981","tags":["神农氏","斲木为耜","商周","牛耕"],"confidence":"medium","consensus":"tentative","sub_type":"agricultural_tool","source_count":"2","evidence_status":"source_backed","description":"耒耜是神农氏制作的农具。《周易·系辞传下》称“斲木为耜，揉木为耒，耒耨之利，以教天下”，赵农称耒耜之具的制作是神农氏生产实践经验的总结和发明。2016 记直到商周时期我国大部分农业区域还只是用耒耜而没有犁耕，并引“冉伯牛名耕”推测春秋已有牛耕。","path":"terms/leisi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"耒耜是 B 维度下原始农具的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:li-cauldron","title":"鬲（Li Cauldron）","name_en":"Li Cauldron","type":"term","type_zh":"术语","color":"#10B981","tags":["陶器","青铜器","炊煮器","袋足","三足器"],"confidence":"medium","consensus":"tentative","sub_type":"vessel_form","source_count":"6","evidence_status":"source_backed","description":"鬲（音力）是中国史前至青铜时代的三足炊煮器，特征为三足上部肥大中空、下部收为锥足，即《尔雅》所谓\"款足\"、《汉书·郊祀志上》所谓\"空足\"。六册都把它作为独立器形处理，但**起源说法不一**：夏燕靖两版与田自秉、高丰都说由鼎改进而来，夏燕靖 2016 在同册内又有\"从陶鬲再由鼎演变而来\"的表述，李立新则说原形是斝形器或釜。本 KU 以器形为条目，把陶鬲与青铜鬲的形制演变放在一条线上，起源三说并列。","path":"terms/li-cauldron.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"鬲是 B 维度下陶器与青铜器共有的三足袋足炊煮器形条目；从新石器晚期到战国、再到龙泉窑仿古器的形制延续牵涉 B/C 两个维度。"},{"id":"terms:liangzhu-culture","title":"良渚文化（Liangzhu Culture）","name_en":"Liangzhu Culture","type":"term","type_zh":"术语","color":"#10B981","tags":["新石器时代","长江下游","黑陶","玉琮","玉璧"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_culture","source_count":"6","evidence_status":"source_backed","description":"良渚文化是长江下游太湖周围地区的新石器时代晚期考古学文化，1936 年发现于浙江余杭良渚、瓶窑、安溪三镇之间（夏燕靖两版）。六册都承认它是黑陶与玉器高度发达的文化，但**分类归属相互冲突**：田自秉与夏燕靖两版把它列为龙山文化四类型之一，李立新把\"东南良渚文化设计区\"列为六大原生设计区之一，赵农、高丰则按独立文化处理。本 KU 以\"良渚文化\"为条目名，把两种归属并列登记，不合并为单一定性。","path":"terms/liangzhu-culture.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"良渚文化是 B 维度下长江下游太湖地区的新石器时代晚期考古学文化条目；玉琮、神人兽面纹与古城同时牵涉 B/C 两个维度。分类归属（独立文化／龙山文化四类型之一）存在册级分歧。"},{"id":"terms:lianzhu-wen","title":"联珠纹（Linked-Pearl Motif）","name_en":"Linked-Pearl Motif","type":"term","type_zh":"术语","color":"#10B981","tags":["萨珊","唐代","联珠圈","丝绸之路","唐锦"],"confidence":"medium","consensus":"tentative","sub_type":"decorative_motif","source_count":"2","evidence_status":"source_backed","description":"联珠纹是以圆圈为基本单位、外圈饰联珠、内圆填对称动物纹样的装饰构成，是唐代丝织品对称式构成的典型。高丰认为联珠纹与动物纹在中国原始彩陶已见，但二者组合最早见于公元 3 世纪前后波斯萨珊王朝丝织品，南北朝经丝绸之路传入；唐代一部分直接照搬，一部分融合中国吉祥动物与汉代变形手法，形成中国式联珠纹。田自秉则反对其从波斯传入之说，举中国彩陶、北魏石砚、隋锦、敦煌藻井等说明中国联珠纹历史悠久。","path":"terms/lianzhu-wen.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"联珠纹是 C 维度下唐代装饰纹样的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:lieding-system","title":"列鼎制度（Graduated Ding System）","name_en":"Graduated Ding System","type":"term","type_zh":"术语","color":"#10B981","tags":["西周","礼制","鼎","簋","等级"],"confidence":"medium","consensus":"tentative","sub_type":"ritual_system","source_count":"2","evidence_status":"source_backed","description":"列鼎制度是西周早期形成的以鼎的数量标示社会等级的用鼎制度：天子九鼎、诸侯七、卿大夫五、元士三。鼎用单数，盛饭食的簋用偶数（天子八、诸侯六、大夫四、士二）；九鼎第一鼎盛牛肉称大牢，五鼎第一鼎盛羊肉称小牢。","path":"terms/lieding-system.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"列鼎制度是 D 维度下西周礼制与器物等级制度的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:lifang-zhi","title":"里坊制（Lifang Ward System）","name_en":"Lifang Ward System","type":"term","type_zh":"术语","color":"#10B981","tags":["北魏洛阳","隋大兴城","108坊","坊墙","城市规划"],"confidence":"medium","consensus":"tentative","sub_type":"urban_system","source_count":"2","evidence_status":"source_backed","description":"里坊制是以方格形里坊组织城市居住区的规划制度。北魏洛阳“方三百步为一里，里开四门，门置里正二人，门士八人，合有二百二十里”（《洛阳伽蓝记·城北》），整齐化一、管理方便；里坊居民有 500 户至 1000 户，贵族王室有自己的庄园，不受里坊限制。市东、市南、市西、市北各分布工商业者聚居的里，城南另有四夷馆和四夷里。隋大兴城以东西、南北大街纵横交错将全城分为 108 个方块，每块称“里”（唐称“坊”）","path":"terms/lifang-zhi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"里坊制是 D 维度下古代城市规划制度的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:ling-silk","title":"绫（Ling (Twill Silk)）","name_en":"Ling (Twill Silk)","type":"term","type_zh":"术语","color":"#10B981","tags":["斜纹提花","唐代","贡绫","缭绫"],"confidence":"medium","consensus":"tentative","sub_type":"textile_type","source_count":"2","evidence_status":"source_backed","description":"绫是以素地起两至三枚经斜纹提花的丝织品，也可染成红、黄、绿、紫等色。唐绫品种最多、产量高，据《新唐书》有 24 处贡绫，并出现整幅大花纹“可幅盘缔缭绫”。","path":"terms/ling-silk.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"绫是 B 维度下丝织品类型的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:lingyang-gong-pattern","title":"陵阳公样（Lingyang Gong Pattern）","name_en":"Lingyang Gong Pattern","type":"term","type_zh":"术语","color":"#10B981","tags":["唐代","织锦","联珠纹","对称构图"],"confidence":"medium","consensus":"tentative","sub_type":"textile_pattern","source_count":"5","evidence_status":"source_backed","description":"陵阳公样是唐太宗时期由益州大行台检校修造窦师伦创制的瑞锦宫绫纹样，因窦师伦封陵阳公而得名。五册来源都以“对雉、对羊、翔凤、游麟”等成对动物纹与对称构图为特征，并把它视为唐代织锦吸收波斯等外来纹样又承续本土传统的代表。","path":"terms/lingyang-gong-pattern.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"陵阳公样是 B 维度下唐代织锦纹样体系的术语锚点，其对称动物纹与联珠纹的组合同时是 E 维度跨文化互动的典型案例。Theme/Topic 尚未 materialize。"},{"id":"terms:liuqi","title":"六齐（Six Bronze Alloy Formulas）","name_en":"Six Bronze Alloy Formulas","type":"term","type_zh":"术语","color":"#10B981","tags":["商周","青铜","考工记","合金配比"],"confidence":"medium","consensus":"tentative","sub_type":"alloy_formula","source_count":"6","evidence_status":"source_backed","description":"\"六齐\"是《考工记》所记的六种青铜合金配比，按器物用途规定铜锡比例。六册来源全部有直接记载，但引述方式差异明显：两册逐条引全六种，另四册只取一句或只作概括。更重要的是，各册对\"六分其金而锡居一\"中\"金\"的所指（合金总量还是纯铜）从未明说，而这一读法直接决定配比能否与实测青铜器成分对应。本 KU 并列原文与解释，不裁定。","path":"terms/liuqi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"六齐是 B 维度下先秦青铜合金配比规范，其文献出处属 `publications/kaogongji.md`，本条只登记配比本身及其解释分歧。Theme/Topic 尚未 materialize。"},{"id":"terms:longshan-culture","title":"龙山文化（Longshan Culture）","name_en":"Longshan Culture","type":"term","type_zh":"术语","color":"#10B981","tags":["新石器时代","黑陶","蛋壳陶","城址","考古学文化"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_culture","source_count":"6","evidence_status":"source_backed","description":"龙山文化是新石器时代晚期以黑陶为标志的考古学文化；田自秉把它定为\"进入父系氏族社会后\"黄河中下游产生的文化，因最早发现于山东历城（今属章丘）龙山镇而得名（六册均未记发现年份）。六册来源一致把它当作彩陶衰落之后的技术转折点：快轮制陶、蛋壳黑陶、早期城址与凿井都集中在这一时期。来源间的差异主要在它的\"位置\"——是仰韶之后的同一序列阶段，还是与仰韶并存的东方区域文化。","path":"terms/longshan-culture.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"龙山文化是 B 维度下新石器时代晚期黑陶工艺与早期城址的类型学锚点，兼涉快轮制陶这一关键工艺转折。Theme/Topic 尚未 materialize。"},{"id":"terms:longyao","title":"龙窑（Dragon Kiln）","name_en":"Dragon Kiln","type":"term","type_zh":"术语","color":"#10B981","tags":["依山而上","火膛","分段烧成","投柴孔","1300℃"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_kiln","source_count":"3","evidence_status":"source_backed","description":"龙窑是依山而上的特殊窑形，从战国秦汉出现以来一直为人们利用，因窑身依山而上、形似火龙而得名。青瓷的出现与窑形改变有很大关系：魏晋南北朝的龙窑已能充分采用火膛与窑室连接的方式，使升焰速度加快、温度提高，获得高温烧瓷的条件，并能一次容纳大量瓷器、增加生产数量；魏晋时期开始改进龙窑形制，以“分段烧成”的方法在窑顶或窑身两侧设置投柴孔，保证烧制温度的平均，防止发生生烧现象。田自秉记汉代早期青瓷使用的窑型烧","path":"terms/longyao.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"龙窑是 B 维度下陶瓷窑炉类型的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:louchuan","title":"楼船（Tower Ship）","name_en":"Tower Ship","type":"term","type_zh":"术语","color":"#10B981","tags":["春秋战国","战船","多层","水军","女墙"],"confidence":"medium","consensus":"tentative","sub_type":"ship_type","source_count":"2","evidence_status":"source_backed","description":"楼船是春秋战国时期战船的一种，结构一般为三层，也有的达 5 层甚至 10 层，是当时水军的主力船型。杜佑《通典》称其“船上建楼三重，列女墙，战格、树幡帜，开驾窗矛穴，置抛车、垒石、铁斗，状如城垒”。汉代广州船舶以楼船为最大，高三四层，设女墙战格，篙、桨、橹、帆、舵、碇俱全。","path":"terms/louchuan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"楼船是 B 维度下先秦两汉战船类型的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:lvse-sheji","title":"绿色设计（Green Design）","name_en":"Green Design","type":"term","type_zh":"术语","color":"#10B981","tags":["3R","生态","环保","可持续"],"confidence":"medium","consensus":"tentative","sub_type":"design_concept","source_count":"2","evidence_status":"source_backed","description":"绿色设计源于对现代技术文化引起环境及生态破坏的反思，核心是“3R”，即 Reduce（节能）、Recycle（再利用）和 Reuse（循环），要求减少物质能源消耗和有害排放，使产品及零部件便于分类回收再生。夏燕靖认为它不仅是技术考量，更是观念变革，要求把重点放在真正环保意义上的创新。","path":"terms/lvse-sheji.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"绿色设计是 D 维度下现代设计观念与方法的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:majiayao-culture","title":"马家窑文化（Majiayao Culture）","name_en":"Majiayao Culture","type":"term","type_zh":"术语","color":"#10B981","tags":["新石器时代","黄河上游","彩陶","甘肃仰韶文化","舞蹈纹盆"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_culture","source_count":"6","evidence_status":"source_backed","description":"马家窑文化是黄河上游新石器时代晚期的考古学文化，因最早在甘肃临洮县瓦家坪马家窑遗址发现而得名，又称\"甘肃仰韶文化\"。六册都把它作为中国史前彩陶的最高峰之一，但**分类口径不一致**：夏燕靖两版按考古学文化处理，分为马家窑、半山、马厂三个类型；田自秉按彩陶类型处理，把\"马家窑型\"\"半山型\"\"马厂型\"与\"半坡型\"\"庙底沟型\"并列比较。本 KU 以文化条目为名，两套口径并列登记。","path":"terms/majiayao-culture.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"马家窑文化是 B 维度下黄河上游新石器时代晚期的彩陶文化条目；陶器纹饰与舞蹈纹盆的仪式含义牵涉 C 维度。文化分期与彩陶类型两套分类口径并存。"},{"id":"terms:meijin-ejin","title":"美金与恶金（Meijin and Ejin (Good and Bad Metal)）","name_en":"Meijin and Ejin (Good and Bad Metal)","type":"term","type_zh":"术语","color":"#10B981","tags":["春秋战国","铜","铁","块炼铁","礼器"],"confidence":"medium","consensus":"tentative","sub_type":"material_concept","source_count":"2","evidence_status":"source_backed","description":"春秋战国时人称铜为“美金”，用以制作礼器；称铁为“恶金”，用以制作工具。称铁为恶金的原因是当时人工冶铁所得均为块炼铁，色泽发黑、质地较为低劣；随着冶铁技术迅速提高，这一名称逐渐淘汰。","path":"terms/meijin-ejin.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"美金与恶金是 B 维度下先秦材料观念与冶铁技术的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:meiping","title":"梅瓶（Meiping (Plum Vase)）","name_en":"Meiping (Plum Vase)","type":"term","type_zh":"术语","color":"#10B981","tags":["宋代","盛酒器","小口丰肩","定窑","龙泉窑"],"confidence":"medium","consensus":"tentative","sub_type":"vessel_form","source_count":"2","evidence_status":"source_backed","description":"梅瓶是宋代瓷瓶形制，小口、短颈、圆肩、长身，尤以小口窈窕为特色，有秀丽媚妩之韵、梅骨清像之姿；深腹稳重、容量颇大，多为盛酒器。高丰记其通高一般约 40 厘米、口径仅 4—5 厘米，挺拔刚劲、峻峭雄健；宋以后梅瓶与玉壶春瓶一直沿用，成为中国古代传统酒瓶造型的典型式样。","path":"terms/meiping.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"梅瓶是 B 维度下宋代瓷酒器造型的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:ming-style-furniture","title":"明式家具（Ming-style Furniture）","name_en":"Ming-style Furniture","type":"term","type_zh":"术语","color":"#10B981","tags":["明代","家具","硬木","榫卯"],"confidence":"medium","consensus":"tentative","sub_type":"furniture_style","source_count":"5","evidence_status":"source_backed","description":"明式家具指明代中期至清代早期（约 15—17 世纪）形成的硬木家具式样，以线形造型、木构架结构、榫卯连接和不施重漆显露木纹为特征。五册来源都把它视为中国传统家具的高峰，并注意到“明式”是一个以时代命名样式的风格概念，而非严格的朝代断代。","path":"terms/ming-style-furniture.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"明式家具是 B 维度下木作工艺与器物风格命名的术语锚点，其“以时代命名式样”的命名史也涉及 A 维度的史学概念问题。Theme/Topic 尚未 materialize。"},{"id":"terms:mingguang-kai","title":"明光铠（Mingguang Armor）","name_en":"Mingguang Armor","type":"term","type_zh":"术语","color":"#10B981","tags":["北周","铠甲","圆护","护心镜"],"confidence":"medium","consensus":"tentative","sub_type":"armor_form","source_count":"2","evidence_status":"source_backed","description":"明光铠是北周新兴的铠甲形制，胸前背后装左右两块“圆护”，由铜铁制成或打磨光亮似镜，俗称“护心镜”。它与晋“筒袖铠”、南北朝“衲裆铠”并列为三种基本铠甲形制。","path":"terms/mingguang-kai.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"明光铠是 B 维度下魏晋南北朝铠甲形制的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:mingqi","title":"明器（Mingqi (Burial Goods)）","name_en":"Mingqi (Burial Goods)","type":"term","type_zh":"术语","color":"#10B981","tags":["随葬","冥器","盟器","模型"],"confidence":"medium","consensus":"tentative","sub_type":"burial_good","source_count":"2","evidence_status":"source_backed","description":"明器是我国古代专为随葬而制作的器物，又称“冥器”或“盟器”。它通常模仿各种礼器或日用器皿、工具、兵器的形状制成，除器皿外还有人、家畜及鸟兽形象，以及车船、家具、建筑物等模型，从新石器时代开始历代墓中都有发现。","path":"terms/mingqi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"明器是 B 维度下随葬器物与模型化设计的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:mise-porcelain","title":"秘色瓷（Mise Porcelain）","name_en":"Mise Porcelain","type":"term","type_zh":"术语","color":"#10B981","tags":["唐代","五代","越窑","吴越","贡瓷"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_type","source_count":"5","evidence_status":"source_backed","description":"秘色瓷是唐五代越窑烧造的高等级青瓷，长期只见于文献，1987 年法门寺地宫出土实物后始得确认。五册来源有直接记载（高丰一册无\"秘色瓷\"字样）。来源在两点上不一致：法门寺地宫所出秘色瓷的件数，以及秘色瓷主要归属唐代还是五代吴越。另外\"秘色\"之名各册均未解释，只记陆龟蒙\"秘色越器\"之称与\"千峰翠色\"之诗。本 KU 并列。","path":"terms/mise-porcelain.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"秘色瓷是 B 维度下唐五代越窑贡瓷的品种条目，其官府督造、贡奉与外交用途属 D 维度。Theme/Topic 尚未 materialize。"},{"id":"terms:muban-nianhua","title":"木版年画（Woodblock New Year Picture）","name_en":"Woodblock New Year Picture","type":"term","type_zh":"术语","color":"#10B981","tags":["雕版印刷","年画","招贴画","民间美术","清代"],"confidence":"medium","consensus":"tentative","sub_type":"print_genre","source_count":"4","evidence_status":"source_backed","description":"木版年画是用雕版印刷的民间画，题材多为世俗生活、吉祥人物与节令风俗，因常在岁末新春张贴而得名。四册中只有高丰给出定义与源流：宋代茶肆酒馆张挂名人绘画，南宋出现“纸画儿”行业，民间画家创作后雕版印刷千百张，世俗题材者“人们一般把这些画称之为木版年画”；他还特别指出，其中一些木版年画“并不限于岁末新春时才张贴”，平时也用于商业场合，“已带有招贴画的意味”。夏燕靖两版与赵农只在清代印刷段列产地与外销，不","path":"terms/muban-nianhua.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"木版年画是 C 维度下民间雕版印刷品与商业招贴的术语锚点；雕版、套色与拱花工艺属 B；产地、作坊与外销属 D。Theme/Topic 尚未 materialize。"},{"id":"terms:nanjing-yunjin","title":"南京云锦（Nanjing Yunjin Brocade）","name_en":"Nanjing Yunjin Brocade","type":"term","type_zh":"术语","color":"#10B981","tags":["明清","官营织造","妆花缎","库锦","库缎"],"confidence":"medium","consensus":"tentative","sub_type":"textile_type","source_count":"3","evidence_status":"source_backed","description":"南京云锦是官营织造生产的提花多彩丝织物，晚清时因花纹绚烂如云彩得名，包括妆花缎、库锦、库缎。其生产用长 5.6 米、高 4 米、宽 1.4 米的大花楼木质提花机，上下两人操作，一天仅织五至六厘米，故称“寸锦寸金”。","path":"terms/nanjing-yunjin.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"南京云锦是 B 维度下明清官营织造与提花丝织的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:nashishi","title":"纳石失（Nasish）","name_en":"Nasish","type":"term","type_zh":"术语","color":"#10B981","tags":["元代","织金锦","丝织","官匠局","波斯"],"confidence":"medium","consensus":"tentative","sub_type":"textile_type","source_count":"5","evidence_status":"source_backed","description":"纳石失是元代对加金织物（织金锦）的称法，以片金线或圆金线作纹纬织成，供蒙古贵族制衣与佩饰。五册来源有直接记载（李立新一册无\"纳石失\"字样）。来源在语源的确定程度上不一致：赵农直接释为波斯语译音，田自秉称\"可能是波斯语的讹译\"。高丰对元代大量加金的风气给出六册中唯一的负面评价。本 KU 并列。","path":"terms/nashishi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"纳石失是 B 维度下元代织金锦的代表品种，其波斯语源、西域工匠与官方匠局的管理方式属 E 维度。Theme/Topic 尚未 materialize。"},{"id":"terms:oracle-bone-script","title":"甲骨文（Oracle Bone Script）","name_en":"Oracle Bone Script","type":"term","type_zh":"术语","color":"#10B981","tags":["商代","占卜","龟甲","汉字体系","贞人"],"confidence":"medium","consensus":"tentative","sub_type":"script_form","source_count":"2","evidence_status":"source_backed","description":"甲骨文是商代刻写在龟甲、兽骨上的占卜文字，完整规范，使中国汉字第一次成为系统的文化体系。商朝用龟甲卜筮，占卜过程包括打磨龟腹甲背甲、去牛肩胛骨骨臼、钻孔、以蓍草烧灼，正面出现兆纹，“龟曰卜、蓍曰筮”；甲骨文内容广泛、记载明确，常见“王占曰”。","path":"terms/oracle-bone-script.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"甲骨文是 C 维度下商代文字体系的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:painted-pottery","title":"彩陶（Painted Pottery）","name_en":"Painted Pottery","type":"term","type_zh":"术语","color":"#10B981","tags":["新石器时代","仰韶文化","马家窑","陶器"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_type","source_count":"5","evidence_status":"source_backed","description":"彩陶指新石器时代在打磨光滑的陶坯上用矿物颜料绘纹、再入窑烧成，使纹样固着于器表的陶器。五册来源都把它作为中国史前装饰艺术的主要载体，重点讨论仰韶文化与马家窑文化的纹样。","path":"terms/painted-pottery.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"彩陶是 B 维度下新石器时代陶器装饰工艺的术语锚点，其纹样母题也涉及 C 维度的视觉符号问题。Theme/Topic 尚未 materialize。"},{"id":"terms:paleolithic-period","title":"旧石器时代（Paleolithic Period）","name_en":"Paleolithic Period","type":"term","type_zh":"术语","color":"#10B981","tags":["石器时代","打制石器","设计起源","原始社会","考古学分期"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_period","source_count":"6","evidence_status":"source_backed","description":"旧石器时代是以打制石器为标志的人类物质文化发展阶段，分早、中、晚三期。在六册设计史中，它不是单纯的年代背景，而是**设计起源叙事的起点**：夏燕靖两版与李立新都把石器视为人类最早的造物产品，高丰称\"旧石器时代生产工具的设计，是人类最早的设计\"，赵农称\"人类的历史就是从设计和制造器具开始的\"，田自秉则把它作为石器时代两阶段中的第一阶段。本 KU 登记定义、分期、中国境内主要遗存、石器技术演进与设计起","path":"terms/paleolithic-period.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"旧石器时代是 B 维度下的史前技术—造物分期条目，同时是六册设计起源叙事的共同起点；石器作为'物质与精神双重特性产品'的判断牵涉 C 维度。"},{"id":"terms:pei-huang","title":"佩璜（Peihuang (Ornamental Jade Pendant)）","name_en":"Peihuang (Ornamental Jade Pendant)","type":"term","type_zh":"术语","color":"#10B981","tags":["商代","佩玉","人纹璜","鸟纹璜"],"confidence":"medium","consensus":"tentative","sub_type":"jade_ornament","source_count":"2","evidence_status":"source_backed","description":"佩璜是一种玩赏性的佩玉，与礼器上的璜无关。商代佩璜已由素面无纹演变为人纹璜、鸟纹璜、色纹璜、兽纹璜等；其他玉佩有象纹佩、牛纹佩、兔纹佩、龟纹佩、鹿纹佩、鸟纹佩、凤纹佩等，形式变化比较自由。","path":"terms/pei-huang.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"佩璜是 B 维度下商代佩玉的类型条目。Theme/Topic 尚未 materialize。"},{"id":"terms:piao-ci","title":"缥瓷（Piao Porcelain）","name_en":"Piao Porcelain","type":"term","type_zh":"术语","color":"#10B981","tags":["晋代","青瓷","瓯窑","淡青釉"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_type","source_count":"2","evidence_status":"source_backed","description":"缥瓷是魏晋南北朝时期出现的淡青色玻璃釉青瓷，即青白色瓷器。田自秉引晋潘岳《笙赋》“倾缥瓷以酌酝”，并称瓯窑胎白釉淡青的制品即晋代诗文所称缥瓷。李立新记当时青瓷胎含铁量增加，出现以淡青色玻璃釉青瓷的“缥瓷”，并形成浙江与河北为中心的南北两大青瓷体系。","path":"terms/piao-ci.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"缥瓷是 B 维度下魏晋南北朝青瓷类型的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:pibo","title":"披帛（Pibo (Silk Shawl)）","name_en":"Pibo (Silk Shawl)","type":"term","type_zh":"术语","color":"#10B981","tags":["隋唐","女装","纱罗","长条"],"confidence":"medium","consensus":"tentative","sub_type":"garment_accessory","source_count":"2","evidence_status":"source_backed","description":"披帛是隋唐女子衣着的组成部分，一般用轻薄的纱、罗或绢裁成长条，长度在两米以上，绕缠于两臂之间，行走时随手臂摆动飘舞；讲究者加饰彩画。","path":"terms/pibo.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"披帛是 B 维度下隋唐女子服饰配件的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:ping-feng","title":"屏风（Folding Screen）","name_en":"Folding Screen","type":"term","type_zh":"术语","color":"#10B981","tags":["西周","春秋战国","魏晋南北朝","家具","隔档"],"confidence":"medium","consensus":"tentative","sub_type":"furniture_form","source_count":"1","evidence_status":"source_backed","description":"屏风是起隔档、挡风作用的家具，并延伸到室内空间的分割。赵农记其在西周出现，称“扆”“黼扆”，张置于主人座位后面；春秋战国时放置在床后，屏风上附有彩绘，并有铜构件镶嵌。魏晋南北朝时屏风有完整的制法，也有多扇组合，形态包括围屏、座屏、板屏、插屏、挂屏、折屏。与屏风接近的步障用于室外临时遮蔽。","path":"terms/ping-feng.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"屏风是 B 维度下家具形制的条目：隔档、挡风与室内空间分割的形制演变在此汇合。Theme/Topic 尚未 materialize。"},{"id":"terms:ping-ji","title":"凭几（Pingji (Arm Rest)）","name_en":"Pingji (Arm Rest)","type":"term","type_zh":"术语","color":"#10B981","tags":["汉代","魏晋","席地而坐","三足几"],"confidence":"medium","consensus":"tentative","sub_type":"furniture_form","source_count":"2","evidence_status":"source_backed","description":"凭几又称倚几、隐几，是席地跪坐疲倦时供胳臂和肘部扶倚、以分散压力的家具。汉代马王堆三号汉墓出土龙纹漆几，几面扁平，下部安高矮两对足；魏晋时期凭几为三足形，几面呈扁平圆弧形，安徽马鞍山东吴朱然墓黑红漆几即此类。","path":"terms/ping-ji.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"凭几是 B 维度下汉魏席坐家具的类型条目。Theme/Topic 尚未 materialize。"},{"id":"terms:plastic","title":"塑料（Plastic）","name_en":"Plastic","type":"term","type_zh":"术语","color":"#10B981","tags":["高分子材料","热塑性","热固性","1958"],"confidence":"medium","consensus":"tentative","sub_type":"material_type","source_count":"2","evidence_status":"source_backed","description":"塑料是以天然或合成树脂为基本原料，含填料、增塑剂、着色剂等成分，可在一定条件下塑化成形的材料，分热塑性和热固性两类。具有材质轻巧、绝缘性强、耐腐蚀、颜色美观、易加工等特点；塑型方法有注塑、搪塑、模塑、吹塑、压塑和挤塑。","path":"terms/plastic.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"塑料是 B 维度下现代人工材料与成型工艺的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:pointed-bottom-jar","title":"尖底瓶（Pointed-bottom Jar）","name_en":"Pointed-bottom Jar","type":"term","type_zh":"术语","color":"#10B981","tags":["新石器时代","仰韶文化","汲水器","力学设计"],"confidence":"medium","consensus":"tentative","sub_type":"vessel_form","source_count":"6","evidence_status":"source_backed","description":"尖底瓶是新石器时代仰韶、半坡、北首岭、庙底沟等类型的汲水器，小口、尖底、腹部双耳。六册来源一致把它当作\"功能决定造型\"的典型例证，但在其力学原理的解释路径上分成三种说法，且对尖底的用途给出了不止一种功能。本 KU 合并登记这些解释，不裁定。","path":"terms/pointed-bottom-jar.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"尖底瓶是 B 维度下新石器时代汲水器形制的代表条目，六册一致用它论证功能决定造型的设计逻辑。Theme/Topic 尚未 materialize。"},{"id":"terms:proto-porcelain","title":"原始青瓷（Proto-porcelain）","name_en":"Proto-porcelain","type":"term","type_zh":"术语","color":"#10B981","tags":["商周","战国","瓷器起源","青釉"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_type","source_count":"6","evidence_status":"source_backed","description":"原始青瓷是商周至战国时期介于陶与瓷之间的青釉器，用高岭土作胎、经 1100—1200℃ 高温烧成、表面有玻璃釉质，但工艺尚未成熟，故称\"原始\"。六册来源均有直接记载，并用它来确定中国瓷器发明的年代上限；高丰一册另用\"原始瓷器\"一名，并记商代至东汉成熟瓷器之间约 1000 多年的过渡时长。来源在\"何时开始\"上给出的时间点不同，本 KU 并存。","path":"terms/proto-porcelain.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"原始青瓷是 B 维度下陶—瓷过渡阶段的技术类型条目，五册来源用以确定中国瓷器发明的上限年代。Theme/Topic 尚未 materialize。"},{"id":"terms:qian-you-tao","title":"铅釉陶（Lead-Glazed Pottery）","name_en":"Lead-Glazed Pottery","type":"term","type_zh":"术语","color":"#10B981","tags":["低温铅釉","汉代","银釉","黄绿釉"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_type","source_count":"3","evidence_status":"source_backed","description":"铅釉陶是涂有黄绿色低温铅釉的陶器。铅釉熔点低，约 700℃~800℃ 即可烧成，并能薄薄匀挂在胎上；釉中混有不同金属元素则形成黄、绿、褐、土红等多种色彩。铅釉陶是汉代陶瓷工艺的代表，因釉面泛出银色光彩，又称银釉。","path":"terms/qian-you-tao.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"铅釉陶是 B 维度下汉代低温釉陶的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:qiangjin","title":"戗金（Qiangjin (Engraved Gold Lacquer)）","name_en":"Qiangjin (Engraved Gold Lacquer)","type":"term","type_zh":"术语","color":"#10B981","tags":["漆器","针刻","填金","戗银","辍耕录"],"confidence":"medium","consensus":"tentative","sub_type":"lacquer_technique","source_count":"2","evidence_status":"source_backed","description":"戗金是在漆面雕刻花纹、在刻纹中上漆后再填金粉的漆器装饰技法，起源于战国针刻。填银称戗银、填彩漆称填彩，花纹仍呈刻划的阴文；与描金同属金漆主要品种。《辍耕录》记戗金戗银法：以黑漆为地、针刻画，再以新罗漆调雌黄（金）或韶粉（银）嵌缝，铺金银薄揩实。","path":"terms/qiangjin.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"戗金是 B 维度下漆器装饰技法的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:qijia-wenhua","title":"齐家文化（Qijia Culture）","name_en":"Qijia Culture","type":"term","type_zh":"术语","color":"#10B981","tags":["黄河上游","甘肃广河","铜器","双耳罐","马鞍口陶罐"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_culture","source_count":"2","evidence_status":"source_backed","description":"齐家文化是黄河上游在马家窑、半山、马厂型之后兴起的文化，时间约等于龙山文化时期，基本上和夏代相始终；彩陶不多，装饰纹样以菱形纹、棋格纹、网格纹为最多，器形以双耳罐和马鞍口式陶罐为典型。2016 记其为黄河上游新石器中晚期文化，位于甘肃广河县齐家坪，并称其出现铜器；马家窑文化在时间顺序上下接齐家文化。","path":"terms/qijia-wenhua.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"齐家文化是 B 维度下黄河上游新石器时代文化的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:qin-zhuan-han-wa","title":"秦砖汉瓦（Qin Bricks and Han Tiles）","name_en":"Qin Bricks and Han Tiles","type":"term","type_zh":"术语","color":"#10B981","tags":["秦汉","建筑材料","画像砖","瓦当","陶制砖瓦"],"confidence":"medium","consensus":"tentative","sub_type":"building_component","source_count":"3","evidence_status":"source_backed","description":"秦砖汉瓦是秦汉陶制砖瓦的合称，涵盖画像砖、砌墙砖、铺地砖、空心砖、条砖、筒瓦、板瓦与圆瓦当。三册的叙述位置不同：夏燕靖两版把它放在\"陶瓷设计\"的彩绘陶之后，以画像砖的图像价值与瓦当的纹饰文字为主，并给出\"烧成后吸水有声，故后世有'秦砖汉瓦'之称\"的得名解释；赵农把它放在\"建筑\"的砖瓦段，以陶制砖瓦技术对土木建筑屋顶与中原建筑样式成型的作用为主，另记楔形、榫头形异形砖与方位性瓦当。本 KU 以两套叙","path":"terms/qin-zhuan-han-wa.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"秦砖汉瓦是 B 维度下秦汉建筑材料的合称条目；制坯、烧造、砌拱与瓦当方位属 B，画像砖的社会图像与四神方位观念牵涉 C 维度。Theme/Topic 尚未 materialize。"},{"id":"terms:qing-ci","title":"青瓷（Celadon）","name_en":"Celadon","type":"term","type_zh":"术语","color":"#10B981","tags":["东汉","越窑","瓯窑","婺窑","德清窑"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_type","source_count":"2","evidence_status":"source_backed","description":"青瓷是我国最早出现的瓷器品种，东汉末年出现，浙江越窑的青瓷成就体现了最高水平；江苏宜兴、江西、湖南、四川等地都出现了早期青瓷的窑址。三国两晋南北朝时期瓷器出现北方白瓷和南方青瓷的分流。魏晋时期青瓷产地主要集中在浙江上虞、永嘉、萧山、余姚、绍兴、临海、丽水、吴兴、德清等地，大体分四个系统：曹娥江地区的越窑、瓯江地区的瓯窑、金衢地区的婺窑、浙北东苕溪地区的德清窑。青瓷常常以动物为造型，增加了青瓷的美感","path":"terms/qing-ci.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"青瓷是 B 维度下瓷器类型的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:qing-style-furniture","title":"清式家具（Qing-style Furniture）","name_en":"Qing-style Furniture","type":"term","type_zh":"术语","color":"#10B981","tags":["家具","清代","广作","苏作","京作"],"confidence":"medium","consensus":"tentative","sub_type":"furniture_style","source_count":"3","evidence_status":"source_backed","description":"清式家具是相对于明式家具的风格概念，指康熙晚期至乾隆近百年间形成的、以广式、苏式、京式三大产地风格共同构成的家具类型。高丰给三期说、造办处背景、三作分工与三条整体风格；田自秉给\"明式简练，清式繁琐\"的总判断与苏作、广作、京作在榫、雕、鳔上的工艺差别；赵农给\"繁琐雕琢、富丽华贵\"的定性，并以太师椅、架子床、宝座、鹿角椅、玫瑰椅、摇椅等具体品类展开。三册对清式的评价一致偏低，但落点不同：高丰着眼于宫廷","path":"terms/qing-style-furniture.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"清式家具是 B 维度下明清高型家具的风格条目；造型、榫卯、雕刻与镶嵌工艺属 B，宫廷威权与满族政治象征牵涉 C 维度。Theme/Topic 尚未 materialize。"},{"id":"terms:qingdai-jiaju-sanda-mingzuo","title":"清代家具三大名作（Three Great Qing Furniture Styles）","name_en":"Three Great Qing Furniture Styles","type":"term","type_zh":"术语","color":"#10B981","tags":["清代","苏作","广作","京作","地方风格"],"confidence":"medium","consensus":"tentative","sub_type":"furniture_style","source_count":"2","evidence_status":"source_backed","description":"清代家具以苏作、广作和京作为代表，被称为清代家具三大名作。三者造型与装饰设计各具地方特色，并且一直保持到现在。","path":"terms/qingdai-jiaju-sanda-mingzuo.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"清代家具三大名作是 B 维度下清代家具地域风格的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:qingtong-jiuqi","title":"青铜酒器（Bronze Wine Vessels）","name_en":"Bronze Wine Vessels","type":"term","type_zh":"术语","color":"#10B981","tags":["尊","彝","壶","爵","五爵"],"confidence":"medium","consensus":"tentative","sub_type":"vessel_category","source_count":"2","evidence_status":"source_backed","description":"青铜酒器分盛酒器和饮酒器两类：盛酒器有尊、彝、壶、卣、罍、觥、盉等，饮酒器有爵、斝、角、觚、觯等。尊由陶尊演变而来，彝与尊同作祭奠使用物，壶仿陶壶、陶壶又仿天然瓜瓢；爵、斝、觚、觯、角合称五爵，其中爵是发现最早的青铜容器，始见于二里头遗址。","path":"terms/qingtong-jiuqi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"青铜酒器是 B 维度下商周青铜器类的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:qingtong-liqi","title":"青铜礼器（Bronze Ritual Vessels）","name_en":"Bronze Ritual Vessels","type":"term","type_zh":"术语","color":"#10B981","tags":["商周","祭祀","典礼","等级","奴隶主"],"confidence":"medium","consensus":"tentative","sub_type":"vessel_category","source_count":"3","evidence_status":"source_backed","description":"青铜礼器是商周时期用于祭祀和典礼的青铜日用器。其造型设计除实用外，多考虑放置祭坛上的陈设效果，因而日用器物造型有了不同因素的观念与审美追求，尤其成为奴隶主阶级表达观念、实行统治的重要工具。西周以成套礼制规定使用数量和规格，使贵贱有等、上下有别。","path":"terms/qingtong-liqi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"青铜礼器是 B 维度下商周青铜器类的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:qingtong-shidai","title":"青铜时代（Bronze Age）","name_en":"Bronze Age","type":"term","type_zh":"术语","color":"#10B981","tags":["夏商周","三代","礼器","公元前2000年"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_period","source_count":"2","evidence_status":"source_backed","description":"青铜时代是继旧石器时代、新石器时代后第三个文明期。书中把夏商周时期称为“青铜时代”；中国青铜时代从公元前 2000 年左右开始形成，历时大约 15 个世纪。其特点包括使用大量青铜生产工具、兵器和礼器，且在进入青铜时代以前已有漫长的利用铜矿物制造器具的历史。","path":"terms/qingtong-shidai.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"青铜时代是 B 维度下技术史分期的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:qingtong-shiqi","title":"青铜食器（Bronze Food Vessels）","name_en":"Bronze Food Vessels","type":"term","type_zh":"术语","color":"#10B981","tags":["鼎","鬲","甗","簋","簠"],"confidence":"medium","consensus":"tentative","sub_type":"vessel_category","source_count":"2","evidence_status":"source_backed","description":"青铜食器分煮食器和盛食器两类：煮食器有鼎、鬲、甗等，盛食器有簋、簠、盌、豆等。鬲最初由陶鬲、再经鼎演变而来，三足上部肥大内空以增加受热面积；甗由上部甑和下部鬲结合而成，中间隔穿孔铜片；簋圆腹侈口圈足，常以偶数与鼎配置；簠为长方形，盌为方中带圆的椭圆形，豆则上有盘、中有柄、底为圈足。","path":"terms/qingtong-shiqi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"青铜食器是 B 维度下商周青铜器类的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:qingtong-shuiqi","title":"青铜水器（Bronze Water Vessels）","name_en":"Bronze Water Vessels","type":"term","type_zh":"术语","color":"#10B981","tags":["鉴","盘","匜","盂","沃盥"],"confidence":"medium","consensus":"tentative","sub_type":"vessel_category","source_count":"2","evidence_status":"source_backed","description":"青铜水器主要有鉴、盘、匜、盂、缶、瓿等。匜是西周后出现的盥洗器，器形仿自瓜瓢，前有流、后有鋬，与盘配合用于沃盥之礼；盘为圆形浅腹，商代无耳圈足，西周中期后加耳，虢季子白盘即著名盥洗器；鉴形体较大，有圆、方两种；盂为圆腹深腹附耳盛水器。","path":"terms/qingtong-shuiqi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"青铜水器是 B 维度下商周青铜器类的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:qingtong","title":"青铜（Bronze）","name_en":"Bronze","type":"term","type_zh":"术语","color":"#10B981","tags":["铜锡合金","六齐","红铜","铜石并用"],"confidence":"medium","consensus":"tentative","sub_type":"material_type","source_count":"2","evidence_status":"source_backed","description":"青铜是铜、锡、铅等元素的合金，较纯铜熔点低、硬度高，具有较好的铸造与机械性能。田自秉定义为用红铜加锡的一种合金，因颜色灰青故名；红铜指天然铜。并指出青铜时代之前应当还有一个红铜时代，历史学家称为铜石并用时代。高丰引《考工记》“金有六齐”，指出含锡约 17% 的青铜色泽美观、声音好、可铸精细花纹，一般青铜鼎即用此配方。","path":"terms/qingtong.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"青铜是 B 维度下金属材料的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:qipao","title":"旗袍（Qipao）","name_en":"Qipao","type":"term","type_zh":"术语","color":"#10B981","tags":["清代","民国","近代","女装","满族"],"confidence":"medium","consensus":"tentative","sub_type":"garment_form","source_count":"4","evidence_status":"source_backed","description":"旗袍是清代满族妇女长袍演变而来的女装形制，近代经收紧腰身等改造后成为流行时装。四册来源有直接记载（田自秉、李立新两册无\"旗袍\"字样）。来源对\"旗袍\"之名系于何时、清代形态由谁影响谁、以及近代流行由什么媒介推动，三处表述不同。本 KU 并列，不裁定。","path":"terms/qipao.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"E","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"旗袍是 E 维度下近代女装改良的代表条目，其礼装规定与满汉服制属 D 维度。Theme/Topic 尚未 materialize。"},{"id":"terms:rendong-wen","title":"忍冬纹（Honeysuckle Scroll Motif）","name_en":"Honeysuckle Scroll Motif","type":"term","type_zh":"术语","color":"#10B981","tags":["六朝","卷草","植物纹","敦煌","石刻"],"confidence":"medium","consensus":"tentative","sub_type":"decorative_motif","source_count":"2","evidence_status":"source_backed","description":"忍冬纹是六朝流行的卷草状植物纹，通称卷草。纹样取忍冬花（金银花）枝叶变化或莲叶演变，一般三叶片与一叶片相对排列，有单叶双叶、顺向相背等变化；东晋北魏之后与莲花纹一起渗透于铜器、金银器、砖瓦、石刻、藻井、柱础等造物类型，唐代演变为繁复的卷草，成为中国造物装饰的主题。","path":"terms/rendong-wen.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"忍冬纹是 C 维度下六朝外来植物纹样的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:shachuan","title":"沙船（Shachuan (Sand Ship)）","name_en":"Shachuan (Sand Ship)","type":"term","type_zh":"术语","color":"#10B981","tags":["崇明","平底","多桅多帆","海船"],"confidence":"medium","consensus":"tentative","sub_type":"ship_type","source_count":"2","evidence_status":"source_backed","description":"沙船是江苏崇明创制的多桅多帆平底船，便于掌握风向，吃水浅、速度快，可载重 5000 石左右；赵农记其为宋代海船制造中出现的一种平底船样式。","path":"terms/shachuan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"沙船是 B 维度下古代海船类型的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:she-yan","title":"歙砚（She Inkstone）","name_en":"She Inkstone","type":"term","type_zh":"术语","color":"#10B981","tags":["婺源","龙尾砚","眉子","罗纹","金星"],"confidence":"medium","consensus":"tentative","sub_type":"inkstone_type","source_count":"2","evidence_status":"source_backed","description":"歙砚相传开采于唐代开元年间的婺源山中，此地属歙州管辖，宋代就颇具规模，当时的歙砚中有“龙尾砚”与南唐澄心堂纸齐名。元末至清初一度停止开采，乾隆年间重新恢复采石制砚的活动；歙砚粒度细腻、匀称密实，质地泛青灰色，并有眉子、罗纹、金星、金纹等天然花纹。","path":"terms/she-yan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"歙砚是 B 维度下文房砚台的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:shenyi","title":"深衣（Shenyi）","name_en":"Shenyi","type":"term","type_zh":"术语","color":"#10B981","tags":["先秦","秦汉","服饰","礼服制度","礼记"],"confidence":"medium","consensus":"tentative","sub_type":"garment_form","source_count":"5","evidence_status":"source_backed","description":"深衣是先秦至汉代的主要服装形制，把上衣与下裳连为一体、衣襟绕身、以带束腰。五册来源有直接记载（田自秉一册无\"深衣\"字样）。来源在三个点上不一致：起始时代（春秋战国／周代／商代）、直裾是否属深衣、以及服用者的等级范围。本 KU 并列，不裁定。","path":"terms/shenyi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"深衣是 B 维度下的服装形制条目，其制度面（礼记规范、等级服用）属 D 维度。Theme/Topic 尚未 materialize。"},{"id":"terms:shi-class","title":"士（Shi (Scholar-Gentry)）","name_en":"Shi (Scholar-Gentry)","type":"term","type_zh":"术语","color":"#10B981","tags":["先秦","社会阶层","学在官府","知识分子"],"confidence":"medium","consensus":"tentative","sub_type":"social_group","source_count":"2","evidence_status":"source_backed","description":"士是我国古代社会中具有一定身份地位的特定社会阶层，后演变为对知识分子的泛称。它原指原始社会末期与氏族部落首领和显贵同族的武士，进入阶级社会后成为统治阶级的一部分；因古代学在官府，只有士以上的贵胄子弟才有文化知识，故士又成了有一定知识和技能之人的称呼。","path":"terms/shi-class.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"士是 D 维度下先秦社会阶层与知识制度的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:shiliu-qun","title":"石榴裙（Pomegranate Skirt）","name_en":"Pomegranate Skirt","type":"term","type_zh":"术语","color":"#10B981","tags":["唐代","红裙","石榴花","女装"],"confidence":"medium","consensus":"tentative","sub_type":"garment_form","source_count":"2","evidence_status":"source_backed","description":"石榴裙是唐代流行的鲜艳红裙，其色如石榴之红、绘石榴大花。一般百姓穿不起安乐公主式百鸟毛裙，遂以颜色和式样取胜，石榴裙因而流行；敦煌壁画与唐代绘画可见裙制变化。另有“拜倒在石榴裙下”俗语与唐明皇、杨贵妃传说。","path":"terms/shiliu-qun.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"石榴裙是 B 维度下唐代女装裙式的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:shu-brocade","title":"蜀锦（Shu Brocade）","name_en":"Shu Brocade","type":"term","type_zh":"术语","color":"#10B981","tags":["四川","成都","三国","经锦","加金"],"confidence":"medium","consensus":"tentative","sub_type":"textile_type","source_count":"2","evidence_status":"source_backed","description":"蜀锦是四川生产的高级织锦，三国时为蜀国主要军费来源，魏、吴争求；两晋仍以蜀锦著名，左思《蜀都赋》描写成都织造盛况。具有千年左右历史，按图案组织分方方、雨丝、条花、散花；保持唐代以前经锦传统，是现今唯一用多色经丝与纬线交织起花的织锦。","path":"terms/shu-brocade.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"蜀锦是 B 维度下四川织锦类型的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:sichou-zhilu","title":"丝绸之路（Silk Road）","name_en":"Silk Road","type":"term","type_zh":"术语","color":"#10B981","tags":["秦汉","隋唐","丝织","西域","海上丝绸之路"],"confidence":"medium","consensus":"tentative","sub_type":"trade_route","source_count":"5","evidence_status":"source_backed","description":"丝绸之路是汉代开通的、以丝绸贸易为主的东西方交通通道。五册给出两条不完全重合的定义线：夏燕靖两版以 1877 年李希霍芬、1910 年赫尔曼的命名为核心，把它定为“中国古代经由中亚通往南亚、西亚以及欧洲、北非的陆上贸易交往的通道”；赵农与高丰则同时记陆上干道、西南通道与“海上丝绸之路”，外延大于夏燕靖的陆上定义。田自秉不记命名，只记汉代丝织品作为赏赐、商品与文化交流物品的外销及国外出土。本 KU ","path":"terms/sichou-zhilu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"丝绸之路是 D 维度下汉代丝织品贸易与跨区域流通的术语锚点；丝织生产与织物品种属 B，中西物质文化交流属 E。Theme/Topic 尚未 materialize。"},{"id":"terms:songban-shu","title":"宋版书（Song Dynasty Block-Printed Books）","name_en":"Song Dynasty Block-Printed Books","type":"term","type_zh":"术语","color":"#10B981","tags":["宋代","雕版印刷","汴本","浙本","建本"],"confidence":"medium","consensus":"tentative","sub_type":"print_genre","source_count":"2","evidence_status":"source_backed","description":"宋版书是宋代雕版印刷的书籍，有雕刻精湛、校对细心、印制清晰等优点，书体整齐规范，主要用皮纸和麻纸，后世成为收藏极品。它在京城开封、浙江杭州、福建建阳、四川眉山等地形成刻印中心，简称汴本、浙本、建本、蜀本，其中以浙江水平最好；又有官刻、家刻、坊刻三种生产方式。","path":"terms/songban-shu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"宋版书是 C 维度下雕版印刷书籍与版本类型的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:songti-zi","title":"宋体字（Songti Typeface）","name_en":"Songti Typeface","type":"term","type_zh":"术语","color":"#10B981","tags":["雕版印刷","宋版书","明体字","老宋字"],"confidence":"medium","consensus":"tentative","sub_type":"typeface","source_count":"2","evidence_status":"source_backed","description":"宋体字是宋代雕版印书上出现的印刷字体，结构严谨紧密、端正整齐，笔画横平竖直、横细直粗、起落笔有棱角。其形成综合欧、柳、颜体书法风格，尤其受颜体影响，并适应雕版快速刻字的实际需要。学界有宋体字始于明万历年间、日本称“明体字”的不同看法；高丰据宋版字体特征主张宋体字始创于宋、成熟于明。","path":"terms/songti-zi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"宋体字是 C 维度下印刷字体的核心条目。Theme/Topic 尚未 materialize。"},{"id":"terms:suniboqing","title":"苏泥勃青（Sumali Blue (Cobalt Pigment)）","name_en":"Sumali Blue (Cobalt Pigment)","type":"term","type_zh":"术语","color":"#10B981","tags":["明代","青花","钴料","宣德","波斯"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_material","source_count":"2","evidence_status":"source_backed","description":"苏泥勃青是明代景德镇青花采用的青料，来自波斯（赵农）或南洋输入（田自秉）；宣德青花用之，色调深沉雅静，浓厚处与釉汁渗合形成斑点，产生深浅浓淡的自然美。使用这种青料使瓷器呈现深蓝、淡蓝、紫蓝等不同效果。","path":"terms/suniboqing.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"苏泥勃青是 B 维度下青花钴料的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:sushi-caihua","title":"苏式彩画（Suzhou-Style Architectural Painting）","name_en":"Suzhou-Style Architectural Painting","type":"term","type_zh":"术语","color":"#10B981","tags":["清代","建筑彩画","烟云退晕","枋心","拙政园"],"confidence":"medium","consensus":"tentative","sub_type":"architectural_painting","source_count":"2","evidence_status":"source_backed","description":"苏式彩画是清代建筑彩画南派，最大特征是枋心轮廓作烟云式退晕，黑、白、灰由外到内、由深到浅画出起伏弧线；枋心主花为山水、人物、花草、鸟兽的中国画形式，藻头、箍头以鱼子纹、鱼鳞纹、万字流水等几何纹衬托。它适宜装饰园林亭榭楼阁，苏州拙政园、北京颐和园长廊和谐趣园、香山见心斋为代表。","path":"terms/sushi-caihua.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"苏式彩画是 B 维度下清代建筑彩画的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:tang-sancai","title":"唐三彩（Tang Sancai）","name_en":"Tang Sancai","type":"term","type_zh":"术语","color":"#10B981","tags":["唐代","铅釉陶","明器","低温釉"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_type","source_count":"5","evidence_status":"source_backed","description":"唐三彩是唐代盛行的低温铅釉陶器，以白（黄）色黏土或高岭土制胎，施以铜、铁、钴、锰等金属氧化物着色的铅釉，经约 900℃ 低温烧成。五册来源都强调其釉色以黄、绿、赭（褐）、白为主并可出现蓝彩，产品主要用作随葬明器。","path":"terms/tang-sancai.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"唐三彩是 B 维度下低温铅釉陶工艺与唐代明器体系的术语锚点。Theme/Topic 尚未 materialize。"},{"id":"terms:tangci","title":"搪瓷（Enamelware）","name_en":"Enamelware","type":"term","type_zh":"术语","color":"#10B981","tags":["珐琅","金属胎","洋瓷","1958","脸盆"],"confidence":"medium","consensus":"tentative","sub_type":"enamelware_type","source_count":"2","evidence_status":"source_backed","description":"搪瓷是在金属表面附有珐琅质层的制品，瓷釉以铅、锡、硼砂、石英等制成。制造先冲压金属坯胎，利用洒喷、浸渍等方法涂敷一层或多层珐琅浆，采用印花、喷花、描花、贴花、洒花等装饰，经干燥、烧制而成；瓷釉和金属坯胎的热涨系数应相同，否则会出现珐琅质龟裂。","path":"terms/tangci.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"搪瓷是 B 维度下金属胎珐琅制品的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:tao-gui","title":"陶鬶（Pottery Gui (Tripod Pourer)）","name_en":"Pottery Gui (Tripod Pourer)","type":"term","type_zh":"术语","color":"#10B981","tags":["龙山文化","款足","鸟喙流","炊煮器"],"confidence":"medium","consensus":"tentative","sub_type":"vessel_form","source_count":"2","evidence_status":"source_backed","description":"陶鬶是龙山文化常见炊煮器，由陶鼎演变而来，以三条肥大中空的款足代替鼎的实心足，扩大受热面积；颈部高拔，口前部有冲天鸟喙状长流，形似昂首挺胸的大鸟。书中认为其形态别致，体现陶匠师实用与美观有机结合的造型设计思想。","path":"terms/tao-gui.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"陶鬶是 B 维度下龙山文化炊器的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:tao-zeng","title":"陶甑（Pottery Zeng (Steamer)）","name_en":"Pottery Zeng (Steamer)","type":"term","type_zh":"术语","color":"#10B981","tags":["河姆渡","蒸食","蒸汽孔","炊器"],"confidence":"medium","consensus":"tentative","sub_type":"vessel_form","source_count":"2","evidence_status":"source_backed","description":"陶甑是底部有通蒸汽小孔的蒸食器，功能类似“蒸屉”。河姆渡文化陶甑有盆形或罐形，两侧有耳，底部有许多通蒸汽的小孔；其功能是利用蒸汽熟化食物。书中认为陶甑的出现促进了人类从煮食向蒸食的过渡，是陶器功能设计的一项重要进展。","path":"terms/tao-zeng.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"陶甑是 B 维度下新石器时代炊器的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:taotie-motif","title":"饕餮纹（Taotie Motif）","name_en":"Taotie Motif","type":"term","type_zh":"术语","color":"#10B981","tags":["商周","青铜器","兽面纹","纹样","礼器"],"confidence":"medium","consensus":"tentative","sub_type":"decorative_motif","source_count":"4","evidence_status":"source_backed","description":"饕餮纹是商代至西周早期青铜器上最有代表性的兽面纹样，通常表现为被夸张或幻想的动物头部正面：横眉咧口、宽鼻瞪眼、口中有獠牙或锯齿形牙，额上有一对立耳或大犄角，并有一对利爪；也有用相对的两个夔纹组成一个兽面。四册的界定有宽窄：高丰与田自秉把它定为商代至西周早期或殷代青铜器的主纹；夏燕靖 2016 把商早期纹饰主体称为“兽面纹”，到殷商早期才说“饕餮纹处于松散状态”，把饕餮纹作为后段名称；赵农只给图题与","path":"terms/taotie-motif.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"饕餮纹是 B 维度下商周青铜器装饰母题的术语锚点；其图像构成、对称与地纹处理属 C；礼器制度与祭祀功能可在后续 Topic 中与 D 连接。Theme/Topic 尚未 materialize。"},{"id":"terms:tianji-hu","title":"天鸡壶（Tianji Ewer (Chicken-Head Ewer)）","name_en":"Tianji Ewer (Chicken-Head Ewer)","type":"term","type_zh":"术语","color":"#10B981","tags":["六朝","隋代","鸡首","壶式"],"confidence":"medium","consensus":"tentative","sub_type":"vessel_form","source_count":"3","evidence_status":"source_backed","description":"天鸡壶是六朝至隋代流行的壶式。它在盘口壶基础上，于肩部一面加鸡头、另一面安把手接盘口：早期鸡头纯作装饰，东晋以后鸡头加长，也有改作羊头、牛头、虎头或两侧刻双翅者，壶体渐高瘦长，至唐代演变为龙耳壶。与六朝相比，隋代天鸡壶腹部修长、上圆下瘦，鸡头雄健，鸡颈较粗；六朝则腹矮底大、鸡头较小、鸡颈呈管状。另有“一边鸡头、一边龙柄、颈部作竹节形”的壶式描述，见于隋和初唐。","path":"terms/tianji-hu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"天鸡壶是 B 维度下六朝隋代壶式的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:tieqi-shidai","title":"铁器时代（Iron Age）","name_en":"Iron Age","type":"term","type_zh":"术语","color":"#10B981","tags":["赫梯","陨铁","铸铁鼎","生产力"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_period","source_count":"2","evidence_status":"source_backed","description":"铁器时代是人类文明史中的重要转折时期。人们最早知道的铁是陨石中的铁，古埃及人称之为神物；世界上最早制造铁器的是小亚细亚的赫梯人，约在公元前 1400 年左右。我国最早使用铁制工具的文字记载是春秋《左传》中的晋国铸铁鼎；铁器广泛使用使工具制造进入全新领域，生产力极大提高。","path":"terms/tieqi-shidai.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"铁器时代是 B 维度下技术史分期的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:tihuaji","title":"提花机（Figured Loom）","name_en":"Figured Loom","type":"term","type_zh":"术语","color":"#10B981","tags":["汉代","多综多蹑","花楼","束综","马王堆"],"confidence":"medium","consensus":"tentative","sub_type":"device_type","source_count":"3","evidence_status":"source_backed","description":"提花机是按花纹要求提综开口、织造复杂织物的织机。汉代已普遍使用，出现多综多蹑织机，能织复杂花纹；蹑为脚踏杆，汉时已达 120 蹑。东汉还发明花楼式束综提花机，以线综调配提花经线，提高图案质量，使纹饰有大面积花样变化。","path":"terms/tihuaji.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"提花机是 B 维度下织造设备的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:tongjing","title":"铜镜（Bronze Mirror）","name_en":"Bronze Mirror","type":"term","type_zh":"术语","color":"#10B981","tags":["青铜器","梳妆用具","战国","唐代","鉴"],"confidence":"medium","consensus":"tentative","sub_type":"device_type","source_count":"3","evidence_status":"source_backed","description":"铜镜是以铜（及锡、铅等合金）铸造、用以梳妆照脸的生活日用品。三册对它的起点判断不一致：夏燕靖两版说\"铜镜从战国时期开始出现并流行\"；赵农说铜镜\"起源是在新石器时期晚期的齐家文化\"，商周已开始发达、战国初步兴盛。本 KU 把两套起点并列，并以战国形制、唐代繁盛两段为主体；汉代一段另立 `terms/hanjing.md`，本条只作过渡。","path":"terms/tongjing.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"铜镜是 B 维度下青铜生活用具的器类条目；从鉴水到鉴镜的观念转变、镜背纹样的信仰含义牵涉 C 维度。Theme/Topic 尚未 materialize。"},{"id":"terms:touguang-jing","title":"透光镜（Light-Transmitting Mirror）","name_en":"Light-Transmitting Mirror","type":"term","type_zh":"术语","color":"#10B981","tags":["汉代","铜镜","铸造应力","光学"],"confidence":"medium","consensus":"tentative","sub_type":"bronze_mirror_type","source_count":"2","evidence_status":"source_backed","description":"透光镜是西汉出现的一种特殊铜镜，外形与普通镜相同，并非真正透光；日光照射镜面时，对面墙上能映出镜背花纹的影像。赵农把它列为汉代铜镜技术中最令人叹为观止的品种，并记其工艺与样式在隋唐仍有流传；田自秉记近代研究以铸造应力和研磨压应力造成的镜面曲率解释这一效应。","path":"terms/touguang-jing.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"透光镜是 B 维度下汉代铜镜铸造与光学效应结合的专门条目。Theme/Topic 尚未 materialize。"},{"id":"terms:tuotai-qiqi","title":"脱胎漆器（Tuotai (Bodiless) Lacquerware）","name_en":"Tuotai (Bodiless) Lacquerware","type":"term","type_zh":"术语","color":"#10B981","tags":["夹纻","乾隆","福州","三宝","轻巧"],"confidence":"medium","consensus":"tentative","sub_type":"lacquerware_type","source_count":"2","evidence_status":"source_backed","description":"脱胎漆器是以泥作模型、再用布或绸粘贴、然后上漆的夹纻技法制成的漆器，色泽华美、器体轻巧；乾隆时期由沈沼安创造，作法一直沿袭至今。2016 记其为福州传统漆器工艺，作品造型古朴大方、工艺精巧细致，大型脱胎漆器“荷叶瓶”“提篮仙子”“竹节瓶”被称为福州脱胎漆器“三宝”。","path":"terms/tuotai-qiqi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"脱胎漆器是 B 维度下夹纻漆器类型的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:underglaze-color","title":"釉下彩（Underglaze Color）","name_en":"Underglaze Color","type":"term","type_zh":"术语","color":"#10B981","tags":["三国","唐代","长沙窑","瓷器装饰","釉下彩绘"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_decoration","source_count":"5","evidence_status":"source_backed","description":"釉下彩（又称窑彩）是在素坯上绘纹、罩透明或浅色面釉、经高温一次烧成的瓷器装饰类别，青花、釉里红、釉下三彩、釉下五彩都属其下品种。五册都把它当作彩瓷的两大工序类型之一（与釉上彩对举）。分歧有两处：**三国时期的点彩算不算釉下彩的起点**，以及**唐代釉下彩的窑口范围**。本 KU 并列，不裁定。\n\n**立条类型说明**：本 KU 定为 `term` 而非 `procedure`。赵农一册的候选（`2","path":"terms/underglaze-color.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"釉下彩是 B 维度下瓷器装饰分类条目：施彩与罩釉的工序、烧成温度属工艺，纹饰被釉膜覆盖的视觉效果属装饰。Theme/Topic 尚未 materialize。"},{"id":"terms:wadang","title":"瓦当（Tile End）","name_en":"Tile End","type":"term","type_zh":"术语","color":"#10B981","tags":["西周","战国","秦汉","建筑陶饰","文字瓦当"],"confidence":"medium","consensus":"tentative","sub_type":"building_component","source_count":"6","evidence_status":"source_backed","description":"瓦当是覆于屋面筒瓦前端的陶制构件，起装饰作用，别称\"瓦头\"。六册中高丰最详，田自秉次之，夏燕靖两版与李立新各取一面，赵农另有形制、护椽功能与燕下都大瓦的文字论述。来源间的实质差异在汉代瓦当的分类体系：高丰分三类、田自秉分四类，两套分类并非同一标准的加细。","path":"terms/wadang.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"瓦当是 C 维度下汉代图案与文字装饰的代表载体，同时是 B 维度建筑陶构件。本批按六册讨论的重心（装饰纹样与文字设计）归主维度 C。Theme/Topic 尚未 materialize。"},{"id":"terms:weft-brocade","title":"纬锦（Weft-faced Brocade）","name_en":"Weft-faced Brocade","type":"term","type_zh":"术语","color":"#10B981","tags":["唐代","丝织","织锦","纬线显花","经锦"],"confidence":"medium","consensus":"tentative","sub_type":"textile_type","source_count":"4","evidence_status":"source_backed","description":"纬锦是以纬线显花的锦，与唐以前以经线显花的经锦相对。四册都把“汉锦/经锦”与“唐锦/纬锦”作为一对技术—时代类型：经锦以经线起花，纬锦以纬线起花；唐代的锦以纬锦为主，织物因此能织出更繁复的花纹、更宽幅的面料和更华丽的色彩。差异在出现时间与技术描述：夏燕靖两版说“南北朝后出现斜纹的纬线显花的纬锦，以两组纬线与一组经线交织而成”；高丰说“唐代新创造了纬锦。纬锦是利用多重多色的纬线起花”；田自秉说“唐锦","path":"terms/weft-brocade.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"纬锦是 B 维度下丝织工艺与织物类型的术语锚点；唐代织造机构、生产规模与外销属 D。Theme/Topic 尚未 materialize。"},{"id":"terms:weizhang","title":"帷帐（Curtain and Canopy）","name_en":"Curtain and Canopy","type":"term","type_zh":"术语","color":"#10B981","tags":["汉代","室内分隔","马王堆","防尘避风"],"confidence":"medium","consensus":"tentative","sub_type":"interior_textile","source_count":"2","evidence_status":"source_backed","description":"帷帐是汉代室内空间分隔与组织的主要手段之一。帷多单幅横面，用于分隔堂、室；帐笼罩四面，施于床上。湖南长沙马王堆一号汉墓出土丝绸帷帐全长约 7.3 米、宽约 1.45 米；帷帐移动方便、可开可合，兼有保暖、避虫、挡风、防尘和装饰功能。","path":"terms/weizhang.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"帷帐是 B 维度下汉代室内空间分隔的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:wenzhi","title":"文质（Wen and Zhi (Ornament and Substance)）","name_en":"Wen and Zhi (Ornament and Substance)","type":"term","type_zh":"术语","color":"#10B981","tags":["孔子","论语","文采","实质","设计准则"],"confidence":"medium","consensus":"tentative","sub_type":"aesthetic_concept","source_count":"3","evidence_status":"source_backed","description":"文质是我国古代文论的基本概念，包括“文”与“质”两个方面：文指文采，质指实质。出典为孔子《论语·雍也》“质胜文则野，文胜质则史，文质彬彬，然后君子”，意即只有学问而无文采则粗野，过分渲染文采而无内涵实质则虚饰，君子须文采与内涵兼具。后世文论多指语言风格的华美与质朴。","path":"terms/wenzhi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"A","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"文质是 A 维度下先秦设计审美观念的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:wucai","title":"五彩（Wucai (Polychrome Porcelain)）","name_en":"Wucai (Polychrome Porcelain)","type":"term","type_zh":"术语","color":"#10B981","tags":["明嘉靖万历","釉上彩","景德镇","彩瓷"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_type","source_count":"2","evidence_status":"source_backed","description":"五彩是明嘉靖、万历时期盛行的釉上彩瓷，用红、黄、绿、紫、孔雀蓝等多种彩料直接在烧成瓷器上描绘花纹、再经焙烧而成。赵农把它列为明清白瓷、青花之外的瓷器品种之一；2016 称其色调多变、富丽堂皇，具有浓郁民族风格。","path":"terms/wucai.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"五彩是 B 维度下明代釉上彩瓷的类型条目。Theme/Topic 尚未 materialize。"},{"id":"terms:wuda-mingyao","title":"五大名窑（Five Great Kilns）","name_en":"Five Great Kilns","type":"term","type_zh":"术语","color":"#10B981","tags":["宋代","官窑","汝窑","钧窑","哥窑"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_kiln_group","source_count":"3","evidence_status":"source_backed","description":"五大名窑是宋瓷中“官、汝、钧、哥、定”五个窑系的合称。赵农指出这仅仅是一种习惯说法，不同地域的窑制自然体现区域特点；2016 以汝窑、官窑、定窑、钧窑、哥窑概括宋代制瓷业的地域流派与工艺成就。","path":"terms/wuda-mingyao.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"五大名窑是 B 维度下宋瓷分类的总目。Theme/Topic 尚未 materialize。"},{"id":"terms:wudai-shiguo","title":"五代十国（Five Dynasties and Ten Kingdoms）","name_en":"Five Dynasties and Ten Kingdoms","type":"term","type_zh":"术语","color":"#10B981","tags":["唐末宋初","五代","十国","分期"],"confidence":"medium","consensus":"tentative","sub_type":"historical_period","source_count":"2","evidence_status":"source_backed","description":"五代十国是唐亡后北方五个短命王朝与南方十个地方政权并立的时期。赵农记五代共 53 年、两宋 319 年，合计 372 年；2016 记其历时约半个世纪，南方十国经济文化胜于北方。","path":"terms/wudai-shiguo.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"五代十国是 B 维度下的历史分期框架，用于安放唐宋之间的工艺与设计史材料。Theme/Topic 尚未 materialize。"},{"id":"terms:xi-mat","title":"席（Mat (Seating Mat)）","name_en":"Mat (Seating Mat)","type":"term","type_zh":"术语","color":"#10B981","tags":["商周","坐卧铺垫","礼制","连席"],"confidence":"medium","consensus":"tentative","sub_type":"furniture_form","source_count":"2","evidence_status":"source_backed","description":"席是中国古代古老而原始的家具，供坐卧铺垫。商代席的使用逐渐普及，周代已有莞席、藻席、次席、蒲席、熊席等名称，并设专掌五席的官吏；席的材质、装饰和使用方式在礼制中有严格等级规定。春秋战国人们以坐席形式接人待客，铺席设筵，席上置案、几等低矮家具。","path":"terms/xi-mat.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"席是 B 维度下先秦起居家具的原点条目。Theme/Topic 尚未 materialize。"},{"id":"terms:xiangxie","title":"相缬（Xiangxie (Xiangzhou Resist Dye)）","name_en":"Xiangxie (Xiangzhou Resist Dye)","type":"term","type_zh":"术语","color":"#10B981","tags":["金代","相州","防染","贡品","套染"],"confidence":"medium","consensus":"tentative","sub_type":"textile_technique","source_count":"2","evidence_status":"source_backed","description":"相缬是金代纺织工艺品种，继承古代纺织品“防染法”染花工艺“缬”，多为民间所用，一般作单色加工，朴实大方；少数供官府呈作贡品的相缬加工复杂，套染出多彩纹样，具晕渲烂漫、变幻迷离的装饰效果。相州产相缬。","path":"terms/xiangxie.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"相缬是 B 维度下金代防染印花品种的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:xiaozhuan","title":"小篆（Small Seal Script）","name_en":"Small Seal Script","type":"term","type_zh":"术语","color":"#10B981","tags":["秦代","书同文","李斯","标准文字","汉字设计"],"confidence":"medium","consensus":"tentative","sub_type":"calligraphy_script","source_count":"2","evidence_status":"source_backed","description":"小篆是秦始皇“书同文”所确立的规范书体，由大篆演变而来。字形规整修长、笔画匀称圆润，具线条化、符号化、规律化特点，是古文字阶段最后一种字体；高丰视其为汉字设计走向成熟的标志。赵农记秦始皇统一六国后采用丞相李斯创意的小篆并颁布全国，以《泰山刻石碑》《峄山刻石碑》《会稽刻石碑》石刻确立规范。","path":"terms/xiaozhuan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"小篆是 C 维度下秦代标准书体与文字设计的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:xiapei","title":"霞帔（Xiapei Stole）","name_en":"Xiapei Stole","type":"term","type_zh":"术语","color":"#10B981","tags":["服饰","明代","宋代","命妇","禽纹"],"confidence":"medium","consensus":"tentative","sub_type":"clothing_accessory","source_count":"3","evidence_status":"source_backed","description":"霞帔是宋明女性服饰中的披挂类附件。三册对它的时代、形态与制度属性说法不同：夏燕靖两版只说明代，称其为\"'恩赐贵妇专用'饰品\"，记深青缎地、云霞禽纹与一至七品的禽纹等级；赵农把霞帔列为宋代一般女服的组成（\"大袖、长裙、霞帔\"），又在明清段称其为\"佩带的饰物，是用彩带连缀的金玉坠子，多为贵族妇女所佩\"。两套描述不仅时代不同，形态也不同：一为绣禽纹的深青缎饰，一为彩带连缀金玉坠子。本 KU 并列，不合并","path":"terms/xiapei.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"霞帔是 B 维度下宋明女性服饰附件的条目；织物、绣纹与佩挂结构属 B，命妇品级与恩赐制度牵涉 C 维度。Theme/Topic 尚未 materialize。"},{"id":"terms:xikesuosi-ren","title":"喜克索斯人（Hyksos）","name_en":"Hyksos","type":"term","type_zh":"术语","color":"#10B981","tags":["古埃及","前17世纪","马拉战车","复合弓","技术传播"],"confidence":"medium","consensus":"tentative","sub_type":"social_group","source_count":"2","evidence_status":"source_backed","description":"喜克索斯人是古代亚洲西部的一个混合民族，于前 17 世纪进入埃及东部，建立第十五和第十六王朝（约前 1674 年至前 1548 年），统治中埃及和下埃及一百多年，并将复合弓、马和马拉战车等新技术引入埃及。","path":"terms/xikesuosi-ren.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"E","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"喜克索斯人是 E 维度下古代跨文化技术传播的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:xinshiqi-shidai","title":"新石器时代（Neolithic Period）","name_en":"Neolithic Period","type":"term","type_zh":"术语","color":"#10B981","tags":["磨制石器","农业","定居","制陶"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_period","source_count":"2","evidence_status":"source_backed","description":"新石器时代是以使用磨制石器为标志的石器时代最后阶段，约从距今 1 万至 8 千年开始，结束于距今 5000 至 2000 多年不等；出现农业、牧业、定居村落和制陶。田自秉以磨制石器的工艺特征定义该时代：把经过选择的石头打成石斧、石刀、石锛、石铲、石凿，并磨光、钻孔、装柄或穿绳。","path":"terms/xinshiqi-shidai.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"新石器时代是 B 维度下的考古分期框架，用于安放农业、聚落与制陶材料。Theme/Topic 尚未 materialize。"},{"id":"terms:xipi","title":"犀皮（Xipi (Marbled Lacquer)）","name_en":"Xipi (Marbled Lacquer)","type":"term","type_zh":"术语","color":"#10B981","tags":["斑纹漆","六朝","宋代","虎皮漆","菠萝漆"],"confidence":"medium","consensus":"tentative","sub_type":"lacquer_technique","source_count":"2","evidence_status":"source_backed","description":"犀皮是以多层色漆形成凹凸漆层、打磨后显出斑纹的漆器品种。田自秉记其做法：先用稠厚色漆在器胎上涂出凹凸不平漆层，干后用对比鲜明的色漆分层涂，最后用磨炭打磨，因漆层高度不同显出片云、圆花、松鳞等斑纹；实为六朝斑漆的发展，俗称虎皮漆或菠萝漆，宋时有犀皮行专门生产、成本低廉。高丰记安徽马鞍山东吴朱然墓出土的一对犀皮鎏金铜扣漆耳杯，为迄今所发现最早的犀皮实物。","path":"terms/xipi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"犀皮是 B 维度下斑纹漆器工艺的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:xishiqi","title":"细石器（Microlith）","name_en":"Microlith","type":"term","type_zh":"术语","color":"#10B981","tags":["旧石器晚期","峙峪文化","下川文化","复合工具","镶嵌"],"confidence":"medium","consensus":"tentative","sub_type":"tool_type","source_count":"2","evidence_status":"source_backed","description":"细石器是旧石器晚期器形普遍变小的石器类型，造型设计趋于多样化和复杂化。山西朔县峙峪文化属细石器初期（距今 28135±1330 年），发现石箭头、钺形小石刀等复合工具；山西沁水下川文化（距今 23900 年）出土上万件石制品，细石器镶嵌在木棍上使用。","path":"terms/xishiqi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"细石器是 B 维度下旧石器晚期石器类型的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:xuan-zhi","title":"宣纸（Xuan Paper）","name_en":"Xuan Paper","type":"term","type_zh":"术语","color":"#10B981","tags":["宋代","明清","安徽泾县","宣州","青檀皮"],"confidence":"medium","consensus":"tentative","sub_type":"material_type","source_count":"1","evidence_status":"source_backed","description":"宣纸是宋代具有区域特色的纸张之一，与蜀纸、越纸并称；明清时期与湖笔、徽墨、歙砚并列为文房四宝名品。赵农记其产地在安徽泾县，泾县为宣州府辖，宣纸因此得名；属皮纸类，主要原料是榆科类青檀皮。宣纸因配料分为绵料、净皮、特净，因厚度分为夹宣、单宣，因工序分为生宣、熟宣、笺纸。同书另记五代南唐李煜汲取四川造纸技术改进宣纸技术，用楮皮制成澄心堂纸。","path":"terms/xuan-zhi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"宣纸是 B 维度下造纸材料与工艺的条目：产地、原料、分类与明清书画用途在此汇合。Theme/Topic 尚未 materialize。"},{"id":"terms:yangshao-culture","title":"仰韶文化（Yangshao Culture）","name_en":"Yangshao Culture","type":"term","type_zh":"术语","color":"#10B981","tags":["新石器时代","彩陶","黄河中游","考古学文化"],"confidence":"medium","consensus":"tentative","sub_type":"archaeological_culture","source_count":"6","evidence_status":"source_backed","description":"仰韶文化是中国新石器时代黄河中游的核心考古学文化，因 1921 年发现于河南渑池仰韶村而得名，以彩陶为标志性器物。六册来源都用它作为彩陶工艺、聚落建筑与早期造物观念的类型学基准。名称层面存在一个需要辨析的问题：六册中有来源把\"仰韶文化\"与\"彩陶\"直接等同，另一来源则分设两条并给出独立的年代与分布。","path":"terms/yangshao-culture.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"仰韶文化是 B 维度下黄河中游新石器时代彩陶工艺与聚落形态的类型学锚点，同时是'彩陶文化'这一旧称的所指。Theme/Topic 尚未 materialize。"},{"id":"terms:yaobian","title":"窑变（Kiln Transmutation）","name_en":"Kiln Transmutation","type":"term","type_zh":"术语","color":"#10B981","tags":["钧窑","铜红","还原焰","紫红斑"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_decoration","source_count":"2","evidence_status":"source_backed","description":"窑变是钧瓷釉中铜元素经还原焰烧制呈现绿或紫红斑，在青釉上打破一色釉的单调、形成对比妍丽效果；最初可能偶然形成，后在实践中认识规律、人工安排达到预期效果。2016 记钧窑烧制过程中因配料掺入铜的气化物（原文如此）而产生釉色变化，使红、蓝、青、白、紫交相融汇、灿若云霞，称此为我国制瓷史上的一大发明。","path":"terms/yaobian.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"窑变是 B 维度下钧窑呈色工艺的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:yi-pourer","title":"匜（Yi (Pouring Vessel)）","name_en":"Yi (Pouring Vessel)","type":"term","type_zh":"术语","color":"#10B981","tags":["周代","水器","沃盥之礼","青铜器"],"confidence":"medium","consensus":"tentative","sub_type":"vessel_form","source_count":"2","evidence_status":"source_backed","description":"匜是周代新增的水器、注水器皿，形如瓢，四足一鋬、有流，后由有足变无足；最早似由觥演变，常与盘组合用于沃盥之礼。2016 记其器身长椭圆形，前有流、后有鋬，少量带盖，西周多为四足，至春秋出现三足或无足且数量大增。","path":"terms/yi-pourer.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"匜是 B 维度下周代青铜水器的类型条目。Theme/Topic 尚未 materialize。"},{"id":"terms:yingqing","title":"影青（Yingqing (Qingbai Ware)）","name_en":"Yingqing (Qingbai Ware)","type":"term","type_zh":"术语","color":"#10B981","tags":["宋代","景德镇","青白瓷","映青","刻花"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_type","source_count":"2","evidence_status":"source_backed","description":"影青是宋代盛行的青白釉瓷，特征是釉厚处或花纹凹线处微呈淡青色，又称“映青”“隐青”“罩青”；烧造地点遍及江西、福建、广东、广西、安徽、浙江、云南，景德镇影青为代表作品。因胎质白薄、透光玉润而有“假玉”之说；宋代景德镇吸收定窑方法，在青白釉下刻画花卉纹饰，形成“影青刻花”。","path":"terms/yingqing.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"影青是 B 维度下宋代青白瓷类型的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:yishu-sheji","title":"艺术设计（Art Design）","name_en":"Art Design","type":"term","type_zh":"术语","color":"#10B981","tags":["1980年代","现代设计","1998","学科目录"],"confidence":"medium","consensus":"tentative","sub_type":"design_discipline","source_count":"2","evidence_status":"source_backed","description":"艺术设计是中国真正的现代设计运动在 1980 年以后逐步形成的学科与行业概念。文化思想解禁、现代主义文艺引进使设计运动及成就引起设计家重视，人们对住宅、服饰、家具、电器等生活用品的需求从外观装饰转向功能要求；1998 年教育部高等教育专业目录以“艺术设计”替代“工艺美术”。夏燕靖另把艺术设计界定为“人类有意识的、用艺术创造力所体现的造物活动”。","path":"terms/yishu-sheji.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"艺术设计是 D 维度下现代设计学科名称与教育体制的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:youlihong-ci","title":"釉里红瓷（Underglaze Red Porcelain）","name_en":"Underglaze Red Porcelain","type":"term","type_zh":"术语","color":"#10B981","tags":["铜红","高温还原焰","景德镇","元代","青花釉里红"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_type","source_count":"2","evidence_status":"source_backed","description":"釉里红瓷以铜红料为呈色剂，在瓷胎上彩绘后施透明釉，于窑中经 1300℃ 左右高温一次烧成的釉下彩瓷器。其烧造工艺源于唐代长沙窑，元代江西景德镇烧造出釉里红瓷并创制青花釉里红。元代釉里红有线条描绘、拔白、涂绘三种装饰特征，后两种能减少飞红现象，形成期应早于线绘。","path":"terms/youlihong-ci.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"釉里红瓷是 B 维度下元代釉下彩瓷的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:youlihong","title":"釉里红（Underglaze Red）","name_en":"Underglaze Red","type":"term","type_zh":"术语","color":"#10B981","tags":["元代","明代","景德镇","铜红","釉下彩"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_type","source_count":"6","evidence_status":"source_backed","description":"釉里红是以铜红料在瓷胎上绘纹、施透明釉后高温还原焰一次烧成的釉下彩瓷，元代景德镇烧造成功。六册均有直接记载。来源对它的**工艺来源**给出三种互不相同的说法（唐代长沙窑／钧瓷紫红釉／元代景德镇创烧），对元代产品的**质量评价**亦正反并存。本 KU 并列，不裁定。","path":"terms/youlihong.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"釉里红是 B 维度下元代景德镇铜红釉下彩的品种条目，其白底红彩的视觉效果属 C 维度。Theme/Topic 尚未 materialize。"},{"id":"terms:youshang-cai","title":"釉上彩（Overglaze Decoration）","name_en":"Overglaze Decoration","type":"term","type_zh":"术语","color":"#10B981","tags":["红炉","低温彩烧","五彩","粉彩","珐琅彩"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_technique","source_count":"2","evidence_status":"source_backed","description":"釉上彩是在已烧成的瓷器釉面上用彩料绘饰，再经 750～860℃ 红炉彩烧的装饰品种。烤烧温度不高，可用色料很多、色彩丰富，但画面在釉上，使用中摩擦、接触酸碱后易褪损变色。釉上彩包括红彩、红绿彩、五彩、粉彩、珐琅彩、墨彩、广彩、新彩等。","path":"terms/youshang-cai.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"釉上彩是 B 维度下瓷器彩饰工艺的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:yu-dai","title":"鱼袋（Fish Tally Bag）","name_en":"Fish Tally Bag","type":"term","type_zh":"术语","color":"#10B981","tags":["宋代","官服","章服","佩鱼","品级"],"confidence":"medium","consensus":"tentative","sub_type":"official_accessory","source_count":"2","evidence_status":"source_backed","description":"鱼袋是宋代官服配饰。北宋初年沿袭唐朝章服佩鱼遗制；有资格穿紫、绯色公服的官员都须在腰间佩挂“鱼袋”，袋内装有金、银、铜制成的鱼，以区别官品。此制仅用于官服中的礼服，一般人很少穿着。","path":"terms/yu-dai.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"鱼袋是 D 维度下宋代官服配饰制度的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:yuanling-paoshan","title":"圆领袍衫（Round-Collar Robe）","name_en":"Round-Collar Robe","type":"term","type_zh":"术语","color":"#10B981","tags":["隋唐","男子服饰","横襕","六合靴"],"confidence":"medium","consensus":"tentative","sub_type":"garment_form","source_count":"2","evidence_status":"source_backed","description":"圆领袍衫是隋唐男子的主要服装：小圆领、窄袖，袍长至膝下，齐膝处设横襕。腰系红鞏带，足登乌皮六合靴。从皇帝到官吏样式几乎相同，差别只在材料、颜色和皮带头的装饰。","path":"terms/yuanling-paoshan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"圆领袍衫是 B 维度下隋唐男子服饰形制的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:yuanmouren","title":"元谋人（Yuanmou Man）","name_en":"Yuanmou Man","type":"term","type_zh":"术语","color":"#10B981","tags":["旧石器时代早期","云南元谋","直立人","打制石器"],"confidence":"medium","consensus":"tentative","sub_type":"hominin","source_count":"2","evidence_status":"source_backed","description":"元谋人是我国发现最早的直立人，距今约 170 万年，1965 年发现于云南元谋县。1973 年在其化石层位发现 6 件石器，后增至 22 件，以石英、石英岩、砾石为原料，包括刮削器、尖状器、石片和石核，均为轻型工具，外貌简单、不规范。","path":"terms/yuanmouren.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"元谋人是 B 维度下中国旧石器时代早期人类与最早石器的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:yuefenpai","title":"月份牌（Yuefenpai Calendar Poster）","name_en":"Yuefenpai Calendar Poster","type":"term","type_zh":"术语","color":"#10B981","tags":["上海","商业广告","水彩","石印","郑曼陀"],"confidence":"medium","consensus":"tentative","sub_type":"advertising_form","source_count":"3","evidence_status":"source_backed","description":"月份牌是把中国传统农历本形式与商业广告相结合、把传统木版年画与西方水彩技法相结合而形成的广告形式。最早产生于 19 世纪末的上海，流行于 20 世纪上半叶；最早标有“月份牌”字样者为 1896 年上海鸿福来票行随彩票赠送的《沪景开彩图》，二三十年代达到鼎盛。","path":"terms/yuefenpai.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"月份牌是 C 维度下近代商业广告形式的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:yuexiu","title":"粤绣（Yue Embroidery）","name_en":"Yue Embroidery","type":"term","type_zh":"术语","color":"#10B981","tags":["广东","潮州","百鸟","马尾缀绣","广绣"],"confidence":"medium","consensus":"tentative","sub_type":"embroidery_type","source_count":"2","evidence_status":"source_backed","description":"粤绣是广东刺绣，花纹繁缛、喜用百鸟鸡、色彩浓艳对比强烈，用马尾于轮廓缀绣并绣“间道风”飞白花纹，富有广东地方特色；潮州刺绣别称潮绣，另有高绣与金线勾边特点。洋人称从广州工部购得的货物为“广货”，对刺绣也称“广绣”或“粤绣”。","path":"terms/yuexiu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"粤绣是 B 维度下地方刺绣工艺的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:yuhuchun-ping","title":"玉壶春瓶（Yuhuchun Vase）","name_en":"Yuhuchun Vase","type":"term","type_zh":"术语","color":"#10B981","tags":["宋代","元代","喇叭口","长颈","圈足"],"confidence":"medium","consensus":"tentative","sub_type":"vessel_form","source_count":"2","evidence_status":"source_backed","description":"玉壶春瓶是宋代典型瓷瓶造型，口部外斜、长颈削肩、鼓腹圆足；2016 记其为元代最有特色的瓶式，口部呈喇叭形，颈部修长，腹圆圈足，稳重优美，其他各种瓶类大多由玉壶春为基本形态变化而成，如蒜头瓶、凤尾瓶等。","path":"terms/yuhuchun-ping.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"玉壶春瓶是 B 维度下宋元瓷瓶造型的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:zhao-tie","title":"招贴（Poster）","name_en":"Poster","type":"term","type_zh":"术语","color":"#10B981","tags":["宋代","广告","年画","四美图","宣传画"],"confidence":"medium","consensus":"tentative","sub_type":"advertising_form","source_count":"1","evidence_status":"source_backed","description":"招贴是一种海报形式，与广告关系密切，分商业类、文化类、政治类、风俗类等，渐渐成为极具独立价值的设计形式。赵农记招贴在宋代已经出现，应为年画性质的文化广告，以《四美图》为著名例证；宋代主要的广告形式即招贴广告，包括店堂门脸匾额、布幌子与悬挂菜单。20 世纪中国因政治、经济活动的不同需要，招贴形成此起彼伏的浪潮。","path":"terms/zhao-tie.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"招贴是 C 维度下广告形式的条目：宋代年画性文化广告与 20 世纪分类体系在此汇合。Theme/Topic 尚未 materialize。"},{"id":"terms:zhinan-che","title":"指南车（South-pointing Chariot）","name_en":"South-pointing Chariot","type":"term","type_zh":"术语","color":"#10B981","tags":["汉代","魏晋南北朝","宋代","制车","机械设计"],"confidence":"medium","consensus":"tentative","sub_type":"device_type","source_count":"4","evidence_status":"source_backed","description":"指南车是汉代以来屡次研制、屡次失传又屡次重造的指向机械车，又称司南车。四册的关注点各不相同：**夏燕靖两版给装置原理与李约瑟的评断**（联合运用车轮、滑轮、各种齿轮和绳索；人类历史上第一架有共协稳定的机械），**赵农给机械原理与宋代燕肃的复原形制**（引《宋史·舆服志》），**李立新给历代复制的失败谱系**（《宋书·礼志》周公始作，张衡再造，马钧恢复，令狐生再造，祖冲之复制）。**四册在“指南车与","path":"terms/zhinan-che.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"指南车是 B 维度下机械制车类型的条目：指向原理、历代重造谱系与宋代复原形制都在此汇合。“官府制车业”一侧归 D 维度。Theme/Topic 尚未 materialize。"},{"id":"terms:zhisun-fu","title":"质孙服（Zhisun Robe）","name_en":"Zhisun Robe","type":"term","type_zh":"术语","color":"#10B981","tags":["元代","官服","一色衣","蒙古","等级"],"confidence":"medium","consensus":"tentative","sub_type":"garment_form","source_count":"2","evidence_status":"source_backed","description":"质孙服是元代官服，汉语称“一色衣”，为较短的长袍，较紧较窄，腰部多衣褶，便于骑马上下。1321 年元英宗参照古制制定为上衣连下裳、上紧下短，腰间加襞积、肩背挂大珠。冬服 11 等、夏服 15 等，含衣帽带靴，仅皇帝即位、寿诞、册立、朝会等场合穿用；它是糅合汉族与蒙古民族特点的服制。","path":"terms/zhisun-fu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"质孙服是 D 维度下元代官服制度的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:zhongguo-guyou-shi-jianzhu","title":"中国固有式建筑（Chinese Inherent-Style Architecture）","name_en":"Chinese Inherent-Style Architecture","type":"term","type_zh":"术语","color":"#10B981","tags":["20世纪二三十年代","民族形式","折中主义","上海"],"confidence":"medium","consensus":"tentative","sub_type":"building_type","source_count":"2","evidence_status":"source_backed","description":"中国固有式建筑是五四运动以来伴随反帝爱国情绪和民族意识高涨而发展起来的建筑形式，主要建于 20 世纪二三十年代。它并非纯传统的“宫室式”，而是受西方建筑思潮强烈影响、近于折衷主义的新形式；《上海市市中心区域规划》明确规定市府新屋应用中国式建筑。","path":"terms/zhongguo-guyou-shi-jianzhu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"中国固有式建筑是 B 维度下近代民族形式建筑的类型条目。Theme/Topic 尚未 materialize。"},{"id":"terms:zhongshanzhuang","title":"中山装（Zhongshan Suit）","name_en":"Zhongshan Suit","type":"term","type_zh":"术语","color":"#10B981","tags":["民国","孙中山","礼服","五权分立","四口袋"],"confidence":"medium","consensus":"tentative","sub_type":"garment_form","source_count":"3","evidence_status":"source_backed","description":"中山装是由孙中山亲自设计并带头穿着的男装，被誉为“中山国服”，1912 年民国政府通令定为礼服。其形制以日本陆军士官服装和南洋华侨的“企领文装”为参照，直翻领、四口袋、前襟五纽、袖口三纽；相传最初制作者为上海南京路“荣昌祥呢绒西服店”裁缝王才运。","path":"terms/zhongshanzhuang.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"中山装是 D 维度下民国服制改革与政治象征设计的代表条目。Theme/Topic 尚未 materialize。"},{"id":"terms:zhu-ding-xiang-wu","title":"铸鼎象物（Casting Ding to Image Things）","name_en":"Casting Ding to Image Things","type":"term","type_zh":"术语","color":"#10B981","tags":["左传","鼎","德行","造物观念","象征"],"confidence":"medium","consensus":"tentative","sub_type":"design_concept","source_count":"2","evidence_status":"source_backed","description":"“铸鼎象物”是《春秋左氏传》记载的当时流行造物观点，也可以说是指导器物制作的方法核心。当时人认为鼎的大小、轻重象征统治者的德行、地位，因而具有很强的精神作用。","path":"terms/zhu-ding-xiang-wu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"A","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"铸鼎象物是 A 维度下先秦造物观念的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:zhuanghua","title":"妆花（Zhuanghua (Polychrome Brocade Weave)）","name_en":"Zhuanghua (Polychrome Brocade Weave)","type":"term","type_zh":"术语","color":"#10B981","tags":["明代","云锦","过管","挖花回纬","金宝地"],"confidence":"medium","consensus":"tentative","sub_type":"textile_technique","source_count":"2","evidence_status":"source_backed","description":"妆花是明代锦缎三类之一，用许多不同色线织成的多彩丝织物，花纹色彩异常丰富、花纹一般较大，有“走马看妆花”之喻。它是云锦中最华美的一种，用“过管”方法边织边配色，彩色一般 6 或 9 色、多至 18 色，同一排花朵可出现完全不同色彩。","path":"terms/zhuanghua.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"妆花是 B 维度下明代提花丝织工艺与品种的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:zhuangjin","title":"壮锦（Zhuang Brocade）","name_en":"Zhuang Brocade","type":"term","type_zh":"术语","color":"#10B981","tags":["壮族","广西","菱形几何","棉经丝纬"],"confidence":"medium","consensus":"tentative","sub_type":"textile_type","source_count":"2","evidence_status":"source_backed","description":"壮锦是广西壮族地区的民族民间织锦。装饰构成以菱形几何图案为骨架，以粗线条菊、梅等花卉作主题花填充，或用回纹、字纹、波纹作地纹，龙凤鸟作有规则的散点排列；色彩对比强烈，风格端庄大方又浓艳粗犷，用于衣裙、中被、背包、台布等。","path":"terms/zhuangjin.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"壮锦是 B 维度下少数民族织锦的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:zikou-tiezu","title":"紫口铁足（Purple Mouth, Iron Foot）","name_en":"Purple Mouth, Iron Foot","type":"term","type_zh":"术语","color":"#10B981","tags":["哥窑","官窑","黑褐胎","边缘呈色"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_decoration","source_count":"2","evidence_status":"source_backed","description":"紫口铁足是宋代官窑、哥窑的特征之一：瓷胎呈黑褐色，器皿的足部和口沿因釉薄而露出铁褐色胎质，形成一条褐色的边。赵农记其为哥窑南宋官窑产品的样式。","path":"terms/zikou-tiezu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"紫口铁足是 B 维度下宋瓷外观特征的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:zisha-tao","title":"紫砂陶（Zisha Pottery）","name_en":"Zisha Pottery","type":"term","type_zh":"术语","color":"#10B981","tags":["宜兴","紫砂泥","不挂釉","茶具","顾景舟"],"confidence":"medium","consensus":"tentative","sub_type":"ceramic_type","source_count":"3","evidence_status":"source_backed","description":"紫砂陶是宜兴窑的特色产品，原料紫砂泥色泽紫红，另有白泥、绿泥、大红泥；深藏岩层下，风化研磨制器，经 1000 多度烧成，不挂釉，以造型取胜，“方非一式，圆不一样”。多做茶具，紫砂壶有泡茶色纯、隔夜不馊、用久味永、泥色生辉的特点。","path":"terms/zisha-tao.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"紫砂陶是 B 维度下宜兴陶器类型的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:zu-ritual-vessel","title":"俎（Zu (Ritual Chopping Stand)）","name_en":"Zu (Ritual Chopping Stand)","type":"term","type_zh":"术语","color":"#10B981","tags":["礼器","祭祀","家具雏形","商代"],"confidence":"medium","consensus":"tentative","sub_type":"vessel_form","source_count":"2","evidence_status":"source_backed","description":"俎是古代祭祀时切牲、陈牲的礼器。考古所见较早实物有辽宁义县商代青铜俎和河南安阳大司空村商代石俎；其整体造型已具有后世几、案、桌类家具的雏形。2016 记其历史最久，传说有虞氏时已有，为后世桌、案、几、椅、凳等家具奠定基础。","path":"terms/zu-ritual-vessel.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"俎是 B 维度下礼器—家具过渡形态的条目。Theme/Topic 尚未 materialize。"},{"id":"terms:zuopu","title":"作铺（Zuopu (Tang Urban Workshop)）","name_en":"Zuopu (Tang Urban Workshop)","type":"term","type_zh":"术语","color":"#10B981","tags":["唐代","城市手工业","作坊","行"],"confidence":"medium","consensus":"tentative","sub_type":"craft_system","source_count":"2","evidence_status":"source_backed","description":"作铺是唐代城市手工业作坊的称谓，如染行、织锦行、金银行、绢行等，规模相当大，大城市往往有一至两个以上行当。","path":"terms/zuopu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"作铺是 D 维度下唐代城市手工业组织条目。Theme/Topic 尚未 materialize。"},{"id":"terms:zuyongdiao","title":"租庸调（Zu-Yong-Diao Tax System）","name_en":"Zu-Yong-Diao Tax System","type":"term","type_zh":"术语","color":"#10B981","tags":["唐初","均田制","绢绵","输庸代役"],"confidence":"medium","consensus":"tentative","sub_type":"tax_system","source_count":"2","evidence_status":"source_backed","description":"租庸调是唐初的租赋劳役制度，与均田制并行。每丁年纳绢 2 丈、绵 3 两，或麻布 2 丈 5 尺、麻 3 斤；唐创制“输庸代役”法以减轻民众负担。田自秉称其对经济发展起一定促进作用。","path":"terms/zuyongdiao.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"租庸调是 D 维度下唐代赋役制度与纺织生产的条目。Theme/Topic 尚未 materialize。"},{"id":"works:budala-gong","title":"布达拉宫（Potala Palace）","name_en":"Potala Palace","type":"work","type_zh":"作品","color":"#F59E0B","tags":["西藏","宫堡式建筑","藏族建筑","清代","政教合一"],"confidence":"medium","consensus":"tentative","sub_type":"palace_complex","source_count":"3","evidence_status":"source_backed","description":"布达拉宫在拉萨玛布日山（红山）上，是宫堡式建筑群。三册的用法很不对称：**夏燕靖两版给规模数字**（999 间、占地 41 万平方米、建筑面积 13 万平方米、主楼 13 层 115 米），**赵农给历史层累与形制构成**（原建、被毁、清初重建，白宫红宫，碉楼与住宅的融合），两者**在高度与结构表述上并不一致**。高丰一册只在唐代铜镜一节提到布达拉宫壁画中的“金城公主照容图”，是铜镜史证据而非建筑","path":"works/budala-gong.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"布达拉宫是 B 维度下宫堡式建筑群的形制样本：碉楼与住宅形式的融合、白宫红宫的分区、石木与土木石两种结构表述都在此汇合。宫顶镏金铜瓦与金顶归 C 维度；五世达赖受册封后重建与政教合一中心地位归 D 维度。Theme/Topic 尚未 materialize。"},{"id":"works:caiqi-mudiao-dongwu-zuoping","title":"彩漆木雕动物座屏（Painted Lacquered Animal Screen）","name_en":"Painted Lacquered Animal Screen","type":"work","type_zh":"作品","color":"#F59E0B","tags":["战国","江陵望山","透雕","楚漆器","50余动物"],"confidence":"medium","consensus":"tentative","sub_type":"lacquer_furniture","source_count":"2","evidence_status":"source_backed","description":"彩漆木雕动物座屏是江陵望山出土的战国漆器，透雕和浮雕有蛇、鹿、凤、雀、蛙等 50 余个形态逼真的动物形象，周身以黑漆为底，彩绘朱红、金银、灰绿等漆色。它被用作战国漆器种类繁多、纹饰精细、色彩艳丽的代表，也是楚国髹漆业高超水平的例证。","path":"works/caiqi-mudiao-dongwu-zuoping.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下战国楚国漆器的器物锚点。Theme/Topic 尚未 materialize。"},{"id":"works:changxin-palace-lamp","title":"长信宫灯（Changxin Palace Lamp）","name_en":"Changxin Palace Lamp","type":"work","type_zh":"作品","color":"#F59E0B","tags":["西汉","青铜器","鎏金","环保设计","满城汉墓"],"confidence":"medium","consensus":"tentative","sub_type":"bronze_lamp","source_count":"5","evidence_status":"source_backed","description":"长信宫灯是西汉青铜鎏金宫灯，1968 年出土于河北满城中山靖王刘胜之妻窦绾墓。五册来源都以它为中国古代灯具设计的代表作，强调其可拆卸清洗、可调节光照、以烟道净化烟气的结构设计。","path":"works/changxin-palace-lamp.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"长信宫灯是 B 维度下汉代青铜灯具结构与消烟设计的器物锚点，其整体造型的人物化处理也涉及 C 维度的形态表现问题。Theme/Topic 尚未 materialize。"},{"id":"works:cuo-jinyi-longfenglu-fangan","title":"错金银龙凤鹿方案（Gold- and Silver-Inlaid Dragon-Phoenix-Deer Stand）","name_en":"Gold- and Silver-Inlaid Dragon-Phoenix-Deer Stand","type":"work","type_zh":"作品","color":"#F59E0B","tags":["战国","青铜器","家具","错金银","中山国"],"confidence":"medium","consensus":"tentative","sub_type":"bronze_furniture","source_count":"4","evidence_status":"source_backed","description":"错金银龙凤鹿方案是战国中山王墓出土的青铜方案（案面为漆木，已朽），以四只卧鹿为足、四条有翼飞龙蟠曲成镂空球状、龙体空隙处各出一凤、每龙头顶一斗拱形饰件承托案框。四册对**结构**的描述高度一致，几乎可以逐句对应；分歧集中在三处：**出土年份**（1977／1997）、**尺寸**（长 47.5×高 36.2 与高 37.4×长宽 48 两套数字）、**案面材质**（高丰作“以青铜材料为主”而“可镶","path":"works/cuo-jinyi-longfenglu-fangan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"错金银龙凤鹿方案是 B 维度下战国青铜家具的结构锚点：以鹿为足、龙凤盘绕成镂空球、龙头承斗拱托案框，四册对结构的描述高度一致。其错金银工艺与造型装饰归 C；以斗拱承案框所反映的建筑与家具关系归 D（制度与技术传承）为次。Theme/Topic 尚未 materialize。"},{"id":"works:cuojin-boshanlu","title":"错金博山炉（Gold-Inlaid Boshan Censer）","name_en":"Gold-Inlaid Boshan Censer","type":"work","type_zh":"作品","color":"#F59E0B","tags":["西汉","满城汉墓","错金","博山","云气纹"],"confidence":"medium","consensus":"tentative","sub_type":"bronze_censer","source_count":"2","evidence_status":"source_backed","description":"错金博山炉是河北满城汉墓（西汉中山靖王墓）出土的铜薰炉，炉柄镂空，炉体饰错金云气纹，造型庄重饱满、线条优美，是汉代博山炉的典型作品。李立新将其作为帝王贵族奢侈性造物消费的例证。","path":"works/cuojin-boshanlu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下西汉铜薰炉的器物锚点。Theme/Topic 尚未 materialize。"},{"id":"works:da-ke-ding","title":"大克鼎（Da Ke Ding）","name_en":"Da Ke Ding","type":"work","type_zh":"作品","color":"#F59E0B","tags":["西周","青铜鼎","兽蹄足","半球腹","毛公鼎"],"confidence":"medium","consensus":"tentative","sub_type":"bronze_ding","source_count":"2","evidence_status":"source_backed","description":"大克鼎是西周青铜鼎。2016 记其为西周后期鼎耳渐外移、口渐敞、下腹内收使器身成半球形、足成兽蹄形的代表器之一，与毛公鼎并举；田自秉仅以“插图 1 大克鼎（周）”图注形式收录，作为西周鼎形演变的示例。","path":"works/da-ke-ding.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下西周青铜鼎的器物锚点。Theme/Topic 尚未 materialize。"},{"id":"works:da-yu-ding","title":"大盂鼎（Da Yu Ding）","name_en":"Da Yu Ding","type":"work","type_zh":"作品","color":"#F59E0B","tags":["西周早期","青铜器","康王","铭文","金文"],"confidence":"medium","consensus":"tentative","sub_type":"bronze_vessel","source_count":"4","evidence_status":"source_backed","description":"大盂鼎是西周康王时期铸作的有铭铜鼎，清道光年间出土于陕西郿县礼村，今陈列于中国历史博物馆。四册来源分工清楚：田自秉一册给出制作年代、出土、收藏、铭文结构与赏赐奴隶数；赵农两处以它为金文范本，给字数与文献价值，另有一处器影；夏燕靖两版只把它当作西周中期后鼎腹变浅、足跟外延这一形制趋势的代表器。**四册均未给尺寸、重量、纹饰与铸造方法**，铭文只给字数与大意，不录原文。来源之间另有一处时间张力：田自秉","path":"works/da-yu-ding.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"大盂鼎是 B 维度下西周早期有铭铜鼎的标本，四册对它的用法集中在两处：铭文（金文的字数、内容与文献价值，属 C 维度）与鼎形演变序列中的位置（属 B）。铭文所记“商亡由于百官沉溺于饮酒”“用德治为规范”涉及周初政治伦理，归 D 维度为次。Theme/Topic 尚未 materialize。"},{"id":"works:daming-gong","title":"大明宫（Daming Palace）","name_en":"Daming Palace","type":"work","type_zh":"作品","color":"#F59E0B","tags":["唐代","长安","龙首原","含元殿","麟德殿"],"confidence":"medium","consensus":"tentative","sub_type":"palace_complex","source_count":"2","evidence_status":"source_backed","description":"大明宫是唐代长安城禁苑宫殿，位于城东北龙首原，原名永安宫，唐太宗时为太上皇李渊建造，高宗迁入执政。赵农记其原是太极宫的一处，后加修成大型宫殿，地处龙首原上，在唐高宗时加以扩建，成为后来唐朝历代帝王理朝和居住之处；含元殿为其前殿。2016 记遗址范围相当于北京故宫面积 3 倍多，由 30 多所宫殿组成，麟德殿面积约太和殿 3 倍、5000 多平方米、可宴 3500 人。","path":"works/daming-gong.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下唐代宫殿建筑的器物锚点。Theme/Topic 尚未 materialize。"},{"id":"works:dayan-ta-652","title":"大雁塔（Giant Wild Goose Pagoda）","name_en":"Giant Wild Goose Pagoda","type":"work","type_zh":"作品","color":"#F59E0B","tags":["唐代","佛塔","楼阁式砖塔","慈恩寺","玄奘"],"confidence":"medium","consensus":"tentative","sub_type":"pagoda","source_count":"3","evidence_status":"source_backed","description":"大雁塔在西安大慈恩寺内，原名慈恩寺塔，唐永徽三年（652）为安置玄奘自印度带回的经籍而建。三册的用法分成两层：夏燕靖两版给**形制与尺寸**（初建五层土心、重建十层、武则天改为七层，塔基与塔身的分项尺度，明代包砖，两通褚遂良碑），赵农给**缘起与观感**（雁故事、玄奘生平、岑参诗、方形角锥与内部楼梯），另有图版两幅。**两版夏燕靖几乎逐字相同**，赵农与它们不冲突，但各给一部分细节，合起来才完整。","path":"works/dayan-ta-652.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"大雁塔是 B 维度下唐代楼阁式砖塔的形制与结构样本：塔基塔身的尺寸、砖砌扁柱与大斗、明代包砖都在此汇合。塔基座南侧褚遂良书两碑与石门楣线刻画归 C 维度；慈恩寺与玄奘译经、皇家追念母后的建塔缘起归 D 维度。Theme/Topic 尚未 materialize。"},{"id":"works:dayunhe","title":"大运河（Grand Canal）","name_en":"Grand Canal","type":"work","type_zh":"作品","color":"#F59E0B","tags":["隋代","五大水系","扬州","漕运","人工河流"],"confidence":"medium","consensus":"tentative","sub_type":"waterway_engineering","source_count":"2","evidence_status":"source_backed","description":"大运河是隋炀帝开凿的水利交通工程，将海河、黄河、淮河、长江、钱塘江五大水系连结起来，促进了南北文化经济的交流和发展，是世界上最长的一条人工河流。隋代大运河开通后，扬州成为长江和大运河的交通枢纽；2016 称其“为南北沟通与经济繁荣开创了新的局面”。","path":"works/dayunhe.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下隋代水利工程的器物锚点，也涉及 D 维度的漕运制度。Theme/Topic 尚未 materialize。"},{"id":"works:dingxian-kaiyuansi-liaodi-pagoda","title":"定县开元寺瞭敌塔（Liaodi Pagoda, Kaiyuan Temple, Dingxian）","name_en":"Liaodi Pagoda, Kaiyuan Temple, Dingxian","type":"work","type_zh":"作品","color":"#F59E0B","tags":["宋代","砖石建筑","佛塔","84米","最高古建筑"],"confidence":"medium","consensus":"tentative","sub_type":"pagoda","source_count":"2","evidence_status":"source_backed","description":"定县开元寺瞭敌塔高达 84 米，相当于一座 20 层的高楼，是现存我国古代最高的建筑物，属宋代砖石建筑中以佛塔最为突出的代表。","path":"works/dingxian-kaiyuansi-liaodi-pagoda.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下宋代砖石佛塔的器物锚点。Theme/Topic 尚未 materialize。"},{"id":"works:dingyao-haier-zhen","title":"定窑孩儿枕（Ding Ware Boy Pillow）","name_en":"Ding Ware Boy Pillow","type":"work","type_zh":"作品","color":"#F59E0B","tags":["宋代","定窑","瓷枕","瓷塑","故宫"],"confidence":"medium","consensus":"tentative","sub_type":"porcelain_pillow","source_count":"2","evidence_status":"source_backed","description":"定窑孩儿枕是宋代定窑瓷枕，故宫博物院所藏一件塑一卧着的小孩，神态天真活泼；原文称它既是一件生活用品，也是一件瓷塑珍品。赵农以图 7-45“宋 定窑孩儿枕”收录，并在定窑部分述及其刻花、划花、印花装饰与覆烧法。","path":"works/dingyao-haier-zhen.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下宋代定窑瓷枕的器物锚点。Theme/Topic 尚未 materialize。"},{"id":"works:foguang-si-dadian","title":"佛光寺大殿（Main Hall of Foguang Temple）","name_en":"Main Hall of Foguang Temple","type":"work","type_zh":"作品","color":"#F59E0B","tags":["唐代","五台山","木构","斗拱","单檐庑殿"],"confidence":"medium","consensus":"tentative","sub_type":"timber_architecture","source_count":"2","evidence_status":"source_backed","description":"佛光寺大殿位于山西五台山，建于公元 857 年（唐宣宗大中十一年），面宽七间、进深四间，是以立柱、斗拱、梁枋等组成的梁柱式木结构典型建筑。整个建筑以榫卯衔接，严谨规范、稳定坚固；屋顶为单檐庑殿式，屋檐由斗拱挑撑、翼角上翘，殿内结构合理，宽敞明亮，朴素大方。","path":"works/foguang-si-dadian.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下唐代木构建筑的器物锚点。Theme/Topic 尚未 materialize。"},{"id":"works:guiguxiashan-qinghua-guan","title":"元代“鬼谷下山”青花瓷罐（Yuan \"Guiguxiashan\" Blue-and-White Jar）","name_en":"Yuan \"Guiguxiashan\" Blue-and-White Jar","type":"work","type_zh":"作品","color":"#F59E0B","tags":["元代","青花","拍卖","克里斯蒂","埃斯凯纳齐"],"confidence":"medium","consensus":"tentative","sub_type":"porcelain_jar","source_count":"2","evidence_status":"source_backed","description":"元代“鬼谷下山”青花瓷罐高 27.5 厘米、直径 33 厘米，是目前世间仅存的 8 件同类古董之一。2005 年 7 月 12 日，古董商埃斯凯纳齐在伦敦克里斯蒂拍卖行以 1568.8 万英镑（约 2.45 亿人民币）投得，创下历来亚洲艺术品拍卖的最高成交价。西方收藏家自 1968 年克利夫兰美术馆举办蒙古统治下的中国艺术展览后开始青睐元代瓷器。","path":"works/guiguxiashan-qinghua-guan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下元代青花瓷器的器物锚点，也涉及 D 维度的艺术市场。Theme/Topic 尚未 materialize。"},{"id":"works:guohui-1950","title":"中华人民共和国国徽（National Emblem of the People's Republic of China）","name_en":"National Emblem of the People's Republic of China","type":"work","type_zh":"作品","color":"#F59E0B","tags":["新中国","国徽","标志设计","天安门","梁思成"],"confidence":"medium","consensus":"tentative","sub_type":"national_emblem","source_count":"3","evidence_status":"source_backed","description":"中华人民共和国国徽于 1950 年 9 月 20 日公布。三册的覆盖极不平衡：**夏燕靖两版给完整过程**（1949 年 7 月征集启事与三项要求、清华大学营建系与另一设计组并行、图案要素、1950 年 6 月与 9 月两道程序），**赵农只给一幅图题和一句总评**（“应是中国 20 世纪设计作品中最重要的一个”）。**“另一设计组”的机构名在 2009 版同一段内就不统一**：前句作“国立北平艺","path":"works/guohui-1950.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"国徽是 C 维度下国家标志设计的核心样本：征集要求的三项、两个设计组的并行、齿轮麦稻穗五星绶带与天安门的组合都在此汇合。1949—1950 年的征集与通过程序归 D 维度；“中国特征”如何被转译为图形语汇归 A 维度。Theme/Topic 尚未 materialize。"},{"id":"works:guoji-zibai-pan","title":"虢季子白盘（Guoji Zibai Basin）","name_en":"Guoji Zibai Basin","type":"work","type_zh":"作品","color":"#F59E0B","tags":["西周晚期","青铜器","宣王","铭文","盥洗器"],"confidence":"medium","consensus":"tentative","sub_type":"bronze_vessel","source_count":"4","evidence_status":"source_backed","description":"虢季子白盘是西周宣王时期铸作的长方形青铜大盘，今陈列于中国历史博物馆，铭文 111 字，记虢季子白抗击外族有功、王设宴庆功。四册对它的定位沿两条线分开：夏燕靖两版把它当作**盥洗器**（盘、匜配合的沃盥之礼）中“长方形盘”的代表，完全不提铭文；赵农在**食器**一节内列“盘”，正文却明确说盘是“盛水或沐浴的器具”，并给出四册中唯一的尺寸“长有 1.5 米”；田自秉把它列在周代长篇铭文诸器之间，给年","path":"works/guoji-zibai-pan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"虢季子白盘在四册中承担两重角色：作为盥洗器样本，它是西周中期后盘类加耳、出现长方形大盘的形制证据（B）；作为有铭重器，它提供宣王时期抗击外族与庆功宴飨的史料（C 之铭文，D 之礼制）。四册均不描述纹饰。Theme/Topic 尚未 materialize。"},{"id":"works:haigu-zhanchuan","title":"海鹘战船（Haigu Warship）","name_en":"Haigu Warship","type":"work","type_zh":"作品","color":"#F59E0B","tags":["唐代","战船","浮板","抗沉性","稳定性"],"confidence":"medium","consensus":"tentative","sub_type":"warship","source_count":"2","evidence_status":"source_backed","description":"海鹘战船是唐代出现的战船，造型独特，头低尾高、前大后小，船舷两侧设浮板起平衡作用；如此设计使船具有良好的抗沉性和稳定性。","path":"works/haigu-zhanchuan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下唐代战船的器物锚点。Theme/Topic 尚未 materialize。"},{"id":"works:houfeng-dizhenyi","title":"候风地动仪（Houfeng Seismograph）","name_en":"Houfeng Seismograph","type":"work","type_zh":"作品","color":"#F59E0B","tags":["东汉","张衡","铜制","都柱","八道"],"confidence":"medium","consensus":"tentative","sub_type":"scientific_instrument","source_count":"3","evidence_status":"source_backed","description":"候风地动仪是东汉张衡等制成的世界上第一架候风地动仪。原文引《后汉书·张衡传》称其“以精铜制成，圆径八尺，合盖隆起，形似酒尊”；内部有“都柱”“八道”等机械装置，尊外八条含铜珠的龙及龙头下面设置的相应蟾蜍，使整个地动仪如精巧工艺品。","path":"works/houfeng-dizhenyi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下东汉铜制科学仪器的器物锚点。Theme/Topic 尚未 materialize。"},{"id":"works:huaniao-renwu-luodian-jing","title":"花鸟人物螺钿镜（Mother-of-Pearl Mirror with Figures and Birds）","name_en":"Mother-of-Pearl Mirror with Figures and Birds","type":"work","type_zh":"作品","color":"#F59E0B","tags":["唐代","洛阳","螺钿","平脱","人物"],"confidence":"medium","consensus":"tentative","sub_type":"bronze_mirror","source_count":"2","evidence_status":"source_backed","description":"花鸟人物螺钿镜是 1956 年洛阳唐墓出土的螺钿铜镜。镜面花树下老者弹琴、另一老者持杯倾听、后立侍童，镜纽下刻山石、鸳鸯、小鸟、仙鹤，人物衣纹、鸟羽、叶脉均细线刻划，螺片空间似用松石屑填饰且多脱落。李立新将其作为青铜器失去礼制作用后转向日用、仍有珍稀之品的例证之一。","path":"works/huaniao-renwu-luodian-jing.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下唐代铜镜的器物锚点。Theme/Topic 尚未 materialize。"},{"id":"works:huwen-da-shiqing","title":"虎纹大石磬（Tiger-Engraved Stone Chime）","name_en":"Tiger-Engraved Stone Chime","type":"work","type_zh":"作品","color":"#F59E0B","tags":["商代","安阳武官村","石磬","双钩线刻","编磬"],"confidence":"medium","consensus":"tentative","sub_type":"musical_instrument","source_count":"2","evidence_status":"source_backed","description":"虎纹大石磬是 1950 年安阳武官村大墓出土的商代石磬，长 84 厘米、高 42 厘米、厚 2.5 厘米。用双钩线刻表现一个张口伸腰的虎形，虎身布满装饰斑纹，原文称是一件精巧的石雕珍品，制作水平较高。同时已有三枚组成的编磬；夏代已有石磬，但大多制器粗糙。","path":"works/huwen-da-shiqing.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下商代石制乐器的器物锚点。Theme/Topic 尚未 materialize。"},{"id":"works:jinan-liujia-zhenpu-tongban","title":"济南刘家功夫针铺铜版（Jinan Liu Family Needle Shop Copper Printing Plate）","name_en":"Jinan Liu Family Needle Shop Copper Printing Plate","type":"work","type_zh":"作品","color":"#F59E0B","tags":["北宋","印刷","商标","广告","铜版"],"confidence":"medium","consensus":"tentative","sub_type":"copper_print_block","source_count":"4","evidence_status":"source_backed","description":"济南刘家功夫针铺铜版是北宋济南一家针铺的印刷广告铜版，今藏中国国家博物馆。四册的写法差别极大：**夏燕靖 2016 给版面分层、逐字铭文与制作方法**（双线为框、内分三层、28 字全文），**高丰给尺寸、构图评析与中西印刷广告的年代比较**（欧洲 1480 年第一张印刷广告、领先至少 400 年），**赵农只给商标功能与两句铭文**（白兔为记、钢针精制），**夏燕靖 2009 在本条只存一条图题，","path":"works/jinan-liujia-zhenpu-tongban.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"济南刘家功夫针铺铜版是 B 维度下宋代印刷与商业设计的实物锚点：铜版雕刻、版面分层与图文编排都在此可量。版面构成与黑白对比归 C 维度，商标与广告的经营功能归 D 维度。Theme/Topic 尚未 materialize。"},{"id":"works:kaifeng-xiangguosi-pagoda","title":"开封相国寺塔（Pagoda of Xiangguo Temple, Kaifeng）","name_en":"Pagoda of Xiangguo Temple, Kaifeng","type":"work","type_zh":"作品","color":"#F59E0B","tags":["宋代","琉璃砖塔","仿木楼阁式","飞天","50多种纹样"],"confidence":"medium","consensus":"tentative","sub_type":"pagoda","source_count":"3","evidence_status":"source_backed","description":"开封相国寺塔是宋代仿木楼阁式砖塔，造型高耸挺秀；塔身采用 28 种琉璃砖砌造，雕刻有飞天、麒麟、菩萨、力士、狮子等 50 多种纹样，雕工精细，整座塔宛如一件大型的琉璃工艺品。","path":"works/kaifeng-xiangguosi-pagoda.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下宋代琉璃砖塔的器物锚点。Theme/Topic 尚未 materialize。"},{"id":"works:lianhe-fanghu","title":"莲鹤方壶（Lotus and Crane Square Hu）","name_en":"Lotus and Crane Square Hu","type":"work","type_zh":"作品","color":"#F59E0B","tags":["春秋","青铜器","新郑","方壶"],"confidence":"medium","consensus":"tentative","sub_type":"bronze_vessel","source_count":"6","evidence_status":"source_backed","description":"莲鹤方壶是河南新郑出土的一对春秋青铜方壶，因壶顶莲瓣中立一展翅欲飞的鹤而得名。六册来源都把它视为青铜器由商周静态、肃穆、礼制化风格转向轻巧活泼风格的代表作，是中国设计史叙述中春秋青铜器设计转变的关键物证。","path":"works/lianhe-fanghu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"莲鹤方壶是 B 维度下春秋青铜器设计转变的代表作；年代、尺寸与收藏信息在来源间不完全一致。Theme/Topic 尚未 materialize。"},{"id":"works:lianhua-zun","title":"莲花尊（Lotus Zun）","name_en":"Lotus Zun","type":"work","type_zh":"作品","color":"#F59E0B","tags":["南北朝","青瓷","仰覆莲瓣","佛教","七层"],"confidence":"medium","consensus":"tentative","sub_type":"porcelain_vessel","source_count":"4","evidence_status":"source_backed","description":"莲花尊是南北朝时期（主要是齐、梁和北魏）的特殊青瓷品种，设计别致、意匠新颖，具有较高艺术性。尊体以腹为中心，上下部塑饰成各为相向的三层莲花瓣，层层相接，故又名仰覆莲花瓷尊；尊底也塑成莲花瓣形，全尊共 7 层，肩部有耳，颈部塑出花鸟云龙。此尊高 66.5 厘米、口径 19.2 厘米，现陈列于北京故宫博物院。河北景县出土四件仰覆莲花尊，最高 40 厘米，综合印贴、刻划、堆塑；南京林山梁代大墓出土两件同","path":"works/lianhua-zun.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下南北朝青瓷的器物锚点，也涉及 E 维度的佛教艺术传播。Theme/Topic 尚未 materialize。"},{"id":"works:liujin-wuma-xianbei-yinhu","title":"鎏金舞马衔杯银壶（Gilt Silver Ewer with Dancing Horse）","name_en":"Gilt Silver Ewer with Dancing Horse","type":"work","type_zh":"作品","color":"#F59E0B","tags":["盛唐","何家村","皮囊壶","鎏金","舞马"],"confidence":"medium","consensus":"tentative","sub_type":"silverware","source_count":"3","evidence_status":"source_backed","description":"鎏金舞马衔杯银壶是盛唐银器，1970 年 10 月西安何家村唐代窖藏出土，通高 18.5 厘米。器腹两面锤出马衔杯纹，仿北方游牧民族皮囊与马镫综合形状，圈足墨书“十三两半”。舞马部分采取鎏金技术，使银壶与鎏金相互辉映。","path":"works/liujin-wuma-xianbei-yinhu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下盛唐金银器的器物锚点，也涉及 E 维度的游牧文化影响。Theme/Topic 尚未 materialize。"},{"id":"works:luanshu-fou","title":"栾书缶（Luan Shu Fou）","name_en":"Luan Shu Fou","type":"work","type_zh":"作品","color":"#F59E0B","tags":["春秋","错金铭文","错金银","青铜缶"],"confidence":"medium","consensus":"tentative","sub_type":"bronze_vessel","source_count":"2","evidence_status":"source_backed","description":"栾书缶是春秋时期青铜缶，上有错金铭文 40 余字，被用作春秋中期错金银工艺有所发展的例证；该器铭文是说明当时错金技术水平的实物材料。","path":"works/luanshu-fou.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下春秋青铜器的器物锚点。Theme/Topic 尚未 materialize。"},{"id":"works:lv-you-tao-lou","title":"绿釉陶楼（Green-Glazed Pottery Tower）","name_en":"Green-Glazed Pottery Tower","type":"work","type_zh":"作品","color":"#F59E0B","tags":["东汉","明器","楼阁式建筑","庄园坞堡","绿釉"],"confidence":"medium","consensus":"tentative","sub_type":"tomb_model","source_count":"2","evidence_status":"source_backed","description":"绿釉陶楼是汉代墓葬出土的绿釉陶质明器，能体现汉代楼阁式建筑式样。汉代建筑以楼阁形式较为典型，一般由台基、门楼和五层楼阁组成，各层门窗、屋脊、栏杆等部位饰有人物、花鸟等纹样；绿釉陶楼直观再现建筑的形制特征和建造技巧，是汉代陶塑中不可多得的上乘之作，并反映东汉末年皇室衰微、地方豪强构筑庄园坞堡、拥兵自卫的社会现实。","path":"works/lv-you-tao-lou.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下东汉建筑明器的器物锚点。Theme/Topic 尚未 materialize。"},{"id":"works:mao-gong-ding","title":"毛公鼎（Mao Gong Ding）","name_en":"Mao Gong Ding","type":"work","type_zh":"作品","color":"#F59E0B","tags":["西周","青铜鼎","长篇铭文","479字","兽蹄足"],"confidence":"medium","consensus":"tentative","sub_type":"bronze_ding","source_count":"2","evidence_status":"source_backed","description":"毛公鼎是西周青铜鼎。2016 在叙述西周后期鼎形演变时，以耳渐外移、口渐敞、下腹内收使器身成半球形、足成兽蹄形为特征，将毛公鼎与大克鼎并举为这一形制的代表器。赵农以图 2-42“西周 毛公鼎”收录，称其长篇铭文是西周珍贵文献，与《史墙盘》《大盂鼎》《虢季子白盘》《多友鼎》并列；《毛公鼎》有 479 个文字，记述当时复杂的社会事件。","path":"works/mao-gong-ding.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下西周青铜鼎的器物锚点，铭文内容另涉 A 维度的文献价值。Theme/Topic 尚未 materialize。"},{"id":"works:miaoying-si-baita","title":"北京妙应寺白塔（Miaoying Temple White Stupa）","name_en":"Miaoying Temple White Stupa","type":"work","type_zh":"作品","color":"#F59E0B","tags":["元代","阿尼哥","覆钵式塔","尼泊尔","铜华盖"],"confidence":"medium","consensus":"tentative","sub_type":"religious_architecture","source_count":"3","evidence_status":"source_backed","description":"北京妙应寺白塔建于至元八年（1271），由尼泊尔名匠阿尼哥设计，为覆钵式塔（喇嘛塔），年代最早、规模最大。塔高 50.9 米，塔基三层、平面呈亚字形、须弥座式，砖雕莲座承塔身；塔肚顶部华盖由 40 块铜板瓦构成，四周悬 36 只铜质透雕流苏和风铃，刹顶置铜制小喇嘛塔高 5 米、重约 40 吨。","path":"works/miaoying-si-baita.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下元代宗教建筑的器物锚点，也涉及 E 维度的跨文化技术流动。Theme/Topic 尚未 materialize。"},{"id":"works:muniu-liuma","title":"木牛流马（Wooden Ox and Flowing Horse）","name_en":"Wooden Ox and Flowing Horse","type":"work","type_zh":"作品","color":"#F59E0B","tags":["三国","诸葛亮","蒲元","独轮车","山地运输"],"confidence":"medium","consensus":"tentative","sub_type":"transport_device","source_count":"2","evidence_status":"source_backed","description":"木牛流马是三国时期蜀汉在山地军事运输中使用的独轮车。赵农记诸葛亮在蜀国山地军事运输中推广使用，被传奇地称为“木牛流马”，它利用独轮车的结构改善山地长途运输功能，提高蜀国军队的战斗供需能力；《三国志·蜀书·诸葛亮传》载“九年，亮复出祁山，以木牛运……十二年春，亮悉大众由斜谷出，以流马运”，木牛“载一岁粮，日行二十里，而人不大劳”。夏燕靖则记其为蜀汉蒲元为解决山道运粮困难而发明，称“廉仰双辕，人行六尺","path":"works/muniu-liuma.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下三国运输工具的器物锚点。Theme/Topic 尚未 materialize。"},{"id":"works:nanchan-si-dadian","title":"南禅寺大殿（Main Hall of Nanchan Temple）","name_en":"Main Hall of Nanchan Temple","type":"work","type_zh":"作品","color":"#F59E0B","tags":["唐代","五台山","木构","现存最古","782年"],"confidence":"medium","consensus":"tentative","sub_type":"timber_architecture","source_count":"2","evidence_status":"source_backed","description":"南禅寺大殿位于山西五台山，建于公元 782 年，是目前现存最古老的木结构建筑。大殿为长宽各三间的格式，四周以 12 根列柱环绕、略微内收，使梁柱枋结构稳定严密；屋顶舒缓，椽檐以斗拱上挑、出檐深远，气象浑厚，殿内无柱，佛坛上还保存着唐代佛像精品。","path":"works/nanchan-si-dadian.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下唐代木构建筑的器物锚点。Theme/Topic 尚未 materialize。"},{"id":"works:nanhai-one","title":"南海一号（Nanhai One Shipwreck）","name_en":"Nanhai One Shipwreck","type":"work","type_zh":"作品","color":"#F59E0B","tags":["南宋","沉船","阳江","海上丝绸之路","尖头船"],"confidence":"medium","consensus":"tentative","sub_type":"shipwreck","source_count":"2","evidence_status":"source_backed","description":"南海一号是南宋时期的木质古沉船，沉没于广东阳江市东平港以南约 20 海里处，1987 年在广东阳江海域发现。为尖头船，船长 30.4 米、宽 9.8 米，船身（不算桅杆）高 8 米，排水量估计可达 600 吨，载重可能近 800 吨，是我国目前发现的最大的宋代船只。船体保存相当完好，专家推测其从中国驶出，赴新加坡、印度等东南亚地区或中东地区进行海外贸易。","path":"works/nanhai-one.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下南宋沉船的器物锚点，也涉及 E 维度的海上贸易。Theme/Topic 尚未 materialize。"},{"id":"works:ou-fangyi","title":"偶方彝（Ou Fangyi (Paired Square Ritual Vessel)）","name_en":"Ou Fangyi (Paired Square Ritual Vessel)","type":"work","type_zh":"作品","color":"#F59E0B","tags":["商代","妇好墓","青铜酒器","斗拱雏形","鸟兽浮雕"],"confidence":"medium","consensus":"tentative","sub_type":"bronze_wine_vessel","source_count":"2","evidence_status":"source_backed","description":"偶方彝是安阳殷墟妇好墓出土的青铜酒器，与铜鸮尊、圈足觥同出，器身饰鸟兽浮雕／圆雕，标志青铜工艺与设计的新高峰。赵农另记妇好墓“偶方彝”上有斗的雏形，作为商周斗拱已见雏形的青铜器例证。","path":"works/ou-fangyi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下商代青铜酒器的器物锚点，斗拱雏形说另涉建筑史。Theme/Topic 尚未 materialize。"},{"id":"works:qikong-shidao","title":"七孔石刀（Seven-Holed Stone Knife）","name_en":"Seven-Holed Stone Knife","type":"work","type_zh":"作品","color":"#F59E0B","tags":["薛家岗文化","新石器时代","长兵器","钻孔","绑缚"],"confidence":"medium","consensus":"tentative","sub_type":"stone_tool","source_count":"2","evidence_status":"source_backed","description":"七孔石刀是 1980 年安徽潜山薛家岗出土的新石器时代石器，属距今约 5500 年的薛家岗文化。器略呈长方形，长 325 毫米、宽 95 毫米、厚约 10 毫米，刀背平直，沿背排列 7 个圆孔。原文推测以木柄开槽嵌刀背，用麻绳或皮革穿孔绑缚，为作战用砍杀长兵器。","path":"works/qikong-shidao.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下新石器时代石质兵器的器物锚点。Theme/Topic 尚未 materialize。"},{"id":"works:qin-bing-ma-yong","title":"秦兵马俑（Terracotta Army）","name_en":"Terracotta Army","type":"work","type_zh":"作品","color":"#F59E0B","tags":["秦代","秦始皇陵","陶塑","模塑结合","写实"],"confidence":"medium","consensus":"tentative","sub_type":"tomb_figurines","source_count":"4","evidence_status":"source_backed","description":"秦兵马俑是 1974 年秦始皇陵东侧出土的陶制兵马俑群，共 7000 余件（一说推测约 8000 余件），身高 1.75–1.85 米、最高 1.98 米。采用模塑结合、分工制作、套合粘接初胎，再覆细泥并综合塑、堆、贴、刻、画技法，兼具整体造型与局部刻画。一号坑东西长 230 米、南北宽 62 米，为步兵和战车混编的主力部队；二号坑是战车、射手、骑兵混编；三号坑是统帅指挥部。兵马俑造型以写实为主，","path":"works/qin-bing-ma-yong.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下秦代陶俑群的器物锚点。Theme/Topic 尚未 materialize。"},{"id":"works:qin-shi-huang-ling","title":"秦始皇陵（Mausoleum of the First Qin Emperor）","name_en":"Mausoleum of the First Qin Emperor","type":"work","type_zh":"作品","color":"#F59E0B","tags":["秦代","临潼","水银","覆斗形封丘","70万人"],"confidence":"medium","consensus":"tentative","sub_type":"mausoleum","source_count":"3","evidence_status":"source_backed","description":"秦始皇陵位于陕西临潼，是秦代最具代表性的营造之作。陵区规模宏大，墓冢高 76 米、底边宽 485 米、长 515 米；据史料记载征用民夫 70 万人、用 37 年建成。陵内宛如地下宫殿，棺椁周围铸满铜汁，设百官、摆珍宝，以人鱼膏为烛，宫室之外灌输水银象征江河湖海，“上具天文，下具地理”；陵墓南屏骊山、北临渭水，陵东 1.5 公里处为兵马俑坑。","path":"works/qin-shi-huang-ling.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下秦代陵墓的器物锚点，也涉及 A 维度的帝王观念。Theme/Topic 尚未 materialize。"},{"id":"works:qingming-shanghe-tu","title":"清明上河图（Along the River During the Qingming Festival）","name_en":"Along the River During the Qingming Festival","type":"work","type_zh":"作品","color":"#F59E0B","tags":["北宋","张择端","汴梁","商业美术","幌子"],"confidence":"medium","consensus":"tentative","sub_type":"painting","source_count":"2","evidence_status":"source_backed","description":"清明上河图是宋代张择端所绘长卷，描绘汴梁繁华社会景象，绘城楼、桥梁、船只、车马、旅店、酒肆、商铺、寺院及各类人物 810 多个，是研究宋代城市和环境设计的重要资料。图中还可见商业广告幌子、虹桥、折叠桌、大小船 28 余艘等细节。2016 记其描绘东京汴梁商号店铺、招牌、幌子、横匾、对联等商业设计，以及数百名各行各业人士的各异服式，是研究宋代商业美术与服饰的重要图像材料。","path":"works/qingming-shanghe-tu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 C 维度下宋代商业美术图像的器物锚点，也涉及 B 维度的城市与家具。Theme/Topic 尚未 materialize。"},{"id":"works:qinling-tongchema","title":"秦陵铜车马（Bronze Chariots and Horses from the Qin Mausoleum）","name_en":"Bronze Chariots and Horses from the Qin Mausoleum","type":"work","type_zh":"作品","color":"#F59E0B","tags":["秦代","青铜器","车制","系驾","秦始皇陵"],"confidence":"medium","consensus":"tentative","sub_type":"bronze_carriage","source_count":"5","evidence_status":"source_backed","description":"秦陵铜车马是秦始皇陵西侧出土的两乘青铜车马，1980 年发掘，各按真车真马约二分之一缩制。五册的关注点分化明显：**夏燕靖两版逐车给车舆、伞盖、门窗与随车器物的尺寸**（2009 与 2016 近乎逐字相同，2016 另补破碎块数与修复年数），**高丰给形制与《考工记》的对读**（辐条 30 根、盖弓 22 根、伞通高 114 厘米、立车 3064 件与安车 3462 件），**赵农给整体尺寸与御","path":"works/qinling-tongchema.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"秦陵铜车马是 B 维度下秦代车制的实物锚点：车舆尺度、系驾方式、伞盖与门窗构造、分铸组装工艺都在此可量。它同时是“以明器证车制”这一研究方法的样本，方法论一侧归 A 维度。Theme/Topic 尚未 materialize。"},{"id":"works:renmin-dahuitang-1959","title":"人民大会堂（Great Hall of the People）","name_en":"Great Hall of the People","type":"work","type_zh":"作品","color":"#F59E0B","tags":["新中国","国庆工程","十大建筑","室内设计","中而新"],"confidence":"medium","consensus":"tentative","sub_type":"public_building","source_count":"3","evidence_status":"source_backed","description":"人民大会堂是为迎接新中国成立 10 周年而建的“国庆工程”十项大型建筑之一，1958 年 9 月确定任务。三册的写法差别很大：**夏燕靖两版给组织过程与室内设计**（1958 年 9 月确定任务、首次聘请装饰设计专家与画家雕塑家配合建筑师、“水天一色”天花、周恩来把近 30 个厅分包各省市、梁思成 1961 年文章的引文），**赵农只把它放进“十大建筑”与天安门广场改造的框架里**，并给出一幅华灯","path":"works/renmin-dahuitang-1959.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"人民大会堂是 B 维度下国家大型公共建筑的样本：1958 年国庆工程的十项建筑之列、室内设计首次引入装饰专家与画家雕塑家协作、万人大会堂的天花处理都在此汇合。“中而新”与民族形式的取向归 A 维度；国家任务与各省市分包的组织方式归 D 维度。Theme/Topic 尚未 materialize。"},{"id":"works:san-jiao-lou","title":"三脚耧（Three-Legged Seed Drill）","name_en":"Three-Legged Seed Drill","type":"work","type_zh":"作品","color":"#F59E0B","tags":["西汉","赵过","播种机","开沟","下种"],"confidence":"medium","consensus":"tentative","sub_type":"agricultural_machine","source_count":"3","evidence_status":"source_backed","description":"三脚耧是汉武帝时搜粟都尉赵过在一脚耧、二脚耧基础上设计发明的播种工具，大大提高播种效率，是现代播种机的雏形。现代全功能播种机把开沟、下种、覆盖、压实四道工序接连完成，而我国两千年前的三脚耧已能把前三道工序合并于一机完成。","path":"works/san-jiao-lou.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下西汉农业机械的器物锚点。Theme/Topic 尚未 materialize。"},{"id":"works:shang-elephant-zun","title":"商代象尊（Shang Elephant Zun）","name_en":"Shang Elephant Zun","type":"work","type_zh":"作品","color":"#F59E0B","tags":["商代","湖南醴陵","鸟兽形尊","祭器","象鼻"],"confidence":"medium","consensus":"tentative","sub_type":"bronze_ritual_vessel","source_count":"2","evidence_status":"source_backed","description":"商代象尊是湖南醴陵出土的鸟兽形青铜尊，整器形象逼真而具装饰性，满身饰纹，象鼻外雕一虎形兽，器盖为一小象，体现工匠高超技艺。象尊属鸟兽形尊，背部凿口并加盖以注酒，是当时专用祭器。","path":"works/shang-elephant-zun.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下商代鸟兽形青铜器的器物锚点。Theme/Topic 尚未 materialize。"},{"id":"works:shanghai-expo-china-pavilion-2010","title":"2010年上海世博会中国馆（China Pavilion, Expo 2010 Shanghai）","name_en":"China Pavilion, Expo 2010 Shanghai","type":"work","type_zh":"作品","color":"#F59E0B","tags":["2010","上海","世博会","中国馆","国家展馆"],"confidence":"medium","consensus":"tentative","sub_type":"exhibition_pavilion","source_count":"1","evidence_status":"source_backed","description":"2010年上海世博会中国馆是赵农《中国艺术设计史》中以图版出现的当代建筑。导论图导论-6 与第十章图10-67 两处图注均以该馆为题，图10-67 图注作“东方既白，知者创物”。两处均只有图注，来源未记设计者、尺寸、材料、结构等信息；两幅图版均未做视觉核验。本条只登记来源可证的图注信息，不据外部知识补全。","path":"works/shanghai-expo-china-pavilion-2010.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本项目是 B 维度下当代国家展馆建筑的图注条目：仅登记赵农两处图版所标对象与图注文字。Theme/Topic 尚未 materialize。"},{"id":"works:shanghai-huifeng-yinhang","title":"上海汇丰银行（HSBC Building, Shanghai）","name_en":"HSBC Building, Shanghai","type":"work","type_zh":"作品","color":"#F59E0B","tags":["外滩","公和洋行","古典主义","钢筋混凝土","1923"],"confidence":"medium","consensus":"tentative","sub_type":"architecture","source_count":"2","evidence_status":"source_backed","description":"上海汇丰银行由英商公和洋行设计，建于 1921～1923 年间，地处上海外滩，高 8 层、占地 14 亩，建筑为钢筋混凝土浇灌、外观仿砖石结构。整个造型中部圆顶高耸，内部为爱奥尼柱式的柱廊和藻井式天花，是典型的古典主义样式建筑。","path":"works/shanghai-huifeng-yinhang.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下近代外滩建筑的器物锚点，也涉及 D 维度的通商口岸制度。Theme/Topic 尚未 materialize。"},{"id":"works:shiwu-lianzhan-tongdeng","title":"十五连盏铜灯（Fifteen-Lamp Bronze Lamp）","name_en":"Fifteen-Lamp Bronze Lamp","type":"work","type_zh":"作品","color":"#F59E0B","tags":["战国","中山国","树形灯","河北平山","可调节"],"confidence":"medium","consensus":"tentative","sub_type":"bronze_lamp","source_count":"2","evidence_status":"source_backed","description":"十五连盏铜灯是河北平山出土的战国中山国铜灯，高达 84.5 厘米，以树形灯架为主体，上饰有龙、鸟、猴、人物等形象，造型奇特；15 盏灯可聚可散，可根据照明需要加以调节。田自秉记其一树为灯杆，上有 15 个灯盏，树身塑造一群动态各异的猴子，称其意趣盎然、生动可爱。","path":"works/shiwu-lianzhan-tongdeng.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下战国青铜灯具的器物锚点。Theme/Topic 尚未 materialize。"},{"id":"works:shui-dui","title":"水碓（Water-Powered Trip Hammer）","name_en":"Water-Powered Trip Hammer","type":"work","type_zh":"作品","color":"#F59E0B","tags":["东汉","西汉末年","水力","齿轮","舂米"],"confidence":"medium","consensus":"tentative","sub_type":"grain_machine","source_count":"2","evidence_status":"source_backed","description":"水碓是以水为动力的粮食加工机械。2016 记其为西汉末年出现，利用水力驱动碓头舂米，极大提高了舂米效率，图 4-35 为西汉水碓模型。赵农记东汉时期出现水碓和畜力碓，利用自然和牲畜的力量加工粮食作物：水碓将水流作为动力，带动齿轮旋转，然后用杵棒敲击谷物，减轻了人们的劳作；东汉《新语》有“及役水而舂，其利乃百倍”的说法。","path":"works/shui-dui.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下汉代粮食加工机械的器物锚点。Theme/Topic 尚未 materialize。"},{"id":"works:shuilu-gongzhan-jian","title":"水陆攻战纹鉴（Water-Land Battle Scene Jian）","name_en":"Water-Land Battle Scene Jian","type":"work","type_zh":"作品","color":"#F59E0B","tags":["战国","汲县山彪镇","红铜镶嵌","战船","约300人"],"confidence":"medium","consensus":"tentative","sub_type":"bronze_basin","source_count":"2","evidence_status":"source_backed","description":"水陆攻战纹鉴是战国青铜鉴，1935 年河南汲县山彪镇出土。外壁用红铜镶嵌水陆射杀、格斗等战争场面，战士束腰佩剑，有张弓、持戟、架梯、荡桨、首级落地、奔跑呼叫等姿态，共约 300 人；器现藏台湾省。李立新据其纹样说明战船分两层、上层作战下层划桨、船底双层。","path":"works/shuilu-gongzhan-jian.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下战国青铜鉴的器物锚点，纹样内容另涉 C 维度的叙事图像。Theme/Topic 尚未 materialize。"},{"id":"works:simei-tu","title":"四美图（Four Beauties Print）","name_en":"Four Beauties Print","type":"work","type_zh":"作品","color":"#F59E0B","tags":["金代","平阳","姬家雕印","招贴","年画"],"confidence":"medium","consensus":"tentative","sub_type":"print_poster","source_count":"2","evidence_status":"source_backed","description":"四美图是金代平阳府（今山西临汾）姬家刻印的雕版印刷招贴画，高 57.5 厘米、宽 32.5 厘米；画面为王昭君、赵飞燕、班姬（婕妤）、绿珠四位美人，花冠绣裳、体姿生动、线条流畅、刻工精细。画面上方刻“随朝窈窕呈倾国之芳容”楷书字样，并有“平阳姬家雕印”题识。赵农另记其高二尺五寸、宽一尺多，并推测为北宋末年山西临汾商家印制的年画、“对屏”中左边一幅。","path":"works/simei-tu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 C 维度下金代雕版印刷招贴的器物锚点。Theme/Topic 尚未 materialize。"},{"id":"works:simuwu-ding","title":"司母戊大方鼎（Simuwu Ding）","name_en":"Simuwu Ding","type":"work","type_zh":"作品","color":"#F59E0B","tags":["商代晚期","青铜器","殷墟","方鼎","铸造工艺"],"confidence":"medium","consensus":"tentative","sub_type":"bronze_vessel","source_count":"5","evidence_status":"source_backed","description":"司母戊大方鼎是商代晚期殷墟出土的巨型青铜方鼎，重 875 公斤、通高 133 厘米，为已知最大的商代青铜器。五册来源有直接记载（李立新一册无\"司母戊\"字样）。尺寸与重量五册完全一致，但**范铸方式的记述互不相同**：腹范究竟是四块（每块内嵌六块分范）、鼎身八块外范，还是每边八块外范；鼎耳是\"接铸\"、在鼎上加范浇铸，还是\"单独铸造后再合铸（分铸法）\"。这些不是措辞差异，而是工艺复原层面的分歧，本 K","path":"works/simuwu-ding.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"司母戊大方鼎是 B 维度下商代晚期青铜铸造规模与范铸技术的器物锚点，其兽面纹、夔纹与虎食人耳纹饰属 C 维度。Theme/Topic 尚未 materialize。"},{"id":"works:siyang-fangzun","title":"四羊方尊（Four-Ram Square Zun）","name_en":"Four-Ram Square Zun","type":"work","type_zh":"作品","color":"#F59E0B","tags":["商代","青铜尊","四羊","图注","年代分歧"],"confidence":"medium","consensus":"tentative","sub_type":"bronze_ritual_vessel","source_count":"2","evidence_status":"source_backed","description":"四羊方尊是商代青铜尊，见于赵农图 2-10（图注“商 四羊方尊”）与夏燕靖 2016 图 2-5（图注作西周器）。两册正文均未对其器形、纹饰、尺寸作进一步说明，图版未视觉核验。","path":"works/siyang-fangzun.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下商周青铜礼器的器物锚点，证据仅到图注层级。Theme/Topic 尚未 materialize。"},{"id":"works:songyue-si-ta-523","title":"嵩岳寺塔（Songyue Temple Pagoda）","name_en":"Songyue Temple Pagoda","type":"work","type_zh":"作品","color":"#F59E0B","tags":["北魏","佛塔","密檐式砖塔","十二边形","登封"],"confidence":"medium","consensus":"tentative","sub_type":"pagoda","source_count":"4","evidence_status":"source_backed","description":"嵩岳寺塔在河南登封嵩岳寺，建于公元 523 年（北魏），是中国现存最古老的砖塔。四册里三册给描述，李立新一册以图版图注加塔的类型分类出现。**赵农给的结构细节最细**（首层十二边形、塔室八角形、厚壁空心式木板楼、空筒状至塔顶），**夏燕靖两版给的地位判断最直**（现存最早高层砖石建筑），**三册在高度上分成 41 米与 39.5 米两说**。李立新正文只谈塔的材料与形式分类，把本塔作插图，故本 K","path":"works/songyue-si-ta-523.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"嵩岳寺塔是 B 维度下北魏密檐式砖塔的结构样本：十二边形首层、八角形塔室、厚壁空心式木板楼、空筒状塔身都在此汇合。北魏佛教寺院数量与舍宅为寺的制度背景归 D 维度。李立新一册只提供塔的类型分类与图版图注，不含该塔的描述。Theme/Topic 尚未 materialize。"},{"id":"works:susha-chanyi","title":"素纱禅衣（Plain Silk Gauze Robe）","name_en":"Plain Silk Gauze Robe","type":"work","type_zh":"作品","color":"#F59E0B","tags":["西汉","马王堆","丝织","服饰","纱"],"confidence":"medium","consensus":"tentative","sub_type":"silk_garment","source_count":"3","evidence_status":"source_backed","description":"素纱禅衣是湖南长沙马王堆一号汉墓出土的西汉单衣，衣长 128 厘米、重 49 克。三册的用法不同：**高丰给形制、镶缘与礼制出处**（领边袖边 5.6 厘米夹层绢缘，引《礼记·玉藻》郑玄注），**田自秉给织造组织与感官评价**（方孔平纹，类似现今的乔其纱，引“轻薄如空”“举之若无”），**赵农两处提到而只给数据与赞叹**（一处引“其水平之精湛，令人叹为观止”，一处给尺寸与重量）。**袖长在两册间相","path":"works/susha-chanyi.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"素纱禅衣是 B 维度下汉代丝织与服饰工艺的器物锚点：纱的平纹组织、单衣形制与不足一两的重量都在此可量。其“轻薄如空”“举之若无”的感官评价与后世纱罗的形态关联归 C 维度。Theme/Topic 尚未 materialize。"},{"id":"works:tang-yin-xiangnang","title":"唐代银香囊（Tang Silver Perfume Pouch）","name_en":"Tang Silver Perfume Pouch","type":"work","type_zh":"作品","color":"#F59E0B","tags":["唐代","何家村","法门寺","平衡环","陀螺仪原理"],"confidence":"medium","consensus":"tentative","sub_type":"silverware","source_count":"2","evidence_status":"source_backed","description":"唐代银香囊是唐代银质熏香器，几乎均出自以西安为中心的陕西关中地区，计 1963 年西安沙坡村 4 件、1970 年西安何家村窖藏 1 件、1987 年扶风法门寺地宫两件；除最大一件（法门寺出土）直径 12.8 厘米外，其余直径大多在五厘米左右。通体圆球状，上半球为盖、顶部铆接环钮并置长链，下半球为身，子母口扣合、铰链相连，通体镂空。内有平衡环及焚香盂，两个同心圆环之间及内圆环与焚香盂之间均以对称短","path":"works/tang-yin-xiangnang.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下唐代金银器的器物锚点。Theme/Topic 尚未 materialize。"},{"id":"works:tibi-chaju","title":"提璧茶具（Tibi Tea Set）","name_en":"Tibi Tea Set","type":"work","type_zh":"作品","color":"#F59E0B","tags":["紫砂","顾景舟","高庄","1950年代","玉文化"],"confidence":"medium","consensus":"tentative","sub_type":"teaset","source_count":"2","evidence_status":"source_backed","description":"提璧茶具是 20 世纪 50 年代紫砂工艺师顾景舟与中央工艺美术学院高庄教授合作创作的紫砂茶具，开创了玉文化与紫砂造型艺术融于一体的设计新理念。","path":"works/tibi-chaju.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下现代紫砂茶具的器物锚点，也涉及 D 维度的工艺美术教育合作。Theme/Topic 尚未 materialize。"},{"id":"works:tong-niu-deng","title":"铜牛灯（Bronze Ox Lamp）","name_en":"Bronze Ox Lamp","type":"work","type_zh":"作品","color":"#F59E0B","tags":["汉代","长沙","虹管灯","虹吸","灯烟"],"confidence":"medium","consensus":"tentative","sub_type":"bronze_lamp","source_count":"2","evidence_status":"source_backed","description":"铜牛灯是长沙出土的汉代铜灯，灯体为牛形，以两角顺背向上做成虹吸管，有一向下的碗状灯罩以吸收灯烟。原文以此说明虹管灯利用虹吸原理防止烟尘污染空气的设计。","path":"works/tong-niu-deng.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下汉代青铜灯具的器物锚点。Theme/Topic 尚未 materialize。"},{"id":"works:wu-zixu-huaxiang-jing","title":"伍子胥画像镜（Wu Zixu Portrait Mirror）","name_en":"Wu Zixu Portrait Mirror","type":"work","type_zh":"作品","color":"#F59E0B","tags":["六朝","铜镜","画像镜","绍兴","上海博物馆"],"confidence":"medium","consensus":"tentative","sub_type":"bronze_mirror","source_count":"3","evidence_status":"source_backed","description":"伍子胥画像镜是六朝时期浙江绍兴一带铸造的画像镜，镜背以浮雕手法表现吴王、伍子胥、越王、范蠡、越女等人物，所取为春秋吴越争霸的历史故事。三册来源分工恰好互补：夏燕靖两版给**地位与收藏**（“魏晋南北朝时期最为突出的铜镜”，现藏上海博物馆，“所表现的重大历史题材，尚属首见”），田自秉给**产地、工艺与图像内容**（绍兴、浮雕、立体感、五名人物），并把伍子胥谏吴王的历史本事与“反映人民对他的追念……反","path":"works/wu-zixu-huaxiang-jing.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"伍子胥画像镜是 B 维度下六朝铜镜的工艺样本（绍兴铸镜、浮雕手法、立体感），其以历史故事为镜背图像、人物多达五名，归 C 维度的图像叙事。四册均不描述其纹样布局与铭文。Theme/Topic 尚未 materialize。"},{"id":"works:wudao-renwu-dongwu-wen-sanse-jin","title":"舞蹈人物动物纹三色锦（Three-Color Brocade with Dancers and Animals）","name_en":"Three-Color Brocade with Dancers and Animals","type":"work","type_zh":"作品","color":"#F59E0B","tags":["战国","江陵","提花机","经纬密度","7单元"],"confidence":"medium","consensus":"tentative","sub_type":"brocade","source_count":"2","evidence_status":"source_backed","description":"舞蹈人物动物纹三色锦是湖北江陵出土的战国锦，为其中纹样最复杂者。它由 7 个单元组成横贯全幅的花纹，经向长 5.5 厘米、纬向宽 49.1 厘米，经纬密度为 156×52 根/平方厘米，表明战国时已有较先进的提花机和熟练的织造技术。","path":"works/wudao-renwu-dongwu-wen-sanse-jin.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下战国织锦的器物锚点。Theme/Topic 尚未 materialize。"},{"id":"works:wudaowen-caitao-pen","title":"舞蹈纹彩陶盆（Painted Pottery Basin with Dancing Figures）","name_en":"Painted Pottery Basin with Dancing Figures","type":"work","type_zh":"作品","color":"#F59E0B","tags":["新石器时代","马家窑文化","彩陶","舞蹈纹","青海大通"],"confidence":"medium","consensus":"tentative","sub_type":"painted_pottery_basin","source_count":"5","evidence_status":"source_backed","description":"舞蹈纹彩陶盆是青海大通上孙家寨马家窑型墓葬出土的彩陶盆，内壁绘三组各五人的集体舞蹈图像。五册用到它的方式差别很大：田自秉给**尺寸与纹样结构**，细到“盆里盛的水到四道圈纹的部位，我们将会看到水面反映出的舞蹈人的倒影”；夏燕靖两版给**五种文化解释**，把学界对舞蹈纹的分歧一次列出；赵农给**图像读法与艺术源流**（“为现代舞蹈、音乐、武术、杂技等艺术形式提供了源头”）；高丰只给一句**艺术评价*","path":"works/wudaowen-caitao-pen.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"舞蹈纹彩陶盆是 B 维度下新石器时代彩陶的器形与装饰样本（马家窑型、内彩、舞蹈人三组五人），其人物纹的构图与人像解读归 C；夏燕靖两版所列五种文化解释涉及原始宗教与氏族制度，归 D 为次。Theme/Topic 尚未 materialize。"},{"id":"works:xiangyun-huoju","title":"北京奥运会火炬“祥云”（Beijing 2008 \"Xiangyun\" Olympic Torch）","name_en":"Beijing 2008 \"Xiangyun\" Olympic Torch","type":"work","type_zh":"作品","color":"#F59E0B","tags":["2008奥运","祥云","纸卷轴","铝材","丙烷"],"confidence":"medium","consensus":"tentative","sub_type":"product_design","source_count":"2","evidence_status":"source_backed","description":"北京奥运会火炬“祥云”造型灵感来自中国传统纸卷轴，长 72 厘米、重 985 克，燃烧时间 15 分钟，零风速火焰高度 25 至 30 厘米。采用锥体曲面异形一次成型和铝材腐蚀、着色技术，燃料为丙烷，外形材料可回收；火炬能在每小时 65 公里强风和每小时 50 毫米大雨下保持燃烧，是我国自主设计研发、拥有完全知识产权的产物。","path":"works/xiangyun-huoju.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 D 维度下当代中国产品设计与国家形象工程的器物锚点。Theme/Topic 尚未 materialize。"},{"id":"works:yannian-yishou-jin","title":"“延年益寿大宜子孙”锦（Yannian Yishou Brocade）","name_en":"Yannian Yishou Brocade","type":"work","type_zh":"作品","color":"#F59E0B","tags":["汉代","织锦","吉祥文字","新疆民丰","茱萸纹"],"confidence":"medium","consensus":"tentative","sub_type":"brocade","source_count":"2","evidence_status":"source_backed","description":"“延年益寿大宜子孙”锦是新疆民丰出土的汉代织锦。它在卷曲的茱萸纹和云气纹之间穿插七八种奇禽异兽，运用装饰的添加手法表现理想世界，是汉代织物动物纹与吉祥图案的实例；李立新又以它说明汉字进入设计、与图形纹样结合，在织物上表现对世间生活幸福的企盼。","path":"works/yannian-yishou-jin.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"C","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 C 维度下汉代织锦文字纹样的器物锚点，同时涉及 B 维度的织造工艺。Theme/Topic 尚未 materialize。"},{"id":"works:yiheyuan","title":"颐和园（Summer Palace (Yiheyuan)）","name_en":"Summer Palace (Yiheyuan)","type":"work","type_zh":"作品","color":"#F59E0B","tags":["清代","皇家园林","清漪园","长廊","十七孔桥"],"confidence":"medium","consensus":"tentative","sub_type":"imperial_garden","source_count":"2","evidence_status":"source_backed","description":"颐和园的前身是乾隆年间建成的清漪园，清漪园原为金元时期的行宫，明代为“好山园”；乾隆年间大肆修复构筑、扩建湖面水域，改瓮山为万寿山，成为清漪园。1860 年英法联军入侵北京，清漪园与圆明园同时被掠夺毁灭，1893 年修复后称为颐和园，1900 年八国联军又毁坏此园，1905 年清政府重新修复。颐和园以东宫门内仁寿殿为中心，形成寝宫乐寿堂、戏楼德和园等建筑群；万寿山下有 728 米长的彩画长廊，南面","path":"works/yiheyuan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下清代皇家园林的器物锚点。Theme/Topic 尚未 materialize。"},{"id":"works:yin-xunlu","title":"银熏炉（Silver Censer）","name_en":"Silver Censer","type":"work","type_zh":"作品","color":"#F59E0B","tags":["唐代","宋代","文思院","德阳","同名异器"],"confidence":"medium","consensus":"tentative","sub_type":"silverware","source_count":"2","evidence_status":"source_backed","description":"银熏炉在本批来源中指两件不同器物。其一为唐代文思院造鎏金银熏炉：通高 29.5 厘米、盖径 25.9 厘米、腹深 7 厘米、重 5.363 千克；银板锤揲成型，盖面缠枝莲上五朵莲花各卧一龟，腹壁流云纹并铆五兽足，器内錾“咸通十年（公元 869 年）文思院造”等 40 余字。其二为宋代银器：1959 年四川德阳孝泉镇清真寺出土的 117 件宋代银器之一，设计作圆球形，上面镂空成卷草纹，还保存着一些唐","path":"works/yin-xunlu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下唐宋银熏炉的器物锚点，因同名而合条，内部按唐器／宋器分列。Theme/Topic 尚未 materialize。"},{"id":"works:yongle-gong","title":"永乐宫（Yongle Palace）","name_en":"Yongle Palace","type":"work","type_zh":"作品","color":"#F59E0B","tags":["元代","道观","三清殿","朝元图","迁建"],"confidence":"medium","consensus":"tentative","sub_type":"taoist_temple","source_count":"2","evidence_status":"source_backed","description":"永乐宫位于山西永济，是元代著名的道观。三清殿是永乐宫的重要建筑，为七间阔单檐四坡顶结构，因供奉玉清元始天尊、上清灵宝天尊、太清道德天尊而名“三清殿”；四壁绘有著名壁画《朝元图》，绘画面积达 400 多平方米。永乐宫因 20 世纪 50 年代修建黄河三门峡水库而迁移到山西芮城。2016 记其为元代为皇帝祈福而建的道教建筑群，宫墙基座、门廊、石阶石雕融会道佛纹饰，既有道家植物花草，又有西汉以来西域忍冬","path":"works/yongle-gong.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下元代道教建筑的器物锚点，也涉及 E 维度的纹样传播。Theme/Topic 尚未 materialize。"},{"id":"works:yu-pingtuo-shuang-putao-jing","title":"玉平脱双葡萄镜（Jade Pingtuo Double-Grape Mirror）","name_en":"Jade Pingtuo Double-Grape Mirror","type":"work","type_zh":"作品","color":"#F59E0B","tags":["五代","前蜀王建墓","平脱","漆","玉"],"confidence":"medium","consensus":"tentative","sub_type":"bronze_mirror","source_count":"2","evidence_status":"source_backed","description":"玉平脱双葡萄镜是五代平脱器中的精美者，在前蜀王建墓出土镜匣中得见；其做法是在铜镜背面用漆平脱出双玉葡萄，可知当时在铜器上也可髹漆并平嵌宝石花纹。","path":"works/yu-pingtuo-shuang-putao-jing.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下五代铜镜的器物锚点。Theme/Topic 尚未 materialize。"},{"id":"works:yuan-yinjingjia","title":"元代银镜架（Yuan Silver Mirror Stand）","name_en":"Yuan Silver Mirror Stand","type":"work","type_zh":"作品","color":"#F59E0B","tags":["元末","苏州","张士诚","折叠式","银皮雕镂"],"confidence":"medium","consensus":"tentative","sub_type":"silverware","source_count":"3","evidence_status":"source_backed","description":"元代银镜架 1964 年出土于苏州盘门外吴门桥东南元末吴王张士诚之父母合葬墓，现藏苏州博物馆。镜架作折叠式，由前后两个支架构成，通高 32.8 厘米、宽 17.8 厘米，仿木制框架结构，在整体支架上镶三片经过雕镂的银皮。","path":"works/yuan-yinjingjia.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下元代银器的器物锚点。Theme/Topic 尚未 materialize。"},{"id":"works:yuanmingyuan","title":"圆明园（Old Summer Palace (Yuanmingyuan)）","name_en":"Old Summer Palace (Yuanmingyuan)","type":"work","type_zh":"作品","color":"#F59E0B","tags":["清代","皇家园林","西洋楼","英法联军","三山五园"],"confidence":"medium","consensus":"tentative","sub_type":"imperial_garden","source_count":"3","evidence_status":"source_backed","description":"圆明园原为雍正皇帝做皇子时赐获的花园，后经乾隆扩建，加修长春园和绮春园。长春园的一部分是欧洲风格的花园，俗称“西洋楼”；圆明园后被英法联军火烧而毁。2016 记其为清代皇家园林，属“三山五园”之一，包括圆明、长春、万春三园。","path":"works/yuanmingyuan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下清代皇家园林的器物锚点，也涉及 E 维度的跨文化造园。Theme/Topic 尚未 materialize。"},{"id":"works:yuewang-goujian-jian","title":"越王勾践剑（Sword of Goujian, King of Yue）","name_en":"Sword of Goujian, King of Yue","type":"work","type_zh":"作品","color":"#F59E0B","tags":["春秋晚期","青铜器","兵器","剑","江陵"],"confidence":"medium","consensus":"tentative","sub_type":"bronze_weapon","source_count":"5","evidence_status":"source_backed","description":"越王勾践剑是春秋晚期吴越之地的青铜剑，湖北江陵出土，剑格嵌饰、剑身铸菱形花纹并错金鸟篆铭文，埋藏两千四百余年仍完好锋利。五册对它的用法分三路：夏燕靖两版给兵器工艺与防锈原理（成分、剑鞘密封、地下水浸泡），赵农给剑格兽面纹的错石工艺，高丰与田自秉各给一句“剑柄嵌有珐琅釉料”，且都用在**景泰蓝／珐琅源流**的论证里。**五册对剑格与剑柄的装饰说法不一**：同一件器物，一处说剑格嵌蓝色琉璃与绿松石，一","path":"works/yuewang-goujian-jian.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"越王勾践剑在五册中承担三重论证：兵器形制与冶铸水平（B）、剑格镶嵌与错金鸟篆铭文的装饰与文字（C）、珐琅釉料用于金属器的早期例证（B 之材料工艺，并被高丰、田自秉两册用于景泰蓝源流之争）。五册均不描述剑身尺寸与整体造型。Theme/Topic 尚未 materialize。"},{"id":"works:zenghouyi-bianzhong","title":"曾侯乙编钟（Bells of Marquis Yi of Zeng）","name_en":"Bells of Marquis Yi of Zeng","type":"work","type_zh":"作品","color":"#F59E0B","tags":["战国早期","青铜器","编钟","曾侯乙墓","礼乐"],"confidence":"medium","consensus":"tentative","sub_type":"bronze_bell_set","source_count":"5","evidence_status":"source_backed","description":"曾侯乙编钟是 1978 年湖北随县（今随州）曾侯乙墓出土的成套青铜编钟，分上中下三层悬挂，是先秦乐器中体量与音律规模最大的一例。来源之间首先在**件数**上不一致：高丰作“64 件之多”，夏燕靖两版与赵农均作“65 枚”。其次在**论证用途**上分流：夏燕靖两版用它证青铜冶铸的规模与推广（浑铸法、分范合铸、复印花纹），赵农用它证音律成就（五个八度、五声七声音阶、十二个半音）与同墓乐器的组合规模，高","path":"works/zenghouyi-bianzhong.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"曾侯乙编钟是 B 维度下战国青铜铸造与乐器设计的规模锚点：件数、层次、音域与铸造工艺在此汇合。其“钟鸣鼎食”的礼乐组合、用钟的等级规定归 D 维度；钟体铭文作为乐律与文字资料归 C 维度。田自秉一册只给编钟作为器类的形制术语，全册未提曾侯乙。Theme/Topic 尚未 materialize。"},{"id":"works:zenghouyi-zunpan","title":"曾侯乙尊盘（Zenghouyi Zun and Pan）","name_en":"Zenghouyi Zun and Pan","type":"work","type_zh":"作品","color":"#F59E0B","tags":["战国","曾侯乙墓","透雕","熔模铸造","失蜡法"],"confidence":"medium","consensus":"tentative","sub_type":"bronze_ritual_vessel","source_count":"2","evidence_status":"source_backed","description":"曾侯乙尊盘出土于湖北随县曾侯乙墓，尊立于盘上。尊盘上下以繁缛的透雕处理，体现了春秋战国时期的熔模设计技术；2016 记墓中出土铜尊、铜盘均由内外两层铜梗组成，透空附饰纤细齐整，是春秋战国青铜冶铸与设计精品。","path":"works/zenghouyi-zunpan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下战国青铜礼器的器物锚点。Theme/Topic 尚未 materialize。"},{"id":"works:zhaozhou-qiao-595-605","title":"赵州桥（Zhaozhou Bridge）","name_en":"Zhaozhou Bridge","type":"work","type_zh":"作品","color":"#F59E0B","tags":["隋代","石拱桥","敞肩拱","李春","赵县"],"confidence":"medium","consensus":"tentative","sub_type":"stone_arch_bridge","source_count":"3","evidence_status":"source_backed","description":"赵州桥在河北赵县南洨河上，隋代李春造，又称安济桥。三册都把它当技术史的高点，但**给数的口径不同**：夏燕靖两版给约数（长 50 余米、跨度 37 米多、1300 多年），赵农给精确值（52.82 米、37.4 米、28 道狭拱各 43 块石、9 道铁拉杆）并附唐碑引文。**年代一说 595～605 年设计修建、一说建于 605 年**，两说可相容但不能互证。","path":"works/zhaozhou-qiao-595-605.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"赵州桥是 B 维度下石拱桥的结构样本：敞肩拱、并列式砌筑、铁拉杆、跨高比都在此汇合，也是“结构即形式”的设计观念样本（A 维度）。来源在年代、尺寸、类型名三处均不一致，KU 并列不裁。Theme/Topic 尚未 materialize。"},{"id":"works:zhenghe-baochuan","title":"郑和宝船（Zheng He's Treasure Ship）","name_en":"Zheng He's Treasure Ship","type":"work","type_zh":"作品","color":"#F59E0B","tags":["明代","造船","航海","郑和下西洋","沙船"],"confidence":"medium","consensus":"tentative","sub_type":"ship","source_count":"4","evidence_status":"source_backed","description":"郑和宝船是明永乐至宣德年间郑和七下西洋船队中最大的船。四册的记载角度不同：**夏燕靖两版给主尺度、桅帆数与船队编制**（长 150 米、宽 60 米、9 桅 12 帆、可载 1000 余人），**赵农给出使年表与船上仪器**（1405—1433、28 年、七次、27000 余人、30 余国，配水密隔舱与牵星板等），**高丰只给一句总评与米制尺寸**（146.7 米 × 60 米，“中国古代船舶设计","path":"works/zhenghe-baochuan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"郑和宝船是 B 维度下明代造船设计的器物锚点：主尺度、桅帆数、舵杆与船队编制都在此汇合。远洋出使的组织与国家造船业归 D 维度，海禁前后的技术进退归 E 维度。Theme/Topic 尚未 materialize。"},{"id":"works:zhongshan-ling-1929","title":"中山陵（Sun Yat-sen Mausoleum）","name_en":"Sun Yat-sen Mausoleum","type":"work","type_zh":"作品","color":"#F59E0B","tags":["民国","陵墓建筑","中国固有式","吕彦直","南京"],"confidence":"medium","consensus":"tentative","sub_type":"mausoleum","source_count":"3","evidence_status":"source_backed","description":"中山陵在南京紫金山南麓，吕彦直设计，是近代中国以公开竞图方式选定方案的大型纪念建筑群。三册的关注点不同：**夏燕靖两版抄录征稿条例与评判报告**（含“木铎警世”的钟形释义，并判为近代建筑史上首次具有规划设计意识的大型建筑群组），**赵农给年代、空间序列与风格评断**（1929 年设计、“晨钟暮鼓”、传统陵墓设计的“一曲绝唱”）。**两册对“设计”与“征图”的年份记载不一致**，且钟形平面在两册中的","path":"works/zhongshan-ling-1929.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"中山陵是 B 维度下近代纪念性建筑群的样本：牌坊—墓道—陵门—碑亭—石阶—祭堂—墓室的空间序列与钟形平面都在此汇合。竞图制度、征稿条例与评判报告归 D 维度；“中国固有式”“民族形式”的取向归 A 维度。Theme/Topic 尚未 materialize。"},{"id":"works:zhuozhengyuan","title":"拙政园（Humble Administrator's Garden）","name_en":"Humble Administrator's Garden","type":"work","type_zh":"作品","color":"#F59E0B","tags":["明代","苏州园林","文征明","远香堂","72亩"],"confidence":"medium","consensus":"tentative","sub_type":"private_garden","source_count":"2","evidence_status":"source_backed","description":"拙政园是明代中期修筑的苏州园林，“拙政”出自西晋潘岳《闲居赋》“灌园鬻蔬，以供朝夕之膳，是亦拙者之为政也”。明代大画家文征明绘有《拙政园图》并著《拙政园记》；园分中、西、东三部分，占地 72 亩，为最大的苏州园林，中部以远香堂为中心，有倚玉轩、小飞虹、香洲、见山楼、雪香云蔚亭、梧竹幽居、荷风四面亭及枇杷园等。","path":"works/zhuozhengyuan.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"本 KU 是 B 维度下明代私家园林的器物锚点。Theme/Topic 尚未 materialize。"}],"links":[],"structure":{"domains":[],"dimensions":[],"themes":[],"topics":[]},"stats":{"total_nodes":505,"total_links":0,"relation_index_total":0,"skipped_non_unit_relations":0,"by_type":{"person":74,"institution":37,"place":39,"work":72,"publication":68,"term":192,"procedure":12,"event":11},"hierarchy":{"domain_assigned":505,"dimension_assigned":505,"theme_assigned":0,"topic_assigned":0},"structure_nodes":{"domains":0,"dimensions":0,"themes":0,"topics":0}}};
+window.KNOWLEDGE_GRAPH_DATA={"nodes":[{"id":"events:1851-wanguo-bolanhui","title":"1851年英国万国博览会（The Great Exhibition of 1851）","name_en":"The Great Exhibition of 1851","type":"event","type_zh":"事件","color":"#EF4444","tags":["1851","万国博览会","水晶宫","工业革命","现代设计"],"confidence":"medium","consensus":"tentative","sub_type":"exhibition","source_count":"1","evidence_status":"source_backed","description":"赵农两处记 1851 年英国博览会：总结处称“在 1851 年英国‘万国博览会’中，钢铁、玻璃结构的‘水晶宫’的出现，揭开了现代艺术设计的序幕”；后记处称“1851 年的英国世界博览会，展示着工业革命的成果，并由此带来了现代设计文化的兴盛”。来源未给举办城市、展馆尺寸、参展国数量、展品清单与参观人数。","path":"events/1851-wanguo-bolanhui.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"E","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"1851 年英国万国博览会是 E 维度下现代设计诞生的跨文化节点，其钢铁玻璃建筑技术归 B 维度。Theme/Topic 尚未 materialize。"},{"id":"events:1972-1976-dingci-huifu","title":"定瓷恢复（Revival of Ding Ware Production）","name_en":"Revival of Ding Ware Production","type":"event","type_zh":"事件","color":"#EF4444","tags":["定瓷","定窑","曲阳","周恩来","田中角荣"],"confidence":"medium","consensus":"tentative","sub_type":"historical_event","source_count":"1","evidence_status":"source_backed","description":"夏燕靖记“文革”极左思潮下工艺美术生产瘫痪，到 1970 年全国有半数以上工艺美术企业转产或停产，产值下降 47%，许多传统产品销声匿迹。从 1971 年到 1972 年，周恩来总理和国务院其他领导人开始力争扭转这一混乱局面。1972 年，日本首相田中角荣访华时向周恩来询问定瓷的烧制状况，周恩来回答说正在恢复之中。1974 年，在周恩来的关怀下，河北保定地区工艺美术定瓷厂在曲阳建立。两年后，定瓷恢","path":"events/1972-1976-dingci-huifu.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"B","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"定瓷恢复是 B 维度下失传名瓷工艺复原的节点，其政府推动与工厂建制归 D 维度。Theme/Topic 尚未 materialize。"},{"id":"events:1998-moe-major-catalog","title":"1998 年教育部本科专业目录调整（1998 Adjustment of the Ministry of Education Undergraduate Program Catalogue）","name_en":"1998 Adjustment of the Ministry of Education Undergraduate Program Catalogue","type":"event","type_zh":"事件","color":"#EF4444","tags":["1998","教育部","本科专业目录","工艺美术","艺术设计"],"confidence":"medium","consensus":"tentative","sub_type":"historical_event","source_count":"1","evidence_status":"source_backed","description":"1998 年 7 月，教育部颁布《普通高等学校本科专业目录》，将“工艺美术专业”改为“艺术设计专业”。来源只记这一名称改动，未给目录全文、专业代码、学科门类归属与实施范围。","path":"events/1998-moe-major-catalog.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"1998 年本科专业目录调整是 D 维度下设计教育学科制度的关键节点，其教学与课程后果归 D 维度。Theme/Topic 尚未 materialize。"},{"id":"events:1998-national-furniture-exhibition","title":"第五届全国家具展览（The Fifth National Furniture Exhibition）","name_en":"The Fifth National Furniture Exhibition","type":"event","type_zh":"事件","color":"#EF4444","tags":["1998","家具展览","中国家具协会","北京农业展览馆"],"confidence":"medium","consensus":"tentative","sub_type":"exhibition","source_count":"1","evidence_status":"source_backed","description":"1998 年 4 月 29 日至 5 月 2 日，由中国家具协会主办的“第五届全国家具展览”在北京农业展览馆举行。来源只记主办单位、时间、地点与展览名称，未记展品、参展企业与观众。","path":"events/1998-national-furniture-exhibition.md","primary_domain":"chinese-design-history","secondary_domains":[],"primary_dimension":"D","primary_theme":"","secondary_themes":[],"role_in_theme":"","topic_memberships":[],"hierarchy_scope_note":"第五届全国家具展览是 D 维度下家具行业展示与交流的节点，其家具设计本体归 B 维度。Theme/Topic 尚未 materialize。"},{"id":"events:1999-book-design-exhibition","title":"第五届全国书籍装帧艺术展览（The Fifth National Book Design Exhibition）","name_en":"The Fifth National Book Design Exhibition","type":"event","type_zh":"事件","color":"#EF4444","tags":["1999","书籍装帧","展览","中国美术馆","出版设计"],"confidence":"medium","consensus":"tentative","sub_type":"exhibition","source_count":"1","evidence_status":"source_backed","description":"1999 年 5 月 11 至 16 日，“第五届全国书籍装帧艺术展览”在北京中国美术馆举行。来源把它与前后的 1999 年设计教育论坛、中央工艺美术学院合并并列为该年设计界事件，但未记主办单位、展品与奖项。","path":"events/1999-book-design-exhibition.md","primary_domain":"chinese-design-his