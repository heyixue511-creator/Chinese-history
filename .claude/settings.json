{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/scripts/agent_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking repository safety policy"
          }
        ]
      }
    ]
  }
}
