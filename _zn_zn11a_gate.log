-{"candidate_id":"2009-zhaonong-zhongguo-yishu-shejishi:cand-12-01","candidate_type":"unit","created_at":"2026-10-24T19:30:47+08:00","decision":{"decided_at":null,"decided_by":null,"reason":null,"status":"pending"},"evidence_refs":["03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L8086-L8086"],"lifecycle_class":"active","origin_ref":"03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md","origin_type":"source","payload":{"knowledge_match":{"notes":"04-knowledge 当前无 KU；待人工复核。","status":"novel","target_refs":[]},"proposed_fields":{"definition":"19世纪末进入中国沿海、以现代纺织技术生产的价廉物美机织布。","term":"洋布"},"proposed_slug":"yangbu","source_span":{"block_ids":["b0338"],"chapter":"第十章 艰难的变革——现代时期的设计","line_end":8102,"line_start":8084,"section":"第四节 服饰与纺织"},"summary":"19世纪末大量现代纺织技术进入中国沿海地区，生产出价廉物美的“洋布”，冲击中国社会现实生活并破坏传统纺织技术的生存条件。传统纺织由此仅成为乡村社会底层妇女农闲时期的劳作，少许手工纺织品仅在周围集市交换。","title":"洋布","unit_type":"term"},"state":"needs_evidence","updated_at":"2026-10-24T19:30:47+08:00"}
-{"candidate_id":"2009-zhaonong-zhongguo-yishu-shejishi:cand-12-02","candidate_type":"unit","created_at":"2026-10-24T19:30:47+08:00","decision":{"decided_at":null,"decided_by":null,"reason":null,"status":"pending"},"evidence_refs":["03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L8092-L8099"],"lifecycle_class":"active","origin_ref":"03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md","origin_type":"source","payload":{"knowledge_match":{"notes":"04-knowledge 当前无 KU；待人工复核。","status":"novel","target_refs":[]},"proposed_fields":{"definition":"苏绣、湘绣、粤绣、蜀绣的合称，形成于1949年后江南丝绸业恢复发展的背景下。","term":"四大名绣"},"proposed_slug":"si-da-ming-xiu","source_span":{"block_ids":["b0338"],"chapter":"第十章 艰难的变革——现代时期的设计","line_end":8102,"line_start":8084,"section":"第四节 服饰与纺织"},"summary":"1949年后江南以上海、苏州、杭州为中心恢复丝绸产品与锦、绸、缎、纱、罗、绫等传统技术，南京云锦、四川蜀锦等也有所发展，形成苏绣、湘绣、粤绣、蜀绣“四大名绣”。此外河南汴绣、山东鲁绣也有突破，少数民族苗绣、黎绣、土家绣各具特色。","title":"四大名绣","unit_type":"term"},"state":"needs_evidence","updated_at":"2026-10-24T19:30:47+08:00"}
-{"candidate_id":"2009-zhaonong-zhongguo-yishu-shejishi:cand-12-03","candidate_type":"claim","created_at":"2026-10-24T19:30:47+08:00","decision":{"decided_at":null,"decided_by":null,"reason":null,"status":"pending"},"evidence_refs":["03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L8086-L8092"],"lifecycle_class":"active","origin_ref":"03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md","origin_type":"source","payload":{"claim_scope":"historiographic_claim","claim_text":"洋布冲击破坏了传统纺织技术的生存条件，使传统纺织退为乡村社会底层妇女农闲时期的劳作，少许手工纺织品仅在周围集市交换，“丝绸大国”的盛景已不复存在。","knowledge_match":{"notes":"04-knowledge 当前无 KU；待人工复核。","status":"novel","target_refs":[]},"proposed_confidence":"tentative","source_span":{"block_ids":["b0338"],"chapter":"第十章 艰难的变革——现代时期的设计","line_end":8102,"line_start":8084,"section":"第四节 服饰与纺织"},"support_note":"L8086直接陈述洋布冲击及传统纺织退居乡村的情形，并以“丝绸大国”盛景不复存在作结；L8092续述1949年后恢复。"},"state":"needs_evidence","updated_at":"2026-10-24T19:30:47+08:00"}
