+{"candidate_id":"2009-zhaonong-zhongguo-yishu-shejishi:cand-03-92","candidate_type":"unit","created_at":"2026-10-24T19:30:47+08:00","decision":{"decided_at":"2026-10-26","decided_by":"Agent","reason":"六节齐全；原文「V 形」的拉丁字母与汉字间空格照录；未给铧冠尺寸、重量与出土单位。","status":"approved"},"evidence_refs":["03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L1982-L1982"],"lifecycle_class":"terminal","origin_ref":"03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md","origin_type":"source","payload":{"knowledge_match":{"notes":"04-knowledge 当前无 KU；待人工复核。","status":"novel","target_refs":[]},"proposed_fields":{"definition":"套在木犁铧上的V形铁冠，春秋时出现，配合牛力耕地。","term":"V形铁铧冠"},"proposed_slug":"v-shaped-iron-ploughshare-cap","source_span":{"block_ids":["b0074"],"chapter":"第三章 霸业的冲撞——春秋战国时期的设计","line_end":1987,"line_start":1966,"section":"第三节 农具与工具"},"summary":"V形铁铧冠在春秋时出现，即在木犁铧上套上铁铧冠，可以用牛力作为耕地的辅助。《国语·晋语》提到的“畎田之勤”就是指牛耕的作用。原文将其视为农具成为社会生活重要生产器具、农业成为具体生活方式的例证。","title":"V形铁铧冠","unit_type":"term"},"state":"applied","target_ref":"04-knowledge/units/terms/v-shaped-iron-ploughshare-cap.md","updated_at":"2026-10-26"}
+{"candidate_id":"2009-zhaonong-zhongguo-yishu-shejishi:cand-03-93","candidate_type":"unit","created_at":"2026-10-24T19:30:47+08:00","decision":{"decided_at":"2026-10-26","decided_by":"Agent","reason":"六节齐全；来源只提下扇磨身，未提完整器形与上扇结构，已写入证据边界；文件名为 shi-mo.md（非候选 proposed_slug 的 stone-mill）。","status":"approved"},"evidence_refs":["03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L1986-L1986"],"lifecycle_class":"terminal","origin_ref":"03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md","origin_type":"source","payload":{"knowledge_match":{"notes":"04-knowledge 当前无 KU；待人工复核。","status":"novel","target_refs":[]},"proposed_fields":{"definition":"战国出现的粮食加工器具，砂岩制，直径约55厘米，推动面食成为北方主食。","term":"石磨"},"proposed_slug":"stone-mill","source_span":{"block_ids":["b0074"],"chapter":"第三章 霸业的冲撞——春秋战国时期的设计","line_end":1987,"line_start":1966,"section":"第三节 农具与工具"},"summary":"石磨在战国时期出现，河北邯郸赵故城、陕西临潼等地发现下扇磨身，属砂岩石制，其中石磨直径约55厘米。石磨的出现使面食逐渐成为北方人的生活习惯；面食的长期食用彻底改变了人们的心理习性，也使农耕生活方式与渔猎生活方式开始分离，并带来一系列器具使用的变化。","title":"石磨","unit_type":"term"},"state":"applied","target_ref":"04-knowledge/units/terms/shi-mo.md","updated_at":"2026-10-26"}
 {"candidate_id":"2009-zhaonong-zhongguo-yishu-shejishi:cand-03-94","candidate_type":"unit","created_at":"2026-10-24T19:30:47+08:00","decision":{"decided_at":"2026-10-25","decided_by":"Agent","reason":"已按 exact change-set 写入 04-knowledge/units/publications/guanzi.md","status":"approved"},"evidence_refs":["03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L1976-L1976","03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L2132-L2132","03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L2418-L2418"],"lifecycle_class":"terminal","origin_ref":"03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md","origin_type":"source","payload":{"knowledge_match":{"notes":"04-knowledge 当前无 KU；待人工复核。","status":"novel","target_refs":[]},"merged_candidate_ids":["2009-zhaonong-zhongguo-yishu-shejishi:cand-04-23"],"proposed_fields":{"notes":"含《轻重乙》《乘马》等篇，涉及农具、工具与都城规划。","period":"先秦","title":"管子"},"proposed_slug":"guanzi","source_span":{"block_ids":["b0074","b0080","b0092"],"chapter":"第三章 霸业的冲撞——春秋战国时期的设计","line_end":2423,"line_start":1966,"section":"第三节 农具与工具"},"summary":"《管子》是先秦典籍，原文引《管子·轻重乙》说明农、车、女所需工具，并称管仲认为齐国种田男子必须有一犁、一耙、一把锄等，造车木匠必须有斧、锯、锥、凿等，妇女必须有针、刀等；从这些议论可见农具和工具在当时生活中的重要位置。原文又引《管子·乘马》“凡立国都，非于大山之下必于广川之上……”说明城市选址与规划。原文又称《管子》相传是春秋时期齐国政治家管仲的著作，今存76篇；管仲推行富民强国的政治经济政策，使齐国成为强盛之国，提出“仓廪实而知礼节，衣食足而知荣辱”的观点，具有“以民为本”的思想。","title":"管子","unit_type":"publication"},"state":"applied","target_ref":"04-knowledge/units/publications/guanzi.md","updated_at":"2026-10-25"}
-{"candidate_id":"2009-zhaonong-zhongguo-yishu-shejishi:cand-03-95","candidate_type":"claim","created_at":"2026-10-24T19:30:47+08:00","decision":{"decided_at":null,"decided_by":null,"reason":null,"status":"pending"},"evidence_refs":["03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L1974-L1974","03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L1792-L1792"],"lifecycle_class":"active","origin_ref":"03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md","origin_type":"source","payload":{"claim_scope":"historiographic_claim","claim_text":"从春秋战国开始，中国已经全面进入铁器时代，铸铁技术、锻铸技术遥遥领先，提高了铁器具制作技术水平并加快制作速度；战国中期铁制兵器、农具、工具大量出现，中国社会全面进入铁器时代，成为中古时期世界先进文化的代表之一。","knowledge_match":{"notes":"04-knowledge 当前无 KU；待人工复核。","status":"novel","target_refs":[]},"proposed_confidence":"tentative","source_span":{"block_ids":["b0074","b0067"],"chapter":"第三章 霸业的冲撞——春秋战国时期的设计","line_end":1987,"line_start":1767,"section":"第一节 绪论"},"support_note":"原文在“铁器”段与绪论“冶铁业”段两次提出中国全面进入铁器时代的判断。"},"state":"needs_evidence","updated_at":"2026-10-24T19:30:47+08:00"}
-{"candidate_id":"2009-zhaonong-zhongguo-yishu-shejishi:cand-03-96","candidate_type":"claim","created_at":"2026-10-24T19:30:47+08:00","decision":{"decided_at":null,"decided_by":null,"reason":null,"status":"pending"},"evidence_refs":["03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L1986-L1986"],"lifecycle_class":"active","origin_ref":"03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md","origin_type":"source","payload":{"claim_scope":"historiographic_claim","claim_text":"石磨的出现使面食逐渐成为北方人的生活习惯，面食的长期食用彻底改变了人们的心理习性，也使农耕生活方式与渔猎生活方式开始分离，并带来一系列器具使用的变化。","knowledge_match":{"notes":"04-knowledge 当前无 KU；待人工复核。","status":"novel","target_refs":[]},"proposed_confidence":"tentative","source_span":{"block_ids":["b0074"],"chapter":"第三章 霸业的冲撞——春秋战国时期的设计","line_end":1987,"line_start":1966,"section":"第三节 农具与工具"},"support_note":"原文在“石磨”段直接提出石磨对面食习惯、心理习性与生活方式分离的影响。"},"state":"needs_evidence","updated_at":"2026-10-24T19:30:47+08:00"}
-{"candidate_id":"2009-zhaonong-zhongguo-yishu-shejishi:cand-03-97","candidate_type":"unit","created_at":"2026-10-24T19:30:47+08:00","decision":{"decided_at":null,"decided_by":null,"reason":null,"status":"pending"},"evidence_refs":["03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L1994-L1994"],"lifecycle_class":"active","origin_ref":"03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md","origin_type":"source","payload":{"knowledge_match":{"notes":"04-knowledge 当前无 KU；待人工复核。","status":"novel","target_refs":[]},"proposed_fields":{"definition":"利用平衡与省力原理的器具与力学概念，是权衡、衡器的雏形。","term":"杠杆"},"proposed_slug":"lever","source_span":{"block_ids":["b0076"],"chapter":"第三章 霸业的冲撞——春秋战国时期的设计","line_end":2039,"line_start":1990,"section":"第三节 农具与工具"},"summary":"杠杆是一种平衡原理，具有省力作用。原文称杠杆原理是在石器时期原始先民使用木棒猎取食物或撬动石块时体验和发现到的；有意利用杠杆原理制成平衡器具，成为“权衡”或“衡器”概念的雏形，是古人的智慧结晶。","title":"杠杆","unit_type":"term"},"state":"needs_evidence","updated_at":"2026-10-24T19:30:47+08:00"}
-{"candidate_id":"2009-zhaonong-zhongguo-yishu-shejishi:cand-03-98","candidate_type":"unit","created_at":"2026-10-24T19:30:47+08:00","decision":{"decided_at":null,"decided_by":null,"reason":null,"status":"pending"},"evidence_refs":["03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L1996-L1996"],"lifecycle_class":"active","origin_ref":"03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md","origin_type":"source","payload":{"knowledge_match":{"notes":"04-knowledge 当前无 KU；待人工复核。","status":"novel","target_refs":[]},"proposed_fields":{"definition":"以杠杆原理称量的秤具，长沙楚墓出土春秋等臂秤具实物。","term":"权衡"},"proposed_slug":"hengqi-balance","source_span":{"block_ids":["b0076"],"chapter":"第三章 霸业的冲撞——春秋战国时期的设计","line_end":2039,"line_start":1990,"section":"第三节 农具与工具"},"summary":"权衡或衡器是称量器具。长沙楚墓出土春秋时期等臂秤具实物，证明春秋时期人们已利用杠杆原理制作秤具。《墨子·墨经》论述“衡木加重焉而不翘……权重相若也。相衡则本短标长……”，其中衡木即秤杆、本为重臂、标为支点到权的距离刻度（力臂）、权为秤砣，这是秤的基本原理；杠杆中秤的原理后来发展成为铢秤。","title":"权衡秤器","unit_type":"term"},"state":"needs_evidence","updated_at":"2026-10-24T19:30:47+08:00"}
-{"candidate_id":"2009-zhaonong-zhongguo-yishu-shejishi:cand-03-99","candidate_type":"unit","created_at":"2026-10-24T19:30:47+08:00","decision":{"decided_at":null,"decided_by":null,"reason":null,"status":"pending"},"evidence_refs":["03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L1998-L2002"],"lifecycle_class":"active","origin_ref":"03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md","origin_type":"source","payload":{"knowledge_match":{"notes":"04-knowledge 当前无 KU；待人工复核。","status":"novel","target_refs":[]},"proposed_fields":{"definition":"井旁利用杠杆与配重汲水的器具，省力并提高提水速度。","term":"桔槔"},"proposed_slug":"jiegou-well-sweep","source_span":{"block_ids":["b0076"],"chapter":"第三章 霸业的冲撞——春秋战国时期的设计","line_end":2039,"line_start":1990,"section":"第三节 农具与工具"},"summary":"桔槔是“引之则俯，舍之则仰”的汲水器具，在深井提水时利用杠杆机械原理：井旁立木架，上用绳子系横木，一端水桶、一端重物，使用时一升一落，省力且提高速度。作者称这是机械杠杆原理的巧妙利用，浇灌土地时使沉重汲水过程变得轻松而富于节奏；《墨子》中桔槔还是守城必备的战斗武器。","title":"桔槔","unit_type":"term"},"state":"needs_evidence","updated_at":"2026-10-24T19:30:47+08:00"}
