-{"candidate_id":"2009-zhaonong-zhongguo-yishu-shejishi:cand-04-127","candidate_type":"unit","created_at":"2026-10-24T19:30:47+08:00","decision":{"decided_at":null,"decided_by":null,"reason":null,"status":"pending"},"evidence_refs":["03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L2975-L2980"],"lifecycle_class":"active","origin_ref":"03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md","origin_type":"source","payload":{"knowledge_match":{"notes":"04-knowledge 当前无 KU；待人工复核。","status":"novel","target_refs":[]},"proposed_fields":{"name":"霍去病","notes":"对匈奴战争取得决定性胜利，24岁早逝，墓在茂陵之侧。","period":"西汉汉武帝时","role":"青年将军"},"proposed_slug":"huo-qubing","source_span":{"block_ids":["b0114"],"chapter":"第四章 统一的气量——秦汉时期的设计","line_end":2987,"line_start":2930,"section":"第五节 建筑与雕塑"},"summary":"霍去病是汉武帝时期的青年将军，英勇骁战、所向披靡，在对北方匈奴的战争中取得决定性的胜利，解除了匈奴长期以来对汉王朝的威胁。他英年早逝，仅仅24岁；汉武帝出于怜惜和缅怀，将其墓置于自己的茂陵之侧，使之成为一座彰功纪念的陪葬墓。","title":"霍去病","unit_type":"person"},"state":"needs_evidence","updated_at":"2026-10-24T19:30:47+08:00"}
-{"candidate_id":"2009-zhaonong-zhongguo-yishu-shejishi:cand-04-128","candidate_type":"claim","created_at":"2026-10-24T19:30:47+08:00","decision":{"decided_at":null,"decided_by":null,"reason":null,"status":"pending"},"evidence_refs":["03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L2969-L2969"],"lifecycle_class":"active","origin_ref":"03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md","origin_type":"source","payload":{"claim_scope":"interpretive_claim","claim_text":"以兵马俑为陪葬的内容，是中国古代陪葬方式的一种极致；已出土的汉代帝王陵墓的陪葬规模和制度，均无法与秦始皇陵及秦兵马俑相比。","knowledge_match":{"notes":"04-knowledge 当前无 KU；待人工复核。","status":"novel","target_refs":[]},"proposed_confidence":"tentative","source_span":{"block_ids":["b0114"],"chapter":"第四章 统一的气量——秦汉时期的设计","line_end":2987,"line_start":2930,"section":"第五节 建筑与雕塑"},"support_note":"L2969先指出兵马俑的出土对认识秦王朝陵墓制度和造墓思想有特殊作用，继而判断以兵马俑陪葬是中国古代陪葬方式的一种极致，并将汉代帝王陵墓的陪葬规模与秦始皇陵及秦兵马俑作比较。"},"state":"needs_evidence","updated_at":"2026-10-24T19:30:47+08:00"}
