+{"candidate_id":"2009-zhaonong-zhongguo-yishu-shejishi:cand-10-24","candidate_type":"claim","created_at":"2026-10-24T19:30:47+08:00","decision":{"decided_at":"2026-10-27","decided_by":"Agent","reason":"已应用：写入 claim-registry.yml claim-0684。","status":"approved"},"evidence_refs":["03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L6724-L6726"],"lifecycle_class":"terminal","origin_ref":"03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md","origin_type":"source","payload":{"claim_scope":"historiographic_claim","claim_text":"明代北京城的整体布局是在国都向北京转移的特定背景下合理规划及设计的结果，其中的设计思想与明代国家制度的需求有很大关系；其中轴线的确立和城市营造的规模、水平较以前朝代有明显进步，清代入关后仅作局部修缮而未改变城市根本格局，使北京城完整延续下来。","knowledge_match":{"notes":"04-knowledge 当前无 KU；待人工复核。","status":"novel","target_refs":[]},"proposed_confidence":"tentative","source_span":{"block_ids":["b0282"],"chapter":"第九章 专制的文化——明清时期的设计","line_end":6727,"line_start":6655,"section":"第二节 城市与建筑"},"support_note":"原文在叙述都城布局后，明确将布局归因于国家制度需求，并评价其较前代的进步及清代的延续。"},"state":"applied","target_ref":"claim/claim-0684","updated_at":"2026-10-27"}
+{"candidate_id":"2009-zhaonong-zhongguo-yishu-shejishi:cand-10-25","candidate_type":"unit","created_at":"2026-10-24T19:30:47+08:00","decision":{"decided_at":"2026-10-26","decided_by":"Agent","reason":"写入 04-knowledge/units/works/nanjing-chengqiang.md（新建）；引用 L6741, L6743。","status":"approved"},"evidence_refs":["03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L6741-L6743"],"lifecycle_class":"terminal","origin_ref":"03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md","origin_type":"source","payload":{"knowledge_match":{"notes":"04-knowledge 当前无 KU；待人工复核。","status":"novel","target_refs":[]},"proposed_fields":{"category":"城防工程","location":"南京","period":"明洪武年间","title":"南京城墙"},"proposed_slug":"nanjing-chengqiang","source_span":{"block_ids":["b0283"],"chapter":"第九章 专制的文化——明清时期的设计","line_end":6761,"line_start":6728,"section":"第二节 城市与建筑"},"summary":"南京在洪武年间修筑了周长达33.70公里的城墙，高度在14~21米之间，因山就势，高低不等，多为砖石包砌，上有城垛和窝铺，以利防御。城墙设置13座城门并建有瓮城，周围还建有土夯外郭城，企图使南京城重重设防、固若金汤。作者评论说，数百年间多次战争使南京城饱受摧残，仅依靠城墙的坚固不能获得持久的安定。","title":"南京城墙","unit_type":"work"},"state":"applied","target_ref":"04-knowledge/units/works/nanjing-chengqiang.md","updated_at":"2026-10-26"}
+{"candidate_id":"2009-zhaonong-zhongguo-yishu-shejishi:cand-10-26","candidate_type":"unit","created_at":"2026-10-24T19:30:47+08:00","decision":{"decided_at":"2026-10-26","decided_by":"Agent","reason":"04-knowledge/units/places/xian.md（更新）；citation 扩至 L6745、L6749、L6751、L7811。","status":"approved"},"evidence_refs":["03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L6745-L6751"],"lifecycle_class":"terminal","origin_ref":"03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md","origin_type":"source","payload":{"knowledge_match":{"notes":"04-knowledge 当前无 KU；待人工复核。","status":"novel","target_refs":[]},"proposed_fields":{"category":"城市","location":"西安","period":"明代","title":"明代西安城"},"proposed_slug":"mingdai-xian-cheng","source_span":{"block_ids":["b0283"],"chapter":"第九章 专制的文化——明清时期的设计","line_end":6761,"line_start":6728,"section":"第二节 城市与建筑"},"summary":"明清时期的西安以隋唐旧城的废墟为基础，利用隋唐旧城的西、南旧城墙修筑了明代西安。西安城墙周长14公里，高12米，四面开有城门并建有御敌城楼；城楼设置箭楼、瓮城、城楼、城门，形成防御系统。明代还在城中心设置钟鼓楼，街道呈十字分布，以钟楼为中心向四方辐射，构成东西南北四条大街的基本格局。","title":"明代西安城","unit_type":"work"},"state":"applied","target_ref":"04-knowledge/units/places/xian.md","updated_at":"2026-10-26"}
+{"candidate_id":"2009-zhaonong-zhongguo-yishu-shejishi:cand-10-27","candidate_type":"unit","created_at":"2026-10-24T19:30:47+08:00","decision":{"decided_at":"2026-10-26","decided_by":"Agent","reason":"写入 04-knowledge/units/works/shenyang-gugong.md（新建）；引用 L6753, L6758。","status":"approved"},"evidence_refs":["03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L6753-L6758"],"lifecycle_class":"terminal","origin_ref":"03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md","origin_type":"source","payload":{"knowledge_match":{"notes":"04-knowledge 当前无 KU；待人工复核。","status":"novel","target_refs":[]},"proposed_fields":{"category":"宫殿建筑群","location":"沈阳（盛京）","period":"明代万历年间以后","title":"沈阳故宫"},"proposed_slug":"shenyang-gugong","source_span":{"block_ids":["b0283"],"chapter":"第九章 专制的文化——明清时期的设计","line_end":6761,"line_start":6728,"section":"第二节 城市与建筑"},"summary":"沈阳是辽金元故地，旧称营州，元代为沈阳路。明代万历年间努尔哈赤建国大金，后来迁都沈阳，改称盛京，城市规模随之扩大并修建宫城，即沈阳故宫。城市中心建有钟鼓楼与宫殿相互呼应，四周城墙各开设两座城门，形成城市街道的井字形布局。","title":"沈阳故宫","unit_type":"work"},"state":"applied","target_ref":"04-knowledge/units/works/shenyang-gugong.md","updated_at":"2026-10-26"}
