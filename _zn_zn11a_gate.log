+{"candidate_id":"2009-zhaonong-zhongguo-yishu-shejishi:cand-10-71","candidate_type":"unit","created_at":"2026-10-24T19:30:47+08:00","decision":{"decided_at":"2026-10-26","decided_by":"Agent","reason":"写入 04-knowledge/units/terms/jiazi-chuang.md（新建）；引用 L7009, L7023。","status":"approved"},"evidence_refs":["03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L7009-L7023"],"lifecycle_class":"terminal","origin_ref":"03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md","origin_type":"source","payload":{"knowledge_match":{"notes":"04-knowledge 当前无 KU；待人工复核。","status":"novel","target_refs":[]},"proposed_fields":{"definition":"床上带顶高架的封闭式床，将床与帐结合，四足承床，三面床围以木剩料装饰。","term":"架子床"},"proposed_slug":"jiazi-chuang","source_span":{"block_ids":["b0291"],"chapter":"第九章 专制的文化——明清时期的设计","line_end":7036,"line_start":6961,"section":"第三节 商业与民居"},"summary":"明式家具的床在制形上趋于封闭，完全成为私密性空间。架子床将床与帐密切结合，既可以防尘挡风，也成为真正意义上的安睡之处；其以床上带顶的高架为特点，四足承床，在床围的头、脚、后三面利用木剩料进行装饰性设计，使纹饰和功能融为一体。","title":"架子床","unit_type":"term"},"state":"applied","target_ref":"04-knowledge/units/terms/jiazi-chuang.md","updated_at":"2026-10-26"}
+{"candidate_id":"2009-zhaonong-zhongguo-yishu-shejishi:cand-10-72","candidate_type":"unit","created_at":"2026-10-24T19:30:47+08:00","decision":{"decided_at":"2026-10-26","decided_by":"Agent","reason":"写入 04-knowledge/units/terms/luohan-chuang.md（新建）；引用 L7025, L7029。","status":"approved"},"evidence_refs":["03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L7025-L7029"],"lifecycle_class":"terminal","origin_ref":"03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md","origin_type":"source","payload":{"knowledge_match":{"notes":"04-knowledge 当前无 KU；待人工复核。","status":"novel","target_refs":[]},"proposed_fields":{"definition":"三面围屏、保留开放性特征的床榻，多用于休闲会客，床上可置矮几。","term":"罗汉床"},"proposed_slug":"luohan-chuang","source_span":{"block_ids":["b0291"],"chapter":"第九章 专制的文化——明清时期的设计","line_end":7036,"line_start":6961,"section":"第三节 商业与民居"},"summary":"罗汉床也称罗汉榻，基本上保留了明代以前床的开放性特征，仅三面围屏作为遮挡。罗汉床多是休闲会客的场所，多在床上安置矮几一类小件家具；因床足粗壮，加之宋元时期多为高僧座谈之器，故以“罗汉”称谓。","title":"罗汉床","unit_type":"term"},"state":"applied","target_ref":"04-knowledge/units/terms/luohan-chuang.md","updated_at":"2026-10-26"}
