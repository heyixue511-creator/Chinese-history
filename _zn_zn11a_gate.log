-{"candidate_id":"2004-gaofeng-zhongguo-shejishi:cand-04-20","candidate_type":"claim","created_at":"2026-10-24T17:56:52+08:00","decision":{"decided_at":null,"decided_by":null,"reason":null,"status":"pending"},"evidence_refs":["03基础书籍-md文档/中国设计史_高丰_2004_广西美术出版社.md#L3067-L3071"],"lifecycle_class":"active","origin_ref":"03基础书籍-md文档/中国设计史_高丰_2004_广西美术出版社.md","origin_type":"source","payload":{"claim_scope":"periodization","claim_text":"三国两晋南北朝至隋唐五代是中国古代家具由低型向高型逐步过渡的转折时期；席地而坐与垂足而坐、矮型与高型家具长期并存，变化先从贵族阶层开始，并与佛教传入、桌椅出现相互促进。","knowledge_match":{"notes":"知识库当前为 0 KU，未发现同名断言。","status":"novel","target_refs":[]},"proposed_confidence":"tentative","source_span":{"block_ids":["b0157"],"chapter":"第五章 设计的多元与融会","line_end":3095,"line_start":3065,"section":"第七节 家具设计与室内设计"},"support_note":"本书以敦煌石窟壁画、周昉《宫乐图》、顾闳中《韩熙载夜宴图》等图像及文献为据，并指出过渡期两种起居方式并存。"},"state":"needs_evidence","updated_at":"2026-10-24T17:56:52+08:00"}
