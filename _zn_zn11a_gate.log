-{"candidate_id":"2009-zhaonong-zhongguo-yishu-shejishi:cand-07-12","candidate_type":"unit","created_at":"2026-10-24T19:30:47+08:00","decision":{"decided_at":null,"decided_by":null,"reason":null,"status":"pending"},"evidence_refs":["03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L4463-L4467"],"lifecycle_class":"active","origin_ref":"03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md","origin_type":"source","payload":{"knowledge_match":{"notes":"04-knowledge 当前无 KU；待人工复核。","status":"novel","target_refs":[]},"proposed_fields":{"definition":"将佛经卷折叠成一定宽度，前后用硬纸或木板夹护并裱糊书皮的装帧形式。","term":"经折装"},"proposed_slug":"jingzhe-binding","source_span":{"block_ids":["b0179"],"chapter":"第六章 繁盛的浮华——隋唐时期的设计","line_end":4476,"line_start":4433,"section":"第三节 印刷与书籍"},"summary":"经折装即折子装，是受卷轴装和梵夹装影响发展起来的书籍装帧形式。它出现于唐代末年，将佛经卷折叠成一定宽度，前后用硬纸或木板夹护，并用硬纸木板裱糊成书皮，便于经卷阅读。","title":"经折装","unit_type":"term"},"state":"needs_evidence","updated_at":"2026-10-24T19:30:47+08:00"}
