-{"candidate_id":"2009-zhaonong-zhongguo-yishu-shejishi:cand-03-90","candidate_type":"unit","created_at":"2026-10-24T19:30:47+08:00","decision":{"decided_at":null,"decided_by":null,"reason":null,"status":"pending"},"evidence_refs":["03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L1962-L1962","03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L2235-L2235","03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L2247-L2247"],"lifecycle_class":"active","origin_ref":"03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md","origin_type":"source","payload":{"knowledge_match":{"notes":"04-knowledge 当前无 KU；待人工复核。","status":"novel","target_refs":[]},"proposed_fields":{"category":"青铜鉴","location":"河南汲县","material":"青铜","period":"战国","title":"水陆攻战纹铜鉴"},"proposed_slug":"shuilu-gongzhan-tongjian","source_span":{"block_ids":["b0072","b0084"],"chapter":"第三章 霸业的冲撞——春秋战国时期的设计","line_end":2252,"line_start":1926,"section":"第二节 车辆与兵器"},"summary":"水陆攻战纹铜鉴出土于河南汲县，是战国青铜鉴，原文亦称《水陆攻战图鉴》。器表图像上下两层：上层士兵击鼓、挥戈、射箭，下层水手划棹行船，被视为楚国水战的生动描写，从中可见战国木板船的样式。原文又称战国墓出土的水陆攻战纹鉴制器大方、绘画生动。","title":"水陆攻战纹铜鉴","unit_type":"work"},"state":"needs_evidence","updated_at":"2026-10-24T19:30:47+08:00"}
-{"candidate_id":"2009-zhaonong-zhongguo-yishu-shejishi:cand-03-91","candidate_type":"claim","created_at":"2026-10-24T19:30:47+08:00","decision":{"decided_at":null,"decided_by":null,"reason":null,"status":"pending"},"evidence_refs":["03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L1962-L1962"],"lifecycle_class":"active","origin_ref":"03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md","origin_type":"source","payload":{"claim_scope":"historiographic_claim","claim_text":"船只的大量制造和使用，使中国南方地区较早进入水上交通的发达阶段，促进了人们生活方式的改变；人们在征服自然、利用水产资源中也提高了自身生存能力。","knowledge_match":{"notes":"04-knowledge 当前无 KU；待人工复核。","status":"novel","target_refs":[]},"proposed_confidence":"tentative","source_span":{"block_ids":["b0072"],"chapter":"第三章 霸业的冲撞——春秋战国时期的设计","line_end":1963,"line_start":1926,"section":"第二节 车辆与兵器"},"support_note":"原文在“水战”段末直接总结船只制造对南方水上交通与生活方式的影响。"},"state":"needs_evidence","updated_at":"2026-10-24T19:30:47+08:00"}
-{"candidate_id":"2009-zhaonong-zhongguo-yishu-shejishi:cand-03-92","candidate_type":"unit","created_at":"2026-10-24T19:30:47+08:00","decision":{"decided_at":null,"decided_by":null,"reason":null,"status":"pending"},"evidence_refs":["03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L1982-L1982"],"lifecycle_class":"active","origin_ref":"03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md","origin_type":"source","payload":{"knowledge_match":{"notes":"04-knowledge 当前无 KU；待人工复核。","status":"novel","target_refs":[]},"proposed_fields":{"definition":"套在木犁铧上的V形铁冠，春秋时出现，配合牛力耕地。","term":"V形铁铧冠"},"proposed_slug":"v-shaped-iron-ploughshare-cap","source_span":{"block_ids":["b0074"],"chapter":"第三章 霸业的冲撞——春秋战国时期的设计","line_end":1987,"line_start":1966,"section":"第三节 农具与工具"},"summary":"V形铁铧冠在春秋时出现，即在木犁铧上套上铁铧冠，可以用牛力作为耕地的辅助。《国语·晋语》提到的“畎田之勤”就是指牛耕的作用。原文将其视为农具成为社会生活重要生产器具、农业成为具体生活方式的例证。","title":"V形铁铧冠","unit_type":"term"},"state":"needs_evidence","updated_at":"2026-10-24T19:30:47+08:00"}
-{"candidate_id":"2009-zhaonong-zhongguo-yishu-shejishi:cand-03-93","candidate_type":"unit","created_at":"2026-10-24T19:30:47+08:00","decision":{"decided_at":null,"decided_by":null,"reason":null,"status":"pending"},"evidence_refs":["03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L1986-L1986"],"lifecycle_class":"active","origin_ref":"03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md","origin_type":"source","payload":{"knowledge_match":{"notes":"04-knowledge 当前无 KU；待人工复核。","status":"novel","target_refs":[]},"proposed_fields":{"definition":"战国出现的粮食加工器具，砂岩制，直径约55厘米，推动面食成为北方主食。","term":"石磨"},"proposed_slug":"stone-mill","source_span":{"block_ids":["b0074"],"chapter":"第三章 霸业的冲撞——春秋战国时期的设计","line_end":1987,"line_start":1966,"section":"第三节 农具与工具"},"summary":"石磨在战国时期出现，河北邯郸赵故城、陕西临潼等地发现下扇磨身，属砂岩石制，其中石磨直径约55厘米。石磨的出现使面食逐渐成为北方人的生活习惯；面食的长期食用彻底改变了人们的心理习性，也使农耕生活方式与渔猎生活方式开始分离，并带来一系列器具使用的变化。","title":"石磨","unit_type":"term"},"state":"needs_evidence","updated_at":"2026-10-24T19:30:47+08:00"}
