-{"candidate_id":"2009-zhaonong-zhongguo-yishu-shejishi:cand-04-03","candidate_type":"unit","created_at":"2026-10-24T19:30:47+08:00","decision":{"decided_at":null,"decided_by":null,"reason":null,"status":"pending"},"evidence_refs":["03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L2274-L2274"],"lifecycle_class":"active","origin_ref":"03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md","origin_type":"source","payload":{"knowledge_match":{"notes":"04-knowledge 当前无 KU；待人工复核。","status":"novel","target_refs":[]},"proposed_fields":{"definition":"楚国流通的铜铸仿贝货币，由贝币演变而来。","term":"蚁鼻钱"},"proposed_slug":"yi-bi-qian","source_span":{"block_ids":["b0085"],"chapter":"第三章 霸业的冲撞——春秋战国时期的设计","line_end":2279,"line_start":2253,"section":"第五节 服饰与货币"},"summary":"蚁鼻钱是贝币的演变、铜铸仿贝的发展，因中间凸出的部分像人的鼻子而称为蚁鼻钱。它携带方便、制作精巧，主要在楚国流通。","title":"蚁鼻钱","unit_type":"term"},"state":"needs_evidence","updated_at":"2026-10-24T19:30:47+08:00"}
