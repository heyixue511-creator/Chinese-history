-{"candidate_id":"2009-zhaonong-zhongguo-yishu-shejishi:cand-09-04","candidate_type":"unit","created_at":"2026-10-24T19:30:47+08:00","decision":{"decided_at":null,"decided_by":null,"reason":null,"status":"pending"},"evidence_refs":["03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L5947-L5949"],"lifecycle_class":"active","origin_ref":"03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md","origin_type":"source","payload":{"knowledge_match":{"notes":"04-knowledge 当前无 KU；待人工复核。","status":"novel","target_refs":[]},"proposed_fields":{"definition":"元代八思巴依藏文字母并参考畏兀儿文、汉文结构创制的官方文字，40余字母","term":"八思巴字"},"proposed_slug":"phags-pa-script","source_span":{"block_ids":["b0245"],"chapter":"第八章 游牧的强悍——辽金西夏元时期的设计","line_end":5961,"line_start":5909,"section":"第二节 文字与印刷"},"summary":"忽必烈时期任命吐蕃僧人八思巴为国师，创制蒙古新字并定为蒙古国字即官方文字。该文字依据藏文字母，并参考畏兀儿文字和汉文字的结构，共有40余个字母，拼写蒙古语和汉语；方体字形从右向左、从上向下书写。此前成吉思汗时期已有借助畏兀儿字母的拼音文字畏兀儿蒙文，源自古回鹘文字，从左自右竖写。","title":"八思巴字（蒙古国字）","unit_type":"term"},"state":"needs_evidence","updated_at":"2026-10-24T19:30:47+08:00"}
-{"candidate_id":"2009-zhaonong-zhongguo-yishu-shejishi:cand-09-05","candidate_type":"unit","created_at":"2026-10-24T19:30:47+08:00","decision":{"decided_at":null,"decided_by":null,"reason":null,"status":"pending"},"evidence_refs":["03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L5956-L5960"],"lifecycle_class":"active","origin_ref":"03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md","origin_type":"source","payload":{"knowledge_match":{"notes":"04-knowledge 当前无 KU；待人工复核。","status":"novel","target_refs":[]},"proposed_fields":{"definition":"元代通行的新波斯文字“普速蛮字”，即穆斯林文字，后发展为经字画","term":"回回文字"},"proposed_slug":"huihui-script","source_span":{"block_ids":["b0245"],"chapter":"第八章 游牧的强悍——辽金西夏元时期的设计","line_end":5961,"line_start":5909,"section":"第二节 文字与印刷"},"summary":"元代八思巴文字、汉文字、回回文字成为通行文字样式；回回文字是新波斯文字，称“普速蛮字”即穆斯林文字，元代设回回国子学和回回国子监教授。元代回回人还流行“亦思替非”文字，有特殊书写和计算方法，属表意的象形文字和符号缩写样式。回回文字在中原发展为经字画，有花体、象形体、波斯体、行书体、宫廷体等书写样式，并采用中堂、横幅、对联等汉书法形式。","title":"回回文字（普速蛮字）","unit_type":"term"},"state":"needs_evidence","updated_at":"2026-10-24T19:30:47+08:00"}
