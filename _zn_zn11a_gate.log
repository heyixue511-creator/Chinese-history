-{"candidate_id":"2009-zhaonong-zhongguo-yishu-shejishi:cand-03-109","candidate_type":"unit","created_at":"2026-10-24T19:30:47+08:00","decision":{"decided_at":null,"decided_by":null,"reason":null,"status":"pending"},"evidence_refs":["03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md#L2047-L2047"],"lifecycle_class":"active","origin_ref":"03基础书籍-md文档/中国艺术设计史_赵农_2009_高等教育出版社.md","origin_type":"source","payload":{"knowledge_match":{"notes":"04-knowledge 当前无 KU；待人工复核。","status":"novel","target_refs":[]},"proposed_fields":{"definition":"以细竹条或细木条编穿成册的书籍形式，简为单条，策（册）为合编。","term":"简策"},"proposed_slug":"jiance-bamboo-slip-books","source_span":{"block_ids":["b0077"],"chapter":"第三章 霸业的冲撞——春秋战国时期的设计","line_end":2054,"line_start":2040,"section":"第三节 农具与工具"},"summary":"简策是用细竹条或细木条编穿在一起的书籍形式。一条竹木条是一简，若干简合编起来就是策或册，“册”的字义即源于此；一般用麻、丝、皮绳子编册。孔子“韦编三绝”的故事中，韦的原意是熟皮绳。","title":"简策","unit_type":"term"},"state":"needs_evidence","updated_at":"2026-10-24T19:30:47+08:00"}
